 \u015f\u00f6yle denilir: \u201c\u015eimdi tad\u0131n. Art\u0131k bundan sonra yaln\u0131zca azab\u0131n\u0131z\u0131 art\u0131raca\u011f\u0131z.\u201d","footnotes":""},{"id":"5703","sura":"78","aya":"31","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0644\u0650\u0644\u06e1\u0645\u064f\u062a\u0651\u064e\u0642\u0650\u064a\u0646\u064e \u0645\u064e\u0641\u064e\u0627\u0632\u064b\u0627","translation":"\u015e\u00fcphesiz takva sahipleri i\u00e7in bir kurtulu\u015f vard\u0131r.","footnotes":""},{"id":"5704","sura":"78","aya":"32","arabic_text":"\u062d\u064e\u062f\u064e\u0627\u0653\u0626\u0650\u0642\u064e \u0648\u064e\u0623\u064e\u0639\u06e1\u0646\u064e\u0670\u0628\u0657\u0627","translation":"Bah\u00e7eler ve \u00fcz\u00fcmler vard\u0131r.","footnotes":""},{"id":"5705","sura":"78","aya":"33","arabic_text":"\u0648\u064e\u0643\u064e\u0648\u064e\u0627\u0639\u0650\u0628\u064e \u0623\u064e\u062a\u06e1\u0631\u064e\u0627\u0628\u0657\u0627","translation":"G\u00f6\u011f\u00fcsleri olgun ya\u015f\u0131t k\u0131zlar vard\u0131r.","footnotes":""},{"id":"5706","sura":"78","aya":"34","arabic_text":"\u0648\u064e\u0643\u064e\u0623\u06e1\u0633\u0657\u0627 \u062f\u0650\u0647\u064e\u0627\u0642\u0657\u0627","translation":"Dolu dolu kadehler vard\u0131r.","footnotes":""},{"id":"5707","sura":"78","aya":"35","arabic_text":"\u0644\u0651\u064e\u0627 \u064a\u064e\u0633\u06e1\u0645\u064e\u0639\u064f\u0648\u0646\u064e \u0641\u0650\u064a\u0647\u064e\u0627 \u0644\u064e\u063a\u06e1\u0648\u0657\u0627 \u0648\u064e\u0644\u064e\u0627 \u0643\u0650\u0630\u0651\u064e\u0670\u0628\u0657\u0627","translation":"Orada ne bir bo\u015f s\u00f6z i\u015fitirler, ne de bir yalan.","footnotes":""},{"id":"5708","sura":"78","aya":"36","arabic_text":"\u062c\u064e\u0632\u064e\u0627\u0653\u0621\u0657 \u0645\u0651\u0650\u0646 \u0631\u0651\u064e\u0628\u0651\u0650\u0643\u064e \u0639\u064e\u0637\u064e\u0627\u0653\u0621\u064b \u062d\u0650\u0633\u064e\u0627\u0628\u0657\u0627","translation":"Rabbinden bir kar\u015f\u0131l\u0131k olmak \u00fczere yeterli bir ba\u011f\u0131\u015ft\u0131r bu.","footnotes":""},{"id":"5709","sura":"78","aya":"37","arabic_text":"\u0631\u0651\u064e\u0628\u0651\u0650 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0648\u064e\u0645\u064e\u0627 \u0628\u064e\u064a\u06e1\u0646\u064e\u0647\u064f\u0645\u064e\u0627 \u0671\u0644\u0631\u0651\u064e\u062d\u06e1\u0645\u064e\u0670\u0646\u0650\u06d6 \u0644\u064e\u0627 \u064a\u064e\u0645\u06e1\u0644\u0650\u0643\u064f\u0648\u0646\u064e \u0645\u0650\u0646\u06e1\u0647\u064f \u062e\u0650\u0637\u064e\u0627\u0628\u0657\u0627","translation":"Bunlar; g\u00f6klerin, yerin ve ikisi aras\u0131nda bulunanlar\u0131n Rahman olan Rabbindendir. Ona hitap etmeye g\u00fc\u00e7 yetiremezler.","footnotes":""},{"id":"5710","sura":"78","aya":"38","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064e\u0642\u064f\u0648\u0645\u064f \u0671\u0644\u0631\u0651\u064f\u0648\u062d\u064f \u0648\u064e\u0671\u0644\u06e1\u0645\u064e\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e\u0629\u064f \u0635\u064e\u0641\u0651\u0657\u0627\u06d6 \u0644\u0651\u064e\u0627 \u064a\u064e\u062a\u064e\u0643\u064e\u0644\u0651\u064e\u0645\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u064e\u0646\u06e1 \u0623\u064e\u0630\u0650\u0646\u064e \u0644\u064e\u0647\u064f \u0671\u0644\u0631\u0651\u064e\u062d\u06e1\u0645\u064e\u0670\u0646\u064f \u0648\u064e\u0642\u064e\u0627\u0644\u064e \u0635\u064e\u0648\u064e\u0627\u0628\u0657\u0627","translation":"Ruh'un ve meleklerin s\u0131ra s\u0131ra duracaklar\u0131 g\u00fcn; Rahman'\u0131n kendilerine izin verdikleri d\u0131\u015f\u0131ndakiler konu\u015famazlar. Onlar da do\u011fruyu s\u00f6ylerler.","footnotes":""},{"id":"5711","sura":"78","aya":"39","arabic_text":"\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0671\u0644\u06e1\u064a\u064e\u0648\u06e1\u0645\u064f \u0671\u0644\u06e1\u062d\u064e\u0642\u0651\u064f\u06d6 \u0641\u064e\u0645\u064e\u0646 \u0634\u064e\u0627\u0653\u0621\u064e \u0671\u062a\u0651\u064e\u062e\u064e\u0630\u064e \u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0647\u0650\u06e6 \u0645\u064e\u0640\u0654\u064e\u0627\u0628\u064b\u0627","translation":"\u0130\u015fte bu o hak g\u00fcnd\u00fcr. O halde dileyen Rabbine bir d\u00f6n\u00fc\u015f yolu edinsin.","footnotes":""},{"id":"5712","sura":"78","aya":"40","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0627\u0653 \u0623\u064e\u0646\u0630\u064e\u0631\u06e1\u0646\u064e\u0670\u0643\u064f\u0645\u06e1 \u0639\u064e\u0630\u064e\u0627\u0628\u0657\u0627 \u0642\u064e\u0631\u0650\u064a\u0628\u0657\u0627 \u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064e\u0646\u0638\u064f\u0631\u064f \u0671\u0644\u06e1\u0645\u064e\u0631\u06e1\u0621\u064f \u0645\u064e\u0627 \u0642\u064e\u062f\u0651\u064e\u0645\u064e\u062a\u06e1 \u064a\u064e\u062f\u064e\u0627\u0647\u064f \u0648\u064e\u064a\u064e\u0642\u064f\u0648\u0644\u064f \u0671\u0644\u06e1\u0643\u064e\u0627\u0641\u0650\u0631\u064f \u064a\u064e\u0670\u0644\u064e\u064a\u06e1\u062a\u064e\u0646\u0650\u064a \u0643\u064f\u0646\u062a\u064f \u062a\u064f\u0631\u064e\u0670\u0628\u064e\u06e2\u0627","translation":"Biz, sizi \u00e7ok yak\u0131n bir azapla uyard\u0131k. Herkes o g\u00fcn, kendi elleriyle ne yapt\u0131\u011f\u0131na bir bakar ve k\u00e2fir olanlar da: \"Ke\u015fke toprak olsayd\u0131m!\" der.","footnotes":""}]}