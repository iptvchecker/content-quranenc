646 \u0633\u064f\u0644\u06e1\u0637\u064e\u0670\u0646\u064d\u06da \u0625\u0650\u0646 \u064a\u064e\u062a\u0651\u064e\u0628\u0650\u0639\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u0638\u0651\u064e\u0646\u0651\u064e \u0648\u064e\u0645\u064e\u0627 \u062a\u064e\u0647\u06e1\u0648\u064e\u0649 \u0671\u0644\u06e1\u0623\u064e\u0646\u0641\u064f\u0633\u064f\u06d6 \u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u062c\u064e\u0627\u0653\u0621\u064e\u0647\u064f\u0645 \u0645\u0651\u0650\u0646 \u0631\u0651\u064e\u0628\u0651\u0650\u0647\u0650\u0645\u064f \u0671\u0644\u06e1\u0647\u064f\u062f\u064e\u0649\u0670\u0653","translation":"Bunlar (putlar) sizin ve atalar\u0131n\u0131z\u0131n takt\u0131\u011f\u0131 isimlerden ba\u015fka bir \u015fey de\u011fildir. Allah, onlar hakk\u0131nda bir delil indirmemi\u015ftir. Onlar, ancak zanna ve nefislerinin arzusuna uyuyorlar. Oysa, onlara Rableri taraf\u0131ndan yol g\u00f6sterici gelmi\u015ftir.","footnotes":""},{"id":"4808","sura":"53","aya":"24","arabic_text":"\u0623\u064e\u0645\u06e1 \u0644\u0650\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u0650 \u0645\u064e\u0627 \u062a\u064e\u0645\u064e\u0646\u0651\u064e\u0649\u0670","translation":"Yoksa insan her arzu etti\u011fi \u015feye sahip mi olacakt\u0131r?","footnotes":""},{"id":"4809","sura":"53","aya":"25","arabic_text":"\u0641\u064e\u0644\u0650\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u064e\u0629\u064f \u0648\u064e\u0671\u0644\u06e1\u0623\u064f\u0648\u0644\u064e\u0649\u0670","translation":"Ahiret de d\u00fcnya da Allah\u2019\u0131nd\u0131r.","footnotes":""},{"id":"4810","sura":"53","aya":"26","arabic_text":"\u06de\u00a0\u0648\u064e\u0643\u064e\u0645 \u0645\u0651\u0650\u0646 \u0645\u0651\u064e\u0644\u064e\u0643\u0656 \u0641\u0650\u064a \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0644\u064e\u0627 \u062a\u064f\u063a\u06e1\u0646\u0650\u064a \u0634\u064e\u0641\u064e\u0670\u0639\u064e\u062a\u064f\u0647\u064f\u0645\u06e1 \u0634\u064e\u064a\u06e1\u0640\u0654\u064b\u0627 \u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u0650\u0646\u06e2 \u0628\u064e\u0639\u06e1\u062f\u0650 \u0623\u064e\u0646 \u064a\u064e\u0623\u06e1\u0630\u064e\u0646\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0644\u0650\u0645\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064f \u0648\u064e\u064a\u064e\u0631\u06e1\u0636\u064e\u0649\u0670\u0653","translation":"G\u00f6klerde nice melekler vard\u0131r ki, Allah diledi\u011fi ve raz\u0131 oldu\u011fu kimseler i\u00e7in izin vermedik\u00e7e onlar\u0131n \u015fefaat\u0131 hi\u00e7bir fayda vermez.","footnotes":""},{"id":"4811","sura":"53","aya":"27","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0644\u064e\u0627 \u064a\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e \u0628\u0650\u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u064e\u0629\u0650 \u0644\u064e\u064a\u064f\u0633\u064e\u0645\u0651\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u0645\u064e\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e\u0629\u064e \u062a\u064e\u0633\u06e1\u0645\u0650\u064a\u064e\u0629\u064e \u0671\u0644\u06e1\u0623\u064f\u0646\u062b\u064e\u0649\u0670","translation":"Do\u011frusu ahirete iman etmeyenler, melekleri di\u015fi isimlerle isimlendirirler.","footnotes":""},{"id":"4812","sura":"53","aya":"28","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0644\u064e\u0647\u064f\u0645 \u0628\u0650\u0647\u0650\u06e6 \u0645\u0650\u0646\u06e1 \u0639\u0650\u0644\u06e1\u0645\u064d\u06d6 \u0625\u0650\u0646 \u064a\u064e\u062a\u0651\u064e\u0628\u0650\u0639\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u0638\u0651\u064e\u0646\u0651\u064e\u06d6 \u0648\u064e\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0638\u0651\u064e\u0646\u0651\u064e \u0644\u064e\u0627 \u064a\u064f\u063a\u06e1\u0646\u0650\u064a \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u062d\u064e\u0642\u0651\u0650 \u0634\u064e\u064a\u06e1\u0640\u0654\u0657\u0627","translation":"H\u00e2lbuki onlar\u0131n buna dair bilgileri yoktur. Onlar ancak zanna uyarlar. Zan ise hi\u00e7 \u015f\u00fcphesiz hak ad\u0131na hi\u00e7bir \u015fey ifade etmez.","footnotes":""},{"id":"4813","sura":"53","aya":"29","arabic_text":"\u0641\u064e\u0623\u064e\u0639\u06e1\u0631\u0650\u0636\u06e1 \u0639\u064e\u0646 \u0645\u0651\u064e\u0646 \u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0649\u0670 \u0639\u064e\u0646 \u0630\u0650\u0643\u06e1\u0631\u0650\u0646\u064e\u0627 \u0648\u064e\u0644\u064e\u0645\u06e1 \u064a\u064f\u0631\u0650\u062f\u06e1 \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u06e1\u062d\u064e\u064a\u064e\u0648\u0670\u0629\u064e \u0671\u0644\u062f\u0651\u064f\u0646\u06e1\u064a\u064e\u0627","translation":"Bu sebeple sen, zikrimizden\/Kur'an'dan y\u00fcz \u00e7evirenden ve d\u00fcnya hayat\u0131ndan ba\u015fka bir \u015fey istemeyenden uzak dur!","footnotes":""},{"id":"4814","sura":"53","aya":"30","arabic_text":"\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0645\u064e\u0628\u06e1\u0644\u064e\u063a\u064f\u0647\u064f\u0645 \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u06e1\u0639\u0650\u0644\u06e1\u0645\u0650\u06da \u0625\u0650\u0646\u0651\u064e \u0631\u064e\u0628\u0651\u064e\u0643\u064e \u0647\u064f\u0648\u064e \u0623\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0628\u0650\u0645\u064e\u0646 \u0636\u064e\u0644\u0651\u064e \u0639\u064e\u0646 \u0633\u064e\u0628\u0650\u064a\u0644\u0650\u0647\u0650\u06e6 \u0648\u064e\u0647\u064f\u0648\u064e \u0623\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0628\u0650\u0645\u064e\u0646\u0650 \u0671\u0647\u06e1\u062a\u064e\u062f\u064e\u0649\u0670","translation":"\u0130\u015fte onlar\u0131n eri\u015febilecekleri ilim budur. \u015e\u00fcphesiz Rabbin, kimin yolundan sapt\u0131\u011f\u0131n\u0131 en iyi bilendir. Kimin hidayet \u00fczere oldu\u011funu da en iyi bilen O\u2019dur.","footnotes":""},{"id":"4815","sura":"53","aya":"31","arabic_text":"\u0648\u064e\u0644\u0650\u0644\u0651\u064e\u0647\u0650 \u0645\u064e\u0627 \u0641\u0650\u064a \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0645\u064e\u0627 \u0641\u0650\u064a \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0644\u0650\u064a\u064e\u062c\u06e1\u0632\u0650\u064a\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064e\u0633\u064e\u0670\u0653\u0640\u0654\u064f\u0648\u0627\u0652 \u0628\u0650\u0645\u064e\u0627 \u0639\u064e\u0645\u0650\u0644\u064f\u0648\u0627\u0652 \u0648\u064e\u064a\u064e\u062c\u06e1\u0632\u0650\u064a\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064e\u062d\u06e1\u0633\u064e\u0646\u064f\u0648\u0627\u0652 \u0628\u0650\u0671\u0644\u06e1\u062d\u064f\u0633\u06e1\u0646\u064e\u0649","translation":"G\u00f6klerde olan da yerde olan da Allah\u2019\u0131nd\u0131r. K\u00f6t\u00fcl\u00fck edenleri yapt\u0131klar\u0131 sebebiyle cezaland\u0131racak, iyilik edenleri de en iyisi ile \u00f6d\u00fcllendirecektir.","footnotes":""},{"id":"4816","sura":"53","aya":"32","arabic_text":"\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u064a\u064e\u062c\u06e1\u062a\u064e\u0646\u0650\u0628\u064f\u0648\u0646\u064e \u0643\u064e\u0628\u064e\u0670\u0653\u0626\u0650\u0631\u064e \u0671\u0644\u06e1\u0625\u0650\u062b\u06e1\u0645\u0650 \u0648\u064e\u0671\u0644\u06e1\u0641\u064e\u0648\u064e\u0670\u062d\u0650\u0634\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u0644\u0651\u064e\u0645\u064e\u0645\u064e\u06da \u0625\u0650\u0646\u0651\u064e \u0631\u064e\u0628\u0651\u064e\u0643\u064e \u0648\u064e\u0670\u0633\u0650\u0639\u064f \u0671\u0644\u06e1\u0645\u064e\u063a\u06e1\u0641\u0650\u0631\u064e\u0629\u0650\u06da \u0647\u064f\u0648\u064e \u0623\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0628\u0650\u0643\u064f\u0645\u06e1 \u0625\u0650\u0630\u06e1 \u0623\u064e\u0646\u0634\u064e\u0623\u064e\u0643\u064f\u0645 \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0648\u064e\u0625\u0650\u0630\u06e1 \u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u0623\u064e\u062c\u0650\u0646\u0651\u064e\u0629\u065e \u0641\u0650\u064a \u0628\u064f\u0637\u064f\u0648\u0646\u0650 \u0623\u064f\u0645\u0651\u064e\u0647\u064e\u0670\u062a\u0650\u0643\u064f\u0645\u06e1\u06d6 \u0641\u064e\u0644\u064e\u0627 \u062a\u064f\u0632\u064e\u0643\u0651\u064f\u0648\u0653\u0627\u0652 \u0623\u064e\u0646\u0641\u064f\u0633\u064e\u0643\u064f\u0645\u06e1\u06d6 \u0647\u064f\u0648\u064e \u0623\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0628\u0650\u0645\u064e\u0646\u0650 \u0671\u062a\u0651\u064e\u0642\u064e\u0649\u0670\u0653","translation":"Onlar k\u00fc\u00e7\u00fck kusurlar d\u0131\u015f\u0131nda g\u00fcn\u00e2hlar\u0131n b\u00fcy\u00fcklerinden ve \u00e7irkin i\u015flerden ka\u00e7\u0131n\u0131rlar. \u015e\u00fcphesiz Rabbin, ma\u011ffireti \u00e7ok geni\u015f oland\u0131r. Sizi topraktan meydana getirdi\u011fi zaman da ve siz, annelerinizin karn\u0131nda cenin halinde iken de sizi en iyi O bilir. \u00d6yleyse kendi kendinizi temize \u00e7\u0131karmay\u0131n. Kimin takval\u0131 oldu\u011funu en iyi O bilir.","footnotes":""},{"id":"4817","sura":"53","aya":"33","arabic_text":"\u0623\u064e\u0641\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0649\u0670","translation":"Y\u00fcz \u00e7eviren kimseyi g\u00f6rd\u00fcn m\u00fc?","footnotes":""},{"id":"4818","sura":"53","aya":"34","arabic_text":"\u0648\u064e\u0623\u064e\u0639\u06e1\u0637\u064e\u0649\u0670 \u0642\u064e\u0644\u0650\u064a\u0644\u0657\u0627 \u0648\u064e\u0623\u064e\u0643\u06e1\u062f\u064e\u0649\u0670\u0653","translation":"Ve az bir \u015fey verip s\u0131ms\u0131k\u0131 tutan\u0131.","footnotes":""},{"id":"4819","sura":"53","aya":"35","arabic_text":"\u0623\u064e\u0639\u0650\u0646\u062f\u064e\u0647\u064f\u06e5 \u0639\u0650\u0644\u06e1\u0645\u064f \u0671\u0644\u06e1\u063a\u064e\u064a\u06e1\u0628\u0650 \u0641\u064e\u0647\u064f\u0648\u064e \u064a\u064e\u0631\u064e\u0649\u0670\u0653","translation":"Gayb\u0131n ilmi onun yan\u0131nda da, o mu g\u00f6r\u00fcyor?","footnotes":""},{"id":"4820","sura":"53","aya":"36","arabic_text":"\u0623\u064e\u0645\u06e1 \u0644\u064e\u0645\u06e1 \u064a\u064f\u0646\u064e\u0628\u0651\u064e\u0623\u06e1 \u0628\u0650\u0645\u064e\u0627 \u0641\u0650\u064a \u0635\u064f\u062d\u064f\u0641\u0650 \u0645\u064f\u0648\u0633\u064e\u0649\u0670","translation":"Yoksa ona M\u00fbs\u00e2'n\u0131n sahifelerinde olan haber verilmedi mi?","footnotes":""},{"id":"4821","sura":"53","aya":"37","arabic_text":"\u0648\u064e\u0625\u0650\u0628\u06e1\u0631\u064e\u0670\u0647\u0650\u064a\u0645\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u0648\u064e\u0641\u0651\u064e\u0649\u0670\u0653","translation":"Ve ahdine vefa g\u00f6steren \u0130brahim'in (sahifelerinde)","footnotes":""},{"id":"4822","sura":"53","aya":"38","arabic_text":"\u0623\u064e\u0644\u0651\u064e\u0627 \u062a\u064e\u0632\u0650\u0631\u064f \u0648\u064e\u0627\u0632\u0650\u0631\u064e\u0629\u065e \u0648\u0650\u0632\u06e1\u0631\u064e \u0623\u064f\u062e\u06e1\u0631\u064e\u0649\u0670","translation":"Ger\u00e7ekten hi\u00e7bir g\u00fcnahk\u00e2r, ba\u015fkas\u0131n\u0131n g\u00fcnah y\u00fck\u00fcn\u00fc y\u00fcklenmez.","footnotes":""},{"id":"4823","sura":"53","aya":"39","arabic_text":"\u0648\u064e\u0623\u064e\u0646 \u0644\u0651\u064e\u064a\u06e1\u0633\u064e \u0644\u0650\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u0650 \u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u064e\u0627 \u0633\u064e\u0639\u064e\u0649\u0670","translation":"\u0130nsan i\u00e7in \u00e7al\u0131\u015ft\u0131\u011f\u0131ndan ba\u015fkas\u0131 yoktur.","footnotes":""},{"id":"4824","sura":"53","aya":"40","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e \u0633\u064e\u0639\u06e1\u064a\u064e\u0647\u064f\u06e5 \u0633\u064e\u0648\u06e1\u0641\u064e \u064a\u064f\u0631\u064e\u0649\u0670","translation":"\u015e\u00fcphesiz onun \u00e7al\u0131\u015fmas\u0131 ileride g\u00f6r\u00fclecektir.","footnotes":""},{"id":"4825","sura":"53","aya":"41","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u064a\u064f\u062c\u06e1\u0632\u064e\u0649\u0670\u0647\u064f \u0671\u0644\u06e1\u062c\u064e\u0632\u064e\u0627\u0653\u0621\u064e \u0671\u0644\u06e1\u0623\u064e\u0648\u06e1\u0641\u064e\u0649\u0670","translation":"Sonra da kar\u015f\u0131l\u0131\u011f\u0131 eksiksiz tam olarak verilecektir.","footnotes":""},{"id":"4826","sura":"53","aya":"42","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e \u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0671\u0644\u06e1\u0645\u064f\u0646\u062a\u064e\u0647\u064e\u0649\u0670","translation":"Ve ku\u015fkusuz en son var\u0131\u015f Rabbinedir.","footnotes":""},{"id":"4827","sura":"53","aya":"43","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u0647\u064f\u0648\u064e \u0623\u064e\u0636\u06e1\u062d\u064e\u0643\u064e \u0648\u064e\u0623\u064e\u0628\u06e1\u0643\u064e\u0649\u0670","translation":"G\u00fcld\u00fcren de, a\u011flatan da O\u2019dur.","footnotes":""},{"id":"4828","sura":"53","aya":"44","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u0647\u064f\u0648\u064e \u0623\u064e\u0645\u064e\u0627\u062a\u064e \u0648\u064e\u0623\u064e\u062d\u06e1\u064a\u064e\u0627","translation":"\u00d6ld\u00fcren de, dirilten de O\u2019dur.","footnotes":""},{"id":"4829","sura":"53","aya":"45","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u062e\u064e\u0644\u064e\u0642\u064e \u0671\u0644\u0632\u0651\u064e\u0648\u06e1\u062c\u064e\u064a\u06e1\u0646\u0650 \u0671\u0644\u0630\u0651\u064e\u0643\u064e\u0631\u064e \u0648\u064e\u0671\u0644\u06e1\u0623\u064f\u0646\u062b\u064e\u0649\u0670","translation":"Erkek ve di\u015fi olarak iki cinsi yaratan O\u2019dur.","footnotes":""},{"id":"4830","sura":"53","aya":"46","arabic_text":"\u0645\u0650\u0646 \u0646\u0651\u064f\u0637\u06e1\u0641\u064e\u0629\u064d \u0625\u0650\u0630\u064e\u0627 \u062a\u064f\u0645\u06e1\u0646\u064e\u0649\u0670","translation":"Bir nutfeden rahimlere d\u00f6k\u00fcld\u00fc\u011f\u00fc zaman.","footnotes":""},{"id":"4831","sura":"53","aya":"47","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650 \u0671\u0644\u0646\u0651\u064e\u0634\u06e1\u0623\u064e\u0629\u064e \u0671\u0644\u06e1\u0623\u064f\u062e\u06e1\u0631\u064e\u0649\u0670","translation":"\u015e\u00fcphesiz tekrar diriltmek de O\u2019na aittir.","footnotes":""},{"id":"4832","sura":"53","aya":"48","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u0647\u064f\u0648\u064e \u0623\u064e\u063a\u06e1\u0646\u064e\u0649\u0670 \u0648\u064e\u0623\u064e\u0642\u06e1\u0646\u064e\u0649\u0670","translation":"Zengin k\u0131lan da, varl\u0131kl\u0131 eden de O\u2019dur.","footnotes":""},{"id":"4833","sura":"53","aya":"49","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u0647\u064f\u0648\u064e \u0631\u064e\u0628\u0651\u064f \u0671\u0644\u0634\u0651\u0650\u0639\u06e1\u0631\u064e\u0649\u0670","translation":"\u015ei\u2019r\u00e2 (y\u0131ld\u0131z\u0131)n\u0131n Rabbi de O\u2019dur.","footnotes":""},{"id":"4834","sura":"53","aya":"50","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5\u0653 \u0623\u064e\u0647\u06e1\u0644\u064e\u0643\u064e \u0639\u064e\u0627\u062f\u064b\u0627 \u0671\u0644\u06e1\u0623\u064f\u0648\u0644\u064e\u0649\u0670","translation":"Ve \u015f\u00fcphesiz ki, \u00f6nceki \u00c2d Kavmi\u2019ni O hel\u00e2k etti.","footnotes":""},{"id":"4835","sura":"53","aya":"51","arabic_text":"\u0648\u064e\u062b\u064e\u0645\u064f\u0648\u062f\u064e\u0627\u0652 \u0641\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u0628\u06e1\u0642\u064e\u0649\u0670","translation":"Sem\u00fbd'u da (O hel\u00e2k etti) ve geriye hi\u00e7bir \u015fey b\u0131rakmad\u0131.","footnotes":""},{"id":"4836","sura":"53","aya":"52","arabic_text":"\u0648\u064e\u0642\u064e\u0648\u06e1\u0645\u064e \u0646\u064f\u0648\u062d\u0656 \u0645\u0651\u0650\u0646 \u0642\u064e\u0628\u06e1\u0644\u064f\u06d6 \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u0647\u064f\u0645\u06e1 \u0623\u064e\u0638\u06e1\u0644\u064e\u0645\u064e \u0648\u064e\u0623\u064e\u0637\u06e1\u063a\u064e\u0649\u0670","translation":"Daha \u00f6nce de N\u00fbh\u2019un kavmini hel\u00e2k etmi\u015fti. \u015e\u00fcphesiz onlar daha zalim ve daha azg\u0131n kimselerdi.","footnotes":""},{"id":"4837","sura":"53","aya":"53","arabic_text":"\u0648\u064e\u0671\u0644\u06e1\u0645\u064f\u0624\u06e1\u062a\u064e\u0641\u0650\u0643\u064e\u0629\u064e \u0623\u064e\u0647\u06e1\u0648\u064e\u0649\u0670","translation":"O, (L\u00fbt kavminin) alt\u00fcst olan \u015fehirlerini de b\u00f6yle yapt\u0131","footnotes":""},{"id":"4838","sura":"53","aya":"54","arabic_text":"\u0641\u064e\u063a\u064e\u0634\u0651\u064e\u0649\u0670\u0647\u064e\u0627 \u0645\u064e\u0627 \u063a\u064e\u0634\u0651\u064e\u0649\u0670","translation":"Onlara b\u00fcr\u00fcyen (\u015fiddetli bir azap) b\u00fcr\u00fcd\u00fc.","footnotes":""},{"id":"4839","sura":"53","aya":"55","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u062a\u064e\u062a\u064e\u0645\u064e\u0627\u0631\u064e\u0649\u0670","translation":"O halde, Rabbinin hangi nimetinden \u015f\u00fcphe ediyorsun?","footnotes":""},{"id":"4840","sura":"53","aya":"56","arabic_text":"\u0647\u064e\u0670\u0630\u064e\u0627 \u0646\u064e\u0630\u0650\u064a\u0631\u065e \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u0646\u0651\u064f\u0630\u064f\u0631\u0650 \u0671\u0644\u06e1\u0623\u064f\u0648\u0644\u064e\u0649\u0670\u0653","translation":"\u0130\u015fte bu, \u00f6nceki uyar\u0131c\u0131lar gibi bir uyar\u0131c\u0131d\u0131r.","footnotes":""},{"id":"4841","sura":"53","aya":"57","arabic_text":"\u0623\u064e\u0632\u0650\u0641\u064e\u062a\u0650 \u0671\u0644\u06e1\u0623\u0653\u0632\u0650\u0641\u064e\u0629\u064f","translation":"Yakla\u015fmakta olan (k\u0131yamet iyice) yakla\u015ft\u0131.","footnotes":""},{"id":"4842","sura":"53","aya":"58","arabic_text":"\u0644\u064e\u064a\u06e1\u0633\u064e \u0644\u064e\u0647\u064e\u0627 \u0645\u0650\u0646 \u062f\u064f\u0648\u0646\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0643\u064e\u0627\u0634\u0650\u0641\u064e\u0629\u064c","translation":"Onu (vaktini) Allah\u2019tan ba\u015fka a\u00e7\u0131\u011fa \u00e7\u0131karacak yoktur.","footnotes":""},{"id":"4843","sura":"53","aya":"59","arabic_text":"\u0623\u064e\u0641\u064e\u0645\u0650\u0646\u06e1 \u0647\u064e\u0670\u0630\u064e\u0627 \u0671\u0644\u06e1\u062d\u064e\u062f\u0650\u064a\u062b\u0650 \u062a\u064e\u0639\u06e1\u062c\u064e\u0628\u064f\u0648\u0646\u064e","translation":"\u015eimdi siz bu s\u00f6ze mi \u015fa\u015f\u0131yorsunuz?","footnotes":""},{"id":"4844","sura":"53","aya":"60","arabic_text":"\u0648\u064e\u062a\u064e\u0636\u06e1\u062d\u064e\u0643\u064f\u0648\u0646\u064e \u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u0628\u06e1\u0643\u064f\u0648\u0646\u064e","translation":"G\u00fcl\u00fcyorsunuz da a\u011flam\u0131yorsunuz!","footnotes":""},{"id":"4845","sura":"53","aya":"61","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u0633\u064e\u0670\u0645\u0650\u062f\u064f\u0648\u0646\u064e","translation":"Ve siz gaflet i\u00e7inde oyalanmaktas\u0131n\u0131z.","footnotes":""},{"id":"4846","sura":"53","aya":"62","arabic_text":"\u0641\u064e\u0671\u0633\u06e1\u062c\u064f\u062f\u064f\u0648\u0627\u0652\u06e4 \u0644\u0650\u0644\u0651\u064e\u0647\u0650\u06e4 \u0648\u064e\u0671\u0639\u06e1\u0628\u064f\u062f\u064f\u0648\u0627\u0652\u06e9","translation":"Art\u0131k, (sadece) Allah\u2019a secde edin. O\u2019na ibadet edin.","footnotes":""}]}