":"32","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064e\u0627 \u062a\u064e\u0631\u06e1\u0645\u0650\u064a \u0628\u0650\u0634\u064e\u0631\u064e\u0631\u0656 \u0643\u064e\u0671\u0644\u06e1\u0642\u064e\u0635\u06e1\u0631\u0650","translation":"O, her biri saraylar gibi olan k\u0131v\u0131lc\u0131mlar sa\u00e7ar.","footnotes":""},{"id":"5655","sura":"77","aya":"33","arabic_text":"\u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u062c\u0650\u0645\u064e\u0670\u0644\u064e\u062a\u065e \u0635\u064f\u0641\u06e1\u0631\u065e","translation":"Her biri sar\u0131 develer gibidir.","footnotes":""},{"id":"5656","sura":"77","aya":"34","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"O g\u00fcn yalanlayanlar\u0131n vay haline!","footnotes":""},{"id":"5657","sura":"77","aya":"35","arabic_text":"\u0647\u064e\u0670\u0630\u064e\u0627 \u064a\u064e\u0648\u06e1\u0645\u064f \u0644\u064e\u0627 \u064a\u064e\u0646\u0637\u0650\u0642\u064f\u0648\u0646\u064e","translation":"Bu, onlar\u0131n konu\u015famayacaklar\u0131 bir g\u00fcnd\u00fcr.","footnotes":""},{"id":"5658","sura":"77","aya":"36","arabic_text":"\u0648\u064e\u0644\u064e\u0627 \u064a\u064f\u0624\u06e1\u0630\u064e\u0646\u064f \u0644\u064e\u0647\u064f\u0645\u06e1 \u0641\u064e\u064a\u064e\u0639\u06e1\u062a\u064e\u0630\u0650\u0631\u064f\u0648\u0646\u064e","translation":"Onlar\u0131n \u00f6z\u00fcr dilemelerine dahi izin verilmez.","footnotes":""},{"id":"5659","sura":"77","aya":"37","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"O g\u00fcn yalanlayanlar\u0131n vay haline!","footnotes":""},{"id":"5660","sura":"77","aya":"38","arabic_text":"\u0647\u064e\u0670\u0630\u064e\u0627 \u064a\u064e\u0648\u06e1\u0645\u064f \u0671\u0644\u06e1\u0641\u064e\u0635\u06e1\u0644\u0650\u06d6 \u062c\u064e\u0645\u064e\u0639\u06e1\u0646\u064e\u0670\u0643\u064f\u0645\u06e1 \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0648\u0651\u064e\u0644\u0650\u064a\u0646\u064e","translation":"Bu, ay\u0131rma (h\u00fck\u00fcm) g\u00fcn\u00fcd\u00fcr. Sizi ve evvelkileri bir araya toplar\u0131z.","footnotes":""},{"id":"5661","sura":"77","aya":"39","arabic_text":"\u0641\u064e\u0625\u0650\u0646 \u0643\u064e\u0627\u0646\u064e \u0644\u064e\u0643\u064f\u0645\u06e1 \u0643\u064e\u064a\u06e1\u062f\u065e \u0641\u064e\u0643\u0650\u064a\u062f\u064f\u0648\u0646\u0650","translation":"E\u011fer bir tuza\u011f\u0131n\u0131z varsa, haydi bana kar\u015f\u0131 tuzak kurun!","footnotes":""},{"id":"5662","sura":"77","aya":"40","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"O g\u00fcn, yalanlayanlar\u0131n vay haline!","footnotes":""},{"id":"5663","sura":"77","aya":"41","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u06e1\u0645\u064f\u062a\u0651\u064e\u0642\u0650\u064a\u0646\u064e \u0641\u0650\u064a \u0638\u0650\u0644\u064e\u0670\u0644\u0656 \u0648\u064e\u0639\u064f\u064a\u064f\u0648\u0646\u0656","translation":"\u015e\u00fcphesiz ki takva sahipleri, g\u00f6lgelerde p\u0131nar ba\u015flar\u0131ndad\u0131r.","footnotes":""},{"id":"5664","sura":"77","aya":"42","arabic_text":"\u0648\u064e\u0641\u064e\u0648\u064e\u0670\u0643\u0650\u0647\u064e \u0645\u0650\u0645\u0651\u064e\u0627 \u064a\u064e\u0634\u06e1\u062a\u064e\u0647\u064f\u0648\u0646\u064e","translation":"Ve canlar\u0131n\u0131n \u00e7ekip-arzu etti\u011fi meyveler (aras\u0131ndad\u0131rlar).","footnotes":""},{"id":"5665","sura":"77","aya":"43","arabic_text":"\u0643\u064f\u0644\u064f\u0648\u0627\u0652 \u0648\u064e\u0671\u0634\u06e1\u0631\u064e\u0628\u064f\u0648\u0627\u0652 \u0647\u064e\u0646\u0650\u064a\u0653\u0640\u0654\u064e\u06e2\u0627 \u0628\u0650\u0645\u064e\u0627 \u0643\u064f\u0646\u062a\u064f\u0645\u06e1 \u062a\u064e\u0639\u06e1\u0645\u064e\u0644\u064f\u0648\u0646\u064e","translation":"Yapt\u0131\u011f\u0131n\u0131z ameller sebebi ile afiyetle yiyin, i\u00e7in.","footnotes":""},{"id":"5666","sura":"77","aya":"44","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0627 \u0643\u064e\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0646\u064e\u062c\u06e1\u0632\u0650\u064a \u0671\u0644\u06e1\u0645\u064f\u062d\u06e1\u0633\u0650\u0646\u0650\u064a\u0646\u064e","translation":"Biz, iyilik yapanlar\u0131 i\u015fte b\u00f6yle \u00f6d\u00fcllendiririz.","footnotes":""},{"id":"5667","sura":"77","aya":"45","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"O g\u00fcn yalanlayanlar\u0131n vay haline!","footnotes":""},{"id":"5668","sura":"77","aya":"46","arabic_text":"\u0643\u064f\u0644\u064f\u0648\u0627\u0652 \u0648\u064e\u062a\u064e\u0645\u064e\u062a\u0651\u064e\u0639\u064f\u0648\u0627\u0652 \u0642\u064e\u0644\u0650\u064a\u0644\u064b\u0627 \u0625\u0650\u0646\u0651\u064e\u0643\u064f\u0645 \u0645\u0651\u064f\u062c\u06e1\u0631\u0650\u0645\u064f\u0648\u0646\u064e","translation":"Yiyin ve biraz yararlan\u0131n; muhakkak ki siz g\u00fcnahk\u00e2rlars\u0131n\u0131z.","footnotes":""},{"id":"5669","sura":"77","aya":"47","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"O g\u00fcn, yalanlayanlar\u0131n vay haline!","footnotes":""},{"id":"5670","sura":"77","aya":"48","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0642\u0650\u064a\u0644\u064e \u0644\u064e\u0647\u064f\u0645\u064f \u0671\u0631\u06e1\u0643\u064e\u0639\u064f\u0648\u0627\u0652 \u0644\u064e\u0627 \u064a\u064e\u0631\u06e1\u0643\u064e\u0639\u064f\u0648\u0646\u064e","translation":"Onlara; \u201cR\u00fck\u00fb edin!\u201d denildi\u011fi zaman r\u00fck\u00fb etmezlerdi.","footnotes":""},{"id":"5671","sura":"77","aya":"49","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"O g\u00fcn yalanlayanlar\u0131n vay haline!","footnotes":""},{"id":"5672","sura":"77","aya":"50","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u062d\u064e\u062f\u0650\u064a\u062b\u0650\u06ed \u0628\u064e\u0639\u06e1\u062f\u064e\u0647\u064f\u06e5 \u064a\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e","translation":"Onlar bundan (Kur'an'dan) sonra art\u0131k hangi s\u00f6ze iman edecekler?","footnotes":""}]}