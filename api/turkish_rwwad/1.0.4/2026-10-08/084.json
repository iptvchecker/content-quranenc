ir.","footnotes":""},{"id":"5908","sura":"84","aya":"24","arabic_text":"\u0641\u064e\u0628\u064e\u0634\u0651\u0650\u0631\u06e1\u0647\u064f\u0645 \u0628\u0650\u0639\u064e\u0630\u064e\u0627\u0628\u064d \u0623\u064e\u0644\u0650\u064a\u0645\u064d","translation":"\u00d6yleyse sen onlara elem dolu bir azab\u0131 m\u00fcjdele!","footnotes":""},{"id":"5909","sura":"84","aya":"25","arabic_text":"\u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u0652 \u0648\u064e\u0639\u064e\u0645\u0650\u0644\u064f\u0648\u0627\u0652 \u0671\u0644\u0635\u0651\u064e\u0670\u0644\u0650\u062d\u064e\u0670\u062a\u0650 \u0644\u064e\u0647\u064f\u0645\u06e1 \u0623\u064e\u062c\u06e1\u0631\u064c \u063a\u064e\u064a\u06e1\u0631\u064f \u0645\u064e\u0645\u06e1\u0646\u064f\u0648\u0646\u0650\u06ed","translation":"Ancak iman edip de salih ameller i\u015fleyenler ba\u015fka. Onlar i\u00e7in bitmez t\u00fckenmez bir m\u00fck\u00e2fat vard\u0131r.","footnotes":""}]}