29\u064e \u0647\u0650\u064a\u064e \u0671\u0644\u06e1\u0645\u064e\u0623\u06e1\u0648\u064e\u0649\u0670","translation":"(O kimse i\u00e7in) Hi\u00e7 \u015f\u00fcphesiz Cennet yeg\u00e2ne bar\u0131nakt\u0131r.","footnotes":""},{"id":"5754","sura":"79","aya":"42","arabic_text":"\u064a\u064e\u0633\u06e1\u0640\u0654\u064e\u0644\u064f\u0648\u0646\u064e\u0643\u064e \u0639\u064e\u0646\u0650 \u0671\u0644\u0633\u0651\u064e\u0627\u0639\u064e\u0629\u0650 \u0623\u064e\u064a\u0651\u064e\u0627\u0646\u064e \u0645\u064f\u0631\u06e1\u0633\u064e\u0649\u0670\u0647\u064e\u0627","translation":"Sana k\u0131yametten soruyorlar: \"Gelip \u00e7atmas\u0131 ne zaman?\" diye.","footnotes":""},{"id":"5755","sura":"79","aya":"43","arabic_text":"\u0641\u0650\u064a\u0645\u064e \u0623\u064e\u0646\u062a\u064e \u0645\u0650\u0646 \u0630\u0650\u0643\u06e1\u0631\u064e\u0649\u0670\u0647\u064e\u0627\u0653","translation":"Sen onu nereden bileceksin?","footnotes":""},{"id":"5756","sura":"79","aya":"44","arabic_text":"\u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0645\u064f\u0646\u062a\u064e\u0647\u064e\u0649\u0670\u0647\u064e\u0627\u0653","translation":"Rabbine aittir onunla ilgili son bilgi.","footnotes":""},{"id":"5757","sura":"79","aya":"45","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u0646\u062a\u064e \u0645\u064f\u0646\u0630\u0650\u0631\u064f \u0645\u064e\u0646 \u064a\u064e\u062e\u06e1\u0634\u064e\u0649\u0670\u0647\u064e\u0627","translation":"Sen ancak, ondan korkan kimseler i\u00e7in bir uyar\u0131c\u0131s\u0131n.","footnotes":""},{"id":"5758","sura":"79","aya":"46","arabic_text":"\u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064e\u0631\u064e\u0648\u06e1\u0646\u064e\u0647\u064e\u0627 \u0644\u064e\u0645\u06e1 \u064a\u064e\u0644\u06e1\u0628\u064e\u062b\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u0644\u0651\u064e\u0627 \u0639\u064e\u0634\u0650\u064a\u0651\u064e\u0629\u064b \u0623\u064e\u0648\u06e1 \u0636\u064f\u062d\u064e\u0649\u0670\u0647\u064e\u0627","translation":"Onlar onu g\u00f6rd\u00fckleri g\u00fcn sanki (d\u00fcnyada) bir ak\u015fam veya ku\u015fluk vakti kadar kald\u0131klar\u0131n\u0131 san\u0131rlar.","footnotes":""}]}