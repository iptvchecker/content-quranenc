},{"id":"5404","sura":"70","aya":"29","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0647\u064f\u0645\u06e1 \u0644\u0650\u0641\u064f\u0631\u064f\u0648\u062c\u0650\u0647\u0650\u0645\u06e1 \u062d\u064e\u0670\u0641\u0650\u0638\u064f\u0648\u0646\u064e","translation":"Onlar, mahrem yerlerini\/\u0131rzlar\u0131n\u0131 koruyan kimselerdir.","footnotes":""},{"id":"5405","sura":"70","aya":"30","arabic_text":"\u0625\u0650\u0644\u0651\u064e\u0627 \u0639\u064e\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0632\u06e1\u0648\u064e\u0670\u062c\u0650\u0647\u0650\u0645\u06e1 \u0623\u064e\u0648\u06e1 \u0645\u064e\u0627 \u0645\u064e\u0644\u064e\u0643\u064e\u062a\u06e1 \u0623\u064e\u064a\u06e1\u0645\u064e\u0670\u0646\u064f\u0647\u064f\u0645\u06e1 \u0641\u064e\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u063a\u064e\u064a\u06e1\u0631\u064f \u0645\u064e\u0644\u064f\u0648\u0645\u0650\u064a\u0646\u064e","translation":"Ancak e\u015flerine ve sahip olduklar\u0131 cariyelerine kar\u015f\u0131 m\u00fcstesna. \u00c7\u00fcnk\u00fc onlar (bundan dolay\u0131) k\u0131nanmazlar.","footnotes":""},{"id":"5406","sura":"70","aya":"31","arabic_text":"\u0641\u064e\u0645\u064e\u0646\u0650 \u0671\u0628\u06e1\u062a\u064e\u063a\u064e\u0649\u0670 \u0648\u064e\u0631\u064e\u0627\u0653\u0621\u064e \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0641\u064e\u0623\u064f\u0648\u0652\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e \u0647\u064f\u0645\u064f \u0671\u0644\u06e1\u0639\u064e\u0627\u062f\u064f\u0648\u0646\u064e","translation":"Bundan \u00f6tesini arayanlar, i\u015fte onlar haddi a\u015fm\u0131\u015f olanlard\u0131r.","footnotes":""},{"id":"5407","sura":"70","aya":"32","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0647\u064f\u0645\u06e1 \u0644\u0650\u0623\u064e\u0645\u064e\u0670\u0646\u064e\u0670\u062a\u0650\u0647\u0650\u0645\u06e1 \u0648\u064e\u0639\u064e\u0647\u06e1\u062f\u0650\u0647\u0650\u0645\u06e1 \u0631\u064e\u0670\u0639\u064f\u0648\u0646\u064e","translation":"Onlar, emanetlerine ve verdikleri s\u00f6zlere riayet ederler.","footnotes":""},{"id":"5408","sura":"70","aya":"33","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0647\u064f\u0645 \u0628\u0650\u0634\u064e\u0647\u064e\u0670\u062f\u064e\u0670\u062a\u0650\u0647\u0650\u0645\u06e1 \u0642\u064e\u0627\u0653\u0626\u0650\u0645\u064f\u0648\u0646\u064e","translation":"Onlar, \u015fahitliklerini (gerekti\u011fi gibi) yerine getirirler.","footnotes":""},{"id":"5409","sura":"70","aya":"34","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0647\u064f\u0645\u06e1 \u0639\u064e\u0644\u064e\u0649\u0670 \u0635\u064e\u0644\u064e\u0627\u062a\u0650\u0647\u0650\u0645\u06e1 \u064a\u064f\u062d\u064e\u0627\u0641\u0650\u0638\u064f\u0648\u0646\u064e","translation":"Onlar namazlar\u0131n\u0131 aksatmadan gere\u011fi gibi k\u0131larlar.","footnotes":""},{"id":"5410","sura":"70","aya":"35","arabic_text":"\u0623\u064f\u0648\u0652\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e \u0641\u0650\u064a \u062c\u064e\u0646\u0651\u064e\u0670\u062a\u0656 \u0645\u0651\u064f\u0643\u06e1\u0631\u064e\u0645\u064f\u0648\u0646\u064e","translation":"\u0130\u015fte onlar, Cennetler'de a\u011f\u0131rlanacaklard\u0131r.","footnotes":""},{"id":"5411","sura":"70","aya":"36","arabic_text":"\u0641\u064e\u0645\u064e\u0627\u0644\u0650 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u0652 \u0642\u0650\u0628\u064e\u0644\u064e\u0643\u064e \u0645\u064f\u0647\u06e1\u0637\u0650\u0639\u0650\u064a\u0646\u064e","translation":"O k\u00e2firlere ne oluyor ki, sana do\u011fru ko\u015fuyorlar?","footnotes":""},{"id":"5412","sura":"70","aya":"37","arabic_text":"\u0639\u064e\u0646\u0650 \u0671\u0644\u06e1\u064a\u064e\u0645\u0650\u064a\u0646\u0650 \u0648\u064e\u0639\u064e\u0646\u0650 \u0671\u0644\u0634\u0651\u0650\u0645\u064e\u0627\u0644\u0650 \u0639\u0650\u0632\u0650\u064a\u0646\u064e","translation":"Sa\u011fdan soldan, b\u00f6l\u00fck b\u00f6l\u00fck.","footnotes":""},{"id":"5413","sura":"70","aya":"38","arabic_text":"\u0623\u064e\u064a\u064e\u0637\u06e1\u0645\u064e\u0639\u064f \u0643\u064f\u0644\u0651\u064f \u0671\u0645\u06e1\u0631\u0650\u064a\u0655\u0656 \u0645\u0651\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0623\u064e\u0646 \u064a\u064f\u062f\u06e1\u062e\u064e\u0644\u064e \u062c\u064e\u0646\u0651\u064e\u0629\u064e \u0646\u064e\u0639\u0650\u064a\u0645\u0656","translation":"Yoksa onlar\u0131n her biri N\u00e2im Cennet'ine konulaca\u011f\u0131n\u0131 m\u0131 umuyor?","footnotes":""},{"id":"5414","sura":"70","aya":"39","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653\u06d6 \u0625\u0650\u0646\u0651\u064e\u0627 \u062e\u064e\u0644\u064e\u0642\u06e1\u0646\u064e\u0670\u0647\u064f\u0645 \u0645\u0651\u0650\u0645\u0651\u064e\u0627 \u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e","translation":"Asla! Biz onlar\u0131 bildikleri o \u015feyden yaratt\u0131k.","footnotes":""},{"id":"5415","sura":"70","aya":"40","arabic_text":"\u0641\u064e\u0644\u064e\u0627\u0653 \u0623\u064f\u0642\u06e1\u0633\u0650\u0645\u064f \u0628\u0650\u0631\u064e\u0628\u0651\u0650 \u0671\u0644\u06e1\u0645\u064e\u0634\u064e\u0670\u0631\u0650\u0642\u0650 \u0648\u064e\u0671\u0644\u06e1\u0645\u064e\u063a\u064e\u0670\u0631\u0650\u0628\u0650 \u0625\u0650\u0646\u0651\u064e\u0627 \u0644\u064e\u0642\u064e\u0670\u062f\u0650\u0631\u064f\u0648\u0646\u064e","translation":"Hay\u0131r, do\u011fular\u0131n ve bat\u0131lar\u0131n Rabbine yemin ederim ki mutlaka biz g\u00fc\u00e7 yetirenleriz.","footnotes":""},{"id":"5416","sura":"70","aya":"41","arabic_text":"\u0639\u064e\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0646 \u0646\u0651\u064f\u0628\u064e\u062f\u0651\u0650\u0644\u064e \u062e\u064e\u064a\u06e1\u0631\u0657\u0627 \u0645\u0651\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0648\u064e\u0645\u064e\u0627 \u0646\u064e\u062d\u06e1\u0646\u064f \u0628\u0650\u0645\u064e\u0633\u06e1\u0628\u064f\u0648\u0642\u0650\u064a\u0646\u064e","translation":"Onlar\u0131n yerlerine kendilerinden daha hay\u0131rl\u0131lar\u0131n\u0131 getirmeye. Ve bizim \u00f6n\u00fcm\u00fcze ge\u00e7ilemez.","footnotes":""},{"id":"5417","sura":"70","aya":"42","arabic_text":"\u0641\u064e\u0630\u064e\u0631\u06e1\u0647\u064f\u0645\u06e1 \u064a\u064e\u062e\u064f\u0648\u0636\u064f\u0648\u0627\u0652 \u0648\u064e\u064a\u064e\u0644\u06e1\u0639\u064e\u0628\u064f\u0648\u0627\u0652 \u062d\u064e\u062a\u0651\u064e\u0649\u0670 \u064a\u064f\u0644\u064e\u0670\u0642\u064f\u0648\u0627\u0652 \u064a\u064e\u0648\u06e1\u0645\u064e\u0647\u064f\u0645\u064f \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u064a\u064f\u0648\u0639\u064e\u062f\u064f\u0648\u0646\u064e","translation":"B\u0131rak onlar\u0131; kendilerine s\u00f6z verilen g\u00fcn gelinceye kadar dal\u0131p oynas\u0131nlar!","footnotes":""},{"id":"5418","sura":"70","aya":"43","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064e\u062e\u06e1\u0631\u064f\u062c\u064f\u0648\u0646\u064e \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0623\u064e\u062c\u06e1\u062f\u064e\u0627\u062b\u0650 \u0633\u0650\u0631\u064e\u0627\u0639\u0657\u0627 \u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u0625\u0650\u0644\u064e\u0649\u0670 \u0646\u064f\u0635\u064f\u0628\u0656 \u064a\u064f\u0648\u0641\u0650\u0636\u064f\u0648\u0646\u064e","translation":"O g\u00fcn onlar sanki dikilmi\u015f putlara s\u00fcratle gidiyorlarm\u0131\u015f gibi kabirlerinden h\u0131zl\u0131ca \u00e7\u0131karlar.","footnotes":""},{"id":"5419","sura":"70","aya":"44","arabic_text":"\u062e\u064e\u0670\u0634\u0650\u0639\u064e\u0629\u064b \u0623\u064e\u0628\u06e1\u0635\u064e\u0670\u0631\u064f\u0647\u064f\u0645\u06e1 \u062a\u064e\u0631\u06e1\u0647\u064e\u0642\u064f\u0647\u064f\u0645\u06e1 \u0630\u0650\u0644\u0651\u064e\u0629\u065e\u06da \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0671\u0644\u06e1\u064a\u064e\u0648\u06e1\u0645\u064f \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u064a\u064f\u0648\u0639\u064e\u062f\u064f\u0648\u0646\u064e","translation":"G\u00f6zleri yere y\u0131k\u0131lm\u0131\u015f, (y\u00fczlerini) zillet b\u00fcr\u00fcm\u00fc\u015ft\u00fcr. \u0130\u015fte bu, onlara s\u00f6z verilen g\u00fcnd\u00fcr!","footnotes":""}]}