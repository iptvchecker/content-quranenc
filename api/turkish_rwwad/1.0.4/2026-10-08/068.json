36\u064e\u0627\u0653\u0644\u0651\u064f\u0648\u0646\u064e","translation":"Fakat bah\u00e7eyi o halde g\u00f6rd\u00fcklerinde; \u201cBiz mutlaka yolumuzu \u015fa\u015f\u0131rm\u0131\u015f olmal\u0131y\u0131z!\u201d dediler.","footnotes":""},{"id":"5298","sura":"68","aya":"27","arabic_text":"\u0628\u064e\u0644\u06e1 \u0646\u064e\u062d\u06e1\u0646\u064f \u0645\u064e\u062d\u06e1\u0631\u064f\u0648\u0645\u064f\u0648\u0646\u064e","translation":"Bil\u00e2kis biz, mahrum b\u0131rak\u0131ld\u0131k.","footnotes":""},{"id":"5299","sura":"68","aya":"28","arabic_text":"\u0642\u064e\u0627\u0644\u064e \u0623\u064e\u0648\u06e1\u0633\u064e\u0637\u064f\u0647\u064f\u0645\u06e1 \u0623\u064e\u0644\u064e\u0645\u06e1 \u0623\u064e\u0642\u064f\u0644 \u0644\u0651\u064e\u0643\u064f\u0645\u06e1 \u0644\u064e\u0648\u06e1\u0644\u064e\u0627 \u062a\u064f\u0633\u064e\u0628\u0651\u0650\u062d\u064f\u0648\u0646\u064e","translation":"Onlar\u0131n en mu'tedil\/insafl\u0131 olan\u0131: \"Ben size, ke\u015fke Allah\u2019\u0131 tesbih etseydiniz dememi\u015f miydim?\" dedi.","footnotes":""},{"id":"5300","sura":"68","aya":"29","arabic_text":"\u0642\u064e\u0627\u0644\u064f\u0648\u0627\u0652 \u0633\u064f\u0628\u06e1\u062d\u064e\u0670\u0646\u064e \u0631\u064e\u0628\u0651\u0650\u0646\u064e\u0627\u0653 \u0625\u0650\u0646\u0651\u064e\u0627 \u0643\u064f\u0646\u0651\u064e\u0627 \u0638\u064e\u0670\u0644\u0650\u0645\u0650\u064a\u0646\u064e","translation":"Onlar; \u201cRabbimizi tesbih ederiz. \u015e\u00fcphesiz biz, zalim kimseler imi\u015fiz.\u201d dediler.","footnotes":""},{"id":"5301","sura":"68","aya":"30","arabic_text":"\u0641\u064e\u0623\u064e\u0642\u06e1\u0628\u064e\u0644\u064e \u0628\u064e\u0639\u06e1\u0636\u064f\u0647\u064f\u0645\u06e1 \u0639\u064e\u0644\u064e\u0649\u0670 \u0628\u064e\u0639\u06e1\u0636\u0656 \u064a\u064e\u062a\u064e\u0644\u064e\u0670\u0648\u064e\u0645\u064f\u0648\u0646\u064e","translation":"Kar\u015f\u0131l\u0131kl\u0131 olarak birbirlerini k\u0131namaya ba\u015flad\u0131lar.","footnotes":""},{"id":"5302","sura":"68","aya":"31","arabic_text":"\u0642\u064e\u0627\u0644\u064f\u0648\u0627\u0652 \u064a\u064e\u0670\u0648\u064e\u064a\u06e1\u0644\u064e\u0646\u064e\u0627\u0653 \u0625\u0650\u0646\u0651\u064e\u0627 \u0643\u064f\u0646\u0651\u064e\u0627 \u0637\u064e\u0670\u063a\u0650\u064a\u0646\u064e","translation":"\u015e\u00f6yle dediler: \u201cYaz\u0131klar olsun bize! Ger\u00e7ekten biz azg\u0131n ki\u015filermi\u015fiz!\u201d","footnotes":""},{"id":"5303","sura":"68","aya":"32","arabic_text":"\u0639\u064e\u0633\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u064f\u0646\u064e\u0627\u0653 \u0623\u064e\u0646 \u064a\u064f\u0628\u06e1\u062f\u0650\u0644\u064e\u0646\u064e\u0627 \u062e\u064e\u064a\u06e1\u0631\u0657\u0627 \u0645\u0651\u0650\u0646\u06e1\u0647\u064e\u0627\u0653 \u0625\u0650\u0646\u0651\u064e\u0627\u0653 \u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0646\u064e\u0627 \u0631\u064e\u0670\u063a\u0650\u0628\u064f\u0648\u0646\u064e","translation":"\u201cUmulur ki, Rabbimiz bize bunun yerine daha iyisini verir. \u00c7\u00fcnk\u00fc biz art\u0131k Rabbimizi arzulayanlar\u0131z.\u201d","footnotes":""},{"id":"5304","sura":"68","aya":"33","arabic_text":"\u0643\u064e\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0671\u0644\u06e1\u0639\u064e\u0630\u064e\u0627\u0628\u064f\u06d6 \u0648\u064e\u0644\u064e\u0639\u064e\u0630\u064e\u0627\u0628\u064f \u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u064e\u0629\u0650 \u0623\u064e\u0643\u06e1\u0628\u064e\u0631\u064f\u06da \u0644\u064e\u0648\u06e1 \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e","translation":"\u0130\u015fte azap b\u00f6yledir. Ahiret azab\u0131 ise elbette daha b\u00fcy\u00fckt\u00fcr. Ke\u015fke bilselerdi.","footnotes":""},{"id":"5305","sura":"68","aya":"34","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0644\u0650\u0644\u06e1\u0645\u064f\u062a\u0651\u064e\u0642\u0650\u064a\u0646\u064e \u0639\u0650\u0646\u062f\u064e \u0631\u064e\u0628\u0651\u0650\u0647\u0650\u0645\u06e1 \u062c\u064e\u0646\u0651\u064e\u0670\u062a\u0650 \u0671\u0644\u0646\u0651\u064e\u0639\u0650\u064a\u0645\u0650","translation":"\u015e\u00fcphesiz Allah\u2019a kar\u015f\u0131 gelmekten sak\u0131nanlar i\u00e7in Rableri kat\u0131nda Na\u00eem Cennetleri vard\u0131r.","footnotes":""},{"id":"5306","sura":"68","aya":"35","arabic_text":"\u0623\u064e\u0641\u064e\u0646\u064e\u062c\u06e1\u0639\u064e\u0644\u064f \u0671\u0644\u06e1\u0645\u064f\u0633\u06e1\u0644\u0650\u0645\u0650\u064a\u0646\u064e \u0643\u064e\u0671\u0644\u06e1\u0645\u064f\u062c\u06e1\u0631\u0650\u0645\u0650\u064a\u0646\u064e","translation":"Biz hi\u00e7, M\u00fcsl\u00fcmanlarla su\u00e7lular\u0131 bir tutar m\u0131y\u0131z?","footnotes":""},{"id":"5307","sura":"68","aya":"36","arabic_text":"\u0645\u064e\u0627 \u0644\u064e\u0643\u064f\u0645\u06e1 \u0643\u064e\u064a\u06e1\u0641\u064e \u062a\u064e\u062d\u06e1\u0643\u064f\u0645\u064f\u0648\u0646\u064e","translation":"Ne oluyor size? Nas\u0131l h\u00fck\u00fcm veriyorsunuz?","footnotes":""},{"id":"5308","sura":"68","aya":"37","arabic_text":"\u0623\u064e\u0645\u06e1 \u0644\u064e\u0643\u064f\u0645\u06e1 \u0643\u0650\u062a\u064e\u0670\u0628\u065e \u0641\u0650\u064a\u0647\u0650 \u062a\u064e\u062f\u06e1\u0631\u064f\u0633\u064f\u0648\u0646\u064e","translation":"Yoksa sizin bir kitab\u0131n\u0131z var da ondan m\u0131 okuyorsunuz?","footnotes":""},{"id":"5309","sura":"68","aya":"38","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0644\u064e\u0643\u064f\u0645\u06e1 \u0641\u0650\u064a\u0647\u0650 \u0644\u064e\u0645\u064e\u0627 \u062a\u064e\u062e\u064e\u064a\u0651\u064e\u0631\u064f\u0648\u0646\u064e","translation":"Onda, \u201cBe\u011fendi\u011finiz her \u015fey sizindir\u201d (diye mi yaz\u0131l\u0131?)","footnotes":""},{"id":"5310","sura":"68","aya":"39","arabic_text":"\u0623\u064e\u0645\u06e1 \u0644\u064e\u0643\u064f\u0645\u06e1 \u0623\u064e\u064a\u06e1\u0645\u064e\u0670\u0646\u064c \u0639\u064e\u0644\u064e\u064a\u06e1\u0646\u064e\u0627 \u0628\u064e\u0670\u0644\u0650\u063a\u064e\u0629\u064c \u0625\u0650\u0644\u064e\u0649\u0670 \u064a\u064e\u0648\u06e1\u0645\u0650 \u0671\u0644\u06e1\u0642\u0650\u064a\u064e\u0670\u0645\u064e\u0629\u0650 \u0625\u0650\u0646\u0651\u064e \u0644\u064e\u0643\u064f\u0645\u06e1 \u0644\u064e\u0645\u064e\u0627 \u062a\u064e\u062d\u06e1\u0643\u064f\u0645\u064f\u0648\u0646\u064e","translation":"Yoksa; \u201cNeye h\u00fckmederseniz o yerine getirilir.\u201d diye k\u0131yamete kadar ge\u00e7erli olacak, size verilmi\u015f yeminler\/s\u00f6zler mi var?","footnotes":""},{"id":"5311","sura":"68","aya":"40","arabic_text":"\u0633\u064e\u0644\u06e1\u0647\u064f\u0645\u06e1 \u0623\u064e\u064a\u0651\u064f\u0647\u064f\u0645 \u0628\u0650\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0632\u064e\u0639\u0650\u064a\u0645\u064c","translation":"Sor onlara; hangileri bunun savunuculu\u011funu yapacak?","footnotes":""},{"id":"5312","sura":"68","aya":"41","arabic_text":"\u0623\u064e\u0645\u06e1 \u0644\u064e\u0647\u064f\u0645\u06e1 \u0634\u064f\u0631\u064e\u0643\u064e\u0627\u0653\u0621\u064f \u0641\u064e\u0644\u06e1\u064a\u064e\u0623\u06e1\u062a\u064f\u0648\u0627\u0652 \u0628\u0650\u0634\u064f\u0631\u064e\u0643\u064e\u0627\u0653\u0626\u0650\u0647\u0650\u0645\u06e1 \u0625\u0650\u0646 \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u0635\u064e\u0670\u062f\u0650\u0642\u0650\u064a\u0646\u064e","translation":"Yoksa onlar\u0131n ortaklar\u0131 m\u0131 var? E\u011fer do\u011fru s\u00f6yleyenler iseler o halde ortaklar\u0131n\u0131 getirsinler.","footnotes":""},{"id":"5313","sura":"68","aya":"42","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064f\u0643\u06e1\u0634\u064e\u0641\u064f \u0639\u064e\u0646 \u0633\u064e\u0627\u0642\u0656 \u0648\u064e\u064a\u064f\u062f\u06e1\u0639\u064e\u0648\u06e1\u0646\u064e \u0625\u0650\u0644\u064e\u0649 \u0671\u0644\u0633\u0651\u064f\u062c\u064f\u0648\u062f\u0650 \u0641\u064e\u0644\u064e\u0627 \u064a\u064e\u0633\u06e1\u062a\u064e\u0637\u0650\u064a\u0639\u064f\u0648\u0646\u064e","translation":"Bald\u0131r\u0131n a\u00e7\u0131laca\u011f\u0131 o g\u00fcnde onlar secde etmeye davet edilecekler. Fakat buna g\u00fc\u00e7 yetiremezler.","footnotes":""},{"id":"5314","sura":"68","aya":"43","arabic_text":"\u062e\u064e\u0670\u0634\u0650\u0639\u064e\u0629\u064b \u0623\u064e\u0628\u06e1\u0635\u064e\u0670\u0631\u064f\u0647\u064f\u0645\u06e1 \u062a\u064e\u0631\u06e1\u0647\u064e\u0642\u064f\u0647\u064f\u0645\u06e1 \u0630\u0650\u0644\u0651\u064e\u0629\u065e\u06d6 \u0648\u064e\u0642\u064e\u062f\u06e1 \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u064a\u064f\u062f\u06e1\u0639\u064e\u0648\u06e1\u0646\u064e \u0625\u0650\u0644\u064e\u0649 \u0671\u0644\u0633\u0651\u064f\u062c\u064f\u0648\u062f\u0650 \u0648\u064e\u0647\u064f\u0645\u06e1 \u0633\u064e\u0670\u0644\u0650\u0645\u064f\u0648\u0646\u064e","translation":"G\u00f6zleri korku i\u00e7inde, y\u00fczlerini zillet b\u00fcr\u00fcm\u00fc\u015ft\u00fcr. Oysa onlar, sa\u011f salim iken secde etmeye \u00e7a\u011fr\u0131lm\u0131\u015flard\u0131.","footnotes":""},{"id":"5315","sura":"68","aya":"44","arabic_text":"\u0641\u064e\u0630\u064e\u0631\u06e1\u0646\u0650\u064a \u0648\u064e\u0645\u064e\u0646 \u064a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f \u0628\u0650\u0647\u064e\u0670\u0630\u064e\u0627 \u0671\u0644\u06e1\u062d\u064e\u062f\u0650\u064a\u062b\u0650\u06d6 \u0633\u064e\u0646\u064e\u0633\u06e1\u062a\u064e\u062f\u06e1\u0631\u0650\u062c\u064f\u0647\u064f\u0645 \u0645\u0651\u0650\u0646\u06e1 \u062d\u064e\u064a\u06e1\u062b\u064f \u0644\u064e\u0627 \u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e","translation":"Art\u0131k beni ve bu s\u00f6z\u00fc yalanlayanlar\u0131 ba\u015f ba\u015fa b\u0131rak. Biz onlar\u0131 bilmeyecekleri bir yerden derece derece azaba yakla\u015ft\u0131raca\u011f\u0131z.","footnotes":""},{"id":"5316","sura":"68","aya":"45","arabic_text":"\u0648\u064e\u0623\u064f\u0645\u06e1\u0644\u0650\u064a \u0644\u064e\u0647\u064f\u0645\u06e1\u06da \u0625\u0650\u0646\u0651\u064e \u0643\u064e\u064a\u06e1\u062f\u0650\u064a \u0645\u064e\u062a\u0650\u064a\u0646\u064c","translation":"Onlara m\u00fchlet veriyorum. \u00c7\u00fcnk\u00fc benim tuza\u011f\u0131m \u00e7ok sa\u011flamd\u0131r.","footnotes":""},{"id":"5317","sura":"68","aya":"46","arabic_text":"\u0623\u064e\u0645\u06e1 \u062a\u064e\u0633\u06e1\u0640\u0654\u064e\u0644\u064f\u0647\u064f\u0645\u06e1 \u0623\u064e\u062c\u06e1\u0631\u0657\u0627 \u0641\u064e\u0647\u064f\u0645 \u0645\u0651\u0650\u0646 \u0645\u0651\u064e\u063a\u06e1\u0631\u064e\u0645\u0656 \u0645\u0651\u064f\u062b\u06e1\u0642\u064e\u0644\u064f\u0648\u0646\u064e","translation":"Yoksa sen onlardan bir \u00fccret istiyorsun da onlar bu y\u00fczden a\u011f\u0131r bir bor\u00e7 y\u00fck\u00fc alt\u0131na m\u0131 girmi\u015flerdir?","footnotes":""},{"id":"5318","sura":"68","aya":"47","arabic_text":"\u0623\u064e\u0645\u06e1 \u0639\u0650\u0646\u062f\u064e\u0647\u064f\u0645\u064f \u0671\u0644\u06e1\u063a\u064e\u064a\u06e1\u0628\u064f \u0641\u064e\u0647\u064f\u0645\u06e1 \u064a\u064e\u0643\u06e1\u062a\u064f\u0628\u064f\u0648\u0646\u064e","translation":"Yoksa gayb onlar\u0131n yan\u0131ndad\u0131r da onlar m\u0131 yaz\u0131yorlar?","footnotes":""},{"id":"5319","sura":"68","aya":"48","arabic_text":"\u0641\u064e\u0671\u0635\u06e1\u0628\u0650\u0631\u06e1 \u0644\u0650\u062d\u064f\u0643\u06e1\u0645\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u0643\u064f\u0646 \u0643\u064e\u0635\u064e\u0627\u062d\u0650\u0628\u0650 \u0671\u0644\u06e1\u062d\u064f\u0648\u062a\u0650 \u0625\u0650\u0630\u06e1 \u0646\u064e\u0627\u062f\u064e\u0649\u0670 \u0648\u064e\u0647\u064f\u0648\u064e \u0645\u064e\u0643\u06e1\u0638\u064f\u0648\u0645\u065e","translation":"Rabbinin h\u00fckm\u00fcn\u00fc sab\u0131rla bekle! Bal\u0131k sahibi\/Yunus gibi olma! Hani o, dertli bir sesle Rabbine seslenmi\u015fti.","footnotes":""},{"id":"5320","sura":"68","aya":"49","arabic_text":"\u0644\u0651\u064e\u0648\u06e1\u0644\u064e\u0627\u0653 \u0623\u064e\u0646 \u062a\u064e\u062f\u064e\u0670\u0631\u064e\u0643\u064e\u0647\u064f\u06e5 \u0646\u0650\u0639\u06e1\u0645\u064e\u0629\u065e \u0645\u0651\u0650\u0646 \u0631\u0651\u064e\u0628\u0651\u0650\u0647\u0650\u06e6 \u0644\u064e\u0646\u064f\u0628\u0650\u0630\u064e \u0628\u0650\u0671\u0644\u06e1\u0639\u064e\u0631\u064e\u0627\u0653\u0621\u0650 \u0648\u064e\u0647\u064f\u0648\u064e \u0645\u064e\u0630\u06e1\u0645\u064f\u0648\u0645\u065e","translation":"\u015eayet Rabbinden ona bir nimet yeti\u015fmemi\u015f olsayd\u0131, o mutlaka k\u0131nanm\u0131\u015f bir h\u00e2lde \u0131ss\u0131z bir yere at\u0131lacakt\u0131.","footnotes":""},{"id":"5321","sura":"68","aya":"50","arabic_text":"\u0641\u064e\u0671\u062c\u06e1\u062a\u064e\u0628\u064e\u0670\u0647\u064f \u0631\u064e\u0628\u0651\u064f\u0647\u064f\u06e5 \u0641\u064e\u062c\u064e\u0639\u064e\u0644\u064e\u0647\u064f\u06e5 \u0645\u0650\u0646\u064e \u0671\u0644\u0635\u0651\u064e\u0670\u0644\u0650\u062d\u0650\u064a\u0646\u064e","translation":"Ancak Rabbi onu se\u00e7ti ve onu salihlerden k\u0131ld\u0131.","footnotes":""},{"id":"5322","sura":"68","aya":"51","arabic_text":"\u0648\u064e\u0625\u0650\u0646 \u064a\u064e\u0643\u064e\u0627\u062f\u064f \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u0652 \u0644\u064e\u064a\u064f\u0632\u06e1\u0644\u0650\u0642\u064f\u0648\u0646\u064e\u0643\u064e \u0628\u0650\u0623\u064e\u0628\u06e1\u0635\u064e\u0670\u0631\u0650\u0647\u0650\u0645\u06e1 \u0644\u064e\u0645\u0651\u064e\u0627 \u0633\u064e\u0645\u0650\u0639\u064f\u0648\u0627\u0652 \u0671\u0644\u0630\u0651\u0650\u0643\u06e1\u0631\u064e \u0648\u064e\u064a\u064e\u0642\u064f\u0648\u0644\u064f\u0648\u0646\u064e \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u0645\u064e\u062c\u06e1\u0646\u064f\u0648\u0646\u065e","translation":"K\u00e2firler, o zikri i\u015fittikleri vakit neredeyse seni g\u00f6zleriyle devireceklerdi. \u201cO, kesinlikle bir delidir.\u201d diyorlard\u0131.","footnotes":""},{"id":"5323","sura":"68","aya":"52","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0647\u064f\u0648\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0630\u0650\u0643\u06e1\u0631\u065e \u0644\u0651\u0650\u0644\u06e1\u0639\u064e\u0670\u0644\u064e\u0645\u0650\u064a\u0646\u064e","translation":"Oysa o (Kur'an) ancak alemler i\u00e7in bir \u00f6\u011f\u00fctt\u00fcr.","footnotes":""}]}