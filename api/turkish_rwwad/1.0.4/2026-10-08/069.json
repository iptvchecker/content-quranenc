aca\u011f\u0131m\u0131 biliyordum.\" der.","footnotes":""},{"id":"5344","sura":"69","aya":"21","arabic_text":"\u0641\u064e\u0647\u064f\u0648\u064e \u0641\u0650\u064a \u0639\u0650\u064a\u0634\u064e\u0629\u0656 \u0631\u0651\u064e\u0627\u0636\u0650\u064a\u064e\u0629\u0656","translation":"Art\u0131k o ho\u015fnut oldu\u011fu bir ya\u015fay\u0131\u015ftad\u0131r.","footnotes":""},{"id":"5345","sura":"69","aya":"22","arabic_text":"\u0641\u0650\u064a \u062c\u064e\u0646\u0651\u064e\u0629\u064d \u0639\u064e\u0627\u0644\u0650\u064a\u064e\u0629\u0656","translation":"Y\u00fcksek bir Cennet'tedir.","footnotes":""},{"id":"5346","sura":"69","aya":"23","arabic_text":"\u0642\u064f\u0637\u064f\u0648\u0641\u064f\u0647\u064e\u0627 \u062f\u064e\u0627\u0646\u0650\u064a\u064e\u0629\u065e","translation":"Meyveleri \u00e7ok yak\u0131nd\u0131r.","footnotes":""},{"id":"5347","sura":"69","aya":"24","arabic_text":"\u0643\u064f\u0644\u064f\u0648\u0627\u0652 \u0648\u064e\u0671\u0634\u06e1\u0631\u064e\u0628\u064f\u0648\u0627\u0652 \u0647\u064e\u0646\u0650\u064a\u0653\u0640\u0654\u064e\u06e2\u0627 \u0628\u0650\u0645\u064e\u0627\u0653 \u0623\u064e\u0633\u06e1\u0644\u064e\u0641\u06e1\u062a\u064f\u0645\u06e1 \u0641\u0650\u064a \u0671\u0644\u06e1\u0623\u064e\u064a\u0651\u064e\u0627\u0645\u0650 \u0671\u0644\u06e1\u062e\u064e\u0627\u0644\u0650\u064a\u064e\u0629\u0650","translation":"Yiyin, i\u00e7in; afiyet olsun. Bu, ge\u00e7mi\u015f g\u00fcnlerde yapt\u0131klar\u0131n\u0131z\u0131n sebebiyle (size bah\u015fedilmi\u015ftir.)","footnotes":""},{"id":"5348","sura":"69","aya":"25","arabic_text":"\u0648\u064e\u0623\u064e\u0645\u0651\u064e\u0627 \u0645\u064e\u0646\u06e1 \u0623\u064f\u0648\u062a\u0650\u064a\u064e \u0643\u0650\u062a\u064e\u0670\u0628\u064e\u0647\u064f\u06e5 \u0628\u0650\u0634\u0650\u0645\u064e\u0627\u0644\u0650\u0647\u0650\u06e6 \u0641\u064e\u064a\u064e\u0642\u064f\u0648\u0644\u064f \u064a\u064e\u0670\u0644\u064e\u064a\u06e1\u062a\u064e\u0646\u0650\u064a \u0644\u064e\u0645\u06e1 \u0623\u064f\u0648\u062a\u064e \u0643\u0650\u062a\u064e\u0670\u0628\u0650\u064a\u064e\u0647\u06e1","translation":"Kitab\u0131 solundan verilen kimseler ise \u015f\u00f6yle der: \u201cEyvah! Ke\u015fke kitab\u0131m verilmeseydi.''","footnotes":""},{"id":"5349","sura":"69","aya":"26","arabic_text":"\u0648\u064e\u0644\u064e\u0645\u06e1 \u0623\u064e\u062f\u06e1\u0631\u0650 \u0645\u064e\u0627 \u062d\u0650\u0633\u064e\u0627\u0628\u0650\u064a\u064e\u0647\u06e1","translation":"\"Hesab\u0131m\u0131n ne oldu\u011funu hi\u00e7 bilmeseydim.\"","footnotes":""},{"id":"5350","sura":"69","aya":"27","arabic_text":"\u064a\u064e\u0670\u0644\u064e\u064a\u06e1\u062a\u064e\u0647\u064e\u0627 \u0643\u064e\u0627\u0646\u064e\u062a\u0650 \u0671\u0644\u06e1\u0642\u064e\u0627\u0636\u0650\u064a\u064e\u0629\u064e","translation":"\"Ke\u015fke (\u00f6l\u00fcm i\u015fimi) bitirmi\u015f olsayd\u0131!\"","footnotes":""},{"id":"5351","sura":"69","aya":"28","arabic_text":"\u0645\u064e\u0627\u0653 \u0623\u064e\u063a\u06e1\u0646\u064e\u0649\u0670 \u0639\u064e\u0646\u0651\u0650\u064a \u0645\u064e\u0627\u0644\u0650\u064a\u064e\u0647\u06e1\u06dc","translation":"\"Mal\u0131m da bana bir fayda vermedi.\"","footnotes":""},{"id":"5352","sura":"69","aya":"29","arabic_text":"\u0647\u064e\u0644\u064e\u0643\u064e \u0639\u064e\u0646\u0651\u0650\u064a \u0633\u064f\u0644\u06e1\u0637\u064e\u0670\u0646\u0650\u064a\u064e\u0647\u06e1","translation":"\"Saltanat\u0131m yok olup gitti.\"","footnotes":""},{"id":"5353","sura":"69","aya":"30","arabic_text":"\u062e\u064f\u0630\u064f\u0648\u0647\u064f \u0641\u064e\u063a\u064f\u0644\u0651\u064f\u0648\u0647\u064f","translation":"Onu yakalay\u0131n da (ellerini boynuna) ba\u011flay\u0131n.","footnotes":""},{"id":"5354","sura":"69","aya":"31","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0671\u0644\u06e1\u062c\u064e\u062d\u0650\u064a\u0645\u064e \u0635\u064e\u0644\u0651\u064f\u0648\u0647\u064f","translation":"Sonra da Cehennem'e at\u0131n!","footnotes":""},{"id":"5355","sura":"69","aya":"32","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0641\u0650\u064a \u0633\u0650\u0644\u06e1\u0633\u0650\u0644\u064e\u0629\u0656 \u0630\u064e\u0631\u06e1\u0639\u064f\u0647\u064e\u0627 \u0633\u064e\u0628\u06e1\u0639\u064f\u0648\u0646\u064e \u0630\u0650\u0631\u064e\u0627\u0639\u0657\u0627 \u0641\u064e\u0671\u0633\u06e1\u0644\u064f\u0643\u064f\u0648\u0647\u064f","translation":"Ard\u0131ndan da onu yetmi\u015f ar\u015f\u0131n boyundaki bir zincire vurup s\u00fcr\u00fckleyin!","footnotes":""},{"id":"5356","sura":"69","aya":"33","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0643\u064e\u0627\u0646\u064e \u0644\u064e\u0627 \u064a\u064f\u0624\u06e1\u0645\u0650\u0646\u064f \u0628\u0650\u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u06e1\u0639\u064e\u0638\u0650\u064a\u0645\u0650","translation":"\u00c7\u00fcnk\u00fc o, Y\u00fcce Allah\u2019a iman etmiyordu.","footnotes":""},{"id":"5357","sura":"69","aya":"34","arabic_text":"\u0648\u064e\u0644\u064e\u0627 \u064a\u064e\u062d\u064f\u0636\u0651\u064f \u0639\u064e\u0644\u064e\u0649\u0670 \u0637\u064e\u0639\u064e\u0627\u0645\u0650 \u0671\u0644\u06e1\u0645\u0650\u0633\u06e1\u0643\u0650\u064a\u0646\u0650","translation":"Yoksulu yedirmeye te\u015fvik etmiyordu.","footnotes":""},{"id":"5358","sura":"69","aya":"35","arabic_text":"\u0641\u064e\u0644\u064e\u064a\u06e1\u0633\u064e \u0644\u064e\u0647\u064f \u0671\u0644\u06e1\u064a\u064e\u0648\u06e1\u0645\u064e \u0647\u064e\u0670\u0647\u064f\u0646\u064e\u0627 \u062d\u064e\u0645\u0650\u064a\u0645\u065e","translation":"Bug\u00fcn onun i\u00e7in burada bir can yolda\u015f\u0131 da yoktur.","footnotes":""},{"id":"5359","sura":"69","aya":"36","arabic_text":"\u0648\u064e\u0644\u064e\u0627 \u0637\u064e\u0639\u064e\u0627\u0645\u064c \u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u0650\u0646\u06e1 \u063a\u0650\u0633\u06e1\u0644\u0650\u064a\u0646\u0656","translation":"\u0130rinden ba\u015fka hi\u00e7bir yiyecek de yoktur.","footnotes":""},{"id":"5360","sura":"69","aya":"37","arabic_text":"\u0644\u0651\u064e\u0627 \u064a\u064e\u0623\u06e1\u0643\u064f\u0644\u064f\u0647\u064f\u06e5\u0653 \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u06e1\u062e\u064e\u0670\u0637\u0650\u0640\u0654\u064f\u0648\u0646\u064e","translation":"O yeme\u011fi g\u00fcnahk\u00e2rlardan ba\u015fkas\u0131 yemez.","footnotes":""},{"id":"5361","sura":"69","aya":"38","arabic_text":"\u0641\u064e\u0644\u064e\u0627\u0653 \u0623\u064f\u0642\u06e1\u0633\u0650\u0645\u064f \u0628\u0650\u0645\u064e\u0627 \u062a\u064f\u0628\u06e1\u0635\u0650\u0631\u064f\u0648\u0646\u064e","translation":"Yemin ederim g\u00f6rd\u00fcklerinize.","footnotes":""},{"id":"5362","sura":"69","aya":"39","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0644\u064e\u0627 \u062a\u064f\u0628\u06e1\u0635\u0650\u0631\u064f\u0648\u0646\u064e","translation":"G\u00f6rmediklerinize de\u2026","footnotes":""},{"id":"5363","sura":"69","aya":"40","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u0642\u064e\u0648\u06e1\u0644\u064f \u0631\u064e\u0633\u064f\u0648\u0644\u0656 \u0643\u064e\u0631\u0650\u064a\u0645\u0656","translation":"\u015e\u00fcphesiz o, \u00e7ok de\u011ferli bir el\u00e7inin s\u00f6z\u00fcd\u00fcr.","footnotes":""},{"id":"5364","sura":"69","aya":"41","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0647\u064f\u0648\u064e \u0628\u0650\u0642\u064e\u0648\u06e1\u0644\u0650 \u0634\u064e\u0627\u0639\u0650\u0631\u0656\u06da \u0642\u064e\u0644\u0650\u064a\u0644\u0657\u0627 \u0645\u0651\u064e\u0627 \u062a\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e","translation":"O, bir \u015fair s\u00f6z\u00fc de\u011fildir. Ne kadar da az iman ediyorsunuz!","footnotes":""},{"id":"5365","sura":"69","aya":"42","arabic_text":"\u0648\u064e\u0644\u064e\u0627 \u0628\u0650\u0642\u064e\u0648\u06e1\u0644\u0650 \u0643\u064e\u0627\u0647\u0650\u0646\u0656\u06da \u0642\u064e\u0644\u0650\u064a\u0644\u0657\u0627 \u0645\u0651\u064e\u0627 \u062a\u064e\u0630\u064e\u0643\u0651\u064e\u0631\u064f\u0648\u0646\u064e","translation":"O, bir k\u00e2hin s\u00f6z\u00fc de de\u011fildir. Ne de az d\u00fc\u015f\u00fcn\u00fcyorsunuz!","footnotes":""},{"id":"5366","sura":"69","aya":"43","arabic_text":"\u062a\u064e\u0646\u0632\u0650\u064a\u0644\u065e \u0645\u0651\u0650\u0646 \u0631\u0651\u064e\u0628\u0651\u0650 \u0671\u0644\u06e1\u0639\u064e\u0670\u0644\u064e\u0645\u0650\u064a\u0646\u064e","translation":"\u00c2lemlerin Rabbi taraf\u0131ndan indirilmi\u015ftir.","footnotes":""},{"id":"5367","sura":"69","aya":"44","arabic_text":"\u0648\u064e\u0644\u064e\u0648\u06e1 \u062a\u064e\u0642\u064e\u0648\u0651\u064e\u0644\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0646\u064e\u0627 \u0628\u064e\u0639\u06e1\u0636\u064e \u0671\u0644\u06e1\u0623\u064e\u0642\u064e\u0627\u0648\u0650\u064a\u0644\u0650","translation":"E\u011fer Peygamber bizim ad\u0131m\u0131za baz\u0131 s\u00f6zler uydurmu\u015f olsayd\u0131;","footnotes":""},{"id":"5368","sura":"69","aya":"45","arabic_text":"\u0644\u064e\u0623\u064e\u062e\u064e\u0630\u06e1\u0646\u064e\u0627 \u0645\u0650\u0646\u06e1\u0647\u064f \u0628\u0650\u0671\u0644\u06e1\u064a\u064e\u0645\u0650\u064a\u0646\u0650","translation":"Elbette onu sa\u011f taraf\u0131ndan k\u0131sk\u0131vrak yakalard\u0131k.","footnotes":""},{"id":"5369","sura":"69","aya":"46","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0644\u064e\u0642\u064e\u0637\u064e\u0639\u06e1\u0646\u064e\u0627 \u0645\u0650\u0646\u06e1\u0647\u064f \u0671\u0644\u06e1\u0648\u064e\u062a\u0650\u064a\u0646\u064e","translation":"Sonra da onun can damar\u0131n\u0131 kopart\u0131rd\u0131k.","footnotes":""},{"id":"5370","sura":"69","aya":"47","arabic_text":"\u0641\u064e\u0645\u064e\u0627 \u0645\u0650\u0646\u0643\u064f\u0645 \u0645\u0651\u0650\u0646\u06e1 \u0623\u064e\u062d\u064e\u062f\u064d \u0639\u064e\u0646\u06e1\u0647\u064f \u062d\u064e\u0670\u062c\u0650\u0632\u0650\u064a\u0646\u064e","translation":"Sizden hi\u00e7 kimse de buna engel olamazd\u0131.","footnotes":""},{"id":"5371","sura":"69","aya":"48","arabic_text":"\u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u062a\u064e\u0630\u06e1\u0643\u0650\u0631\u064e\u0629\u065e \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u062a\u0651\u064e\u0642\u0650\u064a\u0646\u064e","translation":"\u015e\u00fcphesiz o, takva sahipleri i\u00e7in bir \u00f6\u011f\u00fctt\u00fcr.","footnotes":""},{"id":"5372","sura":"69","aya":"49","arabic_text":"\u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0627 \u0644\u064e\u0646\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0623\u064e\u0646\u0651\u064e \u0645\u0650\u0646\u0643\u064f\u0645 \u0645\u0651\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"Elbette biz, biliyoruz ki i\u00e7inizden yalanlayanlar vard\u0131r.","footnotes":""},{"id":"5373","sura":"69","aya":"50","arabic_text":"\u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u062d\u064e\u0633\u06e1\u0631\u064e\u0629\u064c \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u06e1\u0643\u064e\u0670\u0641\u0650\u0631\u0650\u064a\u0646\u064e","translation":"\u015e\u00fcphesiz ki o k\u00e2firler i\u00e7in bir pi\u015fmanl\u0131kt\u0131r.","footnotes":""},{"id":"5374","sura":"69","aya":"51","arabic_text":"\u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u062d\u064e\u0642\u0651\u064f \u0671\u0644\u06e1\u064a\u064e\u0642\u0650\u064a\u0646\u0650","translation":"Ve \u015f\u00fcphesiz o, kesin bir ger\u00e7ektir.","footnotes":""},{"id":"5375","sura":"69","aya":"52","arabic_text":"\u0641\u064e\u0633\u064e\u0628\u0651\u0650\u062d\u06e1 \u0628\u0650\u0671\u0633\u06e1\u0645\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0671\u0644\u06e1\u0639\u064e\u0638\u0650\u064a\u0645\u0650","translation":"O halde sen, Y\u00fcce Rabbinin ad\u0131n\u0131 tesbih et!","footnotes":""}]}