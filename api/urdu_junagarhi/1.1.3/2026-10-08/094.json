d2\u06d4"},{"id":"6098","sura":"94","aya":"8","arabic_text":"\u0648\u064e\u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0641\u064e\u0671\u0631\u06e1\u063a\u064e\u0628","translation":"\u0627\u0648\u0631 \u0627\u067e\u0646\u06d2 \u067e\u0631\u0648\u0631\u062f\u06af\u0627\u0631 \u06c1\u06cc \u06a9\u06cc \u0637\u0631\u0641 \u062f\u0644 \u0644\u06af\u0627.[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u0627\u0633\u06cc \u0633\u06d2 \u062c\u0646\u062a \u06a9\u06cc \u0627\u0645\u06cc\u062f \u0631\u06a9\u06be\u060c \u0627\u0633\u06cc \u0633\u06d2 \u0627\u067e\u0646\u06cc \u062d\u0627\u062c\u062a\u06cc\u06ba \u0637\u0644\u0628 \u06a9\u0631 \u0627\u0648\u0631 \u062a\u0645\u0627\u0645 \u0645\u0639\u0627\u0645\u0644\u0627\u062a \u0645\u06cc\u06ba \u0627\u0633\u06cc \u067e\u0631 \u0627\u0639\u062a\u0645\u0627\u062f \u0627\u0648\u0631 \u0628\u06be\u0631\u0648\u0633\u06c1 \u0631\u06a9\u06be\u06d4"}]}