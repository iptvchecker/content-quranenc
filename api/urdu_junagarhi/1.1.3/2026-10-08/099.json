4\u0645 \u0628\u0646\u0627 \u062f\u06d2 \u06af\u0627 \u0627\u0648\u0631 \u0648\u06c1 \u0627\u0644\u0644\u06c1 \u06a9\u06d2 \u062d\u06a9\u0645 \u0633\u06d2 \u0628\u0648\u0644\u06d2 \u06af\u06cc\u06d4"},{"id":"6144","sura":"99","aya":"6","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u064a\u064e\u0635\u06e1\u062f\u064f\u0631\u064f \u0671\u0644\u0646\u0651\u064e\u0627\u0633\u064f \u0623\u064e\u0634\u06e1\u062a\u064e\u0627\u062a\u0657\u0627 \u0644\u0651\u0650\u064a\u064f\u0631\u064e\u0648\u06e1\u0627\u0652 \u0623\u064e\u0639\u06e1\u0645\u064e\u0670\u0644\u064e\u0647\u064f\u0645\u06e1","translation":"\u0627\u0633 \u0631\u0648\u0632 \u0644\u0648\u06af \u0645\u062e\u062a\u0644\u0641 \u062c\u0645\u0627\u0639\u062a\u06cc\u06ba \u06c1\u0648 \u06a9\u0631 (\u0648\u0627\u067e\u0633) \u0644\u0648\u0679\u06cc\u06ba[1] \u06af\u06d2 \u062a\u0627\u06a9\u06c1 \u0627\u0646\u06c1\u06cc\u06ba \u0627\u0646 \u06a9\u06d2 \u0627\u0639\u0645\u0627\u0644 \u062f\u06a9\u06be\u0627 \u062f\u06cc\u0626\u06d2 \u062c\u0627\u0626\u06cc\u06ba.[2]","footnotes":"[1] \u064a\u064e\u0635\u0652\u062f\u064f\u0631\u064f\u060c \u064a\u064e\u0631\u0652\u062c\u0650\u0639\u064f ( \u0644\u0648\u0679\u06cc\u06ba \u06af\u06d2 ) \u06cc\u06c1 \u0648\u0631\u0648\u062f \u06a9\u06cc \u0636\u062f \u06c1\u06d2\u06d4 \u06cc\u0639\u0646\u06cc \u0642\u0628\u0631\u0648\u06ba \u0633\u06d2 \u0646\u06a9\u0644 \u06a9\u0631 \u0645\u0648\u0642\u0641 \u062d\u0633\u0627\u0628 \u06a9\u06cc \u0637\u0631\u0641\u060c \u06cc\u0627 \u062d\u0633\u0627\u0628 \u06a9\u06d2 \u0628\u0639\u062f \u062c\u0646\u062a \u0627\u0648\u0631 \u062f\u0648\u0632\u062e \u06a9\u06cc \u0637\u0631\u0641 \u0644\u0648\u0679\u06cc\u06ba \u06af\u06d2\u06d4 \u0623\u064e\u0634\u0652\u062a\u064e\u0627\u062a\u064b\u0627\u060c \u0645\u062a\u0641\u0631\u0642\u060c \u06cc\u0639\u0646\u06cc \u0679\u0648\u0644\u06cc\u0627\u06ba \u0679\u0648\u0644\u06cc\u0627\u06ba\u06d4 \u0628\u0639\u0636 \u0628\u06d2\u062e\u0648\u0641 \u06c1\u0648\u06ba \u06af\u06d2\u060c \u0628\u0639\u0636 \u062e\u0648\u0641 \u0632\u062f\u06c1\u060c \u0628\u0639\u0636 \u06a9\u06d2 \u0631\u0646\u06af \u0633\u0641\u06cc\u062f \u06c1\u0648\u06ba \u06af\u06d2 \u062c\u06cc\u0633\u06d2 \u062c\u0646\u062a\u0648\u06ba \u06a9\u06d2 \u06c1\u0648\u06ba \u06af\u06d2 \u0627\u0648\u0631 \u0628\u0639\u0636 \u06a9\u06d2 \u0631\u0646\u06af \u0633\u06cc\u0627\u06c1\u060c \u062c\u0648 \u0627\u0646 \u06a9\u06d2 \u062c\u06c1\u0646\u0645\u06cc \u06c1\u0648\u0646\u06d2 \u06a9\u06cc \u0639\u0644\u0627\u0645\u062a \u06c1\u0648\u06af\u06cc\u06d4 \u0628\u0639\u0636 \u06a9\u0627 \u0631\u062e \u062f\u0627\u0626\u06cc\u06ba \u062c\u0627\u0646\u0628 \u06c1\u0648\u06af\u0627 \u0628\u0639\u0636 \u06a9\u0627 \u0628\u0627\u0626\u06cc\u06ba \u062c\u0627\u0646\u0628\u06d4 \u06cc\u0627 \u06cc\u06c1 \u0645\u062e\u062a\u0644\u0641 \u06af\u0631\u0648\u06c1 \u0627\u062f\u06cc\u0627\u0646 \u0648\u0645\u0630\u0627\u06c1\u0628 \u0627\u0648\u0631 \u0627\u0639\u0645\u0627\u0644 \u0648\u0627\u0641\u0639\u0627\u0644 \u06a9\u06cc \u0628\u0646\u06cc\u0627\u062f \u067e\u0631 \u06c1\u0648\u06ba \u06af\u06d2\u06d4\n[2] \u06cc\u06c1 \u0645\u062a\u0639\u0644\u0642 \u06c1\u06d2 \u064a\u064e\u0635\u0652\u062f\u064f\u0631\u064f \u06a9\u06d2 \u06cc\u0627 \u0627\u0633 \u06a9\u0627 \u062a\u0639\u0644\u0642 \u0623\u064e\u0648\u0652\u062d\u064e\u0649 \u0644\u064e\u0647\u064e\u0627 \u0633\u06d2 \u06c1\u06d2\u06d4 \u06cc\u0639\u0646\u06cc \u0632\u0645\u06cc\u0646 \u0627\u067e\u0646\u06cc \u062e\u0628\u0631\u06cc\u06ba \u0627\u0633 \u0644\u0626\u06d2 \u0628\u06cc\u0627\u0646 \u06a9\u0631\u06d2 \u06af\u06cc \u062a\u0627\u06a9\u06c1 \u0627\u0646\u0633\u0627\u0646\u0648\u06ba \u06a9\u0648 \u0627\u0646 \u06a9\u06d2 \u0627\u0639\u0645\u0627\u0644 \u062f\u06a9\u06be\u0627 \u062f\u06cc\u0626\u06d2 \u062c\u0627\u0626\u06cc\u06ba\u06d4"},{"id":"6145","sura":"99","aya":"7","arabic_text":"\u0641\u064e\u0645\u064e\u0646 \u064a\u064e\u0639\u06e1\u0645\u064e\u0644\u06e1 \u0645\u0650\u062b\u06e1\u0642\u064e\u0627\u0644\u064e \u0630\u064e\u0631\u0651\u064e\u0629\u064d \u062e\u064e\u064a\u06e1\u0631\u0657\u0627 \u064a\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"\u067e\u0633 \u062c\u0633 \u0646\u06d2 \u0630\u0631\u0647 \u0628\u0631\u0627\u0628\u0631 \u0646\u06cc\u06a9\u06cc \u06a9\u06cc \u06c1\u0648\u06af\u06cc \u0648\u0647 \u0627\u0633\u06d2 \u062f\u06cc\u06a9\u06be \u0644\u06d2 \u06af\u0627.[1]","footnotes":"[1] \u067e\u0633 \u0648\u06c1 \u0627\u0633 \u0633\u06d2 \u062e\u0648\u0634 \u06c1\u0648\u06af\u0627\u06d4"},{"id":"6146","sura":"99","aya":"8","arabic_text":"\u0648\u064e\u0645\u064e\u0646 \u064a\u064e\u0639\u06e1\u0645\u064e\u0644\u06e1 \u0645\u0650\u062b\u06e1\u0642\u064e\u0627\u0644\u064e \u0630\u064e\u0631\u0651\u064e\u0629\u0656 \u0634\u064e\u0631\u0651\u0657\u0627 \u064a\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"\u0627\u0648\u0631 \u062c\u0633 \u0646\u06d2 \u0630\u0631\u0647 \u0628\u0631\u0627\u0628\u0631 \u0628\u0631\u0627\u0626\u06cc \u06a9\u06cc \u06c1\u0648\u06af\u06cc \u0648\u0647 \u0627\u0633\u06d2 \u062f\u06cc\u06a9\u06be \u0644\u06d2 \u06af\u0627.[1]","footnotes":"[1] \u0648\u06c1 \u0627\u0633 \u067e\u0631\u0633\u062e\u062a \u067e\u0634\u06cc\u0645\u0627\u0646 \u0627\u0648\u0631 \u0645\u0636\u0637\u0631\u0628 \u06c1\u0648\u06af\u0627\u06d4 \u0630\u064e\u0631\u0651\u064e\u0629\u064d \u0628\u0639\u0636 \u06a9\u06d2 \u0646\u0632\u062f\u06cc\u06a9 \u0686\u06cc\u0648\u0646\u0679\u06cc \u0633\u06d2 \u0628\u06be\u06cc \u0686\u06be\u0648\u0679\u06cc \u0686\u06cc\u0632 \u06c1\u06d2\u06d4 \u0628\u0639\u0636 \u0627\u06c1\u0644 \u0644\u063a\u062a \u06a9\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba\u060c \u0627\u0646\u0633\u0627\u0646 \u0632\u0645\u06cc\u0646 \u067e\u0631 \u06c1\u0627\u062a\u06be \u0645\u0627\u0631\u062a\u0627 \u06c1\u06d2\u060c \u0627\u0633 \u0633\u06d2 \u0627\u0633 \u06a9\u06d2 \u06c1\u0627\u062a\u06be \u067e\u0631\u062c\u0648 \u0645\u0679\u06cc \u0644\u06af \u062c\u0627\u062a\u06cc \u06c1\u06d2\u060c \u0648\u06c1 \u0630\u0631\u06c1 \u06c1\u06d2\u06d4 \u0628\u0639\u0636 \u06a9\u06d2\u0646\u0632\u062f\u06cc\u06a9 \u0633\u0648\u0631\u0627\u062e \u0633\u06d2 \u0622\u0646\u06d2 \u0648\u0627\u0644\u06cc \u0633\u0648\u0631\u062c \u06a9\u06cc \u0634\u0639\u0627\u0639\u0648\u06ba \u0645\u06cc\u06ba \u06af\u0631\u062f \u0648\u063a\u0628\u0627\u0631 \u06a9\u06d2 \u062c\u0648 \u0630\u0631\u0627\u062a \u0646\u0638\u0631 \u0622\u062a\u06d2 \u06c1\u06cc\u06ba\u060c \u0648\u06c1 \u0630\u0631\u06c1 \u06c1\u06d2\u06d4 \u0644\u06cc\u06a9\u0646 \u0627\u0645\u0627\u0645 \u0634\u0648\u06a9\u0627\u0646\u06cc \u0646\u06d2 \u067e\u06c1\u0644\u06d2 \u0645\u0639\u0646\u06cc \u06a9\u0648 \u0627\u0648\u0644\u06cc\u0670 \u06a9\u06c1\u0627 \u06c1\u06d2\u06d4 \u0627\u0645\u0627\u0645 \u0645\u0642\u0627\u062a\u0644 \u06a9\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 \u06cc\u06c1 \u0633\u0648\u0631\u062a \u0627\u0646 \u062f\u0648 \u0622\u0645\u06cc\u0648\u06ba \u06a9\u06d2 \u0628\u06cc\u0627\u0646 \u0645\u06cc\u06ba \u0646\u0627\u0632\u0644 \u06c1\u0648\u0626\u06cc \u06c1\u06d2\u06d4 \u062c\u0646 \u0645\u06cc\u06ba \u0633\u06d2 \u0627\u06cc\u06a9 \u0634\u062e\u0635\u060c \u0633\u0627\u0626\u0644 \u06a9\u0648 \u062a\u06be\u0648\u0691\u0627 \u0633\u0627 \u0635\u062f\u0642\u06c1 \u062f\u06cc\u0646\u06d2 \u0645\u06cc\u06ba \u062a\u0627\u0645\u0644 \u06a9\u0631\u062a\u0627 \u0627\u0648\u0631 \u062f\u0648\u0633\u0631\u0627 \u0634\u062e\u0635 \u0686\u06be\u0648\u0679\u0627 \u06af\u0646\u0627\u06c1 \u06a9\u0631\u0646\u06d2 \u0645\u06cc\u06ba \u06a9\u0648\u0626\u06cc \u062e\u0648\u0641 \u0645\u062d\u0633\u0648\u0633 \u0646\u06c1 \u06a9\u0631\u062a\u0627 \u062a\u06be\u0627\u06d4 (\u0641\u062a\u062d \u0627\u0644\u0642\u062f\u06cc\u0631) \u06d4"}]}