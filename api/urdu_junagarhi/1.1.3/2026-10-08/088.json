48\u0631 \u062c\u0646\u0633 \u06a9\u06d2 \u06c1\u06d2 \u06cc\u0639\u0646\u06cc \u0645\u062a\u0639\u062f\u062f \u0686\u0634\u0645\u06d2 \u06c1\u0648\u06ba \u06af\u06d2\u06d4 \u0646\u064e\u0645\u064e\u0627\u0631\u0650\u0642\u064f \u0628\u0645\u0639\u0646\u06cc \u0648\u064e\u0633\u064e\u0627\u0626\u0650\u062f\u064e ( \u062a\u06a9\u06cc\u06d2 ) \u06c1\u06d2 \u0632\u064e\u0631\u064e\u0627\u0628\u0650\u064a\u0651\u064f \u0645\u0633\u0646\u062f\u06cc\u06ba\u060c \u0642\u0627\u0644\u06cc\u0646 \u0627\u0648\u0631 \u06af\u062f\u06d2 \u0628\u0633\u062a\u0631 \u0645\u064e\u0628\u0652\u062b\u064f\u0648\u062b\u064e\u0629\u064c \u067e\u06be\u06cc\u0644\u06cc \u06c1\u0648\u0626\u06cc\u06d4 \u06cc\u0639\u0646\u06cc \u06cc\u06c1 \u0645\u0633\u0646\u062f\u06cc\u06ba \u062c\u06af\u06c1 \u062c\u06af\u06c1 \u0628\u0686\u06be\u06cc \u06c1\u0648\u0626\u06cc \u06c1\u0648\u06ba \u06af\u06cc\u06d4 \u0627\u06c1\u0644 \u062c\u0646\u062a \u062c\u06c1\u0627\u06ba \u0622\u0631\u0627\u0645 \u06a9\u0631\u0646\u0627 \u0686\u0627\u06c1\u06cc\u06ba \u06af\u06d2\u060c \u06a9\u0631 \u0633\u06a9\u06cc\u06ba \u06af\u06d2\u06d4"},{"id":"5984","sura":"88","aya":"17","arabic_text":"\u0623\u064e\u0641\u064e\u0644\u064e\u0627 \u064a\u064e\u0646\u0638\u064f\u0631\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u064e\u0649 \u0671\u0644\u06e1\u0625\u0650\u0628\u0650\u0644\u0650 \u0643\u064e\u064a\u06e1\u0641\u064e \u062e\u064f\u0644\u0650\u0642\u064e\u062a\u06e1","translation":"\u06a9\u06cc\u0627 \u06cc\u06c1 \u0627\u0648\u0646\u0679\u0648\u06ba \u06a9\u0648 \u0646\u06c1\u06cc\u06ba \u062f\u06cc\u06a9\u06be\u062a\u06d2 \u06a9\u06c1 \u0648\u0647 \u06a9\u0633 \u0637\u0631\u062d \u067e\u06cc\u062f\u0627 \u06a9\u06cc\u06d2 \u06af\u0626\u06d2 \u06c1\u06cc\u06ba.[1]","footnotes":"[1] \u0627\u0648\u0646\u0679 \u0639\u0631\u0628 \u0645\u06cc\u06ba \u0639\u0627\u0645 \u062a\u06be\u06d2 \u0627\u0648\u0631 \u0627\u0646 \u0639\u0631\u0628\u0648\u06ba \u06a9\u06cc \u063a\u0627\u0644\u0628 \u0633\u0648\u0627\u0631\u06cc \u06cc\u06c1