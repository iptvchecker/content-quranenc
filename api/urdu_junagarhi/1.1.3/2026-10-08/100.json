\u0626\u0650\u0630\u0656 \u0644\u0651\u064e\u062e\u064e\u0628\u0650\u064a\u0631\u064f\u06e2","translation":"\u0628\u06cc\u0634\u06a9 \u0627\u0646 \u06a9\u0627 \u0631\u0628 \u0627\u0633 \u062f\u0646 \u0627\u0646 \u06a9\u06d2 \u062d\u0627\u0644 \u0633\u06d2 \u067e\u0648\u0631\u0627 \u0628\u0627\u062e\u0628\u0631 \u06c1\u0648\u06af\u0627.[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u062c\u0648 \u0631\u0628 \u0627\u0646 \u06a9\u0648 \u0642\u0628\u0631\u0648\u06ba \u0633\u06d2 \u0646\u06a9\u0627\u0644 \u0644\u06d2 \u06af\u0627\u060c \u0627\u0646 \u06a9\u06d2 \u0633\u06cc\u0646\u0648\u06ba \u06a9\u06d2 \u0631\u0627\u0632\u0648\u06ba \u06a9\u0648 \u0638\u0627\u06c1\u0631\u06a9\u0631\u062f\u06d2 \u06af\u0627\u060c \u0627\u0633 \u06a9\u06d2 \u0645\u062a\u0639\u0644\u0642 \u06c1\u0631 \u0634\u062e\u0635 \u062c\u0627\u0646 \u0633\u06a9\u062a\u0627 \u06c1\u06d2 \u06a9\u06c1 \u0648\u06c1 \u06a9\u062a\u0646\u0627 \u0628\u0627\u062e\u0628\u0631 \u06c1\u06d2\u061f \u0627\u0648\u0631 \u0627\u0633 \u0633\u06d2 \u06a9\u0648\u0626\u06cc \u0686\u06cc\u0632 \u0645\u062e\u0641\u06cc \u0646\u06c1\u06cc\u06ba \u0631\u06c1 \u0633\u06a9\u062a\u06cc\u06d4 \u0686\u0646\u0627\u0646\u0686\u06c1 \u067e\u06be\u0631 \u0648\u06c1 \u06c1\u0631 \u0627\u06cc\u06a9 \u06a9\u0648 \u0627\u0633 \u06a9\u06d2 \u0639\u0645\u0644\u0648\u06ba \u06a9\u06d2 \u0645\u0637\u0627\u0628\u0642 \u0627\u0686\u06be\u06cc \u06cc\u0627 \u0628\u0631\u06cc \u062c\u0632\u0627 \u062f\u06d2 \u06af\u0627\u06d4 \u06cc\u06c1 \u06af\u0648\u06cc\u0627 \u0627\u0646 \u0627\u0634\u062e\u0627\u0635 \u06a9\u0648 \u062a\u0646\u0628\u06cc\u06c1 \u06c1\u06d2\u062c\u0648 \u0631\u0628 \u06a9\u06cc \u0646\u0639\u0645\u062a\u06cc\u06ba \u062a\u0648 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u060c \u0644\u06cc\u06a9\u0646 \u0627\u0633 \u06a9\u0627 \u0634\u06a9\u0631 \u0627\u062f\u0627 \u06a9\u0631\u0646\u06d2\u06a9\u06d2 \u0628\u062c\u0627\u0626\u06d2\u060c \u0627\u0633 \u06a9\u06cc \u0646\u0627\u0634\