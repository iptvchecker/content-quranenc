06c1\u06d2 \u06a9\u06c1 \u0648\u06c1 \u062c\u0633 \u0634\u06a9\u0644 \u0645\u06cc\u06ba \u0686\u0627\u06c1\u06d2\u060c \u0688\u06be\u0627\u0644 \u062f\u06d2\u060c \u062d\u062a\u06cc\u0670 \u06a9\u06c1 \u0642\u0628\u06cc\u062d \u062a\u0631\u06cc\u0646 \u062c\u0627\u0646\u0648\u0631 \u06a9\u06cc \u0634\u06a9\u0644 \u0645\u06cc\u06ba \u0628\u06be\u06cc \u067e\u06cc\u062f\u0627 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u06d2 \u0644\u06cc\u06a9\u0646 \u06cc\u06c1 \u0627\u0633 \u06a9\u0627 \u0644\u0637\u0641 \u0648\u06a9\u0631\u0645 \u0627\u0648\u0631 \u0645\u06c1\u0631\u0628\u0627\u0646\u06cc \u06c1\u06d2 \u06a9\u06c1 \u0648\u06c1 \u0627\u06cc\u0633\u0627 \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u062a\u0627 \u0627\u0648\u0631 \u0628\u06c1\u062a\u0631\u06cc\u0646 \u0627\u0646\u0633\u0627\u0646\u06cc \u0634\u06a9\u0644 \u0645\u06cc\u06ba \u06c1\u06cc \u067e\u06cc\u062f\u0627 \u0641\u0631\u0645\u0627\u062a\u0627 \u06c1\u06d2\u06d4"},{"id":"5838","sura":"82","aya":"9","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627 \u0628\u064e\u0644\u06e1 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f\u0648\u0646\u064e \u0628\u0650\u0671\u0644\u062f\u0651\u0650\u064a\u0646\u0650","translation":"\u06c1\u0631\u06af\u0632 \u0646\u06c1\u06cc\u06ba \u0628\u0644\u06a9\u06c1 \u062a\u0645 \u062a\u0648 \u062c\u0632\u0627 \u0648\u0633\u0632\u0627 \u06a9\u06d2 \u062f\u0646 \u06a9\u0648 \u062c\u06be\u0679\u0644\u0627\u062a\u06d2 \u06c1\u0648.[1]","footnotes":"[1] \u0643\u064e\u0644\u0627\u060c \u062d\u064e\u0642\u0651\u064b\u0627 \u06a9\u06d2 \u0645\u0639\u0646\u06cc \u0645\u06cc\u06ba \u0628\u06be\u06cc \u06c1\u0648 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4 \u0627\u0648\u0631 \u06a9\u0627\u0641\u0631\u0648\u06ba \u06a9\u06d2\u0627\u0633 \u0637\u0631\u0632 \u0639\u0645\u0644 \u06a9\u06cc \u0646\u0641\u06cc \u0628\u06be\u06cc \u062c\u0648 \u0627\u0644\u0644\u06c1 \u06a9\u0631\u06cc\u0645 \u06a9\u06cc \u0631\u0627\u0641\u062a \u0648\u0631\u062d\u0645\u062a \u0633\u06d2 \u062f\u06be\u0648\u06a9\u06d2 \u0645\u06cc\u06ba \u0645\u0628\u062a\u0644\u0627 \u06c1\u0648\u0646\u06d2 \u067e\u0631 \u0645\u0628\u0646\u06cc \u06c1\u06d2 \u06cc\u0639\u0646\u06cc \u0627\u0633 \u0641\u0631\u06cc\u0628 \u0646\u0641\u0633 \u0645\u06cc\u06ba \u0645\u0628\u062a\u0644\u0627 \u06c1\u0648\u0646\u06d2\u06a9\u0627 \u06a9\u0648\u0626\u06cc \u062c\u0648\u0627\u0632 \u0646\u06c1\u06cc\u06ba \u0628\u0644\u06a9\u06c1 \u0627\u0635\u0644 \u0628\u0627\u062a \u06cc\u06c1 \u06c1\u06d2 \u06a9\u06c1 \u062a\u0645\u06c1\u0627\u0631\u06d2 \u062f\u0644\u0648\u06ba \u0645\u06cc\u06ba \u0627\u0633 \u0628\u0627\u062a \u067e\u0631 \u06cc\u0642\u06cc\u0646 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2 \u06a9\u06c1 \u0642\u06cc\u0627\u0645\u062a \u06c1\u0648\u06af\u06cc \u0627\u0648\u0631 \u0648\u06c1\u0627\u06ba \u062c\u0632\u0627 \u0648\u0633\u0632\u0627 \u06c1\u0648\u06af\u06cc\u06d4"},{"id":"5839","sura":"82","aya":"10","arabic_text":"\u0648\u064e\u0625\u0650\u0646\u0651\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0643\u064f\u0645\u06e1 \u0644\u064e\u062d\u064e\u0670\u0641\u0650\u0638\u0650\u064a\u0646\u064e","translation":"\u06cc\u0642\u06cc\u0646\u0627\u064b \u062a\u0645 \u067e\u0631 \u0646\u06af\u06c1\u0628\u0627\u0646 \u0639\u0632\u062a \u0648\u0627\u0644\u06d2.","footnotes":""},{"id":"5840","sura":"82","aya":"11","arabic_text":"\u0643\u0650\u0631\u064e\u0627\u0645\u0657\u0627 \u0643\u064e\u0670\u062a\u0650\u0628\u0650\u064a\u0646\u064e","translation":"\u0644\u06a9\u06be\u0646\u06d2 \u0648\u0627\u0644\u06d2 \u0645\u0642\u0631\u0631 \u06c1\u06cc\u06ba.","footnotes":""},{"id":"5841","sura":"82","aya":"12","arabic_text":"\u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e \u0645\u064e\u0627 \u062a\u064e\u0641\u06e1\u0639\u064e\u0644\u064f\u0648\u0646\u064e","translation":"\u062c\u0648\u06a9\u0686\u06be \u062a\u0645 \u06a9\u0631\u062a\u06d2 \u06c1\u0648 \u0648\u0647 \u062c\u0627\u0646\u062a\u06d2 \u06c1\u06cc\u06ba.[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u062a\u0645 \u062c\u0648 \u062c\u0632\u0627 \u0648\u0633\u0632\u0627 \u06a9\u06d2 \u0645\u0646\u06a9\u0631 \u06c1\u0648\u060c \u0644\u06cc\u06a9\u0646 \u062a\u0645\u06c1\u06cc\u06ba \u0645\u0639\u0644\u0648\u0645 \u06c1\u0648\u0646\u0627 \u0686\u0627\u06c1\u0626\u06d2 \u06a9\u06c1 \u062a\u0645\u06c1\u0627\u0631\u0627 \u06c1\u0631 \u0642\u0648\u0644 \u0627\u0648\u0631 \u06c1\u0631 \u0641\u0639\u0644 \u0646\u0648\u0679 \u06c1\u0648 \u0631\u06c1\u0627 \u06c1\u06d2\u06d4 \u0627\u0644\u0644\u06c1 \u06a9\u06cc \u0637\u0631\u0641 \u0633\u06d2 \u0641\u0631\u0634\u062a\u06d2 \u062a\u0645 \u067e\u0631 \u0628\u0637\u0648\u0631 \u0646\u06af\u0631\u0627\u0646 \u0645\u0642\u0631\u0631 \u06c1\u06cc\u06ba \u062c\u0648 \u062a\u0645\u06c1\u0627\u0631\u06cc \u06c1\u0631 \u0627\u0633 \u0628\u0627\u062a \u06a9\u0648 \u062c\u0627\u0646\u062a\u06d2 \u06c1\u06cc\u06ba \u062c\u0648 \u062a\u0645 \u06a9\u0631\u062a\u06d2 \u06c1\u0648\u06d4 \u06cc\u06c1 \u06af\u0648\u06cc\u0627 \u0627\u0646\u0633\u0627\u0646\u0648\u0646 \u06a9\u0648 \u062a\u0646\u0628\u06cc\u06c1 \u06c1\u06d2 \u06a9\u06c1 \u06c1\u0631 \u0639\u0645\u0644 \u0627\u0648\u0631 \u0628\u0627\u062a \u0633\u06d2 \u067e\u06c1\u0644\u06d2\u0633\u0648\u0686 \u0644\u0648 \u06a9\u06c1 \u0648\u06c1 \u063a\u0644\u0637 \u062a\u0648 \u0646\u06c1\u06cc\u06ba\u06d4 \u06cc\u06c1 \u0648\u06c1\u06cc \u0628\u0627\u062a \u06c1\u06d2 \u062c\u0648 \u067e\u06c1\u0644\u06d2 \u06af\u0632\u0631 \u0686\u06a9\u06cc \u06c1\u06d2 \u0645\u062b\u0644\u0627\u064b \u0639\u064e\u0646\u0650 \u0627\u0644\u0652\u064a\u064e\u0645\u0650\u064a\u0646\u0650 \u0648\u064e\u0639\u064e\u0646\u0650 \u0627\u0644\u0634\u0651\u0650\u0645\u064e\u0627\u0644\u0650 \u0642\u064e\u0639\u0650\u064a\u062f\u064c (1) \u0645\u064e\u0627 \u064a\u064e\u0644\u0652\u0641\u0650\u0638\u064f \u0645\u0650\u0646\u0652 \u0642\u064e\u0648\u0652\u0644\u064d \u0625\u0650\u0644\u0627 \u0644\u064e\u062f\u064e\u064a\u0652\u0647\u0650 \u0631\u064e\u0642\u0650\u064a\u0628\u064c \u0639\u064e\u062a\u0650\u064a\u062f\u064c ( \u0633\u0648\u0631\u0629 \u0642 \u060c 17\u06d4 18) \u06cc\u0639\u0646\u06cc (\u0627\u06cc\u06a9 \u0641\u0631\u0634\u062a\u06c1 \u0627\u0633 \u06a9\u06d2 \u062f\u0627\u0626\u06cc\u06ba \u0627\u0648\u0631 \u062f\u0648\u0633\u0631\u0627 \u0627\u0633 \u06a9\u06d2 \u0628\u0627\u0626\u06cc\u06ba \u062c\u0627\u0646\u0628 \u0628\u06cc\u0679\u06be\u0627 \u06c1\u0648\u0627 \u06c1\u06d2\u060c \u0627\u0646\u0633\u0627\u0646 \u062c\u0648 \u0628\u0648\u0644\u062a\u0627 \u06c1\u06d2\u060c \u0627\u0633 \u06a9\u06d2 \u067e\u0627\u0633 \u0646\u06af\u0631\u0627\u0646\u060c \u062a\u06cc\u0627\u0631 \u0627\u0648\u0631 \u062d\u0627\u0636\u0631 \u06c1\u06d2) \u06cc\u0639\u0646\u06cc \u0644\u06a9\u06be\u0646\u06d2 \u06a9\u06d2 \u0644\u0626\u06d2\u06d4 \u06a9\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba \u0627\u06cc\u06a9 \u0641\u0631\u0634\u062a\u06c1 \u0646\u06cc\u06a9\u06cc \u0627\u0648\u0631 \u062f\u0648\u0633\u0631\u0627 \u0628\u062f\u06cc \u0644\u06a9\u06be\u062a\u0627 \u06c1\u06d2\u06d4 \u0627\u0648\u0631 \u0627\u062d\u0627\u062f\u06cc\u062b \u0648\u0622\u062b\u0627\u0631 \u0633\u06d2 \u0645\u0639\u0644\u0648\u0645 \u06c1\u0648\u062a\u0627 \u06c1\u06d2 \u06a9\u06c1 \u062f\u0646 \u06a9\u06d2 \u062f\u0648 \u0641\u0631\u0634\u062a\u06d2 \u0627\u0644\u06af \u0627\u0648\u0631 \u0631\u0627\u062a \u06a9\u06d2 \u062f\u0648 \u0641\u0631\u0634\u062a\u06d2 \u0627\u0644\u06af \u06c1\u06cc\u06ba\u06d4 \u0622\u06af\u06d2 \u0646\u06cc\u06a9\u0648\u06ba \u0627\u0648\u0631 \u0628\u062f\u0648\u06ba\u060c \u062f\u0648\u0646\u0648\u06ba \u06a9\u0627 \u0630\u06a9\u0631 \u06a9\u06cc\u0627 \u062c\u0627 \u0631\u06c1\u0627 \u06c1\u06d2\u06d4"},{"id":"5842","sura":"82","aya":"13","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u06e1\u0623\u064e\u0628\u06e1\u0631\u064e\u0627\u0631\u064e \u0644\u064e\u0641\u0650\u064a \u0646\u064e\u0639\u0650\u064a\u0645\u0656","translation":"\u06cc\u0642\u06cc\u0646\u0627\u064b \u0646\u06cc\u06a9 \u0644\u0648\u06af (\u062c\u0646\u062a \u06a9\u06d2 \u0639\u06cc\u0634 \u0648\u0622\u0631\u0627\u0645 \u0627\u0648\u0631) \u0646\u0639\u0645\u062a\u0648\u06ba \u0645\u06cc\u06ba \u06c1\u0648\u06ba \u06af\u06d2.","footnotes":""},{"id":"5843","sura":"82","aya":"14","arabic_text":"\u0648\u064e\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u06e1\u0641\u064f\u062c\u0651\u064e\u0627\u0631\u064e \u0644\u064e\u0641\u0650\u064a \u062c\u064e\u062d\u0650\u064a\u0645\u0656","translation":"\u0627\u0648\u0631 \u06cc\u0642\u06cc\u0646\u0627\u064b \u0628\u062f\u06a9\u0627\u0631 \u0644\u0648\u06af \u062f\u0648\u0632\u062e \u0645\u06cc\u06ba \u06c1\u0648\u06ba \u06af\u06d2.[1]","footnotes":"[1] \u062c\u0633 \u0637\u0631\u062d \u062f\u0648\u0633\u0631\u06d2 \u0645\u0642\u0627\u0645 \u067e\u0631 \u0641\u0631\u0645\u0627\u06cc\u0627\u060c \u0641\u064e\u0631\u0650\u064a\u0642\u064c \u0641\u0650\u064a \u0627\u0644\u0652\u062c\u064e\u0646\u0651\u064e\u0629\u0650 \u0648\u064e\u0641\u064e\u0631\u0650\u064a\u0642\u064c \u0641\u0650\u064a \u0627\u0644\u0633\u0651\u064e\u0639\u0650\u064a\u0631\u0650 (\u0627\u0644\u0634\u0648\u0631\u0649:7) \u06d4"},{"id":"5844","sura":"82","aya":"15","arabic_text":"\u064a\u064e\u0635\u06e1\u0644\u064e\u0648\u06e1\u0646\u064e\u0647\u064e\u0627 \u064a\u064e\u0648\u06e1\u0645\u064e \u0671\u0644\u062f\u0651\u0650\u064a\u0646\u0650","translation":"\u0628\u062f\u0644\u06d2 \u0648\u0627\u0644\u06d2 \u062f\u0646 \u0627\u0633 \u0645\u06cc\u06ba \u062c\u0627\u0626\u06cc\u06ba \u06af\u06d2.[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u062c\u0633 \u062c\u0632\u0627 \u0648\u0633\u0632\u0627 \u06a9\u06d2 \u062f\u0646 \u06a9\u0627 \u0648\u06c1 \u0627\u0646\u06a9\u0627\u0631 \u06a9\u0631\u062a\u06d2 \u062a\u06be\u06d2 \u0627\u0633\u06cc \u062f\u0646 \u062c\u06c1\u0646\u0645 \u0645\u06cc\u06ba \u0627\u067e\u0646\u06d2 \u0627\u0639\u0645\u0627\u0644 \u06a9\u06cc \u067e\u0627\u062f\u0627\u0634 \u0645\u06cc\u06ba \u062f\u0627\u062e\u0644 \u06c1\u0648\u06ba \u06af\u06d2\u06d4"},{"id":"5845","sura":"82","aya":"16","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0647\u064f\u0645\u06e1 \u0639\u064e\u0646\u06e1\u0647\u064e\u0627 \u0628\u0650\u063a\u064e\u0627\u0653\u0626\u0650\u0628\u0650\u064a\u0646\u064e","translation":"\u0648\u0647 \u0627\u0633 \u0633\u06d2 \u06a9\u0628\u06be\u06cc \u063a\u0627\u0626\u0628 \u0646\u06c1 \u06c1\u0648\u0646\u06d2 \u067e\u0627\u0626\u06cc\u06ba \u06af\u06d2.[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u06a9\u0628\u06be\u06cc \u0627\u0633 \u0633\u06d2 \u062c\u062f\u0627 \u0646\u06c1\u06cc\u06ba \u06c1\u0648\u06ba \u06af\u06d2 \u0627\u0648\u0631 \u0627\u0633 \u0633\u06d2 \u063a\u0627\u0626\u0628 \u0646\u06c1\u06cc\u06ba \u06c1\u0648\u06ba \u06af\u06d2\u06d4 \u0628\u0644\u06a9\u06c1 \u06c1\u0645\u06cc\u0634\u06c1 \u0627\u0633\u06cc \u0645\u06cc\u06ba \u0631\u06c1\u06cc\u06ba \u06af\u06d2\u06d4"},{"id":"5846","sura":"82","aya":"17","arabic_text":"\u0648\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u062f\u06e1\u0631\u064e\u0649\u0670\u0643\u064e \u0645\u064e\u0627 \u064a\u064e\u0648\u06e1\u0645\u064f \u0671\u0644\u062f\u0651\u0650\u064a\u0646\u0650","translation":"\u062a\u062c\u06be\u06d2 \u06a9\u0686\u06be \u062e\u0628\u0631 \u0628\u06be\u06cc \u06c1\u06d2 \u06a9\u06c1 \u0628\u062f\u0644\u06d2 \u06a9\u0627 \u062f\u0646 \u06a9\u06cc\u0627 \u06c1\u06d2.","footnotes":""},{"id":"5847","sura":"82","aya":"18","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0645\u064e\u0627\u0653 \u0623\u064e\u062f\u06e1\u0631\u064e\u0649\u0670\u0643\u064e \u0645\u064e\u0627 \u064a\u064e\u0648\u06e1\u0645\u064f \u0671\u0644\u062f\u0651\u0650\u064a\u0646\u0650","translation":"\u0645\u06cc\u06ba \u067e\u06be\u0631 (\u06a9\u06c1\u062a\u0627 \u06c1\u0648\u06ba \u06a9\u06c1) \u062a\u062c\u06be\u06d2 \u06a9\u06cc\u0627 \u0645\u0639\u0644\u0648\u0645 \u06a9\u06c1 \u062c\u0632\u0627 (\u0627\u0648\u0631 \u0633\u0632\u0627) \u06a9\u0627 \u062f\u0646 \u06a9\u06cc\u0627 \u06c1\u06d2.[1]","footnotes":"[1] \u062a\u06a9\u0631\u0627\u0631\u060c \u0627\u0633 \u06a9\u06cc \u0639\u0638\u0645\u062a \u0648\u0636\u062e\u0627\u0645\u062a \u0627\u0648\u0631 \u0627\u0633 \u062f\u0646 \u06a9\u06cc \u06c1\u0648\u0644\u0646\u0627\u06a9\u06cc\u0648\u06ba \u06a9\u06cc \u0648\u0636\u0627\u062d\u062a \u06a9\u06d2 \u0644\u0626\u06d2 \u06c1\u06d2\u06d4"},{"id":"5848","sura":"82","aya":"19","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u0644\u064e\u0627 \u062a\u064e\u0645\u06e1\u0644\u0650\u0643\u064f \u0646\u064e\u0641\u06e1\u0633\u065e \u0644\u0651\u0650\u0646\u064e\u0641\u06e1\u0633\u0656 \u0634\u064e\u064a\u06e1\u0640\u0654\u0657\u0627\u06d6 \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0645\u06e1\u0631\u064f \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u0651\u064e\u0647\u0650","translation":"(\u0648\u0647 \u06c1\u06d2) \u062c\u0633 \u062f\u0646 \u06a9\u0648\u0626\u06cc \u0634\u062e\u0635 \u06a9\u0633\u06cc \u0634\u062e\u0635 \u06a9\u06d2 \u0644\u0626\u06d2 \u06a9\u0633\u06cc \u0686\u06cc\u0632 \u06a9\u0627 \u0645\u062e\u062a\u0627\u0631 \u0646\u06c1 \u06c1\u0648\u06af\u0627\u060c \u0627\u0648\u0631 (\u062a\u0645\u0627\u0645 \u062a\u0631) \u0627\u062d\u06a9\u0627\u0645 \u0627\u0633 \u0631\u0648\u0632 \u0627\u0644\u0644\u06c1 \u06a9\u06d2 \u06c1\u06cc \u06c1\u0648\u06ba \u06af\u06d2.[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u062f\u0646\u06cc\u0627 \u0645\u06cc\u06ba \u062a\u0648 \u0627\u0644\u0644\u06c1 \u0646\u06d2 \u0639\u0627\u0631\u0636\u06cc \u0637\u0648\u0631 \u067e\u0631\u060c \u0622\u0632\u0645\u0627\u0646\u06d2 \u06a9\u06d2 \u0644\u0626\u06d2\u060c \u0627\u0646\u0633\u0627\u0646\u0648\u06ba \u06a9\u0648 \u06a9\u0645 \u0648\u0628\u06cc\u0634 \u06a9\u06d2 \u06a9\u0686\u06be \u0641\u0631\u0642 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0627\u062e\u062a\u06cc\u0627\u0631\u0627\u062a \u062f\u06d2 \u0631\u06a9\u06be\u06d2 \u06c1\u06cc\u06ba\u06d4 \u0644\u06cc\u06a9\u0646 \u0642\u06cc\u0627\u0645\u062a \u0648\u0627\u0644\u06d2\u062f\u0646 \u062a\u0645\u0627\u0645 \u0627\u062e\u062a\u06cc\u0627\u0631\u0627\u062a \u06a9\u0644\u06cc\u062a\u0627\u064b \u0635\u0631\u0641 \u0627\u0648\u0631 \u0635\u0631\u0641 \u0627\u0644\u0644\u06c1 \u06a9\u06d2\u067e\u0627\u0633 \u06c1\u0648\u06ba \u06af\u06d2\u06d4 \u062c\u06cc\u0633\u06d2 \u0641\u0631\u0645\u0627\u06cc\u0627 \u0644\u0650\u0645\u064e\u0646\u0650 \u0627\u0644\u0652\u0645\u064f\u0644\u0652\u0643\u064f \u0627\u0644\u0652\u064a\u064e\u0648\u0652\u0645\u064e \u0644\u0650\u0644\u0651\u064e\u0647\u0650 \u0627\u0644\u0652\u0648\u064e\u0627\u062d\u0650\u062f\u0650 \u0627\u0644\u0652\u0642\u064e\u0647\u0651\u064e\u0627\u0631\u0650 \u06d4 ( \u0633\u0648\u0631\u06c1\u0654 \u0645\u0624\u0645\u0646:16 ) \u0686\u0646\u0627\u0646\u0686\u06c1 \u0646\u0628\u06cc (\u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645) \u0646\u06d2 \u0627\u067e\u0646\u06cc \u067e\u06be\u0648\u067e\u06be\u06cc \u062d\u0636\u0631\u062a \u0635\u0641\u06cc\u06c1 (\u0631\u0636\u06cc \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0627) \u0627\u0648\u0631 \u0627\u067e\u0646\u06cc \u0635\u0627\u062d\u0628\u0632\u0627\u062f\u06cc \u062d\u0636\u0631\u062a \u0641\u0627\u0637\u0645\u06c1 (\u0631\u0636\u06cc \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0627) \u06a9\u0648 \u0641\u0631\u0645\u0627 \u062f\u06cc\u0627 \u062a\u06be\u0627\u060c \u201d\u0644\u0627 \u0623\u064e\u0645\u0652\u0644\u0650\u0643\u064f \u0644\u064e\u0643\u064f\u0645\u0652 \u0645\u0650\u0646\u064e \u0627\u0644\u0644\u0647\u0650 \u0634\u064e\u064a\u0652\u0626\u064b\u0627\u201c (\u0635\u062d\u064a\u062d \u0645\u0633\u0644\u0645\u060c \u0643\u062a\u0627\u0628 \u0627\u0644\u0625\u064a\u0645\u0627\u0646) \u0627\u0648\u0631 \u0628\u0646\u06cc \u06c1\u0627\u0634\u0645 \u0627\u0648\u0631 \u0628\u0646\u06cc \u0639\u0628\u062f\u0627\u0644\u0645\u0637\u0644\u0628 \u06a9\u0648 \u0628\u06be\u06cc \u0645\u062a\u0646\u0628\u06c1 \u0641\u0631\u0645\u0627 \u062f\u06cc\u0627\u060c \u201d\u0623\u064e\u0646\u0652\u0642\u0650\u0630\u064f\u0648\u0627 \u0623\u064e\u0646\u0652\u0641\u064f\u0633\u064e\u0643\u064f\u0645\u0652 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0631\u0650\u060c \u0648\u064e\u0627\u0644\u0644\u0647\u0650 \u0644\u0627 \u0623\u064e\u0645\u0652\u0644\u0650\u0643\u064f \u0644\u064e\u0643\u064f\u0645\u0652 \u0645\u0650\u0646\u064e \u0627\u0644\u0644\u0647\u0650 \u0634\u064e\u064a\u0652\u0626\u064b\u0627\u201c (\u0645\u0633\u0644\u0645 \u060c \u0643\u062a\u0627\u0628 \u0645\u0630\u0643\u0648\u0631 \u060c \u0628\u062e\u0627\u0631\u064a \u060c \u0633\u0648\u0631\u0629 \u0627\u0644\u0634\u0639\u0631\u0627\u0621 ) \u06d4"}]}