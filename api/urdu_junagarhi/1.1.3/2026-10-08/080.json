\u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u06d4"},{"id":"5771","sura":"80","aya":"13","arabic_text":"\u0641\u0650\u064a \u0635\u064f\u062d\u064f\u0641\u0656 \u0645\u0651\u064f\u0643\u064e\u0631\u0651\u064e\u0645\u064e\u0629\u0656","translation":"(\u06cc\u06c1 \u062a\u0648) \u067e\u0631 \u0639\u0638\u0645\u062a \u0635\u062d\u06cc\u0641\u0648\u06ba \u0645\u06cc\u06ba (\u06c1\u06d2).[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u0644\u0648\u062d \u0645\u062d\u0641\u0648\u0638 \u0645\u06cc\u06ba\u060c \u06a9\u06cc\u0648\u06ba \u06a9\u06c1 \u0648\u06c1\u06cc\u06ba \u0633\u06d2 \u06cc\u06c1 \u0642\u0631\u0622\u0646 \u0627\u062a\u0631\u062a\u0627 \u06c1\u06d2\u06d4 \u06cc\u0627 \u0645\u0637\u0644\u0628 \u06c1\u06d2 \u06a9\u06c1 \u06cc\u06c1 \u0635\u062d\u06cc\u0641\u06d2 \u0627\u0644\u0644\u06c1 \u06a9\u06d2 \u06c1\u0627\u06ba \u0628\u0691\u06d2\u0645\u062d\u062a\u0631\u0645 \u06c1\u06cc\u06ba \u06a9\u06cc\u0648\u06ba \u06a9\u06c1 \u0648\u06c1 \u0639\u0644\u0645 \u0648\u062d\u06a9\u0645\u062a \u0633\u06d2 \u067e\u0631 \u06c1\u06cc\u06ba\u06d4"},{"id":"5772","sura":"80","aya":"14","arabic_text":"\u0645\u0651\u064e\u0631\u06e1\u0641\u064f\u0648\u0639\u064e\u0629\u0656 \u0645\u0651\u064f\u0637\u064e\u0647\u0651\u064e\u0631\u064e\u0629\u0650\u06ed","translation":"\u062c\u0648 \u0628\u0644\u0646\u062f \u0648\u0628\u0627\ufefb \u0627\u0648\u0631 \u067e\u0627\u06a9 \u0635\u0627\u0641 \u06c1\u06d2.[1]","footnotes":"[1] \u0645\u064e\u0631\u0652\u0641\u064f\u0648\u0639\u064e\u0629\u064d \u0627\u0644\u0644\u06c1 \u06a9\u06d2 \u06c1\u0627\u06ba \u0631\u0641\u06cc\u0639 \u0627\u0644\u0642\u062f\u0631 \u06c1\u06cc\u06ba\u060c \u06cc\u0627 \u0634\u0628\u06c1\u0627\u062a \u0627\u0648\u0631 \u062a\u0646\u0627\u0642\u0636 \u0633\u06d2 \u0628\u0644\u0646\u062f \u06c1\u06cc\u06ba\u06d4 \u0645\u064f\u0637\u064e\u0647\u0651\u064e\u0631\u064e\u0629\u064d\u060c \u0648\u06c1 \u0628\u0627\u0644\u06a9\u0644 \u067e\u0627\u06a9 \u06c1\u06cc\u06ba \u06a9\u06cc\u0648\u06ba \u06a9\u06c1 \u0627\u0646\u06c1\u06cc\u06ba \u067e\u0627\u06a9 \u0644\u0648\u06af\u0648\u06ba ( \u0641\u0631\u0634\u062a\u0648\u06ba ) \u06a9\u06d2 \u0633\u0648\u0627 \u06a9\u0648\u0626\u06cc \u0686\u06be\u0648\u062a\u0627 \u06c1\u06cc \u0646\u06c1\u06cc\u06ba\u060c \u06cc\u0627 \u06a9\u0645\u06cc \u0628\u06cc\u0634\u06cc \u0633\u06d2 \u067e\u0627\u06a9 \u06c1\u06d2\u06d4"},{"id":"5773","sura":"80","aya":"15","arabic_text":"\u0628\u0650\u0623\u064e\u064a\u06e1\u062f\u0650\u064a \u0633\u064e\u0641\u064e\u0631\u064e\u0629\u0656","translation":"\u0627\u06cc\u0633\u06d2 \u0644\u06a9\u06be\u0646\u06d2 \u0648\u0627\u0644\u0648\u06ba \u06a9\u06d2 \u06c1\u0627\u062a\u06be\u0648\u06ba \u0645\u06cc\u06ba \u06c1\u06d2.[1]","footnotes":"[1] \u0633\u064e\u0641\u064e\u0631\u064e\u0629\u064d\u060c \u0633\u064e\u0627\u0641\u0650\u0631\u064c \u06a9\u06cc \u062c\u0645\u0639 \u06c1\u06d2\u060c \u06cc\u06c1 \u0633\u0641\u0627\u0631\u062a \u0633\u06d2 \u06c1\u06d2\u06d4 \u0645\u0631\u0627\u062f \u06cc\u06c1\u0627\u06ba \u0648\u06c1 \u0641\u0631\u0634\u062a\u06d2 \u06c1\u06cc\u06ba \u062c\u0648 \u0627\u0644\u0644\u06c1 \u06a9\u06cc \u0648\u062d\u06cc \u0627\u0633 \u06a9\u06d2\u0631\u0633\u0648\u0644\u0648\u06ba \u062a\u06a9 \u067e\u06c1\u0646\u0686\u0627\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u06cc\u0639\u0646\u06cc \u0627\u0644\u0644\u06c1 \u0627\u0648\u0631 \u0627\u0633 \u06a9\u06d2\u0631\u0633\u0648\u0644 \u06a9\u06d2 \u062f\u0631\u0645\u06cc\u0627\u0646 \u0633\u0641\u0627\u0631\u062a \u06a9\u0627 \u06a9\u0627\u0645 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u06cc\u06c1 \u0642\u0631\u0622\u0646 \u0627\u06cc\u0633\u06d2 \u0633\u0641\u06cc\u0631\u0648\u06ba \u06a9\u06d2 \u06c1\u0627\u062a\u06be\u0648\u06ba \u0645\u06cc\u06ba \u06c1\u06d2\u062c\u0648 \u0627\u0633\u06d2 \u0644\u0648\u062d \u0645\u062d\u0641\u0648\u0638 \u0633\u06d2 \u0646\u0642\u0644 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4"},{"id":"5774","sura":"80","aya":"16","arabic_text":"\u0643\u0650\u0631\u064e\u0627\u0645\u0650\u06ed \u0628\u064e\u0631\u064e\u0631\u064e\u0629\u0656","translation":"\u062c\u0648 \u0628\u0632\u0631\u06af \u0627\u0648\u0631 \u067e\u0627\u06a9\u0628\u0627\u0632 \u06c1\u06cc\u06ba.[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u062e\u0644\u0642 \u06a9\u06d2 \u0627\u0639\u062a\u0628\u0627\u0631 \u0633\u06d2 \u0648\u06c1 \u06a9\u0631\u06cc\u0645 \u06cc\u0639\u0646\u06cc \u0634\u0631\u06cc\u0641 \u0627\u0648\u0631 \u0628\u0632\u0631\u06af \u06c1\u06cc\u06ba \u0627\u0648\u0631 \u0627\u0641\u0639\u0627\u0644 \u06a9\u06d2 \u0627\u0639\u062a\u0628\u0627\u0631 \u0633\u06d2 \u0648\u06c1 \u0646\u06cc\u06a9\u0648 \u06a9\u0627\u0631 \u0627\u0648\u0631 \u067e\u0627\u06a9\u0628\u0627\u0632 \u06c1\u06cc\u06ba\u06d4 \u06cc\u06c1\u0627\u06ba \u0633\u06d2 \u06cc\u06c1 \u0628\u0627\u062a \u0645\u0639\u0644\u0648\u0645 \u06c1\u0648\u0626\u06cc \u06a9\u06c1 \u062d\u0627\u0645\u0644 \u0642\u0631\u0622\u0646 ( \u062d\u0627\u0641\u0638 \u0627\u0648\u0631 \u0639\u0627\u0644\u0645 ) \u06a9\u0648 \u0628\u06be\u06cc \u0627\u062e\u0644\u0627\u0642 \u0648\u06a9\u0631\u062f\u0627\u0631 \u0627\u0648\u0631 \u0627\u0641\u0639\u0627\u0644 \u0648\u0627\u0637\u0648\u0627\u0631 \u0645\u06cc\u06ba \u0643\u0650\u0631\u064e\u0627\u0645\u064d \u0628\u064e\u0631\u064e\u0631\u064e\u0629\u064d \u06a9\u0627 \u0645\u0635\u062f\u0627\u0642 \u06c1\u0648\u0646\u0627 \u0686\u0627\u06c1\u0626\u06d2\u06d4 (\u0627\u0628\u0646 \u06a9\u062b\u06cc\u0631) \u062d\u062f\u06cc\u062b \u0645\u06cc\u06ba \u0628\u06be\u06cc \u0633\u064e\u0641\u064e\u0631\u064e\u0629\u064d \u06a9\u0627 \u0644\u0641\u0638 \u0641\u0631\u0634\u062a\u0648\u06ba \u06a9\u06d2 \u0644\u0626\u06d2 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06c1\u0648\u0627 \u06c1\u06d2\u06d4 \u0646\u0628\u06cc (\u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645) \u0646\u06d2 \u0641\u0631\u0645\u0627\u06cc\u0627 \u062c\u0648 \u0642\u0631\u0622\u0646 \u067e\u0691\u06be\u062a\u0627 \u06c1\u06d2 \u0627\u0648\u0631 \u0648\u06c1 \u0627\u0633 \u06a9\u0627 \u0645\u0627\u06c1\u0631 \u06c1\u06d2\u060c \u0648\u06c1 \u0627\u0644\u0633\u0651\u064e\u0641\u064e\u0631\u064e\u0629\u064f \u0627\u0644\u0643\u0650\u0631\u064e\u0627\u0645\u064f \u0627\u0644\u0652\u0628\u064e\u0631\u064e\u0631\u064e\u0629\u064f ( \u0641\u0631\u0634\u062a\u0648\u06ba ) \u06a9\u06d2 \u0633\u0627\u062a\u06be \u06c1\u0648\u06af\u0627 \u0627\u0648\u0631 \u062c\u0648 \u0642\u0631\u0622\u0646 \u067e\u0691\u06be\u062a\u0627 \u06c1\u06d2\u060c \u0644\u06cc\u06a9\u0646 \u0645\u0634\u0642\u062a \u06a9\u06d2\u0633\u0627\u062a\u06be\u06d4 ( \u06cc\u0639\u0646\u06cc \u0645\u0627\u06c1\u0631\u06cc\u0646 \u06a9\u06cc \u0637\u0631\u062d \u0633\u06c1\u0648\u0644\u062a \u0627\u0648\u0631 \u0631\u0648\u0627\u0646\u06cc \u0633\u06d2\u0646\u06c1\u06cc\u06ba \u067e\u0691\u06be\u062a\u0627 ) \u0627\u0633 \u06a9\u06d2 \u0644\u0626\u06d2 \u062f\u0648\u06af\u0646\u0627 \u0627\u062c\u0631 \u06c1\u06d2\u06d4 (\u0635\u062d\u064a\u062d \u0628\u062e\u0627\u0631\u064a\u060c \u062a\u0641\u0633\u064a\u0631 \u0633\u0648\u0631\u0629 \u0639\u0628\u0633 \u0645\u0633\u0644\u0645\u060c \u0643\u062a\u0627\u0628 \u0627\u0644\u0635\u0644\u0627\u0629\u060c \u0628\u0627\u0628 \u0641\u0636\u0644 \u0627\u0644\u0645\u0627\u0647\u0631 \u0628\u0627\u0644\u0642\u0631\u0622\u0646....)\u06d4"},{"id":"5775","sura":"80","aya":"17","arabic_text":"\u0642\u064f\u062a\u0650\u0644\u064e \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u0645\u064e\u0627\u0653 \u0623\u064e\u0643\u06e1\u0641\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"\u0627\u0644\u0644\u06c1 \u06a9\u06cc \u0645\u0627\u0631 \u0627\u0646\u0633\u0627\u0646 \u067e\u0631 \u06a9\u06cc\u0633\u0627 \u0646\u0627\u0634\u06a9\u0631\u0627 \u06c1\u06d2.[1]","footnotes":"[1] \u0627\u0633 \u0633\u06d2 \u0648\u06c1 \u0627\u0646\u0633\u0627\u0646 \u0645\u0631\u0627\u062f \u06c1\u06d2 \u062c\u0648 \u0628\u063a\u06cc\u0631 \u06a9\u0633\u06cc \u0633\u0646\u062f \u0627\u0648\u0631 \u062f\u0644\u06cc\u0644 \u06a9\u06d2 \u0642\u06cc\u0627\u0645\u062a \u06a9\u06cc \u062a\u06a9\u0630\u06cc\u0628 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u06d4 \u0642\u064f\u062a\u0650\u0644\u064e \u0628\u0645\u0639\u0646\u06cc \u0644\u064f\u0639\u0650\u0646\u064e \u0627\u0648\u0631 \u0645\u064e\u0627 \u0623\u064e\u0643\u0652\u0641\u064e\u0631\u064e\u0647\u064f ! \u0641\u0639\u0644 \u062a\u0639\u062c\u0628 \u06c1\u06d2\u060c \u06a9\u0633 \u0642\u062f\u0631 \u0646\u0627\u0634\u06a9\u0631\u0627 \u06c1\u06d2\u06d4 \u0622\u06af\u06d2 \u0627\u0633 \u0627\u0646\u0633\u0627\u0646 \u06a9\u0641\u0648\u0631 \u06a9\u0648 \u063a\u0648\u0631 \u0648\u0641\u06a9\u0631 \u06a9\u06cc \u062f\u0639\u0648\u062a \u062f\u06cc \u062c\u0627 \u0631\u06c1\u06cc \u06c1\u06d2 \u06a9\u06c1 \u0634\u0627\u06cc\u062f \u0648\u06c1 \u0627\u067e\u0646\u06d2 \u06a9\u0641\u0631 \u0633\u06d2 \u0628\u0627\u0632 \u0622\u062c\u0627\u0626\u06d2\u06d4"},{"id":"5776","sura":"80","aya":"18","arabic_text":"\u0645\u0650\u0646\u06e1 \u0623\u064e\u064a\u0651\u0650 \u0634\u064e\u064a\u06e1\u0621\u064d \u062e\u064e\u0644\u064e\u0642\u064e\u0647\u064f\u06e5","translation":"\u0627\u0633\u06d2 \u0627\u0644\u0644\u06c1 \u0646\u06d2 \u06a9\u0633 \u0686\u06cc\u0632 \u0633\u06d2 \u067e\u06cc\u062f\u0627 \u06a9\u06cc\u0627.","footnotes":""},{"id":"5777","sura":"80","aya":"19","arabic_text":"\u0645\u0650\u0646 \u0646\u0651\u064f\u0637\u06e1\u0641\u064e\u0629\u064d \u062e\u064e\u0644\u064e\u0642\u064e\u0647\u064f\u06e5 \u0641\u064e\u0642\u064e\u062f\u0651\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"\u0627\u0633\u06d2) \u0627\u06cc\u06a9 \u0646\u0637\u0641\u06c1[1] \u0633\u06d2 \u067e\u06cc\u062f\u0627 \u06a9\u06cc\u0627\u060c\u067e\u06be\u0631\u0627\u0633 \u06a9\u0627 \u0627\u0646\u062f\u0627\u0632\u06c1 \u0645\u0642\u0631\u0631\u06a9\u06cc\u0627 .[2]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u062c\u0633 \u06a9\u06cc \u067e\u06cc\u062f\u0627\u0626\u0634 \u0627\u06cc\u0633\u06d2 \u062d\u0642\u06cc\u0631 \u0642\u0637\u0631\u06c1\u0654 \u0622\u0628 \u0633\u06d2 \u06c1\u0648\u0626\u06cc \u06c1\u06d2\u060c \u06a9\u06cc\u0627 \u0627\u0633\u06d2 \u062a\u06a9\u0628\u0631 \u0632\u06cc\u0628 \u062f\u06cc\u062a\u0627 \u06c1\u06d2\u061f\n[2] \u0627\u0633 \u06a9\u0627 \u0645\u0637\u0644\u0628 \u06c1\u06d2 \u06a9\u06c1 \u0627\u0633 \u06a9\u06d2 \u0645\u0635\u0627\u0644\u062d \u0646\u0641\u0633 \u0627\u0633\u06d2 \u0645\u06c1\u06cc\u0627 \u06a9\u06cc\u06d2\u060c \u0627\u0633 \u06a9\u0648 \u062f\u0648 \u06c1\u0627\u062a\u06be \u062f\u0648 \u067e\u06cc\u0631 \u0627\u0648\u0631\u062f\u0648 \u0622\u0646\u06a9\u06be\u06cc\u06ba \u0627\u0648\u0631 \u062f\u06cc\u06af\u0631 \u0622\u0644\u0627\u062a \u0648\u062e\u0648\u0627\u0635 \u0639\u0637\u0627 \u06a9\u06cc\u06d2\u06d4"},{"id":"5778","sura":"80","aya":"20","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0671\u0644\u0633\u0651\u064e\u0628\u0650\u064a\u0644\u064e \u064a\u064e\u0633\u0651\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"\u067e\u06be\u0631 \u0627\u0633 \u06a9\u06d2 \u0644\u0626\u06d2 \u0631\u0627\u0633\u062a\u06c1 \u0622\u0633\u0627\u0646 \u06a9\u06cc\u0627.[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u062e\u06cc\u0631 \u0627\u0648\u0631 \u0634\u0631 \u06a9\u06d2 \u0631\u0627\u0633\u062a\u06d2 \u0627\u0633 \u06a9\u06d2 \u0644\u0626\u06d2 \u0648\u0627\u0636\u062d \u06a9\u0631 \u062f\u06cc\u0626\u06d2\u06d4 \u0628\u0639\u0636 \u06a9\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba \u0627\u0633 \u0633\u06d2 \u0645\u0631\u0627\u062f \u0645\u0627\u06ba \u06a9\u06d2 \u067e\u06cc\u0679 \u0633\u06d2 \u0646\u06a9\u0644\u0646\u06d2 \u06a9\u0627 \u0631\u0627\u0633\u062a\u06c1 \u06c1\u06d2\u06d4 \u0644\u06cc\u06a9\u0646 \u067e\u06c1\u0644\u0627 \u0645\u0641\u06c1\u0648\u0645 \u0632\u06cc\u0627\u062f\u06c1 \u0635\u062d\u06cc\u062d \u06c1\u06d2\u06d4"},{"id":"5779","sura":"80","aya":"21","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0623\u064e\u0645\u064e\u0627\u062a\u064e\u0647\u064f\u06e5 \u0641\u064e\u0623\u064e\u0642\u06e1\u0628\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"\u067e\u06be\u0631 \u0627\u0633\u06d2 \u0645\u0648\u062a \u062f\u06cc \u0627\u0648\u0631 \u067e\u06be\u0631 \u0642\u0628\u0631 \u0645\u06cc\u06ba \u062f\u0641\u0646 \u06a9\u06cc\u0627.","footnotes":""},{"id":"5780","sura":"80","aya":"22","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0625\u0650\u0630\u064e\u0627 \u0634\u064e\u0627\u0653\u0621\u064e \u0623\u064e\u0646\u0634\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"\u067e\u06be\u0631 \u062c\u0628 \u0686\u0627\u06c1\u06d2 \u06af\u0627 \u0627\u0633\u06d2 \u0632\u0646\u062f\u0647 \u06a9\u0631 \u062f\u06d2 \u06af\u0627\u06d4","footnotes":""},{"id":"5781","sura":"80","aya":"23","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627 \u0644\u064e\u0645\u0651\u064e\u0627 \u064a\u064e\u0642\u06e1\u0636\u0650 \u0645\u064e\u0627\u0653 \u0623\u064e\u0645\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"\u06c1\u0631\u06af\u0632 \u0646\u06c1\u06cc\u06ba[1] \u06d4 \u0627\u0633 \u0646\u06d2 \u0627\u0628 \u062a\u06a9 \u0627\u0644\u0644\u06c1 \u06a9\u06d2 \u062d\u06a9\u0645 \u06a9\u06cc \u0628\u062c\u0627 \u0622\u0648\u0631\u06cc \u0646\u06c1\u06cc\u06ba \u06a9\u06cc.","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u0645\u0639\u0627\u0645\u0644\u06c1 \u0627\u0633 \u0637\u0631\u062d \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u2018 \u062c\u0633 \u0637\u0631\u062d \u06cc\u06c1 \u06a9\u0627\u0641\u0631 \u06a9\u06c1\u062a\u0627 \u06c1\u06d2\u06d4"},{"id":"5782","sura":"80","aya":"24","arabic_text":"\u0641\u064e\u0644\u06e1\u064a\u064e\u0646\u0638\u064f\u0631\u0650 \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u0625\u0650\u0644\u064e\u0649\u0670 \u0637\u064e\u0639\u064e\u0627\u0645\u0650\u0647\u0650\u06e6\u0653","translation":"\u0627\u0646\u0633\u0627\u0646 \u06a9\u0648 \u0686\u0627\u06c1\u0626\u06d2 \u06a9\u06c1 \u0627\u067e\u0646\u06d2 \u06a9\u06be\u0627\u0646\u06d2 \u06a9\u0648 \u062f\u06cc\u06a9\u06be\u06d2.[1]","footnotes":"[1] \u06a9\u06c1 \u0627\u0633\u06d2 \u0627\u0644\u0644\u06c1 \u0646\u06d2 \u06a9\u0633 \u0637\u0631\u062d \u067e\u06cc\u062f\u0627 \u06a9\u06cc\u0627\u060c \u062c\u0648 \u0627\u0633 \u06a9\u06cc \u0632\u0646\u062f\u06af\u06cc \u06a9\u0627 \u0633\u0628\u0628 \u06c1\u06d2 \u0627\u0648\u0631 \u06a9\u0633 \u0637\u0631\u062d \u0627\u0633 \u06a9\u06d2 \u0644\u0626\u06d2 \u0627\u0633\u0628\u0627\u0628 \u0645\u0639\u0627\u0634 \u0645\u06c1\u06cc\u0627 \u06a9\u0626\u06d2 \u062a\u0627\u06a9\u06c1 \u0648\u06c1 \u0627\u0646 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0633\u06d2 \u0633\u0639\u0627\u062f\u062a \u0627\u062e\u0631\u0648\u06cc \u062d\u0627\u0635\u0644 \u06a9\u0631 \u0633\u06a9\u06d2\u06d4"},{"id":"5783","sura":"80","aya":"25","arabic_text":"\u0623\u064e\u0646\u0651\u064e\u0627 \u0635\u064e\u0628\u064e\u0628\u06e1\u0646\u064e\u0627 \u0671\u0644\u06e1\u0645\u064e\u0627\u0653\u0621\u064e \u0635\u064e\u0628\u0651\u0657\u0627","translation":"\u06a9\u06c1 \u06c1\u0645 \u0646\u06d2 \u062e\u0648\u0628 \u067e\u0627\u0646\u06cc \u0628\u0631\u0633\u0627\u06cc\u0627.","footnotes":""},{"id":"5784","sura":"80","aya":"26","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0634\u064e\u0642\u064e\u0642\u06e1\u0646\u064e\u0627 \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u064e \u0634\u064e\u0642\u0651\u0657\u0627","translation":"\u067e\u06be\u0631 \u067e\u06be\u0627\u0691\u0627 \u0632\u0645\u06cc\u0646 \u06a9\u0648 \u0627\u0686\u06be\u06cc \u0637\u0631\u062d.","footnotes":""},{"id":"5785","sura":"80","aya":"27","arabic_text":"\u0641\u064e\u0623\u064e\u0646\u06e2\u0628\u064e\u062a\u06e1\u0646\u064e\u0627 \u0641\u0650\u064a\u0647\u064e\u0627 \u062d\u064e\u0628\u0651\u0657\u0627","translation":"\u067e\u06be\u0631 \u0627\u0633 \u0645\u06cc\u06ba \u0633\u06d2 \u0627\u0646\u0627\u062c \u0627\u06af\u0627\u0626\u06d2.","footnotes":""},{"id":"5786","sura":"80","aya":"28","arabic_text":"\u0648\u064e\u0639\u0650\u0646\u064e\u0628\u0657\u0627 \u0648\u064e\u0642\u064e\u0636\u06e1\u0628\u0657\u0627","translation":"\u0627\u0648\u0631 \u0627\u0646\u06af\u0648\u0631 \u0627\u0648\u0631 \u062a\u0631\u06a9\