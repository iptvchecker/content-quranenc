u06d2 \u06c1\u0627\u06ba \u06a9\u0648\u0626\u06cc \u0627\u06c1\u0645\u06cc\u062a \u0627\u0648\u0631 \u062e\u0627\u0635 \u0648\u0632\u0646 \u06c1\u0648\u06af\u0627\u06d4 ( \u0641\u062a\u062d \u0627\u0644\u0642\u062f\u06cc\u0631 ) \u0644\u06cc\u06a9\u0646 \u067e\u06c1\u0644\u0627 \u0645\u0641\u06c1\u0648\u0645 \u06c1\u06cc \u0631\u0627\u062c\u062d \u0627\u0648\u0631 \u0635\u062d\u06cc\u062d \u06c1\u06d2\u06d4 \u0645\u0637\u0644\u0628 \u06cc\u06c1 \u06c1\u06d2 \u06a9\u06c1 \u062c\u0646 \u06a9\u06cc \u0646\u06cc\u06a9\u06cc\u0627\u06ba \u0632\u06cc\u0627\u062f\u06c1 \u06c1\u0648\u06ba \u06af\u06cc \u0627\u0648\u0631 \u0648\u0632\u0646 \u0627\u0639\u0645\u0627\u0644 \u06a9\u06d2 \u0648\u0642\u062a \u0627\u0646 \u06a9\u06cc \u0646\u06cc\u06a9\u06cc\u0648\u06ba \u0648\u0627\u0644\u0627 \u067e\u0644\u0691\u0627 \u0628\u06be\u0627\u0631\u06cc \u06c1\u0648 \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4"},{"id":"6164","sura":"101","aya":"7","arabic_text":"\u0641\u064e\u0647\u064f\u0648\u064e \u0641\u0650\u064a \u0639\u0650\u064a\u0634\u064e\u0629\u0656 \u0631\u0651\u064e\u0627\u0636\u0650\u064a\u064e\u0629\u0656","translation":"\u0648\u0647 \u062a\u0648 \u062f\u0644 \u067e\u0633\u0646\u062f \u0622\u0631\u0627\u0645 \u06a9\u06cc \u0632\u0646\u062f\u06af\u06cc \u0645\u06cc\u06ba \u06c1\u0648\u06af\u0627.[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u0627\u06cc\u0633\u06cc \u0632\u0646\u062f\u06af\u06cc\u060c \u062c\u0633 \u06a9\u0648 \u0648\u06c1 \u0635\u0627\u062d\u0628 \u0632\u0646\u062f\u06af\u06cc \u067e\u0633\u0646\u062f \u06a9\u0631\u06d2 \u06af\u0627\u06d4"},{"id":"6165","sura":"101","aya":"8","arabic_text":"\u0648\u064e\u0623\u064e\u0645\u0651\u064e\u0627 \u0645\u064e\u0646\u06e1 \u062e\u064e\u0641\u0651\u064e\u062a\u06e1 \u0645\u064e\u0648\u064e\u0670\u0632\u0650\u064a\u0646\u064f\u0647\u064f\u06e5","translation":"\u0627\u0648\u0631 \u062c\u0633 \u06a9\u06d2 \u067e\u0644\u0691\u06d2 \u06c1\u0644\u06a9\u06d2 \u06c1\u0648\u06ba \u06af\u06d2.[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u062c\u0633 \u06a9\u06cc \u0628\u0631\u0627\u0626\u06cc\u0627\u06ba \u0646\u06cc\u06a9\u06cc\u0648\u06ba \u067e\u0631 \u063a\u0627\u0644\u0628 \u06c1\u0648\u06ba \u06af\u06cc\u060c \u0627\u0648\u0631 \u0628\u0631\u0627\u0626\u06cc\u0648\u06ba \u06a9\u0627 \u067e\u0644\u0691\u0627 \u0628\u06be\u0627\u0631\u06cc \u0627\u0648\u0631 \u0646\u06cc\u06a9\u06cc\u0648\u06ba \u06a9\u0627 \u06c1\u0644\u06a9\u0627 \u06c1\u0648\u06af\u0627\u06d4"},{"id":"6166","sura":"101","aya":"9","arabic_text":"\u0641\u064e\u0623\u064f\u0645\u0651\u064f\u0647\u064f\u06e5 \u0647\u064e\u0627\u0648\u0650\u064a\u064e\u0629\u065e","translation":"\u0627\u0633 \u06a9\u0627 \u0679\u06be\u06a9\u0627\u0646\u0627 \u06c1\u0627\u0648\u06cc\u06c1 \u06c1\u06d2.[1]","footnotes":"[1] \u0647\u064e\u0627\u0648\u0650\u064a\u064e\u0629\u064c \u062c\u06c1\u0646\u0645 \u06a9\u0627 \u0646\u0627\u0645 \u06c1\u06d2\u060c \u0627\u0633 \u06a9\u0648 \u06c1\u0627\u0648\u06cc\u06c1 \u0627\u0633 \u0644\u0626\u06d2 \u06a9\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 \u062c\u06c1\u0646\u0645\u06cc \u0627\u0633 \u06a9\u06cc \u06af\u06c1\u0631\u0627\u0626\u06cc \u0645\u06cc\u06ba \u06af\u0631\u06d2 \u06af\u0627\u06d4 \u0627\u0648\u0631 \u0627\u0633 \u06a9\u0648 \u0627\u0645 ( \u0645\u0627\u06ba ) \u0633\u06d2 \u0627\u0633 \u0644\u0626\u06d2 \u062a\u0639\u0628\u06cc\u0631 \u06a9\u06cc\u0627 \u06a9\u06c1 \u062c\u0633 \u0637\u0631\u062d \u0627\u0646\u0633\u0627\u0646 \u06a9\u06d2 \u0644\u0626\u06d2 \u0645\u0627\u06ba\u060c \u062c\u0627\u0626\u06d2\u067e\u0646\u0627\u06c1 \u06c1\u0648\u062a\u06cc \u06c1\u06d2 \u0627\u0633\u06cc \u0637\u0631\u062d \u062c\u06c1\u0646\u0645\u06cc\u0648\u06ba \u06a9\u0627 \u0679\u06be\u06a9\u0627\u0646\u06c1 \u062c\u06c1\u0646\u0645 \u06c1\u0648\u06af\u0627\u06d4 \u0628\u0639\u0636 \u06a9\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 \u0627\u0645 \u06a9\u06d2 \u0645\u0639\u0646\u06cc \u062f\u0645\u0627\u063a \u06a9\u06d2 \u06c1\u06cc\u06ba\u06d4 \u062c\u06c1\u0646\u0645\u06cc\u060c \u062c\u06c1\u0646\u0645 \u0645\u06cc\u06ba \u0633\u0631 \u06a9\u06d2 \u0628\u0644 \u0688\u0627\u0644\u06d2 \u062c\u0627\u0626\u06cc\u06ba \u06af\u06d2\u06d4 ( \u0627\u0628\u0646 \u06a9\u062b\u06cc\u0631 ) \u06d4"},{"id":"6167","sura":"101","aya":"10","arabic_text":"\u0648\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u062f\u06e1\u0631\u064e\u0649\u0670\u0643\u064e \u0645\u064e\u0627 \u0647\u0650\u064a\u064e\u0647\u06e1","translation":"\u062a\u062c\u06be\u06d2 \u06a9\u06cc\u0627 \u0645\u0639\u0644\u0648\u0645 \u06a9\u06c1 \u0648\u0647 \u06a9\u06cc\u0627 \u06c1\u06d2.[1]","footnotes":"[1] \u06cc\u06c1 \u0627\u0633\u062a\u0641\u06c1\u0627\u0645 \u0627\u0633 \u06a9\u06cc \u06c1\u0648\u0644\u0646\u0627\u06a9\u06cc \u0627\u0648\u0631 \u0634\u062f\u062a \u0639\u0630\u0627\u0628 \u06a9\u0648 \u0628\u06cc\u0627\u0646 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u0626\u06d2 \u06c1\u06d2 \u06a9\u06c1 \u0648\u06c1 \u0627\u0646\u0633\u0627\u0646 \u06a9\u06d2 \u0648\u06c1\u0645 \u0648\u062a\u0635\u0648\u0631 \u0633\u06d2 \u0628\u0627\u0644\u0627 \u06c1\u06d2\u060c \u0627\u0646\u0633\u0627\u0646\u06cc \u0639\u0644\u0648\u0645 \u0627\u0633 \u06a9\u0627 \u0627\u062d\u0627\u0637\u06c1 \u0646\u06c1\u06cc\u06ba \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u0627\u0648\u0631 \u0627\u0633 \u06a9\u06cc \u06a9\u0646\u06c1 \u0646\u06c1\u06cc\u06ba \u062c\u0627\u0646 \u0633\u06a9\u062a\u06d2\u06d4"},{"id":"6168","sura":"101","aya":"11","arabic_text":"\u0646\u064e\u0627\u0631\u064c \u062d\u064e\u0627\u0645\u0650\u064a\u064e\u0629\u064f\u06e2","translation":"\u0648\u0647 \u062a\u0646\u062f \u0648\u062a\u06cc\u0632 \u0622\u06af (\u06c1\u06d2).[1]","footnotes":"[1] \u062c\u0633 \u0637\u0631\u062d \u062d\u062f\u06cc\u062b \u0645\u06cc\u06ba \u06c1\u06d2 \u06a9\u06c1 \u0627\u0646\u0633\u0627\u0646 \u062f\u0646\u06cc\u0627\u0645\u06cc\u06ba \u062c\u0648 \u0622\u06af \u062c\u0644\u0627\u062a\u0627 \u06c1\u06d2\u060c \u06cc\u06c1 \u062c\u06c1\u0646\u0645 \u06a9\u06cc \u0622\u06af \u06a9\u0627 \u0633\u062a\u0631 \u0648\u0627\u06ba \u062d\u0635\u06c1 \u06c1\u06d2\u060c \u062c\u06c1\u0646\u0645 \u06a9\u06cc \u0627\u06af \u062f\u0646\u06cc\u0627 \u06a9\u06cc \u0622\u06af \u0633\u06d2 69 \u062f\u0631\u062c\u06c1 \u0632\u06cc\u0627\u062f\u06c1 \u06c1\u06d2\u06d4 (\u0635\u062d\u064a\u062d \u0628\u062e\u0627\u0631\u064a\u060c \u0643\u062a\u0627\u0628 \u0628\u062f\u0621 \u0627\u0644\u062e\u0644\u0642 \u060c \u0628\u0627\u0628 \u0635\u0641\u0629 \u0627\u0644\u0646\u0627\u0631 \u0648\u0623\u0646\u0647\u0627 \u0645\u062e\u0644\u0648\u0642\u0629 \u060c \u0645\u0633\u0644\u0645 \u0643\u062a\u0627\u0628 \u0627\u0644\u062c\u0646\u0629\u060c \u0628\u0627\u0628 \u0641\u064a \u0634\u062f\u0629 \u062d\u0631 \u0646\u0627\u0631 \u062c\u0647\u0646\u0645 ) \u0627\u06cc\u06a9 \u0627\u0648\u0631 \u062d\u062f\u06cc\u062b \u0645\u06cc\u06ba \u06c1\u06d2 \u06a9\u06c1 ( \u0622\u06af \u0646\u06d2 \u0627\u067e\u0646\u06d2 \u0631\u0628 \u0633\u06d2 \u0634\u06a9\u0627\u06cc\u062a \u06a9\u06cc \u06a9\u06c1 \u0645\u06cc\u0631\u0627 \u0627\u06cc\u06a9 \u062d\u0635\u06c1 \u062f\u0648\u0633\u0631\u06d2 \u062d\u0635\u06d2 \u06a9\u0648 \u06a9\u06be\u0627\u0626\u06d2 \u062c\u0627 \u0631\u06c1\u0627 \u06c1\u06d2\u060c \u0627\u0644\u0644\u06c1 \u062a\u0639\u0627\u0644\u06cc\u0670 \u0646\u06d2 \u0627\u0633\u06d2 \u062f\u0648 \u0633\u0627\u0646\u0633 \u0644\u06cc\u0646\u06d2 \u06a9\u06cc \u0627\u062c\u0627\u0632\u062a \u0641\u0631\u0645\u0627 \u062f\u06cc\u06d4 \u0627\u06cc\u06a9 \u0633\u0627\u0646\u0633 \u06af\u0631\u0645\u06cc \u0627\u0648\u0631 \u0627\u06cc\u06a9 \u0633\u0627\u0646\u0633 \u0633\u0631\u062f\u06cc \u0645\u06cc\u06ba \u067e\u0633 \u062c\u0648 \u0633\u062e\u062a \u0633\u0631\u062f\u06cc \u06c1\u0648\u062a\u06cc \u06c1\u06d2 \u06cc\u06c1 \u0627\u0633 \u06a9\u0627 \u0679\u06be\u0646\u0688\u0627 \u0633\u0627\u0646\u0633 \u06c1\u06d2\u06d4 \u0627\u0648\u0631 \u0646\u06c1\u0627\u06cc\u062a \u0633\u062e\u062a \u06af\u0631\u0645\u06cc \u062c\u0648 \u067e\u0691\u062a\u06cc \u06c1\u06d2\u060c \u0648\u06c1 \u062c\u06c1\u0646\u0645 \u06a9\u0627 \u06af\u0631\u0645 \u0633\u0627\u0646\u0633 \u06c1\u06d2)\u06d4 (\u0628\u062e\u0627\u0631\u06cc\u060c \u06a9\u062a\u0627\u0628 \u0648\u0628\u0627\u0628 \u0645\u0630\u06a9\u0648\u0631) \u0627\u06cc\u06a9 \u0627\u0648\u0631 \u062d\u062f\u06cc\u062b \u0645\u06cc\u06ba \u0646\u0628\u06cc (\u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645) \u0646\u06d2 \u0641\u0631\u0645\u0627\u06cc\u0627 \u201d\u062c\u0628 \u06af\u0631\u0645\u06cc \u0632\u06cc\u0627\u062f\u06c1 \u0633\u062e\u062a \u06c1\u0648 \u062a\u0648 \u0646\u0645\u0627\u0632 \u0679\u06be\u0646\u0688\u06cc \u06a9\u0631\u06a9\u06d2 \u067e\u0691\u06be\u0648\u060c \u0627\u0633 \u0644\u0626\u06d2 \u06a9\u06c1 \u06af\u0631\u0645\u06cc \u06a9\u06cc \u0634\u062f\u062a \u062c\u06c1\u0646\u0645 \u06a9\u06d2 \u062c\u0648\u0634 \u06a9\u06cc \u0648\u062c\u06c1 \u0633\u06d2 \u06c1\u06d2\u201c\u06d4 (\u062d\u0648\u0627\u0644\u06c1 \u0645\u0630\u06a9\u0648\u0631\u060c \u0645\u0633\u0644\u0645\u060c \u06a9\u062a\u0627\u0628 \u0627\u0644\u0645\u0633\u0627\u062c\u062f ) \u06d4"}]}