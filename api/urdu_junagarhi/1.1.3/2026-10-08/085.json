\u0631 \u0645\u0633\u0644\u0645\u0627\u0646\u0648\u06ba \u06a9\u06d2 \u0633\u0627\u062a\u06be \u062c\u0648 \u06a9\u0631 \u0631\u06c1\u06d2 \u062a\u06be\u06d2 \u0627\u0633 \u06a9\u0648 \u0627\u067e\u0646\u06d2 \u0633\u0627\u0645\u0646\u06d2 \u062f\u06cc\u06a9\u06be \u0631\u06c1\u06d2 \u062a\u06be\u06d2.","footnotes":""},{"id":"5917","sura":"85","aya":"8","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0646\u064e\u0642\u064e\u0645\u064f\u0648\u0627\u0652 \u0645\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0625\u0650\u0644\u0651\u064e\u0627\u0653 \u0623\u064e\u0646 \u064a\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0627\u0652 \u0628\u0650\u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u06e1\u0639\u064e\u0632\u0650\u064a\u0632\u0650 \u0671\u0644\u06e1\u062d\u064e\u0645\u0650\u064a\u062f\u0650","translation":"\u06cc\u06c1 \u0644\u0648\u06af \u0627\u0646 \u0645\u0633\u0644\u0645\u0627\u0646\u0648\u06ba (\u06a9\u06d2 \u06a9\u0633\u06cc \u0627\u0648\u0631 \u06af\u0646\u0627\u0647 \u06a9\u0627) \u0628\u062f\u0644\u06c1 \u0646\u06c1\u06cc\u06ba \u0644\u06d2 \u0631\u06c1\u06d2 \u062a\u06be\u06d2\u060c \u0633\u0648\u0627\u0626\u06d2 \u0627\u0633 \u06a9\u06d2 \u06a9\u06c1 \u0648\u0647 \u0627\u0644\u0644\u06c1 \u063a\u0627\u0644\u0628 \ufefb\u0626\u0642 \u062d\u0645\u062f \u06a9\u06cc \u0630\u0627\u062a \u067e\u0631 \u0627\u06cc\u0645\u0627\u0646 \ufefb\u0626\u06d2 \u062a\u06be\u06d2.[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u0627\u0646 \u0644\u0648\u06af\u0648\u06ba \u06a9\u0627 \u062c\u0631\u0645\u060c \u062c\u0646\u06c1\u06cc\u06ba \u0622\u06af \u0645\u06cc\u06ba \u062c\u06be\u0648\u0646\u06a9\u0627 \u062c\u0627 \u0631\u06c1\u0627 \u062a\u06be\u0627\u060c \u06cc\u06c1 \u062a\u06be\u0627 \u06a9\u06c1 \u0648\u06c1 \u0627\u0644\u0644\u06c1 \u063a\u0627\u0644\u0628 \u067e\u0631 \u0627\u06cc\u0645\u0627\u0646 \u0644\u06d2 \u0622\u0626\u06d2 \u062a\u06be\u06d2\u06d4 \u0627\u0633 \u0648\u0627\u0642\u0639\u06d2 \u06a9\u06cc \u062a\u0641\u0635\u06cc\u0644 \u062c\u0648 \u0635\u062d\u06cc\u062d \u0627\u062d\u0627\u062f\u06cc\u062b \u0633\u06d2 \u062b\u0627\u0628\u062a \u06c1\u06d2 \u060c \u0645\u0644\u0627\u062d\u0638\u06c1 \u0641\u0631\u0645\u0627\u0626\u06cc\u06ba\u06d4\n\u0648\u0627\u0642\u0639\u06c1 \u0627\u0635\u062d\u0627\u0628 \u0627\u0644\u0627\u062e\u062f\u0648\u062f :\n\u06af\u0632\u0634\u062a\u06c1 \u0632\u0645\u0627\u0646\u06d2 \u0645\u06cc\u06ba \u0627\u06cc\u06a9 \u0628\u0627\u062f\u0634\u0627\u06c1 \u06a9\u0627 \u062c\u0627\u062f\u0648\u06af\u0631 \u0627\u0648\u0631 \u06a9\u0627\u06c1\u0646 \u062a\u06be\u0627\u060c \u062c\u0628 \u0648\u06c1 \u06a9\u0627\u06c1\u0646 \u0628\u0648\u0691\u06be\u0627 \u06c1\u0648 \u06af\u06cc\u0627 \u062a\u0648 \u0627\u0633 \u0646\u06d2 \u0628\u0627\u062f\u0634\u0627\u06c1 \u0633\u06d2\u06a9\u06c1\u0627 \u06a9\u06c1 \u0645\u062c\u06be\u06d2 \u0627\u06cc\u06a9 \u0630\u06c1\u06cc\u0646 \u0644\u0691\u06a9\u0627 \u062f\u0648\u060c \u062c\u0633\u06d2 \u0645\u06cc\u06ba \u06cc\u06c1 \u0639\u0644\u0645 \u0633\u06a9\u06be\u0627 \u062f\u0648\u06ba\u06d4 \u0686\u0646\u0627\u0646\u0686\u06c1 \u0628\u0627\u062f\u0634\u0627\u06c1 \u0646\u06d2 \u0627\u06cc\u06a9 \u0633\u0645\u062c\u06be\u062f\u0627\u0631 \u0644\u0691\u06a9\u0627 \u062a\u0644\u0627\u0634 \u06a9\u0631\u06a9\u06d2 \u0627\u0633 \u06a9\u06d2 \u0633\u067e\u0631\u062f \u06a9\u0631 \u062f\u06cc\u0627\u06d4 \u0644\u0691\u06a9\u06d2 \u06a9\u06d2 \u0631\u0627\u0633\u062a\u06d2 \u0645\u06cc\u06ba \u0627\u06cc\u06a9 \u0631\u0627\u06c1\u0628 \u06a9\u0627 \u0628\u06be\u06cc \u0645\u06a9\u0627\u0646 \u062a\u06be\u0627\u060c \u06cc\u06c1 \u0644\u0691\u06a9\u0627 \u0622\u062a\u06d2 \u062c\u0627\u062a\u06d2 \u0627\u0633 \u06a9\u06d2\u067e\u0627\u0633 \u0628\u06be\u06cc \u0628\u06cc\u0679\u06be\u062a\u0627 \u0627\u0648\u0631 \u0627\u0633 \u06a9\u06cc \u0628\u0627\u062a\u06cc\u06ba \u0633\u0646\u062a\u0627\u060c \u062c\u0648 \u0627\u0633\u06d2 \u0627\u0686\u06be\u06cc \u0644\u06af\u062a\u06cc\u06ba\u06d4 \u0627\u0633\u06cc \u0637\u0631\u062d \u0633\u0644\u0633\u0644\u06c1 \u0686\u0644\u062a\u0627 \u0631\u06c1\u0627\u06d4 \u0627\u06cc\u06a9 \u0645\u0631\u062a\u0628\u06c1 \u06cc\u06c1 \u0644\u0691\u06a9\u0627 \u062c\u0627 \u0631\u06c1\u0627 \u062a\u06be\u0627 \u06a9\u06c1 \u0631\u0627\u0633\u062a\u06d2 \u0645\u06cc\u06ba \u0627\u06cc\u06a9 \u0628\u06c1\u062a \u0628\u0691\u06d2 \u062c\u0627\u0646\u0648\u0631 ( \u0634\u06cc\u0631 \u06cc\u0627 \u0633\u0627\u0646\u067e \u0648\u063a\u06cc\u0631\u06c1 ) \u0646\u06d2 \u0644\u0648\u06af\u0648\u06ba \u06a9\u0627 \u0631\u0627\u0633\u062a\u06c1 \u0631\u0648\u06a9 \u0631\u06a9\u06be\u0627 \u062a\u06be\u0627\u06d4 \u0644\u0691\u06a9\u06d2 \u0646\u06d2 \u0633\u0648\u0686\u0627\u060c \u0622\u062c \u0645\u06cc\u06ba \u067e\u062a\u06c1 \u06a9\u0631\u062a\u0627 \u06c1\u0648\u06ba \u06a9\u06c1 \u062c\u0627\u062f\u0648\u06af\u0631 \u0635\u062d\u06cc\u062d \u06c1\u06d2 \u06cc\u0627 \u0631\u0627\u06c1\u0628 \u061f \u0627\u0633 \u0646\u06d2 \u0627\u06cc\u06a9 \u067e\u062a\u06be\u0631 \u067e\u06a9\u0691\u0627 \u0627\u0648\u0631 \u06a9\u06c1\u0627 \u0627\u06d2 \u0627\u0644\u0644\u06c1\u060c \u0627\u06af\u0631 \u0631\u0627\u06c1\u0628 \u06a9\u0627 \u0645\u0639\u0627\u0645\u0644\u06c1\u060c \u062a\u06cc\u0631\u06d2 \u0646\u0632\u062f\u06cc\u06a9 \u062c\u0627\u062f\u0648\u06af\u0631 \u06a9\u06d2 \u0645\u0639\u0627\u0645\u0644\u06d2 \u0633\u06d2 \u0628\u06c1\u062a\u0631 \u0627\u0648\u0631 \u067e\u0633\u0646\u062f\u06cc\u062f\u06c1 \u06c1\u06d2 \u062a\u0648 \u0627\u0633 \u062c\u0627\u0646\u0648\u0631 \u06a9\u0648 \u0645\u0627\u0631 \u062f\u06d2\u060c \u062a\u0627\u06a9\u06c1 \u0644\u0648\u06af\u0648\u06ba \u06a9\u06cc \u0622\u0645\u062f \u0648\u0631\u0641\u062a \u062c\u0627\u0631\u06cc \u06c1\u0648 \u062c\u0627\u0626\u06d2\u06d4 \u06cc\u06c1 \u06a9\u06c1\u06c1 \u06a9\u0631 \u0627\u0633 \u0646\u06d2 \u067e\u062a\u06be\u0631 \u0645\u0627\u0631\u0627 \u0627\u0648\u0631 \u0648\u06c1 \u062c\u0627\u0646\u0648\u0631 \u0645\u0631 \u06af\u06cc\u0627\u06d4 \u0644\u0691\u06a9\u06d2 \u0646\u06d2 \u062c\u0627 \u06a9\u0631 \u06cc\u06c1 \u0648\u0627\u0642\u0639\u06c1 \u0631\u0627\u06c1\u0628 \u06a9\u0648 \u0628\u062a\u0644\u0627\u06cc\u0627\u06d4 \u0631\u0627\u06c1\u0628 \u0646\u06d2 \u06a9\u06c1\u0627\u060c \u0628\u06cc\u0679\u06d2! \u0627\u0628 \u062a\u0645 \u0641\u0636\u0644 \u0648\u06a9\u0645\u0627\u0644 \u06a9\u0648 \u067e\u06c1\u0646\u0686 \u06af\u0626\u06d2 \u06c1\u0648 \u0627\u0648\u0631 \u062a\u0645\u06c1\u0627\u0631\u06cc \u0622\u0632\u0645\u0627\u0626\u0634 \u0634\u0631\u0648\u0639 \u06c1\u0648\u0646\u06d2 \u0648\u0627\u0644\u06cc \u06c1\u06d2\u06d4 \u0644\u06cc\u06a9\u0646 \u0627\u0633 \u062f\u0648\u0631 \u0627\u0628\u062a\u0644\u0627 \u0645\u06cc\u06ba \u0645\u06cc\u0631\u0627 \u0646\u0627\u0645 \u0638\u0627\u06c1\u0631 \u0646\u06c1 \u06a9\u0631\u0646\u0627\u06d4 \u06cc\u06c1 \u0644\u0691\u06a9\u0627 \u0645\u0627\u062f\u0631 \u0632\u0627\u062f \u0627\u0646\u062f\u06be\u06d2\u060c \u0628\u0631\u0635 \u0627\u0648\u0631 \u062f\u06cc\u06af\u0631 \u0628\u0639\u0636 \u0628\u06cc\u0645\u0627\u0631\u06cc\u0648\u06ba \u06a9\u0627 \u0639\u0644\u0627\u062c \u0628\u06be\u06cc \u06a9\u0631\u062a\u0627 \u062a\u06be\u0627\u060c \u0644\u06cc\u06a9\u0646 \u0627\u06cc\u0645\u0627\u0646 \u0628\u0627\u0644\u0644\u06c1 \u06a9\u06cc \u0634\u0631\u0637 \u067e\u0631\u060c \u0627\u0633\u06cc \u0634\u0631\u0637 \u067e\u0631 \u0627\u0633 \u0646\u06d2 \u0628\u0627\u062f\u0634\u0627\u06c1 \u06a9\u06d2 \u0627\u06cc\u06a9 \u0646\u0627\u0628\u06cc\u0646\u0627 \u0645\u0635\u0627\u062d\u0628 \u06a9\u06cc \u0622\u0646\u06a9\u06be\u06cc\u06ba \u0628\u06be\u06cc\u060c \u0627\u0644\u0644\u06c1 \u0633\u06d2 \u062f\u0639\u0627 \u06a9\u0631\u06a9\u06d2 \u0635\u062d\u06cc\u062d \u06a9\u0631 \u062f\u06cc\u06ba\u06d4 \u06cc\u06c1 \u0644\u0691\u06a9\u0627 \u06cc\u06c1\u06cc \u06a9\u06c1\u062a\u0627 \u062a\u06be\u0627 \u06a9\u06c1 \u0627\u06af\u0631 \u062a\u0645 \u0627\u06cc\u0645\u0627\u0646 \u0644\u06d2 \u0622\u0624 \u06af\u06d2 \u062a\u0648 \u0645\u06cc\u06ba \u0627\u0644\u0644\u06c1 \u0633\u06d2 \u062f\u0639\u0627 \u06a9\u0631\u0648\u06ba \u06af\u0627\u060c \u0648\u06c1 \u0634\u0641\u0627 \u0639\u0637\u0627 \u0641\u0631\u0645\u0627 \u062f\u06d2 \u06af\u0627\u060c \u0686\u0646\u0627\u0646\u0686\u06c1 \u0627\u0633 \u06a9\u06cc \u062f\u0639\u0627 \u0633\u06d2 \u0627\u0644\u0644\u06c1 \u0634\u0641\u0627\u06cc\u0627\u0628 \u0641\u0631\u0645\u0627 \u062f\u06cc\u062a\u0627\u06d4 \u06cc\u06c1 \u062e\u0628\u0631 \u0628\u0627\u062f\u0634\u0627\u06c1 \u062a\u06a9 \u0628\u06be\u06cc \u067e\u06c1\u0646\u0686\u06cc \u062a\u0648 \u0648\u06c1 \u0628\u06c1\u062a \u067e\u0631\u06cc\u0634\u0627\u0646 \u06c1\u0648\u0627\u06d4 \u0628\u0639\u0636 \u0627\u06c1\u0644 \u0627\u06cc\u0645\u0627\u0646 \u06a9\u0648 \u062a\u0648 \u0627\u0633 \u0646\u06d2 \u0642\u062a\u0644 \u06a9\u0631\u0648\u0627 \u062f\u06cc\u0627\u06d4 \u0627\u0633 \u0644\u0691\u06a9\u06d2 \u06a9\u06d2 \u0628\u0627\u0631\u06d2 \u0645\u06cc\u06ba \u0627\u0633 \u0646\u06d2 \u0686\u0646\u062f \u0622\u062f\u0645\u06cc\u0648\u06ba \u06a9\u0648 \u06a9\u06c1\u0627 \u06a9\u06c1 \u0627\u0633\u06d2 \u067e\u06c1\u0627\u0691 \u06a9\u06cc \u0686\u0648\u0679\u06cc \u067e\u0631 \u0644\u06d2\u062c\u0627 \u06a9\u0631 \u0646\u06cc\u0686\u06d2 \u067e\u06be\u06cc\u0646\u06a9 \u062f\u0648\u060c \u0627\u0633 \u0646\u06d2 \u0627\u0644\u0644\u06c1 \u0633\u06d2 \u062f\u0639\u0627 \u06a9\u06cc\u060c \u067e\u06c1\u0627\u0691 \u0645\u06cc\u06ba \u0644\u0631\u0632\u0634 \u067e\u06cc\u062f\u0627 \u06c1\u0648\u0626\u06cc\u060c \u062c\u0633 \u0633\u06d2 \u0648\u06c1 \u0633\u0628 \u06af\u0631 \u06a9\u0631 \u0645\u0631 \u06af\u0626\u06d2 \u0627\u0648\u0631 \u0627\u0644\u0644\u06c1 \u0646\u06d2 \u0627\u0633\u06d2 \u0628\u0686\u0627 \u0644\u06cc\u0627\u06d4 \u0628\u0627\u062f\u0634\u0627\u06c1 \u0646\u06d2 \u0627\u0633\u06d2\u062f\u0648\u0633\u0631\u06d2 \u0622\u062f\u0645\u06cc\u0648\u06ba \u06a9\u06d2\u0633\u067e\u0631\u062f \u06a9\u0631\u06a9\u06d2 \u06a9\u06c1\u0627 \u06a9\u06c1 \u0627\u06cc\u06a9 \u06a9\u0634\u062a\u06cc \u0645\u06cc\u06ba \u0628\u0679\u06be\u0627 \u06a9\u0631 \u0633\u0645\u0646\u062f\u0631 \u06a9\u06d2 \u0628\u06cc\u0686 \u0645\u06cc\u06ba \u0644\u06d2 \u062c\u0627 \u06a9\u0631 \u0627\u0633\u06d2 \u067e\u06be\u06cc\u0646\u06a9 \u062f\u0648\u060c \u0648\u06c1\u0627\u06ba \u0628\u06be\u06cc \u0627\u0633 \u06a9\u06cc \u062f\u0639\u0627 \u0633\u06d2 \u06a9\u0634\u062a\u06cc \u0627\u0644\u0679 \u06af\u0626\u06cc\u060c \u062c\u0633 \u0633\u06d2 \u0648\u06c1 \u0633\u0628 \u063a\u0631\u0642 \u06c1\u0648\u06af\u0626\u06d2\u0627\u0648\u0631 \u06cc\u06c1 \u0628\u0686 \u06af\u06cc\u0627\u06d4 \u0627\u0633 \u0644\u0691\u06a9\u06d2 \u0646\u06d2 \u0628\u0627\u062f\u0634\u0627\u06c1 \u0633\u06d2 \u06a9\u06c1\u0627\u060c \u0627\u06af\u0631 \u0645\u062c\u06be\u06d2 \u06c1\u0644\u0627\u06a9 \u06a9\u0631\u0646\u0627 \u0686\u0627\u06c1\u062a\u0627 \u06c1\u06d2 \u062a\u0648 \u0627\u0633 \u06a9\u0627 \u0637\u0631\u06cc\u0642\u06c1 \u06cc\u06c1 \u06c1\u06d2 \u06a9\u06c1 \u0627\u06cc\u06a9 \u06a9\u06be\u0644\u06d2 \u0645\u06cc\u062f\u0627\u0646 \u0645\u06cc\u06ba \u0644\u0648\u06af\u0648\u06ba \u06a9\u0648 \u062c\u0645\u0639 \u06a9\u0631\u0648 \u0627\u0648\u0631 ( \u0628\u0650\u0633\u0652\u0645\u0650 \u0627\u0644\u0644\u0647\u0650 \u0631\u064e\u0628\u0651\u0650 \u0627\u0644\u0652\u063a\u064f\u0644\u0627\u0645\u0650 ) \u06a9\u06c1\u06c1 \u06a9\u0631 \u0645\u062c\u06be\u06d2 \u062a\u06cc\u0631 \u0645\u0627\u0631\u06d4 \u0628\u0627\u062f\u0634\u0627\u06c1 \u0646\u06d2 \u0627\u06cc\u0633\u0627 \u06c1\u06cc \u06a9\u06cc\u0627\u060c \u062c\u0633 \u0633\u06d2 \u0648\u06c1 \u0644\u0691\u06a9\u0627 \u0645\u0631 \u06af\u06cc\u0627 \u0644\u06cc\u06a9\u0646 \u0633\u0627\u0631\u06d2 \u0644\u0648\u06af \u067e\u06a9\u0627\u0631 \u0627\u0679\u06be\u06d2\u060c \u06a9\u06c1 \u06c1\u0645 \u0627\u0633 \u0644\u0691\u06a9\u06d2 \u06a9\u06d2 \u0631\u0628 \u067e\u0631 \u0627\u06cc\u0645\u0627\u0646 \u0644\u0627\u0626\u06d2\u06d4 \u0628\u0627\u062f\u0634\u0627\u06c1 \u0627\u0648\u0631 \u0632\u06cc\u0627\u062f\u06c1 \u067e\u0631\u06cc\u0634\u0627\u0646 \u06c1\u0648\u06af\u06cc\u0627\u06d4 \u0686\u0646\u0627\u0646\u0686\u06c1 \u0627\u0633 \u0646\u06d2 \u062e\u0646\u062f\u0642\u06cc\u06ba \u06a9\u06be\u062f\u0648\u0627\u0626\u06cc\u06ba \u0627\u0648\u0631 \u0627\u0633 \u0645\u06cc\u06ba \u0622\u06af \u062c\u0644\u0648\u0627\u0626\u06cc \u0627\u0648\u0631 \u062d\u06a9\u0645 \u062f\u06cc\u0627 \u06a9\u06c1 \u062c\u0648 \u0627\u06cc\u0645\u0627\u0646 \u0633\u06d2 \u0627\u0646\u062d\u0631\u0627\u0641 \u0646\u06c1 \u06a9\u0631\u06d2\u060c \u0627\u0633 \u06a9\u0648 \u0622\u06af \u0645\u06cc\u06ba \u067e\u06be\u06cc\u0646\u06a9 \u062f\u0648\u06d4 \u0627\u0633 \u0637\u0631\u062d \u0627\u06cc\u0645\u0627\u0646 \u062f\u0627\u0631 \u0622\u062a\u06d2 \u0631\u06c1\u06d2 \u0627\u0648\u0631 \u0622\u06af \u06a9\u06d2 \u062d\u0648\u0627\u0644\u06d2 \u06c1\u0648\u062a\u06d2 \u0631\u06c1\u06d2\u060c \u062d\u062a\u06cc\u0670 \u06a9\u06c1 \u0627\u06cc\u06a9 \u0639\u0648\u0631\u062a \u0622\u0626\u06cc\u060c \u062c\u0633 \u06a9\u06d2\u0633\u0627\u062a\u06be \u0627\u06cc\u06a9 \u0628\u0686\u06c1 \u062a\u06be\u0627\u060c \u0648\u06c1 \u0630\u0631\u0627 \u0679\u06be\u0679\u06be\u06a9\u06cc\u060c \u062a\u0648 \u0628\u0686\u06c1 \u0628\u0648\u0644 \u067e\u0691\u0627\u060c \u0627\u0645\u0627\u06ba\u060c \u0635\u0628\u0631 \u06a9\u0631\u060c \u062a\u0648 \u062d\u0642 \u067e\u0631 \u06c1\u06d2\u06d4 ( \u0635\u062d\u064a\u062d \u0645\u0633\u0644\u0645\u060c \u0645\u0644\u062e\u0635\u064b\u0627\u060c \u0643\u062a\u0627\u0628 \u0627\u0644\u0632\u0647\u062f \u0648\u0627\u0644\u0631\u0642\u0627\u0642\u060c \u0628\u0627\u0628 \u0642\u0635\u0629 \u0623\u0635\u062d\u0627\u0628 \u0627\u0644\u0623\u062e\u062f\u0648\u062f ) \u0627\u0645\u0627\u0645 \u0627\u0628\u0646 \u06a9\u062b\u06cc\u0631 \u0646\u06d2 \u0627\u0648\u0631 \u0628\u06be\u06cc \u0628\u0639\u0636 \u0648\u0627\u0642\u0639\u0627\u062a \u0646\u0642\u0644 \u06a9\u06cc\u06d2 \u06c1\u06cc\u06ba \u0627\u0648\u0631 \u062c\u0648 \u0627\u0633 \u0633\u06d2 \u0645\u062e\u062a\u0644\u0641 \u06c1\u06cc\u06ba \u0627\u0648\u0631 \u06a9\u06c1\u0627 \u06c1\u06d2\u060c \u0645\u0645\u06a9\u0646 \u06c1\u06d2 \u0627\u0633 \u0642\u0633\u0645 \u06a9\u06d2 \u0645\u062a\u0639\u062f\u062f \u0648\u0627\u0642\u0639\u0627\u062a \u0645\u062e\u062a\u0644\u0641 \u062c\u06af\u06c1\u0648\u06ba \u067e\u0631 \u06c1\u0648\u0626\u06d2 \u06c1\u0648\u06ba\u06d4 ( \u062a\u0641\u0635\u06cc\u0644 \u06a9\u06d2 \u0644\u0626\u06d2 \u062f\u06cc\u06a9\u06be\u0626\u06d2 \u062a\u0641\u0633\u06cc\u0631 \u0627\u0628\u0646 \u06a9\u062b\u06cc\u0631)\u06d4"},{"id":"5918","sura":"85","aya":"9","arabic_text":"\u0671\u0644\u0651\u064e\u0630\u0650\u064a \u0644\u064e\u0647\u064f\u06e5 \u0645\u064f\u0644\u06e1\u0643\u064f \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650\u06da \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0639\u064e\u0644\u064e\u0649\u0670 \u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u064a\u06e1\u0621\u0656 \u0634\u064e\u0647\u0650\u064a\u062f\u064c","translation":"\u062c\u0633 \u06a9\u06d2 \u0644\u0626\u06d2 \u0622\u0633\u0645\u0627\u0646 \u0648\u0632\u0645\u06cc\u0646 \u06a9\u0627 \u0645\u0644\u06a9 \u06c1\u06d2\u06d4 \u0627\u0648\u0631 \u0627\u0644\u0644\u06c1 \u062a\u0639\u0627\u0644\u06cc\u0670 \u06c1\u0631\u0686\u06cc\u0632 \u06a9\u0648 \u062f\u06cc\u06a9\u06be \u0631\u06c1\u0627 \u06c1\u06d2.","footnotes":""},{"id":"5919","sura":"85","aya":"10","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0641\u064e\u062a\u064e\u0646\u064f\u0648\u0627\u0652 \u0671\u0644\u06e1\u0645\u064f\u0624\u06e1\u0645\u0650\u0646\u0650\u064a\u0646\u064e \u0648\u064e\u0671\u0644\u06e1\u0645\u064f\u0624\u06e1\u0645\u0650\u0646\u064e\u0670\u062a\u0650 \u062b\u064f\u0645\u0651\u064e \u0644\u064e\u0645\u06e1 \u064a\u064e\u062a\u064f\u0648\u0628\u064f\u0648\u0627\u0652 \u0641\u064e\u0644\u064e\u0647\u064f\u0645\u06e1 \u0639\u064e\u0630\u064e\u0627\u0628\u064f \u062c\u064e\u0647\u064e\u0646\u0651\u064e\u0645\u064e \u0648\u064e\u0644\u064e\u0647\u064f\u0645\u06e1 \u0639\u064e\u0630\u064e\u0627\u0628\u064f \u0671\u0644\u06e1\u062d\u064e\u0631\u0650\u064a\u0642\u0650","translation":"\u0628\u06cc\u0634\u06a9 \u062c\u0646 \u0644\u0648\u06af\u0648\u06ba \u0646\u06d2 \u0645\u0633\u0644\u0645\u0627\u0646 \u0645\u0631\u062f\u0648\u06ba \u0627\u0648\u0631 \u0639\u0648\u0631\u062a\u0648\u06ba \u06a9\u0648 \u0633\u062a\u0627\u06cc\u0627 \u067e\u06be\u0631 \u062a\u0648\u0628\u06c1 (\u0628\u06be\u06cc) \u0646\u06c1 \u06a9\u06cc \u062a\u0648 \u0627\u0646 \u06a9\u06d2 \u0644\u0626\u06d2 \u062c\u06c1\u0646\u0645 \u06a9\u0627 \u0639\u0630\u0627\u0628 \u06c1\u06d2 \u0627\u0648\u0631 \u062c\u0644\u0646\u06d2 \u06a9\u0627 \u0639\u0630\u0627\u0628 \u06c1\u06d2.","footnotes":""},{"id":"5920","sura":"85","aya":"11","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u0652 \u0648\u064e\u0639\u064e\u0645\u0650\u0644\u064f\u0648\u0627\u0652 \u0671\u0644\u0635\u0651\u064e\u0670\u0644\u0650\u062d\u064e\u0670\u062a\u0650 \u0644\u064e\u0647\u064f\u0645\u06e1 \u062c\u064e\u0646\u0651\u064e\u0670\u062a\u065e \u062a\u064e\u062c\u06e1\u0631\u0650\u064a \u0645\u0650\u0646 \u062a\u064e\u062d\u06e1\u062a\u0650\u0647\u064e\u0627 \u0671\u0644\u06e1\u0623\u064e\u0646\u06e1\u0647\u064e\u0670\u0631\u064f\u06da \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0671\u0644\u06e1\u0641\u064e\u0648\u06e1\u0632\u064f \u0671\u0644\u06e1\u0643\u064e\u0628\u0650\u064a\u0631\u064f","translation":"\u0628\u06cc\u0634\u06a9 \u0627\u06cc\u0645\u0627\u0646 \u0642\u0628\u0648\u0644 \u06a9\u0631\u0646\u06d2 \u0648\u0627\u0644\u0648\u06ba \u0627\u0648\u0631 \u0646\u06cc\u06a9 \u06a9\u0627\u0645 \u06a9\u0631\u0646\u06d2 \u0648\u0627\u0644\u0648\u06ba \u06a9\u06d2 \u0644\u0626\u06d2 \u0648\u0647 \u0628\u0627\u063a\u0627\u062a \u06c1\u06cc\u06ba\u06d4 \u062c\u0646 \u06a9\u06d2 \u0646\u06cc\u0686\u06d2 \u0628\u06c1\u0631\u06cc\u06ba \u0628\u06c1\u06c1 \u0631\u06c1\u06cc \u06c1\u06cc\u06ba\u06d4 \u06cc\u06c1\u06cc \u0628\u0691\u06cc \u06a9\u0627\u0645\u06cc\u0627\u0628\u06cc \u06c1\u06d2.","footnotes":""},{"id":"5921","sura":"85","aya":"12","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0628\u064e\u0637\u06e1\u0634\u064e \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0644\u064e\u0634\u064e\u062f\u0650\u064a\u062f\u064c","translation":"\u06cc\u0642\u06cc\u0646\u0627\u064b \u062a\u06cc\u0631\u06d2 \u0631\u0628 \u06a9\u06cc \u067e\u06a9\u0691 \u0628\u0691\u06cc \u0633\u062e\u062a \u06c1\u06d2.[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u062c\u0628 \u0648\u06c1 \u0627\u067e\u0646\u06d2 \u0627\u0646 \u062f\u0634\u0645\u0646\u0648\u06ba \u06a9\u06cc \u06af\u0631\u0641\u062a \u067e\u0631 \u0622\u0626\u06d2 \u062c\u0648 \u0627\u0633 \u06a9\u06d2 \u0631\u0633\u0648\u0644\u0648\u06ba \u06a9\u06cc \u062a\u06a9\u0630\u06cc\u0628 \u06a9\u0631\u062a\u06d2 \u0627\u0648\u0631 \u0627\u0646 \u06a9\u06d2 \u062d\u06a9\u0645\u0648\u06ba \u06a9\u06cc \u0645\u062e\u0627\u0644\u0641\u062a \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u062a\u0648 \u067e\u06be\u0631 \u0627\u0633 \u06a9\u06cc \u06af\u0631\u0641\u062a \u0633\u06d2 \u0627\u0646\u06c1\u06cc\u06ba \u06a9\u0648\u0626\u06cc \u0646\u06c1\u06cc\u06ba \u0628\u0686\u0627 \u0633\u06a9\u062a\u0627\u06d4"},{"id":"5922","sura":"85","aya":"13","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0647\u064f\u0648\u064e \u064a\u064f\u0628\u06e1\u062f\u0650\u0626\u064f \u0648\u064e\u064a\u064f\u0639\u0650\u064a\u062f\u064f","translation":"\u0648\u06c1\u06cc \u067e\u06c1\u0644\u06cc \u0645\u0631\u062a\u0628\u06c1 \u067e\u06cc\u062f\u0627 \u06a9\u0631\u062a\u0627 \u06c1\u06d2 \u0627\u0648\u0631 \u0648\u06c1\u06cc \u062f\u0648\u0628\u0627\u0631\u0647 \u067e\u06cc\u062f\u0627 \u06a9\u0631\u06d2 \u06af\u0627.[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u0648\u06c1\u06cc \u0627\u067e\u0646\u06cc \u0642\u0648\u062a \u0627\u0648\u0631 \u0642\u062f\u0631\u062a \u06a9\u0627\u0645\u0644\u06c1 \u0633\u06d2 \u067e\u06c1\u0644\u06cc \u0645\u0631\u062a\u0628\u06c1 \u067e\u06cc\u062f\u0627 \u06a9\u0631\u062a\u0627 \u06c1\u06d2 \u0627\u0648\u0631 \u067e\u06be\u0631 \u0642\u06cc\u0627\u0645\u062a \u0648\u0627\u0644\u06d2 \u062f\u0646 \u062f\u0648\u0628\u0627\u0631\u06c1 \u0627\u0646\u06c1\u06cc\u06ba \u0627\u0633\u06cc \u0637\u0631\u062d \u067e\u06cc\u062f\u0627 \u0641\u0631\u0645\u0627\u0626\u06d2 \u06af\u0627 \u062c\u0633 \u0637\u0631\u062d \u0627\u0633 \u0646\u06d2 \u067e\u06c1\u0644\u06cc \u0645\u0631\u062a\u0628\u06c1 \u067e\u06cc\u062f\u0627 \u06a9\u06cc\u0627 \u062a\u06be\u0627\u06d4"},{"id":"5923","sura":"85","aya":"14","arabic_text":"\u0648\u064e\u0647\u064f\u0648\u064e \u0671\u0644\u06e1\u063a\u064e\u0641\u064f\u0648\u0631\u064f \u0671\u0644\u06e1\u0648\u064e\u062f\u064f\u0648\u062f\u064f","translation":"\u0648\u0647 \u0628\u0691\u0627 \u0628\u062e\u0634\u0634 \u06a9\u0631\u0646\u06d2 \u0648\u0627\ufefb \u0627\u0648\u0631 \u0628\u06c1\u062a \u0645\u062d\u0628\u062a \u06a9\u0631\u0646\u06d2 \u0648\u0627\ufefb \u06c1\u06d2.","footnotes":""},{"id":"5924","sura":"85","aya":"15","arabic_text":"\u0630\u064f\u0648 \u0671\u0644\u06e1\u0639\u064e\u0631\u06e1\u0634\u0650 \u0671\u0644\u06e1\u0645\u064e\u062c\u0650\u064a\u062f\u064f","translation":"\u0639\u0631\u0634 \u06a9\u0627 \u0645\u0627\u0644\u06a9 \u0639\u0638\u0645\u062a \u0648\u0627\ufefb \u06c1\u06d2.[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u062a\u0645\u0627\u0645 \u0645\u062e\u0644\u0648\u0642\u0627\u062a \u0633\u06d2 \u0645\u0639\u0638\u0645 \u0627\u0648\u0631 \u0628\u0644\u0646\u062f \u06c1\u06d2 \u0627\u0648\u0631 \u0639\u0631\u0634\u060c \u062c\u0648 \u0633\u0628 \u0633\u06d2 \u0627\u0648\u067e\u0631 \u06c1\u06d2\u060c \u0648\u06c1 \u0627\u0633 \u06a9\u0627 \u0645\u0633\u062a\u0642\u0631 \u06c1\u06d2\u06d4 \u062c\u06cc\u0633\u0627 \u06a9\u06c1 \u0635\u062d\u0627\u0628\u06c1 \u0648\u062a\u0627\u0628\u0639\u06cc\u0646 \u0627\u0648\u0631 \u0645\u062d\u062f\u062b\u06cc\u0646 \u06a9\u0627 \u0639\u0642\u06cc\u062f\u06c1 \u06c1\u06d2\u06d4 \u0627\u0644\u0652\u062c\u0650\u064a\u062f\u0650 \u0635\u0627\u062d\u0628 \u0641\u0636\u0644 \u0648\u06a9\u0631\u0645\u06d4 \u06cc\u06c1 \u0645\u0631\u0641\u0648\u0639 \u0627\u0633 \u0644\u0626\u06d2 \u06c1\u06d2 \u06a9\u06c1 \u06cc\u06c1 \u0630\u064f\u0648 \u06d4 \u06cc\u0639\u0646\u06cc \u0631\u0628 \u06a9\u06cc \u0635\u0641\u062a \u06c1\u06d2\u060c \u0639\u0631\u0634 \u06a9\u06cc \u0635\u0641\u062a \u0646\u06c1\u06cc\u06ba\u06d4 \u0627\u06af\u0631\u0686\u06c1 \u0628\u0639\u0636 \u0644\u0648\u06af \u0627\u0633\u06d2 \u0639\u0631\u0634 \u06a9\u06cc \u0635\u0641\u062a \u062a\u0633\u0644\u06cc\u0645 \u06a9\u0631\u06a9\u06d2 \u0627\u0633\u06d2 \u0645\u062c\u0631\u0648\u0631 \u067e\u0691\u06be\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u0645\u0639\u0646\u0627\u064b \u062f\u0648\u0646\u0648\u06ba \u0635\u062d\u06cc\u062d \u06c1\u06cc\u06ba\u06d4 ( \u0627\u0628\u0646 \u06a9\u062b\u06cc\u0631 ) \u06d4"},{"id":"5925","sura":"85","aya":"16","arabic_text":"\u0641\u064e\u0639\u0651\u064e\u0627\u0644\u065e \u0644\u0651\u0650\u0645\u064e\u0627 \u064a\u064f\u0631\u0650\u064a\u062f\u064f","translation":"\u062c\u0648 \u0686\u0627\u06c1\u06d2 \u0627\u0633\u06d2 \u06a9\u0631 \u06af\u0632\u0631\u0646\u06d2 \u0648\u0627\ufefb \u06c1\u06d2.[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u0648\u06c1 \u062c\u0648 \u0686\u0627\u06c1\u06d2\u060c \u06a9\u0631 \u06af\u0632\u0631\u062a\u0627 \u06c1\u06d2\u060c \u0627\u0633 \u06a9\u06d2 \u062d\u06a9\u0645 \u0627\u0648\u0631 \u0645\u0634\u06cc\u062a \u06a9\u0648 \u0679\u0627\u0644\u0646\u06d2 \u0648\u0627\u0644\u0627 \u06a9\u0648\u0626\u06cc \u0646\u06c1\u06cc\u06ba \u06c1\u06d2 \u0646\u06c1 \u0627\u0633 \u0633\u06d2 \u06a9\u0648\u0626\u06cc \u067e\u0648\u0686\u06be\u0646\u06d2 \u0648\u0627\u0644\u0627 \u06c1\u06cc \u06c1\u06d2\u06d4 \u062d\u0636\u0631\u062a \u0627\u0628\u0648 \u0628\u06a9\u0631 \u0635\u062f\u06cc\u0642 (\u0631\u0636\u064a \u0627\u0644\u0644\u0647 \u0639\u0646\u0647) \u0633\u06d2 \u0627\u0646 \u06a9\u06d2 \u0645\u0631\u0636 \u0627\u0644\u0645\u0648\u062a \u0645\u06cc\u06ba \u06a9\u0633\u06cc \u0646\u06d2 \u067e\u0648\u0686\u06be\u0627:\n\u06a9\u06cc\u0627 \u06a9\u0633\u06cc \u0637\u0628\u06cc\u0628 \u0646\u06d2 \u0622\u067e \u06a9\u0648 \u062f\u06cc\u06a9\u06be\u0627 \u061f \u0627\u0646\u06c1\u0648\u06ba \u0646\u06d2 \u0641\u0631\u0645\u0627\u06cc\u0627\u060c \u06c1\u0627\u06ba\u06d4 \u067e\u0648\u0686\u06be\u0627\u060c \u0627\u0633 \u0646\u06d2 \u06a9\u06cc\u0627 \u06a9\u06c1\u0627 \u061f \u0641\u0631\u0645\u0627\u06cc\u0627\u060c \u0627\u0633 \u0646\u06d2 \u06a9\u06c1\u0627 \u06c1\u06d2\u060c \u0625\u0650\u0646\u0651\u0650\u064a \u0641\u064e\u0639\u0651\u064e\u0627\u0644\u064c \u0644\u0650\u0645\u064e\u0627 \u0623\u064f\u0631\u0650\u064a\u062f\u064f \u0645\u06cc\u06ba \u062c\u0648 \u0686\u0627\u06c1\u0648\u06ba \u06a9\u0631\u0648\u06ba\u060c \u0645\u06cc\u0631\u06d2 \u0645\u0639\u0627\u0645\u0644\u06d2 \u0645\u06cc\u06ba \u06a9\u0648\u0626\u06cc \u062f\u062e\u0644 \u062f\u06cc\u0646\u06d2 \u0648\u0627\u0644\u0627 \u0646\u06c1\u06cc\u06ba\u06d4 ( \u0627\u0628\u0646 \u06a9\u062b\u06cc\u0631 ) \u0645\u0637\u0644\u0628 \u06cc\u06c1 \u062a\u06be\u0627 \u06a9\u06c1 \u0627\u0628 \u0637\u0628\u06cc\u0628\u0648\u06ba \u06a9\u06d2 \u06c1\u0627\u062a\u06be\u0648\u06ba \u0645\u06cc\u06ba \u0646\u06c1\u06cc\u06ba \u0631\u06c1\u0627\u060c \u0645\u06cc\u0631\u0627 \u0622\u062e\u0631\u06cc \u0648\u0642\u062a \u0622\u06af\u06cc\u0627 \u06c1\u06d2 \u0627\u0648\u0631 \u0627\u0644\u0644\u06c1 \u06c1\u06cc \u0627\u0628 \u0645\u06cc\u0631\u0627 \u0637\u0628\u06cc\u0628 \u06c1\u06d2\u060c \u062c\u0633 \u06a9\u06cc \u0645\u0634\u06cc\u062a \u06a9\u0648 \u0679\u0627\u0644\u0646\u06d2 \u06a9\u06cc \u06a9\u0633\u06cc \u06a9\u06d2 \u0627\u0646\u062f\u0631 \u0637\u0627\u0642\u062a \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u06d4"},{"id":"5926","sura":"85","aya":"17","arabic_text":"\u0647\u064e\u0644\u06e1 \u0623\u064e\u062a\u064e\u0649\u0670\u0643\u064e \u062d\u064e\u062f\u0650\u064a\u062b\u064f \u0671\u0644\u06e1\u062c\u064f\u0646\u064f\u0648\u062f\u0650","translation":"\u062a\u062c\u06be\u06d2 \u0644\u0634\u06a9\u0631\u0648\u06ba \u06a9\u06cc \u062e\u0628\u0631 \u0628\u06be\u06cc \u0645\u0644\u06cc \u06c1\u06d2\u061f[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u0627\u0646 \u067e\u0631 \u062c\u0628 \u0645\u06cc\u0631\u0627 \u0639\u0630\u0627\u0628 \u0622\u06cc\u0627 \u0627\u0648\u0631 \u0645\u06cc\u06ba \u0646\u06d2 \u0627\u0646\u06c1\u06cc\u06ba \u0627\u067e\u0646\u06cc \u06af\u0631\u0641\u062a \u0645\u06cc\u06ba \u0644\u06cc\u0627\u060c \u062c\u0633\u06d2 \u06a9\u0648\u0626\u06cc \u0679\u0627\u0644 \u0646\u06c1\u06cc\u06ba \u0633\u06a9\u0627\u06d4"},{"id":"5927","sura":"85","aya":"18","arabic_text":"\u0641\u0650\u0631\u06e1\u0639\u064e\u0648\u06e1\u0646\u064e \u0648\u064e\u062b\u064e\u0645\u064f\u0648\u062f\u064e","translation":"(\u06cc\u0639\u0646\u06cc) \u0641\u0631\u0639\u0648\u0646 \u0627\u0648\u0631 \u062b\u0645\u0648\u062f \u06a9\u06cc.[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u0627\u0646 \u067e\u0631 \u062c\u0628 \u0645\u06cc\u0631\u0627 \u0639\u0630\u0627\u0628 \u0622\u06cc\u0627 \u0627\u0648\u0631 \u0645\u06cc\u06ba \u0646\u06d2 \u0627\u0646\u06c1\u06cc\u06ba \u0627\u067e\u0646\u06cc \u06af\u0631\u0641\u062a \u0645\u06cc\u06ba \u0644\u06cc\u0627\u060c \u062c\u0633\u06d2 \u06a9\u0648\u0626\u06cc \u0679\u0627\u0644 \u0646\u06c1\u06cc\u06ba \u0633\u06a9\u0627\u06d4"},{"id":"5928","sura":"85","aya":"19","arabic_text":"\u0628\u064e\u0644\u0650 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u0652 \u0641\u0650\u064a \u062a\u064e\u0643\u06e1\u0630\u0650\u064a\u0628\u0656","translation":"(\u06a9\u0686\u06be \u0646\u06c1\u06cc\u06ba) \u0628\u0644\u06a9\u06c1 \u06a9\u0627\u0641\u0631 \u062a\u0648 \u062c\u06be\u0679\u0644\u0627\u0646\u06d2 \u0645\u06cc\u06ba \u067e\u0691\u06d2 \u06c1\u0648\u0626\u06d2 \u06c1\u06cc\u06ba.","footnotes":""},{"id":"5929","sura":"85","aya":"20","arabic_text":"\u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0645\u0650\u0646 \u0648\u064e\u0631\u064e\u0627\u0653\u0626\u0650\u0647\u0650\u0645 \u0645\u0651\u064f\u062d\u0650\u064a\u0637\u064f\u06e2","translation":"\u0627\u0648\u0631 \u0627\u0644\u0644\u06c1 \u062a\u0639\u0627\u0644\u06cc\u0670 \u0628\u06be\u06cc \u0627\u0646\u06c1\u06cc\u06ba \u06c1\u0631 \u0637\u0631\u0641 \u0633\u06d2 \u06af\u06be\u06cc\u0631\u06d2 \u06c1\u0648\u0626\u06d2 \u06c1\u06d2.[1]","footnotes":"[1] \u06cc\u06c1 \u0625\u0650\u0646\u0651\u064e \u0628\u064e\u0637\u0652\u0634\u064e \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0644\u064e\u0634\u064e\u062f\u0650\u064a\u062f\u064c \u06c1\u06cc \u06a9\u0627 \u0627\u062b\u0628\u0627\u062a \u0627\u0648\u0631 \u0627\u0633 \u06a9\u06cc \u062a\u0627\u06a9\u06cc\u062f \u06c1\u06d2\u06d4"},{"id":"5930","sura":"85","aya":"21","arabic_text":"\u0628\u064e\u0644\u06e1 \u0647\u064f\u0648\u064e \u0642\u064f\u0631\u06e1\u0621\u064e\u0627\u0646\u065e \u0645\u0651\u064e\u062c\u0650\u064a\u062f\u065e","translation":"\u0628\u0644\u06a9\u06c1 \u06cc\u06c1 \u0642\u0631\u0622\u0646 \u06c1\u06d2 \u0628\u0691\u06cc \u0634\u0627\u0646 \u0648\u0627\ufefb.","footnotes":""},{"id":"5931","sura":"85","aya":"22","arabic_text":"\u0641\u0650\u064a \u0644\u064e\u0648\u06e1\u062d\u0656 \u0645\u0651\u064e\u062d\u06e1\u0641\u064f\u0648\u0638\u0650\u06ed","translation":"\u0644\u0648\u062d \u0645\u062d\u0641\u0648\u0638 \u0645\u06cc\u06ba (\u0644\u06a9\u06be\u0627 \u06c1\u0648\u0627).[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u0644\u0648\u062d \u0645\u062d\u0641\u0648\u0638 \u0645\u06cc\u06ba \u0644\u06a9\u06be\u0627 \u06c1\u0648\u0627 \u06c1\u06d2\u060c \u062c\u06c1\u0627\u06ba \u0641\u0631\u0634\u062a\u06d2 \u0627\u0633 \u06a9\u06cc \u062d\u0641\u0627\u0638\u062a \u067e\u0631 \u0645\u0627\u0645\u0648\u0631 \u06c1\u06cc\u06ba\u060c \u0627\u0644\u0644\u06c1 \u062a\u0639\u0627\u0644\u06cc\u0670 \u062d\u0633\u0628 \u0636\u0631\u0648\u0631\u062a \u0648\u0627\u0642\u062a\u0636\u0627 \u0627\u0633\u06d2 \u0646\u0627\u0632\u0644 \u0641\u0631\u0645\u0627\u062a\u0627 \u06c1\u06d2\u06d4"}]}