s":"[1] \u0637\u064e\u0628\u064e\u0642\u064c \u06a9\u06d2 \u0627\u0635\u0644 \u0645\u0639\u0646\u06cc \u0634\u062f\u062a \u06a9\u06d2 \u06c1\u06cc\u06ba\u06d4 \u06cc\u06c1\u0627\u06ba \u0645\u0631\u0627\u062f \u0648\u06c1 \u0634\u062f\u0627\u0626\u062f \u06c1\u06cc\u06ba \u062c\u0648 \u0642\u06cc\u0627\u0645\u062a \u0648\u0627\u0644\u06d2 \u062f\u0646 \u0648\u0627\u0642\u0639 \u06c1\u0648\u06ba \u06af\u06d2\u06d4 \u06cc\u0639\u0646\u06cc \u0627\u0633 \u0631\u0648\u0632 \u0627\u06cc\u06a9 \u0633\u06d2 \u0628\u0691\u06be \u06a9\u0631 \u0627\u06cc\u06a9 \u062d\u0627\u0644\u062a \u0637\u0627\u0631\u06cc \u06c1\u0648\u06af\u06cc\u06d4 (\u0641\u062a\u062d \u0627\u0644\u0628\u0627\u0631\u064a \u060c \u062a\u0641\u0633\u064a\u0631 \u0633\u0648\u0631\u0629 \u0627\u0646\u0634\u0642\u0627\u0642) \u06cc\u06c1 \u062c\u0648\u0627\u0628 \u0642\u0633\u0645 \u06c1\u06d2\u06d4"},{"id":"5904","sura":"84","aya":"20","arabic_text":"\u0641\u064e\u0645\u064e\u0627 \u0644\u064e\u0647\u064f\u0645\u06e1 \u0644\u064e\u0627 \u064a\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e","translation":"\u0627\u0646\u06c1\u06cc\u06ba \u06a9\u06cc\u0627 \u06c1\u0648 \u06af\u06cc\u0627 \u06a9\u06c1 \u0627\u06cc\u0645\u0627\u0646 \u0646\u06c1\u06cc\u06ba \ufefb\u062a\u06d2.","footnotes":""},{"id":"5905","sura":"84","aya":"21","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0642\u064f\u0631\u0650\u0626\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650\u0645\u064f \u0671\u0644\u06e1\u0642\u064f\u0631\u06e1\u0621\u064e\u0627\u0646\u064f \u0644\u064e\u0627 \u064a\u064e\u0633\u06e1\u062c\u064f\u062f\u064f\u0648\u0646\u064e\u06e4\u06e9","translation":"\u0627\u0648\u0631 \u062c\u0628 \u0627\u0646 \u06a9\u06d2 \u067e\u0627\u0633 \u0642\u0631\u0622\u0646 \u067e\u0691\u06be\u0627 \u062c\u0627\u062a\u0627 \u06c1\u06d2 \u062a\u0648 \u0633\u062c\u062f\u0647 \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u062a\u06d2.[1]","footnotes":"[1] \u0627\u062d\u0627\u062f\u06cc\u062b \u0633\u06d2 \u06cc\u06c1\u0627\u06ba \u0646\u0628\u06cc (\u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645) \u0627\u0648\u0631 \u0635\u062d\u0627\u0628\u06c1 \u06a9\u0631\u0627\u0645 \u06a9\u0627 \u0633\u062c\u062f\u06c1 \u06a9\u0631\u0646\u0627 \u062b\u0627\u0628\u062a \u06c1\u06d2\u06d4"},{"id":"5906","sura":"84","aya":"22","arabic_text":"\u0628\u064e\u0644\u0650 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u0652 \u064a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f\u0648\u0646\u064e","translation":"\u0628\u0644\u06a9\u06c1 \u062c\u0646\u06c1\u0648\u06ba \u0646\u06d2 \u06a9\u0641\u0631 \u06a9\u06cc\u0627 \u0648\u0647 \u062c\u06be\u0679\u0644\u0627 \u0631\u06c1\u06d2 \u06c1\u06cc\u06ba.[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u0627\u06cc\u0645\u0627\u0646 \u0644\u0627\u0646\u06d2 \u06a9\u06d2\u0628\u062c\u0627\u0626\u06d2 \u062c\u06be\u0679\u0644\u0627\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4"},{"id":"5907","sura":"84","aya":"23","arabic_text":"\u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0623\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0628\u0650\u0645\u064e\u0627 \u064a\u064f\u0648\u0639\u064f\u0648\u0646\u064e","translation":"\u0627\u0648\u0631 \u0627\u0644\u0644\u06c1 \u062a\u0639\u0627\u0644\u06cc\u0670 \u062e\u0648\u0628 \u062c\u0627\u0646\u062a\u0627 \u06c1\u06d2 \u062c\u0648 \u06a9\u0686\u06be \u06cc\u06c1 \u062f\u0644\u0648\u06ba \u0645\u06cc\u06ba \u0631\u06a9\u06be\u062a\u06d2 \u06c1\u06cc\u06ba.[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u062a\u06a9\u0630\u06cc\u0628\u060c \u06cc\u0627\u062c\u0648 \u0627\u0641\u0639\u0627\u0644 \u0648\u06c1 \u0686\u06be\u067e \u06a9\u0631 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4"},{"id":"5908","sura":"84","aya":"24","arabic_text":"\u0641\u064e\u0628\u064e\u0634\u0651\u0650\u0631\u06e1\u0647\u064f\u0645 \u0628\u0650\u0639\u064e\u0630\u064e\u0627\u0628\u064d \u0623\u064e\u0644\u0650\u064a\u0645\u064d","translation":"