06af\u06cc\u06d4 \u0622\u06af\u06d2 \u0627\u0633 \u06a9\u06cc \u0645\u0632\u06cc\u062f \u062a\u0641\u0635\u06cc\u0644 \u0648\u0648\u0636\u0627\u062d\u062a \u06c1\u06d2\u06d4"},{"id":"5891","sura":"84","aya":"7","arabic_text":"\u0641\u064e\u0623\u064e\u0645\u0651\u064e\u0627 \u0645\u064e\u0646\u06e1 \u0623\u064f\u0648\u062a\u0650\u064a\u064e \u0643\u0650\u062a\u064e\u0670\u0628\u064e\u0647\u064f\u06e5 \u0628\u0650\u064a\u064e\u0645\u0650\u064a\u0646\u0650\u0647\u0650\u06e6","translation":"\u062a\u0648 (\u0627\u0633 \u0648\u0642\u062a) \u062c\u0633 \u0634\u062e\u0635 \u06a9\u06d2 \u062f\u0627\u06c1\u0646\u06d2 \u06c1\u0627\u062a\u06be \u0645\u06cc\u06ba \u0627\u0639\u0645\u0627\u0644 \u0646\u0627\u0645\u06c1 \u062f\u06cc\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627.","footnotes":""},{"id":"5892","sura":"84","aya":"8","arabic_text":"\u0641\u064e\u0633\u064e\u0648\u06e1\u0641\u064e \u064a\u064f\u062d\u064e\u0627\u0633\u064e\u0628\u064f \u062d\u0650\u0633\u064e\u0627\u0628\u0657\u0627 \u064a\u064e\u0633\u0650\u064a\u0631\u0657\u0627","translation":"\u0627\u0633 \u06a9\u0627 \u062d\u0633\u0627\u0628 \u062a\u0648 \u0628\u0691\u06cc \u0622\u0633\u0627\u0646\u06cc \u0633\u06d2 \u0644\u06cc\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627.[1]","footnotes":"[1] \u0622\u0633\u0627\u0646 \u062d\u0633\u0627\u0628 \u06cc\u06c1 \u06c1\u06d2 \u06a9\u06c1 \u0645\u0648\u0645\u0646 \u06a9\u0627 \u0627\u0639\u0645\u0627\u0644 \u0646\u0627\u0645\u06c1 \u067e\u06cc\u0634 \u06c1\u0648\u06af\u0627\u06d4 \u0627\u0633 \u06a9\u06cc \u063a\u0644\u0637\u06cc\u0627\u06ba \u0628\u06be\u06cc \u0627\u0633 \u06a9\u06d2 \u0633\u0627\u0645\u0646\u06d2 \u0644\u0627\u0626\u06cc \u062c\u0627\u0626\u06cc\u06ba \u06af\u06cc\u060c \u067e\u06be\u0631 \u0627\u0644\u0644\u06c1 \u062a\u0639\u0627\u0644\u06cc\u0670 \u0627\u067e\u0646\u06cc \u0631\u062d\u0645\u062a \u0627\u0648\u0631 \u0641\u0636\u0644 \u0648\u06a9\u0631\u0645 \u0633\u06d2 \u0627\u0646\u06c1\u06cc\u06ba \u0645\u0639\u0627\u0641 \u0641\u0631\u0645\u0627 \u062f\u06d2 \u06af\u0627\u06d4 \u062d\u0636\u0631\u062a \u0639\u0627\u0626\u0634\u06c1 (\u0631\u0636\u06cc \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0627) \u0641\u0631\u0645\u0627\u062a\u06cc \u06c1\u06cc\u06ba \u06a9\u06c1 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u06c1 (\u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645) \u0646\u06d2 \u0641\u0631\u0645\u0627\u06cc\u0627 \u201d\u062c\u0633 \u06a9\u0627 \u062d\u0633\u0627\u0628 \u0644\u06cc\u0627 \u06af\u06cc\u0627 \u0648\u06c1 \u06c1\u0644\u0627\u06a9 \u06c1\u0648\u06af\u06cc\u0627\u201c\u06d4 \u0645\u06cc\u06ba \u0646\u06d2 \u06a9\u06c1\u0627 \u0627\u06d2 \u0627\u0644\u0644\u06c1 \u06a9\u06d2 \u0631\u0633\u0648\u0644! \u0627\u0644\u0644\u06c1 \u0645\u062c\u06be\u06d2 \u0622\u067e \u067e\u0631 \u0642\u0631\u0628\u0627\u0646 \u06a9\u0631\u06d2 \u06a9\u06cc\u0627 \u0627\u0644\u0644\u06c1 \u062a\u0639\u0627\u0644\u06cc\u0670 \u0646\u06d2 \u06cc\u06c1 \u0646\u06c1\u06cc\u06ba \u0641\u0631\u0645\u0627\u06cc\u0627\u060c \u062c\u0633 \u06a9\u06d2 \u062f\u0627\u0626\u06cc\u06ba \u06c1\u0627\u062a\u06be \u0645\u06cc\u06ba \u0646\u0627\u0645\u06c1 \u0627\u0639\u0645\u0627\u0644 \u062f\u06cc\u0627 \u06af\u06cc\u0627\u060c \u0627\u0633 \u06a9\u0627 \u062d\u0633\u0627\u0628 \u0622\u0633\u0627\u0646 \u06c1\u0648\u06af\u0627\u06d4 \u0645\u0637\u0644\u0628 \u062d\u0636\u0631\u062a \u0639\u0627\u0626\u0634\u06c1 (\u0631\u0636\u06cc \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0627) \u06a9\u0627 \u06cc\u06c1 \u062a\u06be\u0627 \u06a9\u06c1 \u0627\u0633 \u0622\u06cc\u062a \u06a9\u06cc \u0631\u0648 \u0633\u06d2 \u062d\u0633\u0627\u0628 \u062a\u0648 \u0645\u0648\u0645\u0646 \u06a9\u0627 \u0628\u06be\u06cc \u06c1\u0648\u06af\u0627 \u0644\u06cc\u06a9\u0646 \u0648\u06c1 \u06c1\u0644\u0627\u06a9\u062a \u0633\u06d2\u062f\u0648\u0686\u0627\u0631 \u0646\u06c1\u06cc\u06ba \u06c1\u0648\u06af\u0627\u06d4 \u0622\u067e (\u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645) \u0646\u06d2 \u0648\u0636\u0627\u062d\u062a \u0641\u0631\u0645\u0627\u0626\u06cc \u201d\u06cc\u06c1 \u062a\u0648 \u067e\u06cc\u0634\u06cc \u06c1\u06d2\u201c\u06d4 \u06cc\u0639\u0646\u06cc \u0645\u0648\u0645\u0646 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0645\u0639\u0627\u0645\u0644\u06c1 \u062d\u0633\u0627\u0628 \u06a9\u0627 \u0646\u06c1\u06cc\u06ba \u06c1\u0648\u06af\u0627\u060c \u0627\u06cc\u06a9 \u0633\u0631\u0633\u0631\u06cc \u0633\u06cc \u067e\u06cc\u0634\u06cc \u06c1\u0648\u06af\u06cc \u0645\u0648\u0645\u0646 \u0631\u0628 \u06a9\u06d2 \u0633\u0627\u0645\u0646\u06d2 \u067e\u06cc\u0634 \u06a9\u06cc\u06d2 \u062c\u0627\u0626\u06cc\u06ba \u06af\u06d2\u060c \u062c\u0633 \u06a9\u0627 \u0645\u0646\u0627\u0642\u0634\u06c1 \u06c1\u0648\u0627 \u06cc\u0639\u0646\u06cc \u067e\u0648\u0686\u06be \u06af\u0686\u06be \u06c1\u0648\u0626\u06cc \u0648\u06c1 \u0645\u0627\u0631\u0627 \u06af\u06cc\u0627\u06d4 ( \u0635\u062d\u064a\u062d \u0627\u0644\u0628\u062e\u0627\u0631\u064a\u060c \u062a\u0641\u0633\u064a\u0631 \u0633\u0648\u0631\u0629 \u0627\u0646\u0634\u0642\u0627\u0642 ) \u0627\u06cc\u06a9 \u0627\u0648\u0631 \u0631\u0648\u0627\u06cc\u062a \u0645\u06cc\u06ba \u062d\u0636\u0631\u062a \u0639\u0627\u0626\u0634\u06c1 (\u0631\u0636\u06cc \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0627) \u0641\u0631\u0645\u0627\u062a\u06cc \u06c1\u06cc\u06ba\u06d4 \u0646\u0628\u06cc (\u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645) \u0627\u067e\u0646\u06cc \u0628\u0639\u0636 \u0646\u0645\u0627\u0632 \u0645\u06cc\u06ba \u06cc\u06c1 \u062f\u0639\u0627 \u067e\u0691\u06be\u062a\u06d2 \u062a\u06be\u06d2\u06d4 \u201d\u0627\u0644\u0644\u0651\u064e\u0647\u064f\u0645\u0651\u064e \u062d\u064e\u0627\u0633\u0650\u0628\u0652\u0646\u0650\u064a \u062d\u0650\u0633\u064e\u0627\u0628\u064b\u0627 \u064a\u064e\u0633\u0650\u064a\u0631\u064b\u0627\u201c (\u0627\u06d2 \u0627\u0644\u0644\u06c1 \u0645\u06cc\u0631\u0627 \u062d\u0633\u0627\u0628 \u0622\u0633\u0627\u0646 \u0641\u0631\u0645\u0627\u0646\u0627) \u0646\u0645\u0627\u0632 \u0633\u06d2 \u0641\u0631\u0627\u063a\u062a \u06a9\u06d2 \u0628\u0639\u062f \u0645\u06cc\u06ba \u0646\u06d2 \u067e\u0648\u0686\u06be\u0627\u060c \u062d\u0633\u0627\u0628\u0627 \u06cc\u0633\u06cc\u0631\u0627 \u201d\u0622\u0633\u0627\u0646 \u062d\u0633\u0627\u0628\u201c \u06a9\u0627 \u06a9\u06cc\u0627 \u0645\u0637\u0644\u0628 \u06c1\u06d2 \u061f \u0622\u067e (\u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645) \u0646\u06d2 \u0641\u0631\u0645\u0627\u06cc\u0627\u060c \u0627\u0644\u0644\u06c1 \u062a\u0639\u0627\u0644\u06cc\u0670 \u0627\u0633 \u06a9\u0627 \u0627\u0639\u0645\u0627\u0644 \u0646\u0627\u0645\u06c1 \u062f\u06cc\u06a9\u06be\u06d2 \u06af\u0627 \u0627\u0648\u0631 \u067e\u06be\u0631 \u0627\u0633\u06d2 \u0645\u0639\u0627\u0641 \u0641\u0631\u0645\u0627 \u062f\u06d2 \u06af\u0627\u06d4\u06d4\u06d4 ( \u0645\u0633\u0646\u062f \u0627\u062d\u0645\u062f\u060c6 \/ 48 ) \u06d4"},{"id":"5893","sura":"84","aya":"9","arabic_text":"\u0648\u064e\u064a\u064e\u0646\u0642\u064e\u0644\u0650\u0628\u064f \u0625\u0650\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0647\u06e1\u0644\u0650\u0647\u0650\u06e6 \u0645\u064e\u0633\u06e1\u0631\u064f\u0648\u0631\u0657\u0627","translation":"\u0627\u0648\u0631 \u0648\u0647 \u0627\u067e\u0646\u06d2 \u0627\u06c1\u0644 \u06a9\u06cc \u0637\u0631\u0641 \u06c1\u0646\u0633\u06cc \u062e\u0648\u0634\u06cc \u0644\u0648\u0679 \u0622\u0626\u06d2 \u06af\u0627.[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u062c\u0648 \u0627\u0633 \u06a9\u06d2 \u06af\u06be\u0631 \u0648\u0627\u0644\u0648\u06ba \u0645\u06cc\u06ba \u0633\u06d2 \u062c\u0646\u062a\u06cc \u06c1\u0648\u06ba \u06af\u06d2\u06d4 \u06cc\u0627 \u0627\u0633 \u0633\u06d2 \u0645\u0631\u0627\u062f \u0648\u06c1 \u062d\u0648\u0631\u0639\u06cc\u0646 \u0627\u0648\u0631 \u0648\u0644\u062f\u0627\u0646 \u06c1\u06cc\u06ba \u062c\u0648 \u062c\u0646\u062a\u06cc\u0648\u06ba \u06a9\u0648 \u0645\u0644\u06cc\u06ba \u06af\u06d2\u06d4"},{"id":"5894","sura":"84","aya":"10","arabic_text":"\u0648\u064e\u0623\u064e\u0645\u0651\u064e\u0627 \u0645\u064e\u0646\u06e1 \u0623\u064f\u0648\u062a\u0650\u064a\u064e \u0643\u0650\u062a\u064e\u0670\u0628\u064e\u0647\u064f\u06e5 \u0648\u064e\u0631\u064e\u0627\u0653\u0621\u064e \u0638\u064e\u0647\u06e1\u0631\u0650\u0647\u0650\u06e6","translation":"\u06c1\u0627\u06ba \u062c\u0633 \u0634\u062e\u0635 \u06a9\u0627 \u0627\u0639\u0645\u0627\u0644 \u0646\u0627\u0645\u06c1 \u0627\u0633 \u06a9\u06cc \u067e\u06cc\u0679\u06be \u06a9\u06d2 \u067e\u06cc\u0686\u06be\u06d2 \u0633\u06d2 \u062f\u06cc\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627.","footnotes":""},{"id":"5895","sura":"84","aya":"11","arabic_text":"\u0641\u064e\u0633\u064e\u0648\u06e1\u0641\u064e \u064a\u064e\u062f\u06e1\u0639\u064f\u0648\u0627\u0652 \u062b\u064f\u0628\u064f\u0648\u0631\u0657\u0627","translation":"\u062a\u0648 \u0648\u0647 \u0645\u0648\u062a \u06a9\u0648 \u0628\u0644\u0627\u0646\u06d2 \u0644\u06af\u06d2 \u06af\u0627.[1]","footnotes":"[1] \u062b\u064f\u0628\u064f\u0648\u0631\u064b\u0627 \u06c1\u0644\u0627\u06a9\u062a\u060c \u062e\u0633\u0627\u0631\u06c1\u06d4 \u06cc\u0639\u0646\u06cc \u0648\u06c1 \u0686\u06cc\u062e\u06d2 \u06af\u0627\u060c \u067e\u06a9\u0627\u0631\u06d2 \u06af\u0627\u060c \u0648\u0627\u0648\u06cc\u0644\u0627 \u06a9\u0631\u06d2 \u06af\u0627 \u06a9\u06c1 \u0645\u06cc\u06ba \u062a\u0648 \u0645\u0627\u0631\u0627 \u06af\u06cc\u0627\u060c \u06c1\u0644\u0627\u06a9 \u06c1\u0648\u06af\u06cc\u0627\u06d4"},{"id":"5896","sura":"84","aya":"12","arabic_text":"\u0648\u064e\u064a\u064e\u0635\u06e1\u0644\u064e\u0649\u0670 \u0633\u064e\u0639\u0650\u064a\u0631\u064b\u0627","translation":"\u0627\u0648\u0631 \u0628\u06be\u0691\u06a9\u062a\u06cc \u06c1\u0648\u0626\u06cc \u062c\u06c1\u0646\u0645 \u0645\u06cc\u06ba \u062f\u0627\u062e\u0644 \u06c1\u0648\u06af\u0627.","footnotes":""},{"id":"5897","sura":"84","aya":"13","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0643\u064e\u0627\u0646\u064e \u0641\u0650\u064a\u0653 \u0623\u064e\u0647\u06e1\u0644\u0650\u0647\u0650\u06e6 \u0645\u064e\u0633\u06e1\u0631\u064f\u0648\u0631\u064b\u0627","translation":"\u06cc\u06c1 \u0634\u062e\u0635 \u0627\u067e\u0646\u06d2 \u0645\u062a\u0639\u0644\u0642\u06cc\u0646 \u0645\u06cc\u06ba (\u062f\u0646\u06cc\u0627 \u0645\u06cc\u06ba) \u062e\u0648\u0634 \u062a\u06be\u0627.[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u062f\u0646\u06cc\u0627 \u0645\u06cc\u06ba \u0627\u067e\u0646\u06cc \u062e\u0648\u0627\u06c1\u0634\u0627\u062a \u0645\u06cc\u06ba \u0645\u06af\u0646 \u0627\u0648\u0631 \u0627\u067e\u0646\u06d2 \u06af\u06be\u0631 \u0648\u0627\u0644\u0648\u06ba \u06a9\u06d2\u062f\u0631\u0645\u06cc\u0627\u0646 \u0628\u0691\u0627 \u062e\u0648\u0634 \u062a\u06be\u0627\u06d4"},{"id":"5898","sura":"84","aya":"14","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0638\u064e\u0646\u0651\u064e \u0623\u064e\u0646 \u0644\u0651\u064e\u0646 \u064a\u064e\u062d\u064f\u0648\u0631\u064e","translation":"\u0627\u0633 \u06a9\u0627 \u062e\u06cc\u0627\u0644 \u062a\u06be\u0627 \u06a9\u06c1 \u0627\u0644\u0644\u06c1 \u06a9\u06cc \u0637\u0631\u0641 \u0644\u0648\u0679 \u06a9\u0631 \u06c1\u06cc \u0646\u06c1 \u062c\u0627\u0626\u06d2 \u06af\u0627.[1]","footnotes":"[1] \u06cc\u06c1 \u0627\u0633 \u06a9\u06d2 \u062e\u0648\u0634 \u06c1\u0648\u0646\u06d2 \u06a9\u06cc \u0639\u0644\u062a \u06c1\u06d2\u06d4 \u06cc\u0639\u0646\u06cc \u0622\u062e\u0631\u062a \u067e\u0631 \u0627\u0633 \u06a9\u0627 \u0639\u0642\u06cc\u062f\u06c1 \u06c1\u06cc \u0646\u06c1\u06cc\u06ba \u062a\u06be\u0627 \u06d4 \u062d\u0648\u0631 \u06a9\u06d2\u0645\u0639\u0646\u06cc \u06c1\u06cc\u06ba\u060c \u0644\u0648\u0679\u0646\u0627\u06d4 \u062c\u0633 \u0637\u0631\u062d \u0646\u0628\u06cc (\u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645) \u06a9\u06cc \u062f\u0639\u0627 \u06c1\u06d2 \u0627\u0644\u0644\u0651\u064e\u0647\u064f\u0645\u0651\u064e \u0625\u0650\u0646\u0651\u0650\u064a \