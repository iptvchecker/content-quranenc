2 \u06c1\u06cc\u06ba \u06a9\u06c1 \u0633\u0627\u0631\u06d2 \u06c1\u06cc \u0633\u062a\u0627\u0631\u06d2\u0645\u0631\u0627\u062f \u06c1\u06cc\u06ba\u060c \u06a9\u06cc\u0648\u06ba \u06a9\u06c1 \u0633\u0628 \u06c1\u06cc \u0627\u067e\u0646\u06d2 \u063a\u0627\u0626\u0628 \u06c1\u0648\u0646\u06d2 \u06a9\u06cc \u062c\u06af\u06c1 \u067e\u0631 \u063a\u0627\u0626\u0628 \u06c1\u0648 \u062c\u0627\u062a\u06d2 \u06c1\u06cc\u06ba \u06cc\u0627 \u062f\u0646 \u06a9\u0648 \u0686\u06be\u067e\u06d2 \u0631\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba \u0627\u0644\u0652\u062c\u064e\u0648\u064e\u0627\u0631\u0650 \u0686\u0644\u0646\u06d2 \u0648\u0627\u0644\u06d2\u060c \u0627\u0644\u0652\u0643\u064f\u0646\u0651\u064e\u0633\u0650 \u0686\u06be\u067e \u062c\u0627\u0646\u06d2 \u0648\u0627\u0644\u06d2\u060c \u062c\u06cc\u0633\u06d2 \u06c1\u0631\u0646 \u0627\u067e\u0646\u06d2 \u0645\u06a9\u0627\u0646 \u0627\u0648\u0631 \u0645\u0633\u06a9\u0646 \u0645\u06cc\u06ba \u0686\u06be\u067e \u062c\u0627\u062a\u0627 \u06c1\u06d2\u06d4"},{"id":"5817","sura":"81","aya":"17","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u064a\u06e1\u0644\u0650 \u0625\u0650\u0630\u064e\u0627 \u0639\u064e\u0633\u06e1\u0639\u064e\u0633\u064e","translation":"\u0627\u0648\u0631 \u0631\u0627\u062a \u06a9\u06cc \u062c\u0628 \u062c\u0627\u0646\u06d2 \u0644\u06af\u06d2.[1]","footnotes":"[1] \u0639\u064e\u0633\u0652\u0639\u064e\u0633\u064e\u060c \u0627\u0636\u062f\u0627\u062f \u0645\u06cc\u06ba \u0633\u06d2 \u06c1\u06d2\u060c \u06cc\u0639\u0646\u06cc \u0622\u0646\u06d2 \u0627\u0648\u0631 \u062c\u0627\u0646\u06d2 \u062f\u0648\u0646\u0648\u06ba \u0645\u0639\u0646\u0648\u06ba \u0645\u06cc\u06ba \u0627\u0633 \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06c1\u0648\u062a\u0627 \u06c1\u06d2\u060c \u062a\u0627\u06c1\u0645 \u06cc\u06c1\u0627\u06ba \u062c\u0627\u0646\u06d2 \u06a9\u06d2 \u0645\u0639\u0646\u06cc \u0645\u06cc\u06ba \u06c1\u06d2\u06d4"},{"id":"5818","sura":"81","aya":"18","arabic_text":"\u0648\u064e\u0671\u0644\u0635\u0651\u064f\u0628\u06e1\u062d\u0650 \u0625\u0650\u0630\u064e\u0627 \u062a\u064e\u0646\u064e\u0641\u0651\u064e\u0633\u064e","translation":"\u0627\u0648\u0631 \u0635\u0628\u062d \u06a9\u06cc \u062c\u0628 \u0686\u0645\u06a9\u0646\u06d2 \u0644\u06af\u06d2.[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u062c\u0628 \u0627\u0633 \u06a9\u0627 \u0638\u06c1\u0648\u0631 \u0648\u0637\u0644\u0648\u0639 \u06c1\u0648 \u062c\u0627\u0626\u06d2\u060c \u06cc\u0627 \u0648\u06c1 \u067e\u06be\u0679 \u0627\u0648\u0631 \u0646\u06a9\u0644 \u0622\u0626\u06d2\u06d4"},{"id":"5819","sura":"81","aya":"19","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u0642\u064e\u0648\u06e1\u0644\u064f \u0631\u064e\u0633\u064f\u0648\u0644\u0656 \u0643\u064e\u0631\u0650\u064a\u0645\u0656","translation":"\u06cc\u0642\u06cc\u0646\u0627\u064b \u06cc\u06c1 \u0627\u06cc\u06a9 \u0628\u0632\u0631\u06af \u0631\u0633\u0648\u0644 \u06a9\u0627 \u06a9\u06c1\u0627 \u06c1\u0648\u0627 \u06c1\u06d2.[1]","footnotes":"[1] \u0627\u0633 \u0644\u0626\u06d2 \u0648\u06c1 \u0627\u0633\u06d2 \u0627\u0644\u0644\u06c1 \u06a9\u06cc \u0637\u0631\u0641 \u0644\u06d2 \u06a9\u0631 \u0622\u06cc\u0627 \u06c1\u06d2\u06d4 \u0645\u0631\u0627\u062f \u062d\u0636\u0631\u062a \u062c\u0628\u0631\u0627\u0626\u06cc\u0644 (\u0639\u0644\u064a\u0647 \u0627\u0644\u0633\u0644\u0627\u0645) \u06c1\u06cc\u06ba\u06d4"},{"id":"5820","sura":"81","aya":"20","arabic_text":"\u0630\u0650\u064a \u0642\u064f\u0648\u0651\u064e\u0629\u064d \u0639\u0650\u0646\u062f\u064e \u0630\u0650\u064a \u0671\u0644\u06e1\u0639\u064e\u0631\u06e1\u0634\u0650 \u0645\u064e\u0643\u0650\u064a\u0646\u0656","translation":"\u062c\u0648 \u0642\u0648\u062a \u0648\u0627\ufefb \u06c1\u06d2[1] \u060c \u0639\u0631\u0634 \u0648\u0627\u0644\u06d2 (\u0627\u0644\u0644\u06c1) \u06a9\u06d2 \u0646\u0632\u062f\u06cc\u06a9 \u0628\u0644\u0646\u062f \u0645\u0631\u062a\u0628\u06c1 \u06c1\u06d2.","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u062c\u0648 \u06a9\u0627\u0645 \u0627\u0633 \u06a9\u06d2\u0633\u067e\u0631\u062f \u06a9\u06cc\u0627\u062c\u0627\u0626\u06d2\u060c\u0627\u0633\u06d2 \u067e\u0648\u0631\u06cc \u0642\u0648\u062a \u0633\u06d2 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u06d4"},{"id":"5821","sura":"81","aya":"21","arabic_text":"\u0645\u0651\u064f\u0637\u064e\u0627\u0639\u0656 \u062b\u064e\u0645\u0651\u064e \u0623\u064e\u0645\u0650\u064a\u0646\u0656","translation":"\u062c\u0633 \u06a9\u06cc (\u0622\u0633\u0645\u0627\u0646\u0648\u06ba \u0645\u06cc\u06ba) \u0627\u0637\u0627\u0639\u062a \u06a9\u06cc \u062c\u0627\u062a\u06cc \u06c1\u06d2 \u0627\u0648\u0631\u0627\u0645\u06cc\u0646[1] \u06c1\u06d2.","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u0641\u0631\u0634\u062a\u0648\u06ba \u06a9\u06d2 \u062f\u0631\u0645\u06cc\u0627\u0646 \u0627\u0633 \u06a9\u06cc \u0627\u0637\u0627\u0639\u062a \u06a9\u06cc \u062c\u0627\u062a\u06cc \u06c1\u06d2\u06d4 \u0648\u06c1 \u0641\u0631\u0634\u062a\u0648\u06ba \u06a9\u0627 \u0645\u0631\u062c\u0639 \u0627\u0648\u0631 \u0645\u0637\u0627\u0639 \u06c1\u06d2 \u0646\u06cc\u0632 \u0648\u062d\u06cc \u06a9\u06d2\u0633\u0644\u0633\u0644\u06d2 \u0645\u06cc\u06ba \u0627\u0645\u06cc\u0646 \u06c1\u06d2\u06d4"},{"id":"5822","sura":"81","aya":"22","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0635\u064e\u0627\u062d\u0650\u0628\u064f\u0643\u064f\u0645 \u0628\u0650\u0645\u064e\u062c\u06e1\u0646\u064f\u0648\u0646\u0656","translation":"\u0627\u0648\u0631 \u062a\u0645\u06c1\u0627\u0631\u0627 \u0633\u0627\u062a\u06be\u06cc \u062f\u06cc\u0648\u0627\u0646\u06c1 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2.[1]","footnotes":"[1] \u06cc\u06c1 \u062e\u0637\u0627\u0628 \u0627\u06c1\u0644 \u0645\u06a9\u06c1 \u0633\u06d2 \u06c1\u06d2 \u0627\u0648\u0631 \u0635\u0627\u062d\u0628 \u0645\u0631\u0627\u062f \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u06c1 (\u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645) \u06c1\u06cc\u06ba\u06d4 \u06cc\u0639\u0646\u06cc \u062a\u0645 \u062c\u0648 \u06af\u0645\u0627\u0646 \u0631\u06a9\u06be\u062a\u06d2 \u06c1\u0648 \u06a9\u06c1 \u062a\u0645\u06c1\u0627\u0631\u0627 \u06c1\u0645 \u0646\u0633\u0628 \u0627\u0648\u0631 \u06c1\u0645 \u0648\u0637\u0646 \u0633\u0627\u062a\u06be \u0633\u0627\u062a\u06be\u06cc\u060c ( \u0645\u062d\u0645\u062f \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645) \u062f\u06cc\u0648\u0627\u0646\u06c1 \u06c1\u06d2 \u06d4 \u0646\u0639\u0648\u0630 \u0628\u0627\u0644\u0644\u06c1 \u06d4 \u0627\u06cc\u0633\u0627 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u060c \u0630\u0631\u0627 \u0642\u0631\u0622\u0646 \u067e\u0691\u06be \u06a9\u0631 \u062a\u0648 \u062f\u06cc\u06a9\u06be\u0648\u06a9\u06c1 \u06a9\u06cc\u0627 \u06a9\u0648\u0626\u06cc \u062f\u06cc\u0648\u0627\u0646\u06c1 \u0627\u06cc\u0633\u06d2 \u0645\u0639\u0627\u0631\u0641 \u0648\u062d\u0642\u0627\u0626\u0642 \u0628\u06cc\u0627\u0646 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u06d2 \u0627\u0648\u0631 \u06af\u0632\u0634\u062a\u06c1 \u0642\u0648\u0645\u0648\u06ba \u06a9\u06d2 \u0635\u062d\u06cc\u062d \u0635\u062d\u06cc\u062d \u062d\u0627\u0644\u0627\u062a \u0628\u062a\u0644\u0627 \u0633\u06a9\u062a\u0627 \u06c1\u06d2 \u062c\u0648 \u0627\u0633 \u0642\u0631\u0622\u0646 \u0645\u06cc\u06ba \u0628\u06cc\u0627\u0646 \u06a9\u0626\u06d2 \u06af\u0626\u06d2 \u06c1\u06cc\u06ba\u06d4"},{"id":"5823","sura":"81","aya":"23","arabic_text":"\u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u0631\u064e\u0621\u064e\u0627\u0647\u064f \u0628\u0650\u0671\u0644\u06e1\u0623\u064f\u0641\u064f\u0642\u0650 \u0671\u0644\u06e1\u0645\u064f\u0628\u0650\u064a\u0646\u0650","translation":"\u0627\u0633 \u0646\u06d2 \u0627\u0633 (\u0641\u0631\u0634\u062a\u06d2) \u06a9\u0648 \u0622\u0633\u0645\u0627\u0646 \u06a9\u06d2 \u06a9\u06be\u0644\u06d2 \u06a9\u0646\u0627\u0631\u06d2 \u067e\u0631 \u062f\u06cc\u06a9\u06be\u0627 \u0628\u06be\u06cc \u06c1\u06d2.[1]","footnotes":"[1] \u06cc\u06c1 \u067e\u06c1\u0644\u06d2 \u0630\u06a9\u0631 \u06af\u0632\u0631 \u0686\u06a9\u0627 \u06c1\u06d2 \u06a9\u06c1 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u06c1 (\u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645) \u0646\u06d2 \u062d\u0636\u0631\u062a \u062c\u0628\u0631\u0627\u0626\u06cc\u0644 \u06a9\u0648 \u062f\u0648 \u0645\u0631\u062a\u0628\u06c1 \u0627\u0646 \u06a9\u06cc \u0627\u0635\u0644 \u062d\u0627\u0644\u062a \u0645\u06cc\u06ba \u062f\u06cc\u06a9\u06be\u0627 \u06c1\u06d2\u060c \u062c\u0646 \u0645\u06cc\u06ba \u0633\u06d2 \u0627\u06cc\u06a9 \u06a9\u0627 \u06cc\u06c1\u0627\u06ba \u0630\u06a9\u0631 \u06c1\u06d2\u06d4 \u06cc\u06c1 \u0627\u0628\u062a\u062f\u0627\u0626\u06d2 \u0646\u0628\u0648\u062a \u06a9\u0627 \u0648\u0627\u0642\u0639\u06c1 \u06c1\u06d2\u060c \u0627\u0633 \u0648\u0642\u062a \u062d\u0636\u0631\u062a \u062c\u0628\u0631\u0627\u0626\u06cc\u0644 (\u0639\u0644\u064a\u0647 \u0627\u0644\u0633\u0644\u0627\u0645) \u06a9\u06d2 \u0686\u06be \u0633\u0648 \u067e\u0631 \u062a\u06be\u06d2\u060c \u062c\u0646\u06c1\u0648\u06ba \u0646\u06d2 \u0622\u0633\u0645\u0627\u0646 \u06a9\u06d2 \u06a9\u0646\u0627\u0631\u0648\u06ba \u06a9\u0648 \u0628\u06be\u0631 \u062f\u06cc\u0627 \u062a\u06be\u0627\u06d4 \u062f\u0648\u0633\u0631\u06cc \u0645\u0631\u062a\u0628\u06c1 \u0645\u0639\u0631\u0627\u062c \u06a9\u06d2 \u0645\u0648\u0642\u0639\u06d2 \u067e\u0631 \u062f\u06cc\u06a9\u06be\u0627\u06d4 \u062c\u06cc\u0633\u0627 \u06a9\u06c1 \u0633\u0648\u0631\u06c1\u0654 \u0646\u062c\u0645 \u0645\u06cc\u06ba \u062a\u0641\u0635\u06cc\u0644 \u06af\u0632\u0631 \u0686\u06a9\u06cc \u06c1\u06d2\u06d4"},{"id":"5824","sura":"81","aya":"24","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0647\u064f\u0648\u064e \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u06e1\u063a\u064e\u064a\u06e1\u0628\u0650 \u0628\u0650\u0636\u064e\u0646\u0650\u064a\u0646\u0656","translation":"\u0627\u0648\u0631 \u06cc\u06c1 \u063a\u06cc\u0628 \u06a9\u06cc \u0628\u0627\u062a\u0648\u06ba \u06a9\u0648 \u0628\u062a\u0644\u0627\u0646\u06d2 \u0645\u06cc\u06ba \u0628\u062e\u06cc\u0644 \u0628\u06be\u06cc \u0646\u06c1\u06cc\u06ba.[1]","footnotes":"[1] \u06cc\u06c1 \u0646\u0628\u06cc (\u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645) \u06a9\u06cc \u0628\u0627\u0628\u062a \u0648\u0636\u0627\u062d\u062a \u06a9\u06cc \u062c\u0627 \u0631\u06c1\u06cc \u06c1\u06d2 \u06a9\u06c1 \u0622\u067e \u06a9\u0648 \u062c\u0646 \u0628\u0627\u062a\u0648\u06ba \u06a9\u06cc \u0627\u0637\u0644\u0627\u0639 \u062f\u06cc \u062c\u0627\u062a\u06cc \u06c1\u06d2\u060c \u062c\u0648 \u0627\u062d\u06a9\u0627\u0645 \u0648\u0641\u0631\u0627\u0626\u0636 \u0622\u067e \u06a9\u0648 \u0628\u062a\u0644\u0627\u0626\u06d2 \u062c\u0627\u062a\u06d2 \u06c1\u06cc\u06ba\u060c \u0627\u0646 \u0645\u06cc\u06ba \u0633\u06d2\u06a9\u0648\u0626\u06cc \u0628\u0627\u062a \u0622\u067e \u0627\u067e\u0646\u06d2 \u067e\u0627\u0633 \u0646\u06c1\u06cc\u06ba \u0631\u06a9\u06be\u062a\u06d2 \u0628\u0644\u06a9\u06c1 \u0641\u0631\u06cc\u0636\u06c1\u0654 \u0631\u0633\u0627\u0644\u062a \u06a9\u06cc \u0630\u0645\u06d2 \u062f\u0627\u0631\u06cc\u0648\u06ba \u06a9\u0627 \u0627\u062d\u0633\u0627\u0633 \u06a9\u0631\u062a\u06d2 \u06c1\u0648\u0626\u06d2 \u06c1\u0631 \u0628\u0627\u062a \u0627\u0648\u0631 \u06c1\u0631 \u062d\u06a9\u0645 \u0644\u0648\u06af\u0648\u06ba \u062a\u06a9 \u067e\u06c1\u0646\u0686\u0627 \u062f\u06cc\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4"},{"id":"5825","sura":"81","aya":"25","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0647\u064f\u0648\u064e \u0628\u0650\u0642\u064e\u0648\u06e1\u0644\u0650 \u0634\u064e\u064a\u06e1\u0637\u064e\u0670\u0646\u0656 \u0631\u0651\u064e\u062c\u0650\u064a\u0645\u0656","translation":"\u0627\u0648\u0631 \u06cc\u06c1 \u0642\u0631\u0622\u0646 \u0634\u06cc\u0637\u0627\u0646 \u0645\u0631\u062f\u0648\u062f \u06a9\u0627 \u06a9\u0644\u0627\u0645 \u0646\u06c1\u06cc\u06ba.[1]","footnotes":"[1] \u062c\u0633 \u0637\u0631\u062d \u0646\u062c\u0648\u0645\u06cc\u0648\u06ba \u06a9\u06d2 \u067e\u0627\u0633 \u0634\u06cc\u0637\u0627\u0646 \u0622\u062a\u06d2 \u06c1\u06cc\u06ba \u0627\u0648\u0631 \u0622\u0633\u0645\u0627\u0646\u0648\u06ba \u06a9\u06cc \u0628\u0639\u0636 \u0686\u0648\u0631\u06cc \u0686\u06be\u067e\u06cc \u0628\u0627\u062a\u06cc\u06ba \u0627\u062f\u06be\u0648\u0631\u06cc \u0634\u06a9\u0644 \u0645\u06cc\u06ba \u0627\u0646\u06c1\u06cc\u06ba \u0628\u062a\u0644\u0627 \u062f\u06cc\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u0642\u0631\u0622\u0646 \u0627\u06cc\u0633\u0627 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u06d4"},{"id":"5826","sura":"81","aya":"26","arabic_text":"\u0641\u064e\u0623\u064e\u064a\u06e1\u0646\u064e \u062a\u064e\u0630\u06e1\u0647\u064e\u0628\u064f\u0648\u0646\u064e","translation":"\u067e\u06be\u0631 \u062a\u0645 \u06a9\u06c1\u0627\u06ba \u062c\u0627 \u0631\u06c1\u06d2 \u06c1\u0648.[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u06a9\u06cc\u0648\u06ba \u0627\u0633 \u0633\u06d2\u0627\u0639\u0631\u0627\u0636 \u06a9\u0631\u062a\u06d2 \u06c1\u0648 \u061f \u0627\u0648\u0631 \u0627\u0633 \u06a9\u06cc \u0627\u0637\u0627\u0639\u062a \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u062a\u06d2 \u061f"},{"id":"5827","sura":"81","aya":"27","arabic_text":"\u0625\u0650\u0646\u06e1 \u0647\u064f\u0648\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0630\u0650\u0643\u06e1\u0631\u065e \u0644\u0651\u0650\u0644\u06e1\u0639\u064e\u0670\u0644\u064e\u0645\u0650\u064a\u0646\u064e","translation":"\u06cc\u06c1 \u062a\u0648 \u062a\u0645\u0627\u0645 \u062c\u06c1\u0627\u0646 \u0648\u0627\u0644\u0648\u06ba \u06a9\u06d2 \u0644\u0626\u06d2 \u0646\u0635\u06cc\u062d\u062a \u0646\u0627\u0645\u06c1 \u06c1\u06d2.","footnotes":""},{"id":"5828","sura":"81","aya":"28","arabic_text":"\u0644\u0650\u0645\u064e\u0646 \u0634\u064e\u0627\u0653\u0621\u064e \u0645\u0650\u0646\u0643\u064f\u0645\u06e1 \u0623\u064e\u0646 \u064a\u064e\u0633\u06e1\u062a\u064e\u0642\u0650\u064a\u0645\u064e","translation":"(\u0628\u0627\u0644\u062e\u0635\u0648\u0635) \u0627\u0633 \u06a9\u06d2 \u0644\u0626\u06d2 \u062c\u0648 \u062a\u0645 \u0645\u06cc\u06ba \u0633\u06d2 \u0633\u06cc\u062f\u06be\u06cc \u0631\u0627\u0647 \u067e\u0631 \u0686\u0644\u0646\u0627 \u0686\u0627\u06c1\u06d2.","footnotes":""},{"id":"5829","sura":"81","aya":"29","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u062a\u064e\u0634\u064e\u0627\u0653\u0621\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627\u0653 \u0623\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0631\u064e\u0628\u0651\u064f \u0671\u0644\u06e1\u0639\u064e\u0670\u0644\u064e\u0645\u0650\u064a\u0646\u064e","translation":"\u0627\u0648\u0631 \u062a\u0645 \u0628\u063a\u06cc\u0631 \u067e\u0631\u0648\u0631\u062f\u06af\u0627\u0631 \u0639\u0627\u0644\u0645 \u06a9\u06d2 \u0686\u0627\u06c1\u06d2 \u06a9\u0686\u06be \u0646\u06c1\u06cc\u06ba \u0686\u0627\u0647 \u0633\u06a9\u062a\u06d2.[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u062a\u0645\u06c1\u0627\u0631\u06cc \u0686\u0627\u06c1\u062a \u060c \u0627\u0644\u0644\u06c1 \u06a9\u06cc \u062a\u0648\u0641\u06cc\u0642 \u067e\u0631 \u0645\u0646\u062d\u0635\u0631 \u06c1\u06d2\u060c \u062c\u0628 \u062a\u06a9 \u062a\u0645\u06c1\u0627\u0631\u06cc \u0686\u0627\u06c1\u062a \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0627\u0644\u0644\u06c1 \u06a9\u06cc \u0645\u0634\u06cc\u062a \u0627\u0648\u0631 \u0627\u0633 \u06a9\u06cc \u062a\u0648\u0641\u06cc\u0642 \u0628\u06be\u06cc \u0634\u0627\u0645\u0644 \u0646\u06c1\u06cc\u06ba \u06c1\u0648\u06af\u06cc\u060c \u0627\u0633 \u0648\u0642\u062a \u062a\u06a9 \u062a\u0645 \u0633\u06cc\u062f\u06be\u0627 \u0631\u0627\u0633\u062a\u06c1 \u0628\u06be\u06cc \u0627\u062e\u062a\u06cc\u0627\u0631 \u0646\u06c1\u06cc\u06ba \u06a9\u0631 \u0633\u06a9\u062a\u06d2\u06d4 \u06cc\u06c1 \u0648\u06c1\u06cc \u0645\u0636\u0645\u0648\u0646 \u06c1\u06d2 \u062c\u0648 \u0625\u0650\u0646\u0651\u064e\u0643\u064e \u0644\u0627 \u062a\u064e\u0647\u0652\u062f\u0650\u064a \u0645\u064e\u0646\u0652 \u0623\u064e\u062d\u0652\u0628\u064e\u0628\u0652\u062a\u064e (\u0627\u0644\u0642\u0635\u0635: 56) \u0648\u063a\u06cc\u0631\u06c1 \u0622\u06cc\u0627\u062a \u0645\u06cc\u06ba \u0628\u06cc\u0627\u0646 \u06c1\u0648\u0627 \u06c1\u06d2\u06d4"}]}