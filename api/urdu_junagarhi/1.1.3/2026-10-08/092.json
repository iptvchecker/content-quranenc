644\u06c1 \u06a9\u06cc \u0631\u0627\u06c1 \u0645\u06cc\u06ba \u062e\u0631\u0686 \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u06d2 \u06af\u0627 \u0627\u0648\u0631 \u0627\u0644\u0644\u06c1 \u06a9\u06d2 \u062d\u06a9\u0645 \u0633\u06d2 \u0628\u06d2 \u067e\u0631\u0648\u0627\u06c1\u06cc\u060c \u06a9\u0631\u06d2 \u06af\u0627\u06d4 - \u06cc\u0627 \u0622\u062e\u0631\u062a \u06a9\u06cc \u062c\u0632\u0627 \u0627\u0648\u0631 \u062d\u0633\u0627\u0628 \u06a9\u062a\u0627\u0628 \u06a9\u0627 \u0627\u0646\u06a9\u0627\u0631 \u06a9\u0631\u06d2 \u06af\u0627\u06d4"},{"id":"6067","sura":"92","aya":"9","arabic_text":"\u0648\u064e\u0643\u064e\u0630\u0651\u064e\u0628\u064e \u0628\u0650\u0671\u0644\u06e1\u062d\u064f\u0633\u06e1\u0646\u064e\u0649\u0670","translation":"\u0627\u0648\u0631 \u0646\u06cc\u06a9 \u0628\u0627\u062a \u06a9\u06cc \u062a\u06a9\u0630\u06cc\u0628 \u06a9\u06cc.[1]","footnotes":"[1] \u06cc\u0627 \u0622\u062e\u0631\u062a \u06a9\u06cc \u062c\u0632\u0627 \u0627\u0648\u0631 \u062d\u0633\u0627\u0628 \u06a9\u062a\u0627\u0628 \u06a9\u0627 \u0627\u0646\u06a9\u0627\u0631 \u06a9\u0631\u06d2 \u06af\u0627\u06d4-"},{"id":"6068","sura":"92","aya":"10","arabic_text":"\u0641\u064e\u0633\u064e\u0646\u064f\u064a\u064e\u0633\u0651\u0650\u0631\u064f\u0647\u064f\u06e5 \u0644\u0650\u0644\u06e1\u0639\u064f\u0633\u06e1\u0631\u064e\u0649\u0670","translation":"\u062a\u0648 \u06c1\u0645 \u0628\u06be\u06cc \u0627\u0633 \u06a9\u06cc \u062a\u0646\u06af\u06cc \u0648\u0645\u0634\u06a9\u0644 \u06a9\u06d2 \u0633\u0627\u0645\u0627\u0646 \u0645\u06cc\u0633\u0631 \u06a9\u0631 \u062f\u06cc\u06ba \u06af\u06d2.[1]","footnotes":"[1] \u0639\u064f\u0633\u0652\u0631\u064e\u0649( \u062a\u0646\u06af\u06cc ) \u0633\u06d2\u0645\u0631\u0627\u062f \u06a9\u0641\u0631 \u0648\u0645\u0639\u0635\u06cc\u062a \u0627\u0648\u0631 \u0637\u0631\u06cc\u0642 \u0634\u0631 \u06c1\u06d2\u06d4 \u06cc\u0639\u0646\u06cc \u06c1\u0645 \u0627\u0633 \u06a9\u06d2 \u0644\u0626\u06d2 \u0646\u0627\u0641\u0631\u0645\u0627\u0646\u06cc \u06a9\u0627 \u0631\u0627\u0633\u062a\u06c1 \u0622\u0633\u0627\u0646 \u06a9\u0631 \u062f\u06cc\u06ba \u06af\u06d2\u060c \u062c\u0633 \u0633\u06d2 \u0627\u0633 \u06a9\u06d2 \u0644\u0626\u06d2 \u062e\u06cc\u0631 \u0648\u0633\u0639\u0627\u062f\u062a \u06a9\u06d2 \u0631\u0627\u0633\u062a\u06d2 \u0645\u0634\u06a9\u0644 \u06c1\u0648 \u062c\u0627\u0626\u06cc\u06ba \u06af\u06d2\u06d4 \u0642\u0631\u0622\u0646 \u0645\u062c\u06cc\u062f \u0645\u06cc\u06ba \u06cc\u06c1 \u0645\u0636\u0645\u0648\u0646 \u06a9\u0626\u06cc \u062c\u06af\u06c1 \u0628\u06cc\u0627\u0646 \u06a9\u06cc\u0627 \u06af\u06cc\u0627 \u06c1\u06d2 \u06a9\u06c1 \u062c\u0648 \u062e\u06cc\u0631 \u0648\u0631\u0634\u062f \u06a9\u0627 \u0631\u0627\u0633\u062a\u06c1 \u0627\u067e\u0646\u0627\u062a\u0627 \u06c1\u06d2\u060c \u0627\u0633 \u06a9\u06d2 \u0635\u0644\u06d2 \u0645\u06cc\u06ba \u0627\u0644\u0644\u06c1 \u0627\u0633\u06d2 \u062e\u06cc\u0631 \u06a9\u06cc \u062a\u0648\u0641\u06cc\u0642 \u0633\u06d2 \u0646\u0648\u0627\u0632\u062a\u0627 \u06c1\u06d2 \u0627\u0648\u0631 \u062c\u0648 \u0634\u0631 \u0648\u0645\u0639\u0635\u06cc\u062a \u06a9\u0648 \u0627\u062e\u062a\u06cc\u0627\u0631 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u060c \u0627\u0644\u0644\u06c1 \u0627\u0633 \u06a9\u0648 \u0627\u0633 \u06a9\u06d2 \u062d\u0627\u0644 \u067e\u0631 \u0686\u06be\u0648\u0691\u062f\u06cc\u062a\u0627 \u06c1\u06d2 \u0627\u0648\u0631 \u06cc\u06c1 \u0627\u0633 \u062a\u0642\u062f\u06cc\u0631 \u06a9\u06d2 \u0645\u0637\u0627\u0628\u0642 \u06c1\u06cc \u06c1\u0648\u062a\u0627 \u06c1\u06d2 \u062c\u0648 \u0627\u0644\u0644\u06c1 \u0646\u06d2 \u0627\u067e\u0646\u06d2 \u0639\u0644\u0645 \u0633\u06d2 \u0644\u06a9\u06be \u0631\u06a9\u06be\u06cc \u06c1\u06d2\u06d4 ( \u0627\u0628\u0646 \u06a9\u062b\u06cc\u0631 ) \u06cc\u06c1 \u0645\u0636\u0645\u0648\u0646 \u062d\u062f\u06cc\u062b \u0645\u06cc\u06ba \u0628\u06be\u06cc \u0628\u06cc\u0627\u0646 \u06a9\u06cc\u0627 \u06af\u06cc\u0627 \u06c1\u06d2\u06d4 \u0646\u0628\u06cc (\u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645) \u0646\u06d2 \u0641\u0631\u0645\u0627\u06cc\u0627 \u062a\u0645 \u0639\u0645\u0644 \u06a9\u0631\u0648\u060c \u06c1\u0631 \u0634\u062e\u0635 \u062c\u0633 \u06a9\u0627\u0645 \u06a9\u06d2 \u0644\u0626\u06d2 \u067e\u06cc\u062f\u0627 \u06a9\u06cc\u0627 \u06af\u06cc\u0627 \u06c1\u06d2\u060c \u0648\u06c1 \u0627\u0633 \u06a9\u06d2 \u0644\u0626\u06d2 \u0622\u0633\u0627\u0646 \u06a9\u0631 \u062f\u06cc\u0627 \u062c\u0627\u062a\u0627 \u06c1\u06d2\u060c \u062c\u0648 \u0627\u06c1\u0644 \u0633\u0639\u0627\u062f\u062a \u0633\u06d2 \u06c1\u0648\u062a\u0627 \u06c1\u06d2\u060c \u0627\u0633\u06d2 \u0627\u06c1\u0644 \u0633\u0639\u0627\u062f\u062a \u0648\u0627\u0644\u06d2 \u0639\u0645\u0644 \u06a9\u06cc \u062a\u0648\u0641\u06cc\u0642 \u062f\u06d2 \u062f\u06cc \u062c\u0627\u062a\u06cc \u06c1\u06d2 \u0627\u0648\u0631 \u062c\u0648 \u0627\u06c1\u0644 \u0634\u0642\u0627\u0648\u062a \u0633\u06d2 \u06c1\u0648\u062a\u0627 \u06c1\u06d2\u060c \u0627\u0633 \u06a9\u06d2 \u0644\u0626\u06d2 \u0627\u06c1\u0644 \u0634\u0642\u0627\u0648\u062a \u0648\u0627\u0644\u06d2 \u0639\u0645\u0644 \u0622\u0633\u0627\u0646 \u06a9\u0631 \u062f\u06cc\u0626\u06d2 \u062c\u0627\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 ( \u0635\u062d\u064a\u062d \u0627\u0644\u0628\u062e\u0627\u0631\u064a\u060c \u062a\u0641\u0633\u064a\u0631 \u0633\u0648\u0631\u0629 \u0627\u0644\u0644\u064a\u0644 )"},{"id":"6069","sura":"92","aya":"11","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u064a\u064f\u063a\u06e1\u0646\u0650\u064a \u0639\u064e\u0646\u06e1\u0647\u064f \u0645\u064e\u0627\u0644\u064f\u0647\u064f\u06e5\u0653 \u0625\u0650\u0630\u064e\u0627 \u062a\u064e\u0631\u064e\u062f\u0651\u064e\u0649\u0670\u0653","translation":"\u0627\u0633 \u06a9\u0627 \u0645\u0627\u0644 \u0627\u0633\u06d2 (\u0627\u0648\u0646\u062f\u06be\u0627) \u06af\u0631\u0646\u06d2 \u06a9\u06d2 \u0648\u0642\u062a \u06a9\u0686\u06be \u06a9\u0627\u0645 \u0646\u06c1 \u0622\u0626\u06d2 \u06af\u0627.[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u062c\u0628 \u062c\u06c1\u0646\u0645 \u0645\u06cc\u06ba \u06af\u0631\u06d2 \u06af\u0627 \u062a\u0648 \u06cc\u06c1 \u0645\u0627\u0644\u060c \u062c\u0633\u06d2 \u0648\u06c1 \u062e\u0631\u0686 \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u062a\u0627 \u062a\u06be\u0627\u060c \u06a9\u0686\u06be \u06a9\u0627\u0645 \u0646\u06c1 \u0622\u0626\u06d2 \u06af\u0627\u06d4"},{"id":"6070","sura":"92","aya":"12","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0646\u064e\u0627 \u0644\u064e\u0644\u06e1\u0647\u064f\u062f\u064e\u0649\u0670","translation":"\u0628\u06cc\u0634\u06a9 \u0631\u0627\u0647 \u062f\u06a9\u06be\u0627 \u062f\u06cc\u0646\u0627 \u06c1\u0645\u0627\u0631\u06d2 \u0630\u0645\u06c1 \u06c1\u06d2.[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u062d\u0644\u0627\u0644 \u0627\u0648\u0631 \u062d\u0631\u0627\u0645\u060c \u062e\u06cc\u0631 \u0627\u0648\u0631 \u0634\u0631\u060c \u06c1\u062f\u0627\u06cc\u062a \u0627\u0648\u0631 \u0636\u0644\u0627\u0644\u062a \u06a9\u0648 \u0648\u0627\u0636\u062d \u0627\u0648\u0631 \u0628\u06cc\u0627\u0646 \u06a9\u0631\u0646\u0627 \u06c1\u0645\u0627\u0631\u06d2 \u0630\u0645\u06d2 \u06c1\u06d2\u06d4 ( \u062c\u0648 \u06a9\u06c1 \u06c1\u0645 \u0646\u06d2 \u06a9\u0631 \u062f\u06cc\u0627 \u06c1\u06d2)"},{"id":"6071","sura":"92","aya":"13","arabic_text":"\u0648\u064e\u0625\u0650\u0646\u0651\u064e \u0644\u064e\u0646\u064e\u0627 \u0644\u064e\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u064e\u0629\u064e \u0648\u064e\u0671\u0644\u06e1\u0623\u064f\u0648\u0644\u064e\u0649\u0670","translation":"\u0627\u0648\u0631 \u06c1\u0645\u0627\u0631\u06d2 \u06c1\u06cc \u06c1\u0627\u062a\u06be \u0622\u062e\u0631\u062a \u0627\u0648\u0631 \u062f\u0646\u06cc\u0627 \u06c1\u06d2.[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u062f\u0648\u0646\u0648\u06ba \u06a9\u06d2 \u0645\u0627\u0644\u06a9 \u06c1\u0645 \u06c1\u06cc \u06c1\u06cc\u06ba\u060c \u0627\u0646 \u0645\u06cc\u06ba \u062c\u0633 \u0637\u0631\u062d \u0686\u0627\u06c1\u06cc\u06ba \u062a\u0635\u0631\u0641 \u06a9\u0631\u06cc\u06ba \u0627\u0633 \u0644\u0626\u06d2 \u0627\u0646 \u062f\u0648\u0646\u0648\u06ba \u06a9\u06d2 \u06cc\u0627 \u0627\u0646 \u0645\u06cc\u06ba \u0633\u06d2 \u06a9\u0633\u06cc \u0627\u06cc\u06a9 \u06a9\u06d2 \u0637\u0627\u0644\u0628 \u06c1\u0645 \u0633\u06d2 \u06c1\u06cc \u0645\u0627\u0646\u06af\u06cc\u06ba \u06a9\u06cc\u0648\u06ba \u06a9\u06c1 \u06c1\u0631 \u0637\u0627\u0644\u0628 \u06a9\u0648 \u06c1\u0645 \u06c1\u06cc \u0627\u067e\u0646\u06cc \u0645\u0634\u06cc\u062a \u06a9\u06d2 \u0645\u0637\u0627\u0628\u0642 \u062f\u06cc\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4"},{"id":"6072","sura":"92","aya":"14","arabic_text":"\u0641\u064e\u0623\u064e\u0646\u0630\u064e\u0631\u06e1\u062a\u064f\u0643\u064f\u0645\u06e1 \u0646\u064e\u0627\u0631\u0657\u0627 \u062a\u064e\u0644\u064e\u0638\u0651\u064e\u0649\u0670","translation":"\u0645\u06cc\u06ba \u0646\u06d2 \u062a\u0648 \u062a\u0645\u06c1\u06cc\u06ba \u0634\u0639\u0644\u06d2 \u0645\u0627\u0631\u062a\u06cc \u06c1\u0648\u0626\u06cc \u0622\u06af \u0633\u06d2 \u0688\u0631\u0627 \u062f\u06cc\u0627 \u06c1\u06d2.","footnotes":""},{"id":"6073","sura":"92","aya":"15","arabic_text":"\u0644\u064e\u0627 \u064a\u064e\u0635\u06e1\u0644\u064e\u0649\u0670\u0647\u064e\u0627\u0653 \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u06e1\u0623\u064e\u0634\u06e1\u0642\u064e\u0649","translation":"\u062c\u0633 \u0645\u06cc\u06ba \u0635\u0631\u0641 \u0648\u06c1\u06cc \u0628\u062f\u0628\u062e\u062a \u062f\u0627\u062e\u0644 \u06c1\u0648\u06af\u0627.","footnotes":""},{"id":"6074","sura":"92","aya":"16","arabic_text":"\u0671\u0644\u0651\u064e\u0630\u0650\u064a \u0643\u064e\u0630\u0651\u064e\u0628\u064e \u0648\u064e\u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0649\u0670","translation":"\u062c\u0633 \u0646\u06d2 \u062c\u06be\u0679\u0644\u0627\u06cc\u0627 \u0627\u0648\u0631 (\u0627\u0633 \u06a9\u06cc \u067e\u06cc\u0631\u0648\u06cc \u0633\u06d2) \u0645\u0646\u06be \u067e\u06be\u06cc\u0631 \u0644\u06cc\u0627.[1]","footnotes":"[1] \u0627\u0633 \u0622\u06cc\u062a \u0633\u06d2 \u0645\u0631\u062c\u0626\u06c1 \u0641\u0631\u0642\u06d2 \u0646\u06d2 (\u062c\u0648 \u0627\u06cc\u06a9 \u0628\u0627\u0637\u0644 \u0641\u0631\u0642\u06c1 \u06af\u0632\u0631\u0627 \u06c1\u06d2) \u0627\u0633\u062a\u062f\u0644\u0627\u0644 \u06a9\u06cc\u0627 \u06c1\u06d2 \u06a9\u06c1 \u062c\u06c1\u0646\u0645 \u0645\u06cc\u06ba \u0635\u0631\u0641 \u06a9\u0627\u0641\u0631 \u06c1\u06cc \u062c\u0627\u0626\u06cc\u06ba \u06af\u06d2\u06d4 \u06a9\u0648\u0626\u06cc \u0645\u0633\u0644\u0645\u0627\u0646 \u0686\u0627\u06c1\u06d2 \u06a9\u062a\u0646\u0627 \u06c1\u06cc \u06af\u0646\u0627\u06c1 \u06af\u0627\u0631 \u06c1\u0648\u060c \u0648\u06c1 \u062c\u06c1\u0646\u0645 \u0645\u06cc\u06ba \u0646\u06c1\u06cc\u06ba \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4 \u0644\u06cc\u06a9\u0646 \u06cc\u06c1 \u0639\u0642\u06cc\u062f\u06c1 \u0627\u0646 \u0646\u0635\u0648\u0635 \u0635\u0631\u06cc\u062d\u06c1 \u06a9\u06d2 \u062e\u0644\u0627\u0641 \u06c1\u06d2 \u062c\u0646 \u0633\u06d2 \u0645\u0639\u0644\u0648\u0645 \u06c1\u0648\u062a\u0627 \u06c1\u06d2 \u06a9\u06c1 \u0628\u06c1\u062a \u0633\u06d2 \u0645\u0633\u0644\u0645\u0627\u0646 \u0628\u06be\u06cc\u060c \u062c\u0646 \u06a9\u0648 \u0627\u0644\u0644\u06c1 \u062a\u0639\u0627\u0644\u06cc\u0670 \u06a9\u0686\u06be \u0633\u0632\u0627 \u062f\u06cc\u0646\u0627 \u0686\u0627\u06c1\u06d2 \u06af\u0627\u060c \u06a9\u0686\u06be \u0639\u0631\u0635\u06d2 \u06a9\u06d2 \u0644\u0626\u06d2 \u062c\u06c1\u0646\u0645 \u0645\u06cc\u06ba \u062c\u0627\u0626\u06cc\u06ba \u06af\u06d2\u060c \u067e\u06be\u0631 \u0648\u06c1 \u0646\u0628\u06cc (\u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645) \u060c \u0645\u0644\u0627\u0626\u06a9\u06c1 \u0627\u0648\u0631 \u062f\u06cc\u06af\u0631 \u0635\u0627\u0644\u062d\u06cc\u0646 \u06a9\u06cc \u0634\u0641\u0627\u0639\u062a \u0633\u06d2 \u0646\u06a9\u0627\u0644 \u0644\u0626\u06d2 \u062c\u0627\u0626\u06cc\u06ba \u06af\u06d2\u060c \u06cc\u06c1\u0627\u06ba \u062d\u0635\u0631 \u06a9\u06d2 \u0627\u0646\u062f\u0627\u0632 \u0645\u06cc\u06ba \u062c\u0648 \u06a9\u06c1\u0627 \u06af\u06cc\u0627 \u06c1\u06d2\u060c \u0627\u0633 \u06a9\u0627 \u0645\u0637\u0644\u0628 \u06c1\u06d2 \u06a9\u06c1 \u062c\u0648 \u0644\u0648\u06af \u067e\u06a9\u06d2 \u06a9\u0627\u0641\u0631 \u0627\u0648\u0631 \u0646\u06c1\u0627\u06cc\u062a \u0628\u062f\u0628\u062e\u062a \u06c1\u06cc\u06ba\u060c \u062c\u06c1\u0646\u0645 \u062f\u0631\u0627\u0635\u0644 \u0627\u0646 \u06c1\u06cc \u06a9\u06d2 \u0644\u0626\u06d2 \u0628\u0646\u0627\u0626\u06cc \u06af\u0626\u06cc \u06c1\u06d2\u060c \u062c\u0633 \u0645\u06cc\u06ba \u0648\u06c1 \u0644\u0627\u0632\u0645\u06cc \u0627\u0648\u0631 \u062d\u062a\u0645\u06cc \u0637\u0648\u0631 \u067e\u0631 \u0627\u0648\u0631 \u06c1\u0645\u06cc\u0634\u06c1 \u06a9\u06d2 \u0644\u0626\u06d2 \u062f\u0627\u062e\u0644 \u06c1\u0648\u06ba \u06af\u06d2\u06d4 \u0627\u06af\u0631 \u06a9\u0686\u06be \u0646\u0627\u0641\u0631\u0645\u0627\u0646 \u0642\u0633\u0645 \u06a9\u06d2 \u0645\u0633\u0644\u0645\u0627\u0646 \u062c\u06c1\u0646\u0645 \u0645\u06cc\u06ba \u062c\u0627\u0626\u06cc\u06ba \u06af\u06d2 \u062a\u0648 \u0648\u06c1 \u0644\u0627\u0632\u0645\u06cc \u0627\u0648\u0631 \u062d\u062a\u0645\u06cc \u0637\u0648\u0631 \u067e\u0631 \u0627\u0648\u0631 \u06c1\u0645\u06cc\u0634\u06c1 \u06a9\u06d2 \u0644\u0626\u06d2 \u0646\u06c1\u06cc\u06ba \u062c\u0627\u0626\u06cc\u06ba \u06af\u06d2\u060c \u0628\u0644\u06a9\u06c1 \u0628\u0637\u0648\u0631 \u0633\u0632\u0627 \u0627\u0646 \u06a9\u0627 \u06cc\u06c1 \u062f\u062e\u0648\u0644 \u0639\u0627\u0631\u0636\u06cc \u06c1\u0648\u06af\u0627\u06d4 ( \u0641\u062a\u062d \u0627\u0644\u0642\u062f\u06cc\u0631 )\u06d4"},{"id":"6075","sura":"92","aya":"17","arabic_text":"\u0648\u064e\u0633\u064e\u064a\u064f\u062c\u064e\u0646\u0651\u064e\u0628\u064f\u0647\u064e\u0627 \u0671\u0644\u06e1\u0623\u064e\u062a\u06e1\u0642\u064e\u0649","translation":"\u0627\u0648\u0631 \u0627\u0633 \u0633\u06d2 \u0627\u06cc\u0633\u0627 \u0634\u062e\u0635 \u062f\u0648\u0631 \u0631\u06a9\u06be\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627 \u062c\u0648 \u0628\u0691\u0627 \u067e\u0631\u06c1\u06cc\u0632\u06af\u0627\u0631 \u06c1\u0648 \u06af\u0627.[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u062c\u06c1\u0646\u0645 \u0633\u06d2 \u062f\u0648\u0631 \u0631\u06c1\u06d2 \u06af\u0627 \u0627\u0648\u0631 \u062c\u0646\u062a \u0645\u06cc\u06ba \u062f\u0627\u062e\u0644 \u06c1\u0648\u06af\u0627\u06d4"},{"id":"6076","sura":"92","aya":"18","arabic_text":"\u0671\u0644\u0651\u064e\u0630\u0650\u064a \u064a\u064f\u0624\u06e1\u062a\u0650\u064a \u0645\u064e\u0627\u0644\u064e\u0647\u064f\u06e5 \u064a\u064e\u062a\u064e\u0632\u064e\u0643\u0651\u064e\u0649\u0670","translation":"\u062c\u0648 \u067e\u0627\u06a9\u06cc \u062d\u0627\u0635\u0644 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u0626\u06d2 \u0627\u067e\u0646\u0627 \u0645\u0627\u0644 \u062f\u06cc\u062a\u0627 \u06c1\u06d2.[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u062c\u0648 \u0627\u067e\u0646\u0627 \u0645\u0627\u0644 \u0627\u0644\u0644\u06c1 \u06a9\u06d2 \u062d\u06a9\u0645 \u06a9\u06d2 \u0645\u0637\u0627\u0628\u0642 \u062e\u0631\u0686 \u06a9\u0631\u062a\u0627 \u06c1\u06d2 \u062a\u0627\u06a9\u06c1 \u0627\u0633 \u06a9\u0627 \u0646\u0641\u0633 \u0628\u06be\u06cc \u0627\u0648\u0631 \u0627\u0633 \u06a9\u0627 \u0645\u0627\u0644 \u0628\u06be\u06cc \u067e\u0627\u06a9 \u06c1\u0648 \u062c\u0627\u0626\u06d2\u06d4"},{"id":"6077","sura":"92","aya":"19","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0644\u0650\u0623\u064e\u062d\u064e\u062f\u064d \u0639\u0650\u0646\u062f\u064e\u0647\u064f\u06e5 \u0645\u0650\u0646 \u0646\u0651\u0650\u0639\u06e1\u0645\u064e\u0629\u0656 \u062a\u064f\u062c\u06e1\u0632\u064e\u0649\u0670\u0653","translation":"\u06a9\u0633\u06cc \u06a9\u0627 \u0627\u0633 \u067e\u0631 \u06a9\u0648\u0626\u06cc \u0627\u062d\u0633\u0627\u0646 \u0646\u06c1\u06cc\u06ba \u06a9\u06c1 \u062c\u0633 \u06a9\u0627 \u0628\u062f\u0644\u06c1 \u062f\u06cc\u0627 \u062c\u0627 \u0631\u06c1\u0627 \u06c1\u0648.[1]","footnotes":"[1] \u06cc\u0639\u0646\u06cc \u0628\u062f\u0644\u06c1 \u0627\u062a\u0627\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u062e\u0631\u0686 \u0646\u06c1 \u06a9\u0631\u062a\u0627 \u06c1\u0648\u06d4"},{"id":"6078","sura":"92","aya":"20","arabic_text":"\u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0628\u06e1\u062a\u0650\u063a\u064e\u0627\u0653\u0621\u064e \u0648\u064e\u062c\u06e1\u0647\u0650 \u0631\u064e\u0628\u0651\u0650\u0647\u0650 \u0671\u0644\u06e1\u0623\u064e\u0639\u06e1\u0644\u064e\u0649\u0670","translation":"\u0628\u0644\u06a9\u06c1 \u0635\u0631\u0641 \u0627\u067e\u0646\u06d2 \u067e\u0631\u0648\u0631\u062f\u06af\u0627\u0631 \u0628\u0632\u0631\u06af \u0648\u0628\u0644\u0646\u062f \u06a9\u06cc \u0631\u0636\u0627 \u0686\u0627\u06c1\u0646\u06d2 \u06a9\u06d2 \u0644\u0626\u06d2.[1]","footnotes":"[1] \u0628\u0644\u06a9\u06c1 \u0627\u062e\u0644\u0627\u0635 \u0633\u06d2 \u0627\u0644\u0644\u06c1 \u06a9\u06cc \u0631\u0636\u0627 \u0627\u0648\u0631 \u062c\u0646\u062a \u0645\u06cc\u06ba \u0627\u0633 \u06a9\u06d2 \u062f\u06cc\u062f\u0627\u0631 \u06a9\u06d2 \u0644\u0626\u06d2 \u062e\u0631\u0686 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u06d4"},{"id":"6079","sura":"92","aya":"21","arabic_text":"\u0648\u064e\u0644\u064e\u0633\u064e\u0648\u06e1\u0641\u064e \u064a\u064e\u0631\u06e1\u0636\u064e\u0649\u0670","translation":"\u06cc\u0642\u06cc\u0646\u0627\u064b \u0648\u0647 (\u0627\u0644\u0644\u06c1 \u0628\u06be\u06cc) \u0639\u0646\u0642\u0631\u06cc\u0628 \u0631\u0636\u0627\u0645\u0646\u062f \u06c1\u0648 \u062c\u0627\u0626\u06d2 \u06af\u0627.[1]","footnotes":"[1] \u06cc\u0627 \u0648\u06c1 \u0631\u0627\u0636\u06cc \u06c1\u0648 \u062c\u0627\u0626\u06d2 \u06af\u0627\u060c \u06cc\u0639\u0646\u06cc \u062c\u0648 \u0634\u062e\u0635 \u0627\u0646 \u0635\u0641\u0627\u062a \u06a9\u0627 \u062d\u0627\u0645\u0644 \u06c1\u0648\u06af\u0627\u060c \u0627\u0644\u0644\u06c1 \u062a\u0639\u0627\u0644\u06cc\u0670 \u0627\u0633\u06d2 \u062c\u0646\u062a \u06a9\u06cc \u0646\u0639\u0645\u062a\u06cc\u06ba \u0627\u0648\u0631 \u0639\u0632\u062a \u0648\u0634\u0631\u0641 \u0639\u0637\u0627 \u0641\u0631\u0645\u0627\u0626\u06d2 \u06af\u0627\u060c \u062c\u0633 \u0633\u06d2 \u0648\u06c1 \u0631\u0627\u0636\u06cc \u06c1\u0648 \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4 \u0627\u06a9\u062b\u0631 \u0645\u0641\u0633\u0631\u06cc\u0646 \u0646\u06d2 \u06a9\u06c1\u0627 \u06c1\u06d2 \u0628\u0644\u06a9\u06c1 \u0628\u0639\u0636 \u0646\u06d2 \u0627\u062c\u0645\u0627\u0639 \u062a\u06a9 \u0646\u0642\u0644 \u06a9\u06cc\u0627 \u06c1\u06d2 \u06a9\u06c1 \u06cc\u06c1 \u0622\u06cc\u0627\u062a \u062d\u0636\u0631\u062a \u0627\u0628\u0648\u0628\u06a9\u0631 \u0635\u062f\u06cc\u0642 (\u0631\u0636\u064a \u0627\u0644\u0644\u0647 \u0639\u0646\u0647) \u06a9\u06cc \u0634\u0627\u0646 \u0645\u06cc\u06ba \u0646\u0627\u0632\u0644 \u06c1\u0648\u0626\u06cc \u06c1\u06cc\u06ba\u06d4 \u062a\u0627\u06c1\u0645 \u0645\u0639\u0646\u06cc \u0648\u0645\u0641\u06c1\u0648\u0645 \u06a9\u06d2 \u0627\u0639\u062a\u0628\u0627\u0631 \u0633\u06d2 \u06cc\u06c1 \u0639\u0627\u0645 \u06c1\u06cc\u06ba\u06d4 \u062c\u0648 \u0628\u06be\u06cc \u0627\u0646 \u0635\u0641\u0627\u062a \u0639\u0627\u0644\u06cc\u06c1 \u0633\u06d2 \u0645\u062a\u0635\u0641 \u06c1\u0648\u06af\u0627\u060c \u0648\u06c1 \u0628\u0627\u0631\u06af\u0627\u06c1 \u0627\u0644\u0670\u06c1\u06cc \u0645\u06cc\u06ba \u0627\u0646 \u06a9\u0627 \u0645\u0635\u062f\u0627\u0642 \u0642\u0631\u0627\u0631 \u067e\u0627\u0626\u06d2 \u06af\u0627\u06d4"}]}