0644\u06c1 \u0646\u06d2 \u062a\u06cc\u0646 \u0642\u0633\u0645\u0648\u06ba \u06a9\u06d2 \u0628\u0639\u062f \u0641\u0631\u0645\u0627\u06cc\u0627\u06d4 (\u0641\u062a\u062d \u0627\u0644\u0642\u062f\u06cc\u0631)\u06d4"},{"id":"6103","sura":"95","aya":"5","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0631\u064e\u062f\u064e\u062f\u06e1\u0646\u064e\u0670\u0647\u064f \u0623\u064e\u0633\u06e1\u0641\u064e\u0644\u064e \u0633\u064e\u0670\u0641\u0650\u0644\u0650\u064a\u0646\u064e","translation":"\u067e\u06be\u0631 \u0627\u0633\u06d2 \u0646\u06cc\u0686\u0648\u06ba \u0633\u06d2 \u0646\u06cc\u0686\u0627 \u06a9\u0631 \u062f\u06cc\u0627.[1]","footnotes":"[1] \u06cc\u06c1 \u0627\u0634\u0627\u0631\u06c1 \u0627\u0646\u0633\u0627\u0646 \u06a9\u06d2 \u0627\u0631\u0630\u0644 \u0639\u0645\u0631 ( \u0628\u06c1\u062a \u0632\u06cc\u0627\u062f\u06c1 \u0639\u0645\u0631 ) \u06a9\u06cc \u0637\u0631\u0641\u06d4 \u062c\u0633 \u0645\u06cc\u06ba \u062c\u0648\u0627\u0646\u06cc \u0627\u0648\u0631 \u0642\u0648\u062a \u06a9\u06d2 \u0628\u0639\u062f \u0628\u0691\u06be\u0627\u067e\u0627 \u0627\u0648\u0631 \u0636\u0639\u0641 \u0622\u062c\u0627\u062a\u0627 \u06c1\u06d2 \u0627\u0648\u0631 \u0627\u0646\u0633\u0627\u0646 \u06a9\u06cc \u0639\u0642\u0644 \u0627\u0648\u0631 \u0630\u06c1\u0646 \u0628\u0686\u06d2 \u06a9\u06cc \u0637\u0631\u062d \u06c1\u0648 \u062c\u0627\u062a\u0627 \u06c1\u06d2\u06d4 \u0628\u0639\u0636 \u0646\u06d2 \u0627\u0633 \u0633\u06d2 \u06a9\u0631\u062f\u0627\u0631 \u06a9\u0627 \u0648\u06c1 \u0633\u0641\u0644\u06c1 \u067e\u0646 \u0644\u06cc\u0627 \u06c1\u06d2 \u062c\u0633 \u0645\u06cc\u06ba \u0645\u0628\u062a\u0644\u0627 \u06c1\u0648 \u06a9\u0631 \u0627\u0646\u0633\u0627\u0646 \u0627\u0646\u062a\u06c1\u0627\u0626\u06cc \u067e\u0633\u062a \u0627\u0648\u0631 \u0633\u0627\u0646\u067e \u0628\u0686\u06be\u0648 \u0633\u06d2 \u0628\u06be\u06cc \u0632\u06cc\u0627\u062f\u06c1 \u06af\u06cc\u0627 \u06af\u0632\u0631\u0627 \u06c1\u0648 \u062c\u0627\u062a\u0627 \u06c1\u06d2 \u0627\u0648\u0631 \u0628\u0639\u0636 \u0646\u06d2 \u0627\u0633 \u0633\u06d2 \u0630\u0644\u062a \u0648\u0631\u0633\u0648\u0627\u0626\u06cc \u06a9\u0627 \u0648\u06c1 \u0639\u0630\u0627\u0628 \u0645\u0631\u0627\u062f \u0644\u06cc\u0627 \u06c1\u06d2 \u062c\u0648 \u062c\u06c1\u0646\u0645 \u0645\u06cc\u06ba \u06a9\u0627\u0641\u0631\u0648\u06ba \u06a9\u06d2 \u0644\u0626\u06d2 \u06c1\u06d2\u06d4 \u06af\u0648\u06cc\u0627 \u0627\u0646\u0633\u0627\u0646 \u0627\u0644\u0644\u06c1 \u0627\u0648\u0631 \u0631\u0633\u0648\u0644 \u06a9\u06cc \u0627\u0637\u0627\u0639\u062a \u0633\u06d2 \u0627\u0646\u062d\u0631\u0627\u0641 \u06a9\u0631\u06a9\u06d2 \u0627\u067e\u0646\u06d2 \u06a9\u0648 \u0627\u062d\u0633\u0646 \u062a\u0642\u0648\u06cc\u0645 \u06a9\u06d2 \u0628\u0644\u0646\u062f \u0631\u062a\u0628\u06c1 \u0648\u0627\u0639\u0632\u0627\u0632 \u0633\u06d2 \u06af\u0631\u0627 \u06a9\u0631 \u062c\u06c1\u0646\u0645 \u06a9\u06cc \u0627\u0633\u0641\u0644 \u0633\u0627\u0641\u0644\u06cc\u0646 \u0645\u06cc\u06ba \u0688\u0627\u0644 \u0644\u06cc\u062a\u0627 \u06c1\u06d2\u06d4"},{"id":"6104","sura":"95","aya":"6","arabic_text":"\u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u0652 \u0648\u064e\u0639\u064e\u0645\u0650\u0644\u064f\u0648\u0627\u0652 \u0671\u0644\u0635\u0651\u064e\u0670\u0644\u0650\u062d\u064e\u0670\u062a\u0650 \u0641\u064e\u0644\u064e\u0647\u064f\u0645\u06e1 \u0623\u064e\u062c\u06e1\u0631\u064c \u063a\u064e\u064a\u06e1\u0631\u064f \u0645\u064e\u0645\u06e1\u0646\u064f\u0648\u0646\u0656","translation":"\u0644\u06cc\u06a9\u0646 \u062c\u0648 \u0644\u0648\u06af \u0627\u06cc\u0645\u0627\u0646 \ufefb\u0626\u06d2 \u0627\u0648\u0631 (\u067e\u06be\u0631) \u0646\u06cc\u06a9 \u0639\u0645\u0644 \u06a9\u06cc\u06d2 \u062a\u0648 \u0627\u0646 \u06a9\u06d2 \u0644\u0626\u06d2 \u0627\u06cc\u0633\u0627 \u0627\u062c\u0631 \u06c1\u06d2 \u062c\u0648 \u06a9\u0628\u06be\u06cc \u062e\u062a\u0645 \u0646\u06c1 \u06c1\u0648\u06af\u0627.[1]","footnotes":"[1] \u0622\u06cc\u062a \u0645\u0627\u0642\u0628\u0644 \u06a9\u06d2 \u067e\u06c1\u0644\u06d2 \u0645\u0641\u06c1\u0648\u0645 \u06a9\u06d2 \u0627\u0639\u062a\u0628\u0627\u0631 \u0633\u06d2 \u06cc\u06c1 \u062c\u0645\u0644\u06c1 \u0645\u0628\u06cc\u0646\u06c1 \u06c1\u06d2\u060c \u0645\u0648\u0645\u0646\u0648\u06ba \u06a9\u06cc \u06a9\u06cc\u0641\u06cc\u062a \u0628\u06cc\u0627\u0646 \u06a9\u0631 \u0631\u06c1\u0627 \u06c1\u06d2 \u0627\u0648\u0631 \u062f\u0648\u0633\u0631\u06d2 \u062a\u06cc\u0633\u0631\u06d2 \u0645\u0641\u06c1\u0648\u0645 \u06a9\u06d2 \u0627\u0639\u062a\u0628\u0627\u0631 \u0633\u06d2\u060c \u0645\u0627\u0642\u0628\u0644 \u06a9\u06cc \u062a\u0627\u06a9\u06cc\u062f \u06c1\u06d2 \u06a9\u06c1 \u0627\u0633 \u0627\u0646\u062c\u0627\u0645 \u0633\u06d2 \u0627\u0633 \u0646\u06d2 \u0645\u0648\u0645\u0646\u0648\u06ba \u06a9\u0627 \u0627\u0633\u062a\u062b\u0646\u0627 \u06a9\u0631\u062f\u06cc\u0627\u06d4 ( \u0641\u062a\u062d \u0627\u0644\u0642\u062f\u06cc\u0631 ) \u06d4"},{"id":"6105","sura":"95","aya":"7","arabic_text":"\u0641\u064e\u0645\u064e\u0627 \u064a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f\u0643\u064e \u0628\u064e\u0639\u06e1\u062f\u064f \u0628\u0650\u0671\u0644\u062f\u0651\u0650\u064a\u0646\u0650","translation":"\u067e\u0633 \u062a\u062c\u06be\u06d2 \u0627\u0628 \u0631\u0648\u0632 \u062c\u0632\u0627 \u06a9\u06d2 \u062c\u06be\u0679\u0644\u0627\u0646\u06d2 \u067e\u0631 \u06a9\u0648\u0646 \u0633\u06cc \u0686\u06cc\u0632 \u0622\u0645\u0627\u062f\u0647 \u06a9\u0631\u062a\u06cc \u06c1\u06d2.[1]","footnotes":"[1] \u06cc\u06c1 \u0627\u0646\u0633\u0627\u0646 \u0633\u06d2 \u062e\u0637\u0627\u0628 \u06c1\u06d2\u060c \u0632\u062c\u0631 \u0648\u062a\u0648\u0628\u06cc\u062e \u06a9\u06d2 \u0644\u0626\u06d2\u06d4 \u06a9\u06c1 \u0627\u0644\u0644\u06c1 \u0646\u06d2 \u062a\u062c\u06be\u06d2 \u0628\u06c1\u062a\u0631\u06cc\u0646 \u0635\u0648\u0631\u062a \u0645\u06cc\u06ba \u067e\u06cc\u062f\u0627 \u06a9\u06cc\u0627 \u0627\u0648\u0631 \u0648\u06c1 \u062a\u062c\u06be\u06d2 \u0627\u0633 \u06a9\u06d2 \u0628\u0631\u0639\u06a9\u0633 \u0642\u0639\u0631 \u0645\u0630\u0644\u062a \u0645\u06cc\u06ba \u0628\u06be\u06cc \u06af\u0631\u0627\u0646\u06d2 \u06a9\u06cc \u0642\u062f\u0631\u062a \u0631\u06a9\u06be\u062a\u0627 \u06c1\u06d2\u06d4 \u0627\u0633 \u06a9\u0627 \u0645\u0637\u0644\u0628 \u06c1\u06d2 \u06a9\u06c1 \u0627\u0633 \u06a9\u06d2 \u0644\u0626\u06d2 \u062f\u0648\u0628\u0627\u0631\u06c1 \u067e\u06cc\u062f\u0627 \u06a9\u0631\u0646\u0627 \u06a9\u0648\u0626\u06cc \u0645\u0634\u06a9\u0644 \u0646\u06c1\u06cc\u06ba\u06d4 \u0627\u0633 \u06a9\u06d2 \u0628\u0639\u062f \u0628\u06be\u06cc \u062a\u0648 \u0642\u06cc\u0627\u0645\u062a \u0627\u0648\u0631 \u062c\u0632\u0627 \u06a9\u0627 \u0627\u0646\u06a9\u0627\u0631 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u061f"},{"id":"6106","sura":"95","aya":"8","arabic_text":"\u0623\u064e\u0644\u064e\u064a\u06e1\u0633\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0628\u0650\u0623\u064e\u062d\u06e1\u0643\u064e\u0645\u0650 \u0671\u0644\u06e1\u062d\u064e\u0670\u0643\u0650\u0645\u0650\u064a\u0646\u064e","translation":"\u06a9\u06cc\u0627 \u0627\u0644\u0644\u06c1 \u062a\u0639\u0627\u0644\u06cc\u0670 (\u0633\u0628) \u062d\u0627\u06a9\u0645\u0648\u06ba \u06a9\u0627 \u062d\u0627\u06a9\u0645 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2.[1]","footnotes":"[1] \u062c\u0648 \u06a9\u0633\u06cc \u067e\u0631 \u0638\u0644\u0645 \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u062a\u0627 \u0627\u0648\u0631 \u0627\u0633 \u06a9\u06d2 \u0639\u062f\u0644 \u06c1\u06cc \u06a9\u0627 \u06cc\u06c1 \u062a\u0642\u0627\u0636\u0627 \u06c1\u06d2 \u06a9\u06c1 \u0648\u06c1 \u0642\u06cc\u0627\u0645\u062a \u0628\u0631\u067e\u0627 \u06a9\u0631\u06d2 \u0627\u0648\u0631 \u0627\u0646 \u06a9\u06cc \u062f\u0627\u062f \u0631\u0633\u06cc \u06a9\u0631\u06d2 \u062c\u0646 \u067e\u0631 \u062f\u0646\u06cc\u0627 \u0645\u06cc\u06ba \u0638\u0644\u0645 \u06c1\u0648\u0627\u06d4 \u067e\u06c1\u0644\u06d2 \u06af\u0632\u0631 \u0686\u06a9\u0627 \u06c1\u06d2 \u06a9\u06c1 \u0627\u06cc\u06a9 \u0636\u0639\u06cc\u0641 \u062d\u062f\u06cc\u062b \u0645\u06cc\u06ba \u0627\u0633 \u06a9\u0627 \u06cc\u06c1 \u062c\u0648\u0627\u0628 \u062f\u06cc\u0646\u0627 \u0645\u0646\u0642\u0648\u0644 \u06c1\u06d2\u06d4 \u0628\u064e\u0644\u064e\u0649\u060c \u0648\u064e\u0623\u064e\u0646\u064e\u0627 \u0639\u064e\u0644\u064e\u0649 \u0630\u064e\u0644\u0650\u0643\u064e \u0645\u0650\u0646\u064e \u0627\u0644\u0634\u0651\u064e\u0627\u0647\u0650\u062f\u0650\u064a\u0646\u064e ) ( \u0627\u0644\u062a\u0631\u0645\u0630\u064a ) \u06d4"}]}