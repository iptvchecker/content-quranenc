13. des enfants toujours \u00e0 ses c\u00f4t\u00e9s,","footnotes":""},{"id":"5509","sura":"74","aya":"14","arabic_text":"\u0648\u064e\u0645\u064e\u0647\u0651\u064e\u062f\u062a\u0651\u064f \u0644\u064e\u0647\u064f\u06e5 \u062a\u064e\u0645\u06e1\u0647\u0650\u064a\u062f\u0657\u0627","translation":"14. et devant qui J\u2019ai rendu facile le chemin.","footnotes":""},{"id":"5510","sura":"74","aya":"15","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u064a\u064e\u0637\u06e1\u0645\u064e\u0639\u064f \u0623\u064e\u0646\u06e1 \u0623\u064e\u0632\u0650\u064a\u062f\u064e","translation":"15. Livr\u00e9 \u00e0 sa convoitise, il esp\u00e8re que Je lui donnerai davantage !","footnotes":""},{"id":"5511","sura":"74","aya":"16","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653\u06d6 \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0643\u064e\u0627\u0646\u064e \u0644\u0650\u0623\u0653\u064a\u064e\u0670\u062a\u0650\u0646\u064e\u0627 \u0639\u064e\u0646\u0650\u064a\u062f\u0657\u0627","translation":"16. Non, il n\u2019en sera rien. Car il rejetait Nos Signes avec une telle opini\u00e2tret\u00e9 !","footnotes":""},{"id":"5512","sura":"74","aya":"17","arabic_text":"\u0633\u064e\u0623\u064f\u0631\u06e1\u0647\u0650\u0642\u064f\u0647\u064f\u06e5 \u0635\u064e\u0639\u064f\u0648\u062f\u064b\u0627","translation":"17. Je l\u2019\u00e9puiserai en lui faisant gravir les mont\u00e9es (les plus abruptes).","footnotes":""},{"id":"5513","sura":"74","aya":"18","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0641\u064e\u0643\u0651\u064e\u0631\u064e \u0648\u064e\u0642\u064e\u062f\u0651\u064e\u0631\u064e","translation":"18. Il r\u00e9fl\u00e9chit et prit sa d\u00e9cision.","footnotes":""},{"id":"5514","sura":"74","aya":"19","arabic_text":"\u0641\u064e\u0642\u064f\u062a\u0650\u0644\u064e \u0643\u064e\u064a\u06e1\u0641\u064e \u0642\u064e\u062f\u0651\u064e\u0631\u064e","translation":"19. Puisse-t-il donc p\u00e9rir ! Quelle fa\u00e7on il a de d\u00e9cider !","footnotes":""},{"id":"5515","sura":"74","aya":"20","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0642\u064f\u062a\u0650\u0644\u064e \u0643\u064e\u064a\u06e1\u0641\u064e \u0642\u064e\u062f\u0651\u064e\u0631\u064e","translation":"20. Puisse-t-il donc encore p\u00e9rir ! Quelle fa\u00e7on il a de d\u00e9cider !","footnotes":""},{"id":"5516","sura":"74","aya":"21","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0646\u064e\u0638\u064e\u0631\u064e","translation":"21. Puis il regarda (autour de lui),","footnotes":""},{"id":"5517","sura":"74","aya":"22","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0639\u064e\u0628\u064e\u0633\u064e \u0648\u064e\u0628\u064e\u0633\u064e\u0631\u064e","translation":"22. fron\u00e7a les sourcils et s\u2019assombrit,","footnotes":""},{"id":"5518","sura":"74","aya":"23","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0623\u064e\u062f\u06e1\u0628\u064e\u0631\u064e \u0648\u064e\u0671\u0633\u06e1\u062a\u064e\u0643\u06e1\u0628\u064e\u0631\u064e","translation":"23. puis se d\u00e9tourna, d\u00e9daigneux.","footnotes":""},{"id":"5519","sura":"74","aya":"24","arabic_text":"\u0641\u064e\u0642\u064e\u0627\u0644\u064e \u0625\u0650\u0646\u06e1 \u0647\u064e\u0670\u0630\u064e\u0627\u0653 \u0625\u0650\u0644\u0651\u064e\u0627 \u0633\u0650\u062d\u06e1\u0631\u065e \u064a\u064f\u0624\u06e1\u062b\u064e\u0631\u064f","translation":"24. \u00ab Ce n\u2019est l\u00e0, dit-il, que magie qui se transmet,","footnotes":""},{"id":"5520","sura":"74","aya":"25","arabic_text":"\u0625\u0650\u0646\u06e1 \u0647\u064e\u0670\u0630\u064e\u0627\u0653 \u0625\u0650\u0644\u0651\u064e\u0627 \u0642\u064e\u0648\u06e1\u0644\u064f \u0671\u0644\u06e1\u0628\u064e\u0634\u064e\u0631\u0650","translation":"25. ce n\u2019est l\u00e0 que parole humaine ! \u00bb","footnotes":""},{"id":"5521","sura":"74","aya":"26","arabic_text":"\u0633\u064e\u0623\u064f\u0635\u06e1\u0644\u0650\u064a\u0647\u0650 \u0633\u064e\u0642\u064e\u0631\u064e","translation":"26. Je le ferai br\u00fbler dans le Feu de Saqar,","footnotes":""},{"id":"5522","sura":"74","aya":"27","arabic_text":"\u0648\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u062f\u06e1\u0631\u064e\u0649\u0670\u0643\u064e \u0645\u064e\u0627 \u0633\u064e\u0642\u064e\u0631\u064f","translation":"27. Et qui te fera jamais savoir ce que c\u2019est que Saqar ?","footnotes":""},{"id":"5523","sura":"74","aya":"28","arabic_text":"\u0644\u064e\u0627 \u062a\u064f\u0628\u06e1\u0642\u0650\u064a \u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u0630\u064e\u0631\u064f","translation":"28. (Un Feu qui) n\u2019\u00e9pargne et ne laisse rien,","footnotes":""},{"id":"5524","sura":"74","aya":"29","arabic_text":"\u0644\u064e\u0648\u0651\u064e\u0627\u062d\u064e\u0629\u065e \u0644\u0651\u0650\u0644\u06e1\u0628\u064e\u0634\u064e\u0631\u0650","translation":"29. et qui calcine la chair des hommes.","footnotes":""},{"id":"5525","sura":"74","aya":"30","arabic_text":"\u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u064e\u0627 \u062a\u0650\u0633\u06e1\u0639\u064e\u0629\u064e \u0639\u064e\u0634\u064e\u0631\u064e","translation":"30. Dix-neuf (Anges) y montent la garde.","footnotes":""},{"id":"5526","sura":"74","aya":"31","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0627\u0653 \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u064e \u0671\u0644\u0646\u0651\u064e\u0627\u0631\u0650 \u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u064e\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e\u0629\u0657\u06d6 \u0648\u064e\u0645\u064e\u0627 \u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0627 \u0639\u0650\u062f\u0651\u064e\u062a\u064e\u0647\u064f\u0645\u06e1 \u0625\u0650\u0644\u0651\u064e\u0627 \u0641\u0650\u062a\u06e1\u0646\u064e\u0629\u0657 \u0644\u0651\u0650\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u0652 \u0644\u0650\u064a\u064e\u0633\u06e1\u062a\u064e\u064a\u06e1\u0642\u0650\u0646\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064f\u0648\u062a\u064f\u0648\u0627\u0652 \u0671\u0644\u06e1\u0643\u0650\u062a\u064e\u0670\u0628\u064e \u0648\u064e\u064a\u064e\u0632\u06e1\u062f\u064e\u0627\u062f\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u064a\u0645\u064e\u0670\u0646\u0657\u0627 \u0648\u064e\u0644\u064e\u0627 \u064a\u064e\u0631\u06e1\u062a\u064e\u0627\u0628\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064f\u0648\u062a\u064f\u0648\u0627\u0652 \u0671\u0644\u06e1\u0643\u0650\u062a\u064e\u0670\u0628\u064e \u0648\u064e\u0671\u0644\u06e1\u0645\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e \u0648\u064e\u0644\u0650\u064a\u064e\u0642\u064f\u0648\u0644\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0641\u0650\u064a \u0642\u064f\u0644\u064f\u0648\u0628\u0650\u0647\u0650\u0645 \u0645\u0651\u064e\u0631\u064e\u0636\u065e \u0648\u064e\u0671\u0644\u06e1\u0643\u064e\u0670\u0641\u0650\u0631\u064f\u0648\u0646\u064e \u0645\u064e\u0627\u0630\u064e\u0627\u0653 \u0623\u064e\u0631\u064e\u0627\u062f\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0628\u0650\u0647\u064e\u0670\u0630\u064e\u0627 \u0645\u064e\u062b\u064e\u0644\u0657\u0627\u06da \u0643\u064e\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u064a\u064f\u0636\u0650\u0644\u0651\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0645\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064f \u0648\u064e\u064a\u064e\u0647\u06e1\u062f\u0650\u064a \u0645\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064f\u06da \u0648\u064e\u0645\u064e\u0627 \u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u062c\u064f\u0646\u064f\u0648\u062f\u064e \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0647\u064f\u0648\u064e\u06da \u0648\u064e\u0645\u064e\u0627 \u0647\u0650\u064a\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0630\u0650\u0643\u06e1\u0631\u064e\u0649\u0670 \u0644\u0650\u0644\u06e1\u0628\u064e\u0634\u064e\u0631\u0650","translation":"31. Nous n\u2019avons d\u00e9sign\u00e9, comme gardiens du Feu, que des Anges. Nous ne les avons d\u00e9finis en nombre pr\u00e9cis que pour \u00e9prouver les m\u00e9cr\u00e9ants, enraciner la certitude dans les c\u0153urs de ceux qui ont re\u00e7u le Livre et accro\u00eetre la foi des croyants. Ainsi, les gens du Livre et les croyants ne seront plus dans le doute, cependant que ceux dont le c\u0153ur est rong\u00e9 par le mal et les m\u00e9cr\u00e9ants diront : \u00abQue veut dire Allah par (ce nombre) donn\u00e9 en exemple ? \u00bb C\u2019est ainsi qu\u2019Allah \u00e9gare qui Il veut et guide qui Il veut. Seul Lui Conna\u00eet les arm\u00e9es de ton Seigneur. Et cela n\u2019est qu\u2019un rappel \u00e0 l\u2019intention des humains.","footnotes":""},{"id":"5527","sura":"74","aya":"32","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627 \u0648\u064e\u0671\u0644\u06e1\u0642\u064e\u0645\u064e\u0631\u0650","translation":"32. Que oui ![2] Par la lune !","footnotes":"[2] Litt\u00e9ralement : \u00ab Que non ! \u00bb Il s\u2019agit l\u00e0 d\u2019une interjection qui se produit souvent au d\u00e9but du serment d\u2019Allah."},{"id":"5528","sura":"74","aya":"33","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u064a\u06e1\u0644\u0650 \u0625\u0650\u0630\u06e1 \u0623\u064e\u062f\u06e1\u0628\u064e\u0631\u064e","translation":"33. Par la nuit quand elle se retire !","footnotes":""},{"id":"5529","sura":"74","aya":"34","arabic_text":"\u0648\u064e\u0671\u0644\u0635\u0651\u064f\u0628\u06e1\u062d\u0650 \u0625\u0650\u0630\u064e\u0627\u0653 \u0623\u064e\u0633\u06e1\u0641\u064e\u0631\u064e","translation":"34. Et l\u2019aurore quand elle se d\u00e9voile !","footnotes":""},{"id":"5530","sura":"74","aya":"35","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064e\u0627 \u0644\u064e\u0625\u0650\u062d\u06e1\u062f\u064e\u0649 \u0671\u0644\u06e1\u0643\u064f\u0628\u064e\u0631\u0650","translation":"35. (Saqar) est certainement l\u2019un des plus grands (p\u00e9rils),","footnotes":""},{"id":"5531","sura":"74","aya":"36","arabic_text":"\u0646\u064e\u0630\u0650\u064a\u0631\u0657\u0627 \u0644\u0651\u0650\u0644\u06e1\u0628\u064e\u0634\u064e\u0631\u0650","translation":"36. un avertissement adress\u00e9 aux humains,","footnotes":""},{"id":"5532","sura":"74","aya":"37","arabic_text":"\u0644\u0650\u0645\u064e\u0646 \u0634\u064e\u0627\u0653\u0621\u064e \u0645\u0650\u0646\u0643\u064f\u0645\u06e1 \u0623\u064e\u0646 \u064a\u064e\u062a\u064e\u0642\u064e\u062f\u0651\u064e\u0645\u064e \u0623\u064e\u0648\u06e1 \u064a\u064e\u062a\u064e\u0623\u064e\u062e\u0651\u064e\u0631\u064e","translation":"37. et \u00e0 qui, parmi vous, veut aller au-devant (des ordres de son Seigneur), ou pr\u00e9f\u00e8re rester en arri\u00e8re.","footnotes":""},{"id":"5533","sura":"74","aya":"38","arabic_text":"\u0643\u064f\u0644\u0651\u064f \u0646\u064e\u0641\u06e1\u0633\u0650\u06ed \u0628\u0650\u0645\u064e\u0627 \u0643\u064e\u0633\u064e\u0628\u064e\u062a\u06e1 \u0631\u064e\u0647\u0650\u064a\u0646\u064e\u0629\u064c","translation":"38. Chaque \u00e2me doit assumer la charge de ce qu\u2019elle a fait,","footnotes":""},{"id":"5534","sura":"74","aya":"39","arabic_text":"\u0625\u0650\u0644\u0651\u064e\u0627\u0653 \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u064e \u0671\u0644\u06e1\u064a\u064e\u0645\u0650\u064a\u0646\u0650","translation":"39. except\u00e9 les gens de la dextre,","footnotes":""},{"id":"5535","sura":"74","aya":"40","arabic_text":"\u0641\u0650\u064a \u062c\u064e\u0646\u0651\u064e\u0670\u062a\u0656 \u064a\u064e\u062a\u064e\u0633\u064e\u0627\u0653\u0621\u064e\u0644\u064f\u0648\u0646\u064e","translation":"40. qui seront dans des jardins et s\u2019interrogeront mutuellement","footnotes":""},{"id":"5536","sura":"74","aya":"41","arabic_text":"\u0639\u064e\u0646\u0650 \u0671\u0644\u06e1\u0645\u064f\u062c\u06e1\u0631\u0650\u0645\u0650\u064a\u0646\u064e","translation":"41. \u00e0 propos des sc\u00e9l\u00e9rats :","footnotes":""},{"id":"5537","sura":"74","aya":"42","arabic_text":"\u0645\u064e\u0627 \u0633\u064e\u0644\u064e\u0643\u064e\u0643\u064f\u0645\u06e1 \u0641\u0650\u064a \u0633\u064e\u0642\u064e\u0631\u064e","translation":"42. \u00ab Qu\u2019est-ce qui vous a conduits jusqu\u2019\u00e0 Saqar ? \u00bb","footnotes":""},{"id":"5538","sura":"74","aya":"43","arabic_text":"\u0642\u064e\u0627\u0644\u064f\u0648\u0627\u0652 \u0644\u064e\u0645\u06e1 \u0646\u064e\u0643\u064f \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0645\u064f\u0635\u064e\u0644\u0651\u0650\u064a\u0646\u064e","translation":"43. \u00ab Nous n\u2019\u00e9tions pas du nombre de ceux qui accomplissent la pri\u00e8re, r\u00e9pondront-ils,","footnotes":""},{"id":"5539","sura":"74","aya":"44","arabic_text":"\u0648\u064e\u0644\u064e\u0645\u06e1 \u0646\u064e\u0643\u064f \u0646\u064f\u0637\u06e1\u0639\u0650\u0645\u064f \u0671\u0644\u06e1\u0645\u0650\u0633\u06e1\u0643\u0650\u064a\u0646\u064e","translation":"44. nous ne donnions pas \u00e0 manger au pauvre,","footnotes":""},{"id":"5540","sura":"74","aya":"45","arabic_text":"\u0648\u064e\u0643\u064f\u0646\u0651\u064e\u0627 \u0646\u064e\u062e\u064f\u0648\u0636\u064f \u0645\u064e\u0639\u064e \u0671\u0644\u06e1\u062e\u064e\u0627\u0653\u0626\u0650\u0636\u0650\u064a\u0646\u064e","translation":"45. et nous nous engagions dans des discussions futiles avec ceux qui s\u2019y engageaient.","footnotes":""},{"id":"5541","sura":"74","aya":"46","arabic_text":"\u0648\u064e\u0643\u064f\u0646\u0651\u064e\u0627 \u0646\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f \u0628\u0650\u064a\u064e\u0648\u06e1\u0645\u0650 \u0671\u0644\u062f\u0651\u0650\u064a\u0646\u0650","translation":"46. Et nous tenions pour mensonge le Jour de la R\u00e9tribution,","footnotes":""},{"id":"5542","sura":"74","aya":"47","arabic_text":"\u062d\u064e\u062a\u0651\u064e\u0649\u0670\u0653 \u0623\u064e\u062a\u064e\u0649\u0670\u0646\u064e\u0627 \u0671\u0644\u06e1\u064a\u064e\u0642\u0650\u064a\u0646\u064f","translation":"47. Jusqu\u2019\u00e0 ce que nous parv\u00eent la grande certitude. \u00bb","footnotes":""},{"id":"5543","sura":"74","aya":"48","arabic_text":"\u0641\u064e\u0645\u064e\u0627 \u062a\u064e\u0646\u0641\u064e\u0639\u064f\u0647\u064f\u0645\u06e1 \u0634\u064e\u0641\u064e\u0670\u0639\u064e\u0629\u064f \u0671\u0644\u0634\u0651\u064e\u0670\u0641\u0650\u0639\u0650\u064a\u0646\u064e","translation":"48. L\u2019intercession des intercesseurs ne leur sera pas utile.","footnotes":""},{"id":"5544","sura":"74","aya":"49","arabic_text":"\u0641\u064e\u0645\u064e\u0627 \u0644\u064e\u0647\u064f\u0645\u06e1 \u0639\u064e\u0646\u0650 \u0671\u0644\u062a\u0651\u064e\u0630\u06e1\u0643\u0650\u0631\u064e\u0629\u0650 \u0645\u064f\u0639\u06e1\u0631\u0650\u0636\u0650\u064a\u0646\u064e","translation":"49. Qu\u2019ont-ils donc \u00e0 se d\u00e9tourner du Rappel,","footnotes":""},{"id":"5545","sura":"74","aya":"50","arabic_text":"\u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u062d\u064f\u0645\u064f\u0631\u065e \u0645\u0651\u064f\u0633\u06e1\u062a\u064e\u0646\u0641\u0650\u0631\u064e\u0629\u065e","translation":"50. tels des \u00e2nes sauvages qui, dans leur panique,","footnotes":""},{"id":"5546","sura":"74","aya":"51","arabic_text":"\u0641\u064e\u0631\u0651\u064e\u062a\u06e1 \u0645\u0650\u0646 \u0642\u064e\u0633\u06e1\u0648\u064e\u0631\u064e\u0629\u0650\u06ed","translation":"51. fuient devant un lion ?","footnotes":""},{"id":"5547","sura":"74","aya":"52","arabic_text":"\u0628\u064e\u0644\u06e1 \u064a\u064f\u0631\u0650\u064a\u062f\u064f \u0643\u064f\u0644\u0651\u064f \u0671\u0645\u06e1\u0631\u0650\u064a\u0655\u0656 \u0645\u0651\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0623\u064e\u0646 \u064a\u064f\u0624\u06e1\u062a\u064e\u0649\u0670 \u0635\u064f\u062d\u064f\u0641\u0657\u0627 \u0645\u0651\u064f\u0646\u064e\u0634\u0651\u064e\u0631\u064e\u0629\u0657","translation":"52. Chaque individu parmi eux voudrait recevoir des Feuillets (sp\u00e9cialement) d\u00e9ploy\u00e9s (pour lui).","footnotes":""},{"id":"5548","sura":"74","aya":"53","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u06d6 \u0628\u064e\u0644 \u0644\u0651\u064e\u0627 \u064a\u064e\u062e\u064e\u0627\u0641\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u064e\u0629\u064e","translation":"53. Non ! Plut\u00f4t ils ne redoutent pas l\u2019autre monde.","footnotes":""},{"id":"5549","sura":"74","aya":"54","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653 \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u062a\u064e\u0630\u06e1\u0643\u0650\u0631\u064e\u0629\u065e","translation":"54. Non ! Ceci est un Rappel.","footnotes":""},{"id":"5550","sura":"74","aya":"55","arabic_text":"\u0641\u064e\u0645\u064e\u0646 \u0634\u064e\u0627\u0653\u0621\u064e \u0630\u064e\u0643\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"55. Alors, s\u2019en souviendra qui voudra.","footnotes":""},{"id":"5551","sura":"74","aya":"56","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u064a\u064e\u0630\u06e1\u0643\u064f\u0631\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627\u0653 \u0623\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f\u06da \u0647\u064f\u0648\u064e \u0623\u064e\u0647\u06e1\u0644\u064f \u0671\u0644\u062a\u0651\u064e\u0642\u06e1\u0648\u064e\u0649\u0670 \u0648\u064e\u0623\u064e\u0647\u06e1\u0644\u064f \u0671\u0644\u06e1\u0645\u064e\u063a\u06e1\u0641\u0650\u0631\u064e\u0629\u0650","translation":"56. Mais ils ne s\u2019en souviendront que si Allah le veut, Lui le Seul digne d\u2019\u00eatre craint, Lui le plus digne de pardonner.","footnotes":""}]}