":"13. Ton Seigneur s\u00e9vit alors contre eux par le fouet de (Son) supplice.","footnotes":""},{"id":"6007","sura":"89","aya":"14","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0631\u064e\u0628\u0651\u064e\u0643\u064e \u0644\u064e\u0628\u0650\u0671\u0644\u06e1\u0645\u0650\u0631\u06e1\u0635\u064e\u0627\u062f\u0650","translation":"14. Car, certes, ton Seigneur toujours guette.","footnotes":""},{"id":"6008","sura":"89","aya":"15","arabic_text":"\u0641\u064e\u0623\u064e\u0645\u0651\u064e\u0627 \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u0625\u0650\u0630\u064e\u0627 \u0645\u064e\u0627 \u0671\u0628\u06e1\u062a\u064e\u0644\u064e\u0649\u0670\u0647\u064f \u0631\u064e\u0628\u0651\u064f\u0647\u064f\u06e5 \u0641\u064e\u0623\u064e\u0643\u06e1\u0631\u064e\u0645\u064e\u0647\u064f\u06e5 \u0648\u064e\u0646\u064e\u0639\u0651\u064e\u0645\u064e\u0647\u064f\u06e5 \u0641\u064e\u064a\u064e\u0642\u064f\u0648\u0644\u064f \u0631\u064e\u0628\u0651\u0650\u064a\u0653 \u0623\u064e\u0643\u06e1\u0631\u064e\u0645\u064e\u0646\u0650","translation":"15. Quand son Seigneur, en l\u2019\u00e9prouvant, l\u2019honore et le comble de bienfaits, l\u2019homme dit : \u00ab Mon Seigneur m\u2019a honor\u00e9 ! \u00bb","footnotes":""},{"id":"6009","sura":"89","aya":"16","arabic_text":"\u0648\u064e\u0623\u064e\u0645\u0651\u064e\u0627\u0653 \u0625\u0650\u0630\u064e\u0627 \u0645\u064e\u0627 \u0671\u0628\u06e1\u062a\u064e\u0644\u064e\u0649\u0670\u0647\u064f \u0641\u064e\u0642\u064e\u062f\u064e\u0631\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650 \u0631\u0650\u0632\u06e1\u0642\u064e\u0647\u064f\u06e5 \u0641\u064e\u064a\u064e\u0642\u064f\u0648\u0644\u064f \u0631\u064e\u0628\u0651\u0650\u064a\u0653 \u0623\u064e\u0647\u064e\u0670\u0646\u064e\u0646\u0650","translation":"16. Mais quand, en l\u2019\u00e9prouvant, Il lui accorde parcimonieusement sa subsistance, il proteste : \u00ab Mon Seigneur m\u2019a humili\u00e9 ! \u00bb","footnotes":""},{"id":"6010","sura":"89","aya":"17","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u06d6 \u0628\u064e\u0644 \u0644\u0651\u064e\u0627 \u062a\u064f\u0643\u06e1\u0631\u0650\u0645\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u064a\u064e\u062a\u0650\u064a\u0645\u064e","translation":"17. Que non ! Car c\u2019est plut\u00f4t vous qui manquez de g\u00e9n\u00e9rosit\u00e9 envers l\u2019orphelin,","footnotes":""},{"id":"6011","sura":"89","aya":"18","arabic_text":"\u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u062d\u064e\u0670\u0653\u0636\u0651\u064f\u0648\u0646\u064e \u0639\u064e\u0644\u064e\u0649\u0670 \u0637\u064e\u0639\u064e\u0627\u0645\u0650 \u0671\u0644\u06e1\u0645\u0650\u0633\u06e1\u0643\u0650\u064a\u0646\u0650","translation":"18. qui ne vous exhortez pas (les uns les autres) \u00e0 nourrir le pauvre,","footnotes":""},{"id":"6012","sura":"89","aya":"19","arabic_text":"\u0648\u064e\u062a\u064e\u0623\u06e1\u0643\u064f\u0644\u064f\u0648\u0646\u064e \u0671\u0644\u062a\u0651\u064f\u0631\u064e\u0627\u062b\u064e \u0623\u064e\u0643\u06e1\u0644\u0657\u0627 \u0644\u0651\u064e\u0645\u0651\u0657\u0627","translation":"19. qui vous emparez des h\u00e9ritages avec cupidit\u00e9,","footnotes":""},{"id":"6013","sura":"89","aya":"20","arabic_text":"\u0648\u064e\u062a\u064f\u062d\u0650\u0628\u0651\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u0645\u064e\u0627\u0644\u064e \u062d\u064f\u0628\u0651\u0657\u0627 \u062c\u064e\u0645\u0651\u0657\u0627","translation":"20. et aimez les richesses d\u2019un amour d\u00e9mesur\u00e9.","footnotes":""},{"id":"6014","sura":"89","aya":"21","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653\u06d6 \u0625\u0650\u0630\u064e\u0627 \u062f\u064f\u0643\u0651\u064e\u062a\u0650 \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u064f \u062f\u064e\u0643\u0651\u0657\u0627 \u062f\u064e\u0643\u0651\u0657\u0627","translation":"21. Que non ! Lorsque la terre s\u2019effritera parcelle par parcelle,","footnotes":""},{"id":"6015","sura":"89","aya":"22","arabic_text":"\u0648\u064e\u062c\u064e\u0627\u0653\u0621\u064e \u0631\u064e\u0628\u0651\u064f\u0643\u064e \u0648\u064e\u0671\u0644\u06e1\u0645\u064e\u0644\u064e\u0643\u064f \u0635\u064e\u0641\u0651\u0657\u0627 \u0635\u064e\u0641\u0651\u0657\u0627","translation":"22. et lorsque ton Seigneur viendra, de m\u00eame que les Anges, rang\u00e9e par rang\u00e9e,","footnotes":""},{"id":"6016","sura":"89","aya":"23","arabic_text":"\u0648\u064e\u062c\u0650\u0627\u0652\u064a\u0653\u0621\u064e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0650\u06ed \u0628\u0650\u062c\u064e\u0647\u064e\u0646\u0651\u064e\u0645\u064e\u06da \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u064a\u064e\u062a\u064e\u0630\u064e\u0643\u0651\u064e\u0631\u064f \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0649\u0670 \u0644\u064e\u0647\u064f \u0671\u0644\u0630\u0651\u0650\u0643\u06e1\u0631\u064e\u0649\u0670","translation":"23. et lorsque, ce jour-l\u00e0, la G\u00e9henne sera amen\u00e9e; ce jour-l\u00e0 alors, l\u2019homme se souviendra. Mais \u00e0 quoi pourrait bien lui servir de se souvenir ?","footnotes":""},{"id":"6017","sura":"89","aya":"24","arabic_text":"\u064a\u064e\u0642\u064f\u0648\u0644\u064f \u064a\u064e\u0670\u0644\u064e\u064a\u06e1\u062a\u064e\u0646\u0650\u064a \u0642\u064e\u062f\u0651\u064e\u0645\u06e1\u062a\u064f \u0644\u0650\u062d\u064e\u064a\u064e\u0627\u062a\u0650\u064a","translation":"24. Il dira : \u00ab Ah, Si seulement j\u2019avais pr\u00e9vu (de faire le bien) pour ma vie (dans l\u2019autre monde) ! \u00bb","footnotes":""},{"id":"6018","sura":"89","aya":"25","arabic_text":"\u0641\u064e\u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u064e\u0627 \u064a\u064f\u0639\u064e\u0630\u0651\u0650\u0628\u064f \u0639\u064e\u0630\u064e\u0627\u0628\u064e\u0647\u064f\u06e5\u0653 \u0623\u064e\u062d\u064e\u062f\u065e","translation":"25. Ce jour-l\u00e0, nul ne suppliciera comme Lui supplicie.","footnotes":""},{"id":"6019","sura":"89","aya":"26","arabic_text":"\u0648\u064e\u0644\u064e\u0627 \u064a\u064f\u0648\u062b\u0650\u0642\u064f \u0648\u064e\u062b\u064e\u0627\u0642\u064e\u0647\u064f\u06e5\u0653 \u0623\u064e\u062d\u064e\u062f\u065e","translation":"26. Nul ne ligotera comme Lui ligote.","footnotes":""},{"id":"6020","sura":"89","aya":"27","arabic_text":"\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064e\u062a\u064f\u0647\u064e\u0627 \u0671\u0644\u0646\u0651\u064e\u0641\u06e1\u0633\u064f \u0671\u0644\u06e1\u0645\u064f\u0637\u06e1\u0645\u064e\u0626\u0650\u0646\u0651\u064e\u0629\u064f","translation":"27. \u00ab \u00d4 toi, \u00e2me sereine !","footnotes":""},{"id":"6021","sura":"89","aya":"28","arabic_text":"\u0671\u0631\u06e1\u062c\u0650\u0639\u0650\u064a\u0653 \u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0643\u0650 \u0631\u064e\u0627\u0636\u0650\u064a\u064e\u0629\u0657 \u0645\u0651\u064e\u0631\u06e1\u0636\u0650\u064a\u0651\u064e\u0629\u0657","translation":"28. Reviens vers ton Seigneur, contente et agr\u00e9\u00e9e !","footnotes":""},{"id":"6022","sura":"89","aya":"29","arabic_text":"\u0641\u064e\u0671\u062f\u06e1\u062e\u064f\u0644\u0650\u064a \u0641\u0650\u064a \u0639\u0650\u0628\u064e\u0670\u062f\u0650\u064a","translation":"29. Entre parmi Mes serviteurs !","footnotes":""},{"id":"6023","sura":"89","aya":"30","arabic_text":"\u0648\u064e\u0671\u062f\u06e1\u062e\u064f\u0644\u0650\u064a \u062c\u064e\u0646\u0651\u064e\u062a\u0650\u064a","translation":"30. Entre dans Mon Paradis !\u00bb","footnotes":""}]}