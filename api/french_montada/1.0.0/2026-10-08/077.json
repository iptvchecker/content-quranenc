1","arabic_text":"\u0641\u064e\u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0670\u0647\u064f \u0641\u0650\u064a \u0642\u064e\u0631\u064e\u0627\u0631\u0656 \u0645\u0651\u064e\u0643\u0650\u064a\u0646\u064d","translation":"21. que Nous avons \u00e9tabli dans un r\u00e9ceptacle s\u00fbr,","footnotes":""},{"id":"5644","sura":"77","aya":"22","arabic_text":"\u0625\u0650\u0644\u064e\u0649\u0670 \u0642\u064e\u062f\u064e\u0631\u0656 \u0645\u0651\u064e\u0639\u06e1\u0644\u064f\u0648\u0645\u0656","translation":"22. pour un d\u00e9lai d\u00e9j\u00e0 fix\u00e9 ?","footnotes":""},{"id":"5645","sura":"77","aya":"23","arabic_text":"\u0641\u064e\u0642\u064e\u062f\u064e\u0631\u06e1\u0646\u064e\u0627 \u0641\u064e\u0646\u0650\u0639\u06e1\u0645\u064e \u0671\u0644\u06e1\u0642\u064e\u0670\u062f\u0650\u0631\u064f\u0648\u0646\u064e","translation":"23. Ainsi l\u2019avons-Nous d\u00e9termin\u00e9, et nul ne le pourra mieux que Nous !","footnotes":""},{"id":"5646","sura":"77","aya":"24","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"24. Malheur, ce jour-l\u00e0, aux n\u00e9gateurs !","footnotes":""},{"id":"5647","sura":"77","aya":"25","arabic_text":"\u0623\u064e\u0644\u064e\u0645\u06e1 \u0646\u064e\u062c\u06e1\u0639\u064e\u0644\u0650 \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u064e \u0643\u0650\u0641\u064e\u0627\u062a\u064b\u0627","translation":"25. N\u2019avons-Nous pas fait de la terre un r\u00e9ceptacle commun","footnotes":""},{"id":"5648","sura":"77","aya":"26","arabic_text":"\u0623\u064e\u062d\u06e1\u064a\u064e\u0627\u0653\u0621\u0657 \u0648\u064e\u0623\u064e\u0645\u06e1\u0648\u064e\u0670\u062a\u0657\u0627","translation":"26. aux vivants et aux morts ?","footnotes":""},{"id":"5649","sura":"77","aya":"27","arabic_text":"\u0648\u064e\u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0627 \u0641\u0650\u