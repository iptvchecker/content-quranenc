 ne pr\u00e9munit contre les flammes.","footnotes":""},{"id":"5654","sura":"77","aya":"32","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064e\u0627 \u062a\u064e\u0631\u06e1\u0645\u0650\u064a \u0628\u0650\u0634\u064e\u0631\u064e\u0631\u0656 \u0643\u064e\u0671\u0644\u06e1\u0642\u064e\u0635\u06e1\u0631\u0650","translation":"32. Car (le Feu de la G\u00e9henne) projette des \u00e9tincelles aussi grandes que de hautes citadelles,","footnotes":""},{"id":"5655","sura":"77","aya":"33","arabic_text":"\u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u062c\u0650\u0645\u064e\u0670\u0644\u064e\u062a\u065e \u0635\u064f\u0641\u06e1\u0631\u065e","translation":"33. ou semblables \u00e0 des chameaux jaunes.","footnotes":""},{"id":"5656","sura":"77","aya":"34","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"34. Malheur, ce jour-l\u00e0, aux n\u00e9gateurs !","footnotes":""},{"id":"5657","sura":"77","aya":"35","arabic_text":"\u0647\u064e\u0670\u0630\u064e\u0627 \u064a\u064e\u0648\u06e1\u0645\u064f \u0644\u064e\u0627 \u064a\u064e\u0646\u0637\u0650\u0642\u064f\u0648\u0646\u064e","translation":"35. Ce jour-l\u00e0, (les m\u00e9cr\u00e9ants) ne pourront ni parler,","footnotes":""},{"id":"5658","sura":"77","aya":"36","arabic_text":"\u0648\u064e\u0644\u064e\u0627 \u064a\u064f\u0624\u06e1\u0630\u064e\u0646\u064f \u0644\u064e\u0647\u064f\u0645\u06e1 \u0641\u064e\u064a\u064e\u0639\u06e1\u062a\u064e\u0630\u0650\u0631\u064f\u0648\u0646\u064e","translation":"36. ni ne seront autoris\u00e9s \u00e0 pr\u00e9senter des excuses.","footnotes":""},{"id":"5659","sura":"77","aya":"37","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"37. Malheur, ce jour-l\u00e0, aux n\u00e9gateurs !","footnotes":""},{"id":"5660","sura":"77","aya":"38","arabic_text":"\u0647\u064e\u0670\u0630\u064e\u0627 \u064a\u064e\u0648\u06e1\u0645\u064f \u0671\u0644\u06e1\u0641\u064e\u0635\u06e1\u0644\u0650\u06d6 \u062c\u064e\u0645\u064e\u0639\u06e1\u0646\u064e\u0670\u0643\u064f\u0645\u06e1 \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0648\u0651\u064e\u0644\u0650\u064a\u0646\u064e","translation":"38. Voici venu le Jour de la D\u00e9cision o\u00f9 Nous vous r\u00e9unissons avec ceux qui vous ont pr\u00e9c\u00e9d\u00e9s.","footnotes":""},{"id":"5661","sura":"77","aya":"39","arabic_text":"\u0641\u064e\u0625\u0650\u0646 \u0643\u064e\u0627\u0646\u064e \u0644\u064e\u0643\u064f\u0645\u06e1 \u0643\u064e\u064a\u06e1\u062f\u065e \u0641\u064e\u0643\u0650\u064a\u062f\u064f\u0648\u0646\u0650","translation":"39. Si vous avez quelque stratag\u00e8me faites-en donc usage contre Moi !","footnotes":""},{"id":"5662","sura":"77","aya":"40","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"40. Malheur, ce jour-l\u00e0, aux n\u00e9gateurs !","footnotes":""},{"id":"5663","sura":"77","aya":"41","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u06e1\u0645\u064f\u062a\u0651\u064e\u0642\u0650\u064a\u0646\u064e \u0641\u0650\u064a \u0638\u0650\u0644\u064e\u0670\u0644\u0656 \u0648\u064e\u0639\u064f\u064a\u064f\u0648\u0646\u0656","translation":"41. Ceux qui sont pieux seront au milieu d\u2019ombrages et de sources (vives),","footnotes":""},{"id":"5664","sura":"77","aya":"42","arabic_text":"\u0648\u064e\u0641\u064e\u0648\u064e\u0670\u0643\u0650\u0647\u064e \u0645\u0650\u0645\u0651\u064e\u0627 \u064a\u064e\u0634\u06e1\u062a\u064e\u0647\u064f\u0648\u0646\u064e","translation":"42. et auront les fruits qu\u2019ils d\u00e9sireront.","footnotes":""},{"id":"5665","sura":"77","aya":"43","arabic_text":"\u0643\u064f\u0644\u064f\u0648\u0627\u0652 \u0648\u064e\u0671\u0634\u06e1\u0631\u064e\u0628\u064f\u0648\u0627\u0652 \u0647\u064e\u0646\u0650\u064a\u0653\u0640\u0654\u064e\u06e2\u0627 \u0628\u0650\u0645\u064e\u0627 \u0643\u064f\u0646\u062a\u064f\u0645\u06e1 \u062a\u064e\u0639\u06e1\u0645\u064e\u0644\u064f\u0648\u0646\u064e","translation":"43. \u00ab Mangez et buvez en paix pour tout ce que vous faisiez. \u00bb","footnotes":""},{"id":"5666","sura":"77","aya":"44","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0627 \u0643\u064e\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0646\u064e\u062c\u06e1\u0632\u0650\u064a \u0671\u0644\u06e1\u0645\u064f\u062d\u06e1\u0633\u0650\u0646\u0650\u064a\u0646\u064e","translation":"44. C\u2019est ainsi que Nous r\u00e9tribuons les bienfaiteurs.","footnotes":""},{"id":"5667","sura":"77","aya":"45","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"45. Malheur, ce jour-l\u00e0, aux n\u00e9gateurs !","footnotes":""},{"id":"5668","sura":"77","aya":"46","arabic_text":"\u0643\u064f\u0644\u064f\u0648\u0627\u0652 \u0648\u064e\u062a\u064e\u0645\u064e\u062a\u0651\u064e\u0639\u064f\u0648\u0627\u0652 \u0642\u064e\u0644\u0650\u064a\u0644\u064b\u0627 \u0625\u0650\u0646\u0651\u064e\u0643\u064f\u0645 \u0645\u0651\u064f\u062c\u06e1\u0631\u0650\u0645\u064f\u0648\u0646\u064e","translation":"46. \u00ab Mangez et jouissez pour peu de temps (\u00f4 m\u00e9cr\u00e9ants), vous \u00eates certes des sc\u00e9l\u00e9rats ! \u00bb","footnotes":""},{"id":"5669","sura":"77","aya":"47","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"47. Malheur, ce jour-l\u00e0, aux n\u00e9gateurs !","footnotes":""},{"id":"5670","sura":"77","aya":"48","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0642\u0650\u064a\u0644\u064e \u0644\u064e\u0647\u064f\u0645\u064f \u0671\u0631\u06e1\u0643\u064e\u0639\u064f\u0648\u0627\u0652 \u0644\u064e\u0627 \u064a\u064e\u0631\u06e1\u0643\u064e\u0639\u064f\u0648\u0646\u064e","translation":"48. Quand il leur est dit : \u00ab Inclinez-vous (pour la \u00c7al\u00e2t) \u00bb, ils ne s\u2019inclinent pas.","footnotes":""},{"id":"5671","sura":"77","aya":"49","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"49. Malheur, ce jour-l\u00e0, aux n\u00e9gateurs !","footnotes":""},{"id":"5672","sura":"77","aya":"50","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u062d\u064e\u062f\u0650\u064a\u062b\u0650\u06ed \u0628\u064e\u0639\u06e1\u062f\u064e\u0647\u064f\u06e5 \u064a\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e","translation":"50. En quelle parole, apr\u00e8s celle-l\u00e0, vont-ils donc croire ?","footnotes":""}]}