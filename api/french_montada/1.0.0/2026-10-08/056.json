lation":"29. et des fleurs d\u2019acacias bellement dispos\u00e9es,","footnotes":""},{"id":"5009","sura":"56","aya":"30","arabic_text":"\u0648\u064e\u0638\u0650\u0644\u0651\u0656 \u0645\u0651\u064e\u0645\u06e1\u062f\u064f\u0648\u062f\u0656","translation":"30. sous des ombres qui s\u2019\u00e9tendent,","footnotes":""},{"id":"5010","sura":"56","aya":"31","arabic_text":"\u0648\u064e\u0645\u064e\u0627\u0653\u0621\u0656 \u0645\u0651\u064e\u0633\u06e1\u0643\u064f\u0648\u0628\u0656","translation":"31. aupr\u00e8s d\u2019une eau coulant sans cesse,","footnotes":""},{"id":"5011","sura":"56","aya":"32","arabic_text":"\u0648\u064e\u0641\u064e\u0670\u0643\u0650\u0647\u064e\u0629\u0656 \u0643\u064e\u062b\u0650\u064a\u0631\u064e\u0629\u0656","translation":"32. et des fruits \u00e0 profusion,","footnotes":""},{"id":"5012","sura":"56","aya":"33","arabic_text":"\u0644\u0651\u064e\u0627 \u0645\u064e\u0642\u06e1\u0637\u064f\u0648\u0639\u064e\u0629\u0656 \u0648\u064e\u0644\u064e\u0627 \u0645\u064e\u0645\u06e1\u0646\u064f\u0648\u0639\u064e\u0629\u0656","translation":"33. ni introuvables ni d\u00e9fendus.","footnotes":""},{"id":"5013","sura":"56","aya":"34","arabic_text":"\u0648\u064e\u0641\u064f\u0631\u064f\u0634\u0656 \u0645\u0651\u064e\u0631\u06e1\u0641\u064f\u0648\u0639\u064e\u0629\u064d","translation":"34. Et (il y aura pour eux) des lits \u00e9lev\u00e9s.","footnotes":""},{"id":"5014","sura":"56","aya":"35","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0627\u0653 \u0623\u064e\u0646\u0634\u064e\u0623\u06e1\u0646\u064e\u0670\u0647\u064f\u0646\u0651\u064e \u0625\u0650\u0646\u0634\u064e\u0627\u0653\u0621\u0657","translation":"35. Nous les[2] avons (v\u00e9ritablement) cr\u00e9\u00e9es d\u2019une cr\u00e9ation (nouvelle),","footnotes":"[2] Les houris du Paradis."},{"id":"5015","sura":"56","aya":"36","arabic_text":"\u0641\u064e\u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0670\u0647\u064f\u0646\u0651\u064e \u0623\u064e\u0628\u06e1\u0643\u064e\u0627\u0631\u064b\u0627","translation":"36. et nous en avons fait des vierges (\u00e9ternelles),","footnotes":""},{"id":"5016","sura":"56","aya":"37","arabic_text":"\u0639\u064f\u0631\u064f\u0628\u064b\u0627 \u0623\u064e\u062a\u06e1\u0631\u064e\u0627\u0628\u0657\u0627","translation":"37. pleines de tendresse et toutes du m\u00eame \u00e2ge,","footnotes":""},{"id":"5017","sura":"56","aya":"38","arabic_text":"\u0644\u0651\u0650\u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u0650 \u0671\u0644\u06e1\u064a\u064e\u0645\u0650\u064a\u0646\u0650","translation":"38. \u00e0 l\u2019intention des gens de la dextre.","footnotes":""},{"id":"5018","sura":"56","aya":"39","arabic_text":"\u062b\u064f\u0644\u0651\u064e\u0629\u065e \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u06e1\u0623\u064e\u0648\u0651\u064e\u0644\u0650\u064a\u0646\u064e","translation":"39. Nombre seront (choisis) parmi les g\u00e9n\u00e9rations premi\u00e8res,","footnotes":""},{"id":"5019","sura":"56","aya":"40","arabic_text":"\u0648\u064e\u062b\u064f\u0644\u0651\u064e\u0629\u065e \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u0650\u064a\u0646\u064e","translation":"40. et nombre seront (choisis) parmi les g\u00e9n\u00e9rations qui ont suivi.","footnotes":""},{"id":"5020","sura":"56","aya":"41","arabic_text":"\u0648\u064e\u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u064f \u0671\u0644\u0634\u0651\u0650\u0645\u064e\u0627\u0644\u0650 \u0645\u064e\u0627\u0653 \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u064f \u0671\u0644\u0634\u0651\u0650\u0645\u064e\u0627\u0644\u0650","translation":"41. Quant aux gens de la senestre : mais que sont les gens de la senestre ?","footnotes":""},{"id":"5021","sura":"56","aya":"42","arabic_text":"\u0641\u0650\u064a \u0633\u064e\u0645\u064f\u0648\u0645\u0656 \u0648\u064e\u062d\u064e\u0645\u0650\u064a\u0645\u0656","translation":"42. Ils seront au sein m\u00eame du souffle infernal et (baigneront) dans l\u2019eau bouillante,","footnotes":""},{"id":"5022","sura":"56","aya":"43","arabic_text":"\u0648\u064e\u0638\u0650\u0644\u0651\u0656 \u0645\u0651\u0650\u0646 \u064a\u064e\u062d\u06e1\u0645\u064f\u0648\u0645\u0656","translation":"43. dans l\u2019ombre d\u2019une fum\u00e9e \u00e9paisse et noire,","footnotes":""},{"id":"5023","sura":"56","aya":"44","arabic_text":"\u0644\u0651\u064e\u0627 \u0628\u064e\u0627\u0631\u0650\u062f\u0656 \u0648\u064e\u0644\u064e\u0627 \u0643\u064e\u0631\u0650\u064a\u0645\u064d","translation":"44. ni fra\u00eeche ni cl\u00e9mente.","footnotes":""},{"id":"5024","sura":"56","aya":"45","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u0642\u064e\u0628\u06e1\u0644\u064e \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0645\u064f\u062a\u06e1\u0631\u064e\u0641\u0650\u064a\u0646\u064e","translation":"45. Avant cela, ils \u00e9taient dans l\u2019opulence,","footnotes":""},{"id":"5025","sura":"56","aya":"46","arabic_text":"\u0648\u064e\u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u064a\u064f\u0635\u0650\u0631\u0651\u064f\u0648\u0646\u064e \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u06e1\u062d\u0650\u0646\u062b\u0650 \u0671\u0644\u06e1\u0639\u064e\u0638\u0650\u064a\u0645\u0650","translation":"46. et s\u2019obstinaient dans le comble du p\u00e9ch\u00e9.","footnotes":""},{"id":"5026","sura":"56","aya":"47","arabic_text":"\u0648\u064e\u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u064a\u064e\u0642\u064f\u0648\u0644\u064f\u0648\u0646\u064e \u0623\u064e\u0626\u0650\u0630\u064e\u0627 \u0645\u0650\u062a\u06e1\u0646\u064e\u0627 \u0648\u064e\u0643\u064f\u0646\u0651\u064e\u0627 \u062a\u064f\u0631\u064e\u0627\u0628\u0657\u0627 \u0648\u064e\u0639\u0650\u0638\u064e\u0670\u0645\u064b\u0627 \u0623\u064e\u0621\u0650\u0646\u0651\u064e\u0627 \u0644\u064e\u0645\u064e\u0628\u06e1\u0639\u064f\u0648\u062b\u064f\u0648\u0646\u064e","translation":"47. Ils disaient : \u00ab Une fois que nous serons morts, r\u00e9duits en poussi\u00e8re et ossements, serons-nous vraiment ressuscit\u00e9s ?","footnotes":""},{"id":"5027","sura":"56","aya":"48","arabic_text":"\u0623\u064e\u0648\u064e\u0621\u064e\u0627\u0628\u064e\u0627\u0653\u0624\u064f\u0646\u064e\u0627 \u0671\u0644\u06e1\u0623\u064e\u0648\u0651\u064e\u0644\u064f\u0648\u0646\u064e","translation":"48. Et les premiers de nos anc\u00eatres aussi ? \u00bb","footnotes":""},{"id":"5028","sura":"56","aya":"49","arabic_text":"\u0642\u064f\u0644\u06e1 \u0625\u0650\u0646\u0651\u064e \u0671\u0644\u06e1\u0623\u064e\u0648\u0651\u064e\u0644\u0650\u064a\u0646\u064e \u0648\u064e\u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u0650\u064a\u0646\u064e","translation":"49. Dis : \u00ab Les premiers et les derniers","footnotes":""},{"id":"5029","sura":"56","aya":"50","arabic_text":"\u0644\u064e\u0645\u064e\u062c\u06e1\u0645\u064f\u0648\u0639\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u064e\u0649\u0670 \u0645\u0650\u064a\u0642\u064e\u0670\u062a\u0650 \u064a\u064e\u0648\u06e1\u0645\u0656 \u0645\u0651\u064e\u0639\u06e1\u0644\u064f\u0648\u0645\u0656","translation":"50. seront tous r\u00e9unis pour le rendez-vous d\u2019un jour d\u00e9j\u00e0 connu. \u00bb","footnotes":""},{"id":"5030","sura":"56","aya":"51","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0625\u0650\u0646\u0651\u064e\u0643\u064f\u0645\u06e1 \u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u0636\u0651\u064e\u0627\u0653\u0644\u0651\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f\u0648\u0646\u064e","translation":"51. Puis vous, les \u00e9gar\u00e9s, les n\u00e9gateurs,","footnotes":""},{"id":"5031","sura":"56","aya":"52","arabic_text":"\u0644\u064e\u0623\u0653\u0643\u0650\u0644\u064f\u0648\u0646\u064e \u0645\u0650\u0646 \u0634\u064e\u062c\u064e\u0631\u0656 \u0645\u0651\u0650\u0646 \u0632\u064e\u0642\u0651\u064f\u0648\u0645\u0656","translation":"52. vous mangerez certainement de l\u2019arbre de Zaqq\u00fbm,","footnotes":""},{"id":"5032","sura":"56","aya":"53","arabic_text":"\u0641\u064e\u0645\u064e\u0627\u0644\u0650\u0640\u0654\u064f\u0648\u0646\u064e \u0645\u0650\u0646\u06e1\u0647\u064e\u0627 \u0671\u0644\u06e1\u0628\u064f\u0637\u064f\u0648\u0646\u064e","translation":"53. et vos ventres en seront pleins.","footnotes":""},{"id":"5033","sura":"56","aya":"54","arabic_text":"\u0641\u064e\u0634\u064e\u0670\u0631\u0650\u0628\u064f\u0648\u0646\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650 \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u062d\u064e\u0645\u0650\u064a\u0645\u0650","translation":"54. Puis vous ingurgiterez en plus une eau bouillante,","footnotes":""},{"id":"5034","sura":"56","aya":"55","arabic_text":"\u0641\u064e\u0634\u064e\u0670\u0631\u0650\u0628\u064f\u0648\u0646\u064e \u0634\u064f\u0631\u06e1\u0628\u064e \u0671\u0644\u06e1\u0647\u0650\u064a\u0645\u0650","translation":"55. dont vous boirez goul\u00fbment ainsi que des chameaux qui meurent de soif.","footnotes":""},{"id":"5035","sura":"56","aya":"56","arabic_text":"\u0647\u064e\u0670\u0630\u064e\u0627 \u0646\u064f\u0632\u064f\u0644\u064f\u0647\u064f\u0645\u06e1 \u064a\u064e\u0648\u06e1\u0645\u064e \u0671\u0644\u062f\u0651\u0650\u064a\u0646\u0650","translation":"56. Tel sera le repas d\u2019arriv\u00e9e au Jour de la R\u00e9tribution.","footnotes":""},{"id":"5036","sura":"56","aya":"57","arabic_text":"\u0646\u064e\u062d\u06e1\u0646\u064f \u062e\u064e\u0644\u064e\u0642\u06e1\u0646\u064e\u0670\u0643\u064f\u0645\u06e1 \u0641\u064e\u0644\u064e\u0648\u06e1\u0644\u064e\u0627 \u062a\u064f\u0635\u064e\u062f\u0651\u0650\u0642\u064f\u0648\u0646\u064e","translation":"57. Nous vous avons cr\u00e9\u00e9s, pourquoi ne croirez-vous donc pas (\u00e0 votre r\u00e9surrection)?","footnotes":""},{"id":"5037","sura":"56","aya":"58","arabic_text":"\u0623\u064e\u0641\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064f\u0645 \u0645\u0651\u064e\u0627 \u062a\u064f\u0645\u06e1\u0646\u064f\u0648\u0646\u064e","translation":"58. Avez-vous consid\u00e9r\u00e9 ce que vous \u00e9jaculez ?","footnotes":""},{"id":"5038","sura":"56","aya":"59","arabic_text":"\u0621\u064e\u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u062a\u064e\u062e\u06e1\u0644\u064f\u0642\u064f\u0648\u0646\u064e\u0647\u064f\u06e5\u0653 \u0623\u064e\u0645\u06e1 \u0646\u064e\u062d\u06e1\u0646\u064f \u0671\u0644\u06e1\u062e\u064e\u0670\u0644\u0650\u0642\u064f\u0648\u0646\u064e","translation":"59. Est-ce vous qui le cr\u00e9ez ou est-ce Nous le Cr\u00e9ateur ?","footnotes":""},{"id":"5039","sura":"56","aya":"60","arabic_text":"\u0646\u064e\u062d\u06e1\u0646\u064f \u0642\u064e\u062f\u0651\u064e\u0631\u06e1\u0646\u064e\u0627 \u0628\u064e\u064a\u06e1\u0646\u064e\u0643\u064f\u0645\u064f \u0671\u0644\u06e1\u0645\u064e\u0648\u06e1\u062a\u064e \u0648\u064e\u0645\u064e\u0627 \u0646\u064e\u062d\u06e1\u0646\u064f \u0628\u0650\u0645\u064e\u0633\u06e1\u0628\u064f\u0648\u0642\u0650\u064a\u0646\u064e","translation":"60. C\u2019est Nous Qui avons d\u00e9cr\u00e9t\u00e9 la mort parmi vous, et personne ne Nous pr\u00e9c\u00e9dera","footnotes":""},{"id":"5040","sura":"56","aya":"61","arabic_text":"\u0639\u064e\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0646 \u0646\u0651\u064f\u0628\u064e\u062f\u0651\u0650\u0644\u064e \u0623\u064e\u0645\u06e1\u062b\u064e\u0670\u0644\u064e\u0643\u064f\u0645\u06e1 \u0648\u064e\u0646\u064f\u0646\u0634\u0650\u0626\u064e\u0643\u064f\u0645\u06e1 \u0641\u0650\u064a \u0645\u064e\u0627 \u0644\u064e\u0627 \u062a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e","translation":"61. pour vous remplacer par d\u2019autres comme vous, ni pour vous recr\u00e9er en ce que vous ne sauriez conna\u00eetre.","footnotes":""},{"id":"5041","sura":"56","aya":"62","arabic_text":"\u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u0639\u064e\u0644\u0650\u0645\u06e1\u062a\u064f\u0645\u064f \u0671\u0644\u0646\u0651\u064e\u0634\u06e1\u0623\u064e\u0629\u064e \u0671\u0644\u06e1\u0623\u064f\u0648\u0644\u064e\u0649\u0670 \u0641\u064e\u0644\u064e\u0648\u06e1\u0644\u064e\u0627 \u062a\u064e\u0630\u064e\u0643\u0651\u064e\u0631\u064f\u0648\u0646\u064e","translation":"62. Vous avez pourtant connu la premi\u00e8re cr\u00e9ation, que n\u2019y r\u00e9fl\u00e9chissez-vous pas ?","footnotes":""},{"id":"5042","sura":"56","aya":"63","arabic_text":"\u0623\u064e\u0641\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064f\u0645 \u0645\u0651\u064e\u0627 \u062a\u064e\u062d\u06e1\u0631\u064f\u062b\u064f\u0648\u0646\u064e","translation":"63. Ne voyez-vous pas ce que vous labourez ?","footnotes":""},{"id":"5043","sura":"56","aya":"64","arabic_text":"\u0621\u064e\u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u062a\u064e\u0632\u06e1\u0631\u064e\u0639\u064f\u0648\u0646\u064e\u0647\u064f\u06e5\u0653 \u0623\u064e\u0645\u06e1 \u0646\u064e\u062d\u06e1\u0646\u064f \u0671\u0644\u0632\u0651\u064e\u0670\u0631\u0650\u0639\u064f\u0648\u0646\u064e","translation":"64. Est-ce vous qui en semez (les graines), ou est-ce Nous le Semeur ?","footnotes":""},{"id":"5044","sura":"56","aya":"65","arabic_text":"\u0644\u064e\u0648\u06e1 \u0646\u064e\u0634\u064e\u0627\u0653\u0621\u064f \u0644\u064e\u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0670\u0647\u064f \u062d\u064f\u0637\u064e\u0670\u0645\u0657\u0627 \u0641\u064e\u0638\u064e\u0644\u06e1\u062a\u064f\u0645\u06e1 \u062a\u064e\u0641\u064e\u0643\u0651\u064e\u0647\u064f\u0648\u0646\u064e","translation":"65. Si Nous voulions, Nous en ferions un amas de d\u00e9bris, et vous n\u2019en croiriez pas vos yeux.","footnotes":""},{"id":"5045","sura":"56","aya":"66","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0627 \u0644\u064e\u0645\u064f\u063a\u06e1\u0631\u064e\u0645\u064f\u0648\u0646\u064e","translation":"66. \u00ab Nous voil\u00e0 cribl\u00e9s de dettes !","footnotes":""},{"id":"5046","sura":"56","aya":"67","arabic_text":"\u0628\u064e\u0644\u06e1 \u0646\u064e\u062d\u06e1\u0646\u064f \u0645\u064e\u062d\u06e1\u0631\u064f\u0648\u0645\u064f\u0648\u0646\u064e","translation":"67. Ou nous voil\u00e0 plut\u00f4t ruin\u00e9s ! \u00bb","footnotes":""},{"id":"5047","sura":"56","aya":"68","arabic_text":"\u0623\u064e\u0641\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064f\u0645\u064f \u0671\u0644\u06e1\u0645\u064e\u0627\u0653\u0621\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u062a\u064e\u0634\u06e1\u0631\u064e\u0628\u064f\u0648\u0646\u064e","translation":"68. Ne voyez-vous pas l\u2019eau dont vous buvez ?","footnotes":""},{"id":"5048","sura":"56","aya":"69","arabic_text":"\u0621\u064e\u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u0623\u064e\u0646\u0632\u064e\u0644\u06e1\u062a\u064f\u0645\u064f\u0648\u0647\u064f \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0645\u064f\u0632\u06e1\u0646\u0650 \u0623\u064e\u0645\u06e1 \u0646\u064e\u062d\u06e1\u0646\u064f \u0671\u0644\u06e1\u0645\u064f\u0646\u0632\u0650\u0644\u064f\u0648\u0646\u064e","translation":"69. Est-ce vous qui la faites descendre des nuages ou est-ce Nous qui le faisons ?","footnotes":""},{"id":"5049","sura":"56","aya":"70","arabic_text":"\u0644\u064e\u0648\u06e1 \u0646\u064e\u0634\u064e\u0627\u0653\u0621\u064f \u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0670\u0647\u064f \u0623\u064f\u062c\u064e\u0627\u062c\u0657\u0627 \u0641\u064e\u0644\u064e\u0648\u06e1\u0644\u064e\u0627 \u062a\u064e\u0634\u06e1\u0643\u064f\u0631\u064f\u0648\u0646\u064e","translation":"70. Si Nous voulions, Nous en ferions une eau saum\u00e2tre. Que n\u2019\u00eates-vous donc reconnaissants ?","footnotes":""},{"id":"5050","sura":"56","aya":"71","arabic_text":"\u0623\u064e\u0641\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064f\u0645\u064f \u0671\u0644\u0646\u0651\u064e\u0627\u0631\u064e \u0671\u0644\u0651\u064e\u062a\u0650\u064a \u062a\u064f\u0648\u0631\u064f\u0648\u0646\u064e","translation":"71. Ne voyez-vous pas le feu que vous allumez ?","footnotes":""},{"id":"5051","sura":"56","aya":"72","arabic_text":"\u0621\u064e\u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u0623\u064e\u0646\u0634\u064e\u0623\u06e1\u062a\u064f\u0645\u06e1 \u0634\u064e\u062c\u064e\u0631\u064e\u062a\u064e\u0647\u064e\u0627\u0653 \u0623\u064e\u0645\u06e1 \u0646\u064e\u062d\u06e1\u0646\u064f \u0671\u0644\u06e1\u0645\u064f\u0646\u0634\u0650\u0640\u0654\u064f\u0648\u0646\u064e","translation":"72. Est-ce vous qui avez cr\u00e9\u00e9 l\u2019arbre (qui permet de l\u2019allumer) ou est-ce Nous le Cr\u00e9ateur ?","footnotes":""},{"id":"5052","sura":"56","aya":"73","arabic_text":"\u0646\u064e\u062d\u06e1\u0646\u064f \u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0670\u0647\u064e\u0627 \u062a\u064e\u0630\u06e1\u0643\u0650\u0631\u064e\u0629\u0657 \u0648\u064e\u0645\u064e\u062a\u064e\u0670\u0639\u0657\u0627 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0642\u06e1\u0648\u0650\u064a\u0646\u064e","translation":"73. Nous avons fait (du feu) un rappel et un \u00e9l\u00e9ment au service des hommes.[3]","footnotes":"[3] Litt\u00e9ralement : aux voyageurs qui campent dans le d\u00e9sert."},{"id":"5053","sura":"56","aya":"74","arabic_text":"\u0641\u064e\u0633\u064e\u0628\u0651\u0650\u062d\u06e1 \u0628\u0650\u0671\u0633\u06e1\u0645\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0671\u0644\u06e1\u0639\u064e\u0638\u0650\u064a\u0645\u0650","translation":"74. Rends donc gloire au nom de ton Seigneur, le Tr\u00e8s Grand !","footnotes":""},{"id":"5054","sura":"56","aya":"75","arabic_text":"\u06de\u00a0\u0641\u064e\u0644\u064e\u0627\u0653 \u0623\u064f\u0642\u06e1\u0633\u0650\u0645\u064f \u0628\u0650\u0645\u064e\u0648\u064e\u0670\u0642\u0650\u0639\u0650 \u0671\u0644\u0646\u0651\u064f\u062c\u064f\u0648\u0645\u0650","translation":"75. Non ! J\u2019en Jure par les positions des \u00e9toiles,","footnotes":""},{"id":"5055","sura":"56","aya":"76","arabic_text":"\u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u0642\u064e\u0633\u064e\u0645\u065e \u0644\u0651\u064e\u0648\u06e1 \u062a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e \u0639\u064e\u0638\u0650\u064a\u0645\u064c","translation":"76. Et voil\u00e0 le plus solennel des serments, si vous saviez,","footnotes":""},{"id":"5056","sura":"56","aya":"77","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u0642\u064f\u0631\u06e1\u0621\u064e\u0627\u0646\u065e \u0643\u064e\u0631\u0650\u064a\u0645\u065e","translation":"77. que c\u2019est certes un Coran noble,","footnotes":""},{"id":"5057","sura":"56","aya":"78","arabic_text":"\u0641\u0650\u064a \u0643\u0650\u062a\u064e\u0670\u0628\u0656 \u0645\u0651\u064e\u0643\u06e1\u0646\u064f\u0648\u0646\u0656","translation":"78. en un Livre prot\u00e9g\u00e9,","footnotes":""},{"id":"5058","sura":"56","aya":"79","arabic_text":"\u0644\u0651\u064e\u0627 \u064a\u064e\u0645\u064e\u0633\u0651\u064f\u0647\u064f\u06e5\u0653 \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u06e1\u0645\u064f\u0637\u064e\u0647\u0651\u064e\u0631\u064f\u0648\u0646\u064e","translation":"79. et que ne touchent que les purifi\u00e9s.","footnotes":""},{"id":"5059","sura":"56","aya":"80","arabic_text":"\u062a\u064e\u0646\u0632\u0650\u064a\u0644\u065e \u0645\u0651\u0650\u0646 \u0631\u0651\u064e\u0628\u0651\u0650 \u0671\u0644\u06e1\u0639\u064e\u0670\u0644\u064e\u0645\u0650\u064a\u0646\u064e","translation":"80. C\u2019est l\u00e0 une r\u00e9v\u00e9lation du Seigneur de l\u2019Univers.","footnotes":""},{"id":"5060","sura":"56","aya":"81","arabic_text":"\u0623\u064e\u0641\u064e\u0628\u0650\u0647\u064e\u0670\u0630\u064e\u0627 \u0671\u0644\u06e1\u062d\u064e\u062f\u0650\u064a\u062b\u0650 \u0623\u064e\u0646\u062a\u064f\u0645 \u0645\u0651\u064f\u062f\u06e1\u0647\u0650\u0646\u064f\u0648\u0646\u064e","translation":"81. Est-ce donc \u00e0 ce discours-l\u00e0[4] que vous refusez de croire ?","footnotes":"[4] Le Coran."},{"id":"5061","sura":"56","aya":"82","arabic_text":"\u0648\u064e\u062a\u064e\u062c\u06e1\u0639\u064e\u0644\u064f\u0648\u0646\u064e \u0631\u0650\u0632\u06e1\u0642\u064e\u0643\u064f\u0645\u06e1 \u0623\u064e\u0646\u0651\u064e\u0643\u064f\u0645\u06e1 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f\u0648\u0646\u064e","translation":"82. Serait-ce l\u00e0 votre mani\u00e8re de reconna\u00eetre les bienfaits que de tenir (le Coran) pour un mensonge ?","footnotes":""},{"id":"5062","sura":"56","aya":"83","arabic_text":"\u0641\u064e\u0644\u064e\u0648\u06e1\u0644\u064e\u0627\u0653 \u0625\u0650\u0630\u064e\u0627 \u0628\u064e\u0644\u064e\u063a\u064e\u062a\u0650 \u0671\u0644\u06e1\u062d\u064f\u0644\u06e1\u0642\u064f\u0648\u0645\u064e","translation":"83. Lorsque ( avant d\u2019\u00eatre rendue) l\u2019\u00e2me remonte jusqu\u2019\u00e0 la gorge,","footnotes":""},{"id":"5063","sura":"56","aya":"84","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u062d\u0650\u064a\u0646\u064e\u0626\u0650\u0630\u0656 \u062a\u064e\u0646\u0638\u064f\u0631\u064f\u0648\u0646\u064e","translation":"84. alors que vous \u00eates l\u00e0 \u00e0 regarder,","footnotes":""},{"id":"5064","sura":"56","aya":"85","arabic_text":"\u0648\u064e\u0646\u064e\u062d\u06e1\u0646\u064f \u0623\u064e\u0642\u06e1\u0631\u064e\u0628\u064f \u0625\u0650\u0644\u064e\u064a\u06e1\u0647\u0650 \u0645\u0650\u0646\u0643\u064f\u0645\u06e1 \u0648\u064e\u0644\u064e\u0670\u0643\u0650\u0646 \u0644\u0651\u064e\u0627 \u062a\u064f\u0628\u06e1\u0635\u0650\u0631\u064f\u0648\u0646\u064e","translation":"85. et que Nous sommes plus proches (du mourant) que vous ne l\u2019\u00eates, mais vous ne le voyez pas,","footnotes":""},{"id":"5065","sura":"56","aya":"86","arabic_text":"\u0641\u064e\u0644\u064e\u0648\u06e1\u0644\u064e\u0627\u0653 \u0625\u0650\u0646 \u0643\u064f\u0646\u062a\u064f\u0645\u06e1 \u063a\u064e\u064a\u06e1\u0631\u064e \u0645\u064e\u062f\u0650\u064a\u0646\u0650\u064a\u0646\u064e","translation":"86. pourquoi donc, si vous n\u2019avez pas vraiment \u00e0 payer pour vos \u0153uvres,","footnotes":""},{"id":"5066","sura":"56","aya":"87","arabic_text":"\u062a\u064e\u0631\u06e1\u062c\u0650\u0639\u064f\u0648\u0646\u064e\u0647\u064e\u0627\u0653 \u0625\u0650\u0646 \u0643\u064f\u0646\u062a\u064f\u0645\u06e1 \u0635\u064e\u0670\u062f\u0650\u0642\u0650\u064a\u0646\u064e","translation":"87. ne la faites-vous pas revenir, si vous \u00eates sinc\u00e8res (dans vos dires) ?","footnotes":""},{"id":"5067","sura":"56","aya":"88","arabic_text":"\u0641\u064e\u0623\u064e\u0645\u0651\u064e\u0627\u0653 \u0625\u0650\u0646 \u0643\u064e\u0627\u0646\u064e \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0645\u064f\u0642\u064e\u0631\u0651\u064e\u0628\u0650\u064a\u0646\u064e","translation":"88. Si (le d\u00e9funt) est du nombre des privil\u00e9gi\u00e9s,[5]","footnotes":"[5] Litt\u00e9ralement : des rapproch\u00e9s."},{"id":"5068","sura":"56","aya":"89","arabic_text":"\u0641\u064e\u0631\u064e\u0648\u06e1\u062d\u065e \u0648\u064e\u0631\u064e\u064a\u06e1\u062d\u064e\u0627\u0646\u065e \u0648\u064e\u062c\u064e\u0646\u0651\u064e\u062a\u064f \u0646\u064e\u0639\u0650\u064a\u0645\u0656","translation":"89. Il y aura alors pour lui repos, gr\u00e2ce et Jardin des d\u00e9lices.","footnotes":""},{"id":"5069","sura":"56","aya":"90","arabic_text":"\u0648\u064e\u0623\u064e\u0645\u0651\u064e\u0627\u0653 \u0625\u0650\u0646 \u0643\u064e\u0627\u0646\u064e \u0645\u0650\u0646\u06e1 \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u0650 \u0671\u0644\u06e1\u064a\u064e\u0645\u0650\u064a\u0646\u0650","translation":"90. Et s\u2019il est du nombre des gens de la dextre,","footnotes":""},{"id":"5070","sura":"56","aya":"91","arabic_text":"\u0641\u064e\u0633\u064e\u0644\u064e\u0670\u0645\u065e \u0644\u0651\u064e\u0643\u064e \u0645\u0650\u0646\u06e1 \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u0650 \u0671\u0644\u06e1\u064a\u064e\u0645\u0650\u064a\u0646\u0650","translation":"91. Alors, \u00ab Paix \u00e0 toi (lui sera-t-il dit), (\u00f4 toi qui fais partie) des gens de la dextre. \u00bb","footnotes":""},{"id":"5071","sura":"56","aya":"92","arabic_text":"\u0648\u064e\u0623\u064e\u0645\u0651\u064e\u0627\u0653 \u0625\u0650\u0646 \u0643\u064e\u0627\u0646\u064e \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e \u0671\u0644\u0636\u0651\u064e\u0627\u0653\u0644\u0651\u0650\u064a\u0646\u064e","translation":"92. Et s\u2019il est du nombre des n\u00e9gateurs fourvoy\u00e9s,","footnotes":""},{"id":"5072","sura":"56","aya":"93","arabic_text":"\u0641\u064e\u0646\u064f\u0632\u064f\u0644\u065e \u0645\u0651\u0650\u0646\u06e1 \u062d\u064e\u0645\u0650\u064a\u0645\u0656","translation":"93. il sera l\u2019h\u00f4te (de l\u2019Enfer) o\u00f9 il sera abreuv\u00e9 d\u2019eau bouillante,","footnotes":""},{"id":"5073","sura":"56","aya":"94","arabic_text":"\u0648\u064e\u062a\u064e\u0635\u06e1\u0644\u0650\u064a\u064e\u0629\u064f \u062c\u064e\u062d\u0650\u064a\u0645\u064d","translation":"94. et o\u00f9 il br\u00fblera dans la Fournaise.","footnotes":""},{"id":"5074","sura":"56","aya":"95","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0647\u064e\u0670\u0630\u064e\u0627 \u0644\u064e\u0647\u064f\u0648\u064e \u062d\u064e\u0642\u0651\u064f \u0671\u0644\u06e1\u064a\u064e\u0642\u0650\u064a\u0646\u0650","translation":"95. Telle est la v\u00e9ritable certitude.","footnotes":""},{"id":"5075","sura":"56","aya":"96","arabic_text":"\u0641\u064e\u0633\u064e\u0628\u0651\u0650\u062d\u06e1 \u0628\u0650\u0671\u0633\u06e1\u0645\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0671\u0644\u06e1\u0639\u064e\u0638\u0650\u064a\u0645\u0650","translation":"96. Rends donc gloire au Nom de ton Seigneur, le Tr\u00e8s Grand.","footnotes":""}]}