 l\u2019a nivel\u00e9e.","footnotes":""},{"id":"5743","sura":"79","aya":"31","arabic_text":"\u0623\u064e\u062e\u06e1\u0631\u064e\u062c\u064e \u0645\u0650\u0646\u06e1\u0647\u064e\u0627 \u0645\u064e\u0627\u0653\u0621\u064e\u0647\u064e\u0627 \u0648\u064e\u0645\u064e\u0631\u06e1\u0639\u064e\u0649\u0670\u0647\u064e\u0627","translation":"31. Il en a fait sortir eaux et p\u00e2turages.","footnotes":""},{"id":"5744","sura":"79","aya":"32","arabic_text":"\u0648\u064e\u0671\u0644\u06e1\u062c\u0650\u0628\u064e\u0627\u0644\u064e \u0623\u064e\u0631\u06e1\u0633\u064e\u0649\u0670\u0647\u064e\u0627","translation":"32. Les montagnes, Il les a implant\u00e9es,","footnotes":""},{"id":"5745","sura":"79","aya":"33","arabic_text":"\u0645\u064e\u062a\u064e\u0670\u0639\u0657\u0627 \u0644\u0651\u064e\u0643\u064f\u0645\u06e1 \u0648\u064e\u0644\u0650\u0623\u064e\u0646\u06e1\u0639\u064e\u0670\u0645\u0650\u0643\u064f\u0645\u06e1","translation":"33. pour vos besoins \u00e0 vous et \u00e0 ceux de vos bestiaux.","footnotes":""},{"id":"5746","sura":"79","aya":"34","arabic_text":"\u0641\u064e\u0625\u0650\u0630\u064e\u0627 \u062c\u064e\u0627\u0653\u0621\u064e\u062a\u0650 \u0671\u0644\u0637\u0651\u064e\u0627\u0653\u0645\u0651\u064e\u0629\u064f \u0671\u0644\u06e1\u0643\u064f\u0628\u06e1\u0631\u064e\u0649\u0670","translation":"34. Mais quand se produira le plus grand des cataclysmes,","footnotes":""},{"id":"5747","sura":"79","aya":"35","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064e\u062a\u064e\u0630\u064e\u0643\u0651\u064e\u0631\u064f \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u0645\u064e\u0627 \u0633\u064e\u0639\u064e\u0649\u0670","translation":"35. le jour o\u00f9 l\u2019homme se souviendra de ce tout ce qu\u2019il s\u2019est employ\u00e9 \u00e0 accomplir,","footnotes":""},{"id":"5748","sura":"79","aya":"36","arabic_text":"\u0648\u064e\u0628\u064f\u0631\u0651\u0650\u0632\u064e\u062a\u0650 \u0671\u0644\u06e1\u062c\u064e\u062d\u0650\u064a\u0645\u064f \u0644\u0650\u0645\u064e\u0646 \u064a\u064e\u0631\u064e\u0649\u0670","translation":"36. et que l\u2019Enfer sera mis en \u00e9vidence devant quiconque peut voir,","footnotes":""},{"id":"5749","sura":"79","aya":"37","arabic_text":"\u0641\u064e\u0623\u064e\u0645\u0651\u064e\u0627 \u0645\u064e\u0646 \u0637\u064e\u063a\u064e\u0649\u0670","translation":"37. alors, celui qui se sera livr\u00e9 \u00e0 la d\u00e9mesure,","footnotes":""},{"id":"5750","sura":"79","aya":"38","arabic_text":"\u0648\u064e\u0621\u064e\u0627\u062b\u064e\u0631\u064e \u0671\u0644\u06e1\u062d\u064e\u064a\u064e\u0648\u0670\u0629\u064e \u0671\u0644\u062f\u0651\u064f\u0646\u06e1\u064a\u064e\u0627","translation":"38. et qui aura pr\u00e9f\u00e9r\u00e9 la vie en ce bas monde,","footnotes":""},{"id":"5751","sura":"79","aya":"39","arabic_text":"\u0641\u064e\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u06e1\u062c\u064e\u062d\u0650\u064a\u0645\u064e \u0647\u0650\u064a\u064e \u0671\u0644\u06e1\u0645\u064e\u0623\u06e1\u0648\u064e\u0649\u0670","translation":"39. aura pour seul refuge l\u2019Enfer !","footnotes":""},{"id":"5752","sura":"79","aya":"40","arabic_text":"\u0648\u064e\u0623\u064e\u0645\u0651\u064e\u0627 \u0645\u064e\u0646\u06e1 \u062e\u064e\u0627\u0641\u064e \u0645\u064e\u0642\u064e\u0627\u0645\u064e \u0631\u064e\u0628\u0651\u0650\u0647\u0650\u06e6 \u0648\u064e\u0646\u064e\u0647\u064e\u0649 \u0671\u0644\u0646\u0651\u064e\u0641\u06e1\u0633\u064e \u0639\u064e\u0646\u0650 \u0671\u0644\u06e1\u0647\u064e\u0648\u064e\u0649\u0670","translation":"40. Quant \u00e0 celui que le statut supr\u00eame de son Seigneur (faisait trembler) de crainte, (celui qui) s\u2019interdisait de succomber aux passions,","footnotes":""},{"id":"5753","sura":"79","aya":"41","arabic_text":"\u0641\u064e\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u06e1\u062c\u064e\u0646\u0651\u064e\u0629\u064e \u0647\u0650\u064a\u064e \u0671\u0644\u06e1\u0645\u064e\u0623\u06e1\u0648\u064e\u0649\u0670","translation":"41. le Paradis sera son s\u00e9jour.","footnotes":""},{"id":"5754","sura":"79","aya":"42","arabic_text":"\u064a\u064e\u0633\u06e1\u0640\u0654\u064e\u0644\u064f\u0648\u0646\u064e\u0643\u064e \u0639\u064e\u0646\u0650 \u0671\u0644\u0633\u0651\u064e\u0627\u0639\u064e\u0629\u0650 \u0623\u064e\u064a\u0651\u064e\u0627\u0646\u064e \u0645\u064f\u0631\u06e1\u0633\u064e\u0649\u0670\u0647\u064e\u0627","translation":"42. Ils t\u2019interrogent au sujet de l\u2019Heure : \u00ab Quand va-t-elle enfin venir ? \u00bb","footnotes":""},{"id":"5755","sura":"79","aya":"43","arabic_text":"\u0641\u0650\u064a\u0645\u064e \u0623\u064e\u0646\u062a\u064e \u0645\u0650\u0646 \u0630\u0650\u0643\u06e1\u0631\u064e\u0649\u0670\u0647\u064e\u0627\u0653","translation":"43. Comment saurais-tu y trouver r\u00e9ponse ?","footnotes":""},{"id":"5756","sura":"79","aya":"44","arabic_text":"\u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0645\u064f\u0646\u062a\u064e\u0647\u064e\u0649\u0670\u0647\u064e\u0627\u0653","translation":"44. C\u2019est de ton Seigneur que rel\u00e8ve son terme.","footnotes":""},{"id":"5757","sura":"79","aya":"45","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u0646\u062a\u064e \u0645\u064f\u0646\u0630\u0650\u0631\u064f \u0645\u064e\u0646 \u064a\u064e\u062e\u06e1\u0634\u064e\u0649\u0670\u0647\u064e\u0627","translation":"45. Tu n\u2019es l\u00e0, (quant \u00e0 toi), que pour avertir quiconque l\u2019appr\u00e9hende.","footnotes":""},{"id":"5758","sura":"79","aya":"46","arabic_text":"\u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064e\u0631\u064e\u0648\u06e1\u0646\u064e\u0647\u064e\u0627 \u0644\u064e\u0645\u06e1 \u064a\u064e\u0644\u06e1\u0628\u064e\u062b\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u0644\u0651\u064e\u0627 \u0639\u064e\u0634\u0650\u064a\u0651\u064e\u0629\u064b \u0623\u064e\u0648\u06e1 \u0636\u064f\u062d\u064e\u0649\u0670\u0647\u064e\u0627","translation":"46. Le jour o\u00f9 ils la verront, ce sera comme s\u2019ils n\u2019\u00e9taient rest\u00e9s (sur terre) qu\u2019un apr\u00e8s-midi ou une matin\u00e9e !","footnotes":""}]}