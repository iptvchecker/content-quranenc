4\u064e\u0670\u0642\u0650\u064a\u0647\u0650","translation":"6. alors, \u00f4 toi \u00eatre humain qui sans cesse t\u2019\u00e9vertues pour aller vers ton Seigneur, (sache que) tu Le rencontreras !","footnotes":""},{"id":"5891","sura":"84","aya":"7","arabic_text":"\u0641\u064e\u0623\u064e\u0645\u0651\u064e\u0627 \u0645\u064e\u0646\u06e1 \u0623\u064f\u0648\u062a\u0650\u064a\u064e \u0643\u0650\u062a\u064e\u0670\u0628\u064e\u0647\u064f\u06e5 \u0628\u0650\u064a\u064e\u0645\u0650\u064a\u0646\u0650\u0647\u0650\u06e6","translation":"7. Celui qui aura re\u00e7u son Livre en sa main droite","footnotes":""},{"id":"5892","sura":"84","aya":"8","arabic_text":"\u0641\u064e\u0633\u064e\u0648\u06e1\u0641\u064e \u064a\u064f\u062d\u064e\u0627\u0633\u064e\u0628\u064f \u062d\u0650\u0633\u064e\u0627\u0628\u0657\u0627 \u064a\u064e\u0633\u0650\u064a\u0631\u0657\u0627","translation":"8. sera jug\u00e9 d\u2019un jugement cl\u00e9ment,","footnotes":""},{"id":"5893","sura":"84","aya":"9","arabic_text":"\u0648\u064e\u064a\u064e\u0646\u0642\u064e\u0644\u0650\u0628\u064f \u0625\u0650\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0647\u06e1\u0644\u0650\u0647\u0650\u06e6 \u0645\u064e\u0633\u06e1\u0631\u064f\u0648\u0631\u0657\u0627","translation":"9. et s\u2019en reviendra heureux aupr\u00e8s de sa famille.","footnotes":""},{"id":"5894","sura":"84","aya":"10","arabic_text":"\u0648\u064e\u0623\u064e\u0645\u0651\u064e\u0627 \u0645\u064e\u0646\u06e1 \u0623\u064f\u0648\u062a\u0650\u064a\u064e \u0643\u0650\u062a\u064e\u0670\u0628\u064e\u0647\u064f\u06e5 \u0648\u064e\u0631\u064e\u0627\u0653\u0621\u064e \u0638\u064e\u0647\u06e1\u0631\u0650\u0647\u0650\u06e6","translation":"10. Quant \u00e0 celui qui recevra son Livre derri\u00e8re son dos,","footnotes":""},{"id":"5895","sura":"84","aya":"11","arabic_text":"\u0641\u064e\u0633\u064e\u0648\u06e1\u0641\u064e \u064a\u064e\u062f\u06e1\u0639\u064f\u0648\u0627\u0652 \u062b\u064f\u0628\u064f\u0648\u0631\u0657\u0627","translation":"11. il criera au malheur","footnotes":""},{"id":"5896","sura":"84","aya":"12","arabic_text":"\u0648\u064e\u064a\u064e\u0635\u06e1\u0644\u064e\u0649\u0670 \u0633\u064e\u0639\u0650\u064a\u0631\u064b\u0627","translation":"12. et br\u00fblera dans le Brasier.","footnotes":""},{"id":"5897","sura":"84","aya":"13","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0643\u064e\u0627\u0646\u064e \u0641\u0650\u064a\u0653 \u0623\u064e\u0647\u06e1\u0644\u0650\u0647\u0650\u06e6 \u0645\u064e\u0633\u06e1\u0631\u064f\u0648\u0631\u064b\u0627","translation":"13. Il \u00e9tait heureux aupr\u00e8s de sa famille,","footnotes":""},{"id":"5898","sura":"84","aya":"14","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0638\u064e\u0646\u0651\u064e \u0623\u064e\u0646 \u0644\u0651\u064e\u0646 \u064a\u064e\u062d\u064f\u0648\u0631\u064e","translation":"14. s\u2019imaginant que jamais il ne reviendrait \u00e0 la vie (pour \u00eatre jug\u00e9).","footnotes":""},{"id":"5899","sura":"84","aya":"15","arabic_text":"\u0628\u064e\u0644\u064e\u0649\u0670\u0653\u06da \u0625\u0650\u0646\u0651\u064e \u0631\u064e\u0628\u0651\u064e\u0647\u064f\u06e5 \u0643\u064e\u0627\u0646\u064e \u0628\u0650\u0647\u0650\u06e6 \u0628\u064e\u0635\u0650\u064a\u0631\u0657\u0627","translation":"15. Eh bien si ! Son Seigneur, Tout Voyant, l\u2019observait en permanence.","footnotes":""},{"id":"5900","sura":"84","aya":"16","arabic_text":"\u0641\u064e\u0644\u064e\u0627\u0653 \u0623\u064f\u0642\u06e1\u0633\u0650\u0645\u064f \u0628\u0650\u0671\u0644\u0634\u0651\u064e\u0641\u064e\u0642\u0650","translation":"16. J\u2019en jure par le cr\u00e9puscule !","footnotes":""},{"id":"5901","sura":"84","aya":"17","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u064a\u06e1\u0644\u0650 \u0648\u064e\u0645\u064e\u0627 \u0648\u064e\u0633\u064e\u0642\u064e","translation":"17. Par la nuit et ce qu\u2019elle englobe !","footnotes":""},{"id":"5902","sura":"84","aya":"18","arabic_text":"\u0648\u064e\u0671\u0644\u06e1\u0642\u064e\u0645\u064e\u0631\u0650 \u0625\u0650\u0630\u064e\u0627 \u0671\u062a\u0651\u064e\u0633\u064e\u0642\u064e","translation":"18. Par la lune quand elle est pleine !","footnotes":""},{"id":"5903","sura":"84","aya":"19","arabic_text":"\u0644\u064e\u062a\u064e\u0631\u06e1\u0643\u064e\u0628\u064f\u0646\u0651\u064e \u0637\u064e\u0628\u064e\u0642\u064b\u0627 \u0639\u064e\u0646 \u0637\u064e\u0628\u064e\u0642\u0656","translation":"19. Vous passerez sans cesse \u00e9tape par \u00e9tape.","footnotes":""},{"id":"5904","sura":"84","aya":"20","arabic_text":"\u0641\u064e\u0645\u064e\u0627 \u0644\u064e\u0647\u064f\u0645\u06e1 \u0644\u064e\u0627 \u064a\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e","translation":"20. Pourquoi donc ne croient-ils pas ?","footnotes":""},{"id":"5905","sura":"84","aya":"21","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0642\u064f\u0631\u0650\u0626\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650\u0645\u064f \u0671\u0644\u06e1\u0642\u064f\u0631\u06e1\u0621\u064e\u0627\u0646\u064f \u0644\u064e\u0627 \u064a\u064e\u0633\u06e1\u062c\u064f\u062f\u064f\u0648\u0646\u064e\u06e4\u06e9","translation":"21. Et quand le Coran leur est lu ne se prosternent-ils pas ?[1]","footnotes":"[1] Une prosternation est recommand\u00e9e apr\u00e8s la lecture de ce verset."},{"id":"5906","sura":"84","aya":"22","arabic_text":"\u0628\u064e\u0644\u0650 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u0652 \u064a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f\u0648\u0646\u064e","translation":"22. C\u2019est que les m\u00e9cr\u00e9ants le tiennent pour mensonge.","footnotes":""},{"id":"5907","sura":"84","aya":"23","arabic_text":"\u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0623\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0628\u0650\u0645\u064e\u0627 \u064a\u064f\u0648\u0639\u064f\u0648\u0646\u064e","translation":"23. Mais Allah Sait le mieux (les sentiments secrets) qu\u2019ils nourrissent.","footnotes":""},{"id":"5908","sura":"84","aya":"24","arabic_text":"\u0641\u064e\u0628\u064e\u0634\u0651\u0650\u0631\u06e1\u0647\u064f\u0645 \u0628\u0650\u0639\u064e\u0630\u064e\u0627\u0628\u064d \u0623\u064e\u0644\u0650\u064a\u0645\u064d","translation":"24. Annonce-leur donc un supplice tr\u00e8s douloureux.","footnotes":""},{"id":"5909","sura":"84","aya":"25","arabic_text":"\u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u0652 \u0648\u064e\u0639\u064e\u0645\u0650\u0644\u064f\u0648\u0627\u0652 \u0671\u0644\u0635\u0651\u064e\u0670\u0644\u0650\u062d\u064e\u0670\u062a\u0650 \u0644\u064e\u0647\u064f\u0645\u06e1 \u0623\u064e\u062c\u06e1\u0631\u064c \u063a\u064e\u064a\u06e1\u0631\u064f \u0645\u064e\u0645\u06e1\u0646\u064f\u0648\u0646\u0650\u06ed","translation":"25. \u00c0 l\u2019exception de ceux qui ont cru et ont accompli les bonnes \u0153uvres, et qui auront alors une r\u00e9compense illimit\u00e9e.","footnotes":""}]}