u062a\u064e\u0646\u064e\u0670\u0641\u0650\u0633\u064f\u0648\u0646\u064e","translation":"26. Son cachet sera de musc : voil\u00e0 (un objectif) pour ceux qui voudraient rivaliser (de ferveur pour l\u2019atteindre) !","footnotes":""},{"id":"5875","sura":"83","aya":"27","arabic_text":"\u0648\u064e\u0645\u0650\u0632\u064e\u0627\u062c\u064f\u0647\u064f\u06e5 \u0645\u0650\u0646 \u062a\u064e\u0633\u06e1\u0646\u0650\u064a\u0645\u064d","translation":"27. (Et ce nectar) sera m\u00e9lang\u00e9 \u00e0 l\u2019eau de Tasn\u00eem,","footnotes":""},{"id":"5876","sura":"83","aya":"28","arabic_text":"\u0639\u064e\u064a\u06e1\u0646\u0657\u0627 \u064a\u064e\u0634\u06e1\u0631\u064e\u0628\u064f \u0628\u0650\u0647\u064e\u0627 \u0671\u0644\u06e1\u0645\u064f\u0642\u064e\u0631\u0651\u064e\u0628\u064f\u0648\u0646\u064e","translation":"28. source dont boivent les privil\u00e9gi\u00e9s.[2]","footnotes":"[2] Litt\u00e9ralement : les rapproch\u00e9s. Si nous avons traduit ainsi, c\u2019est pour qu\u2019il n\u2019y ait pas de confusion avec le sens du m\u00eame mot utilis\u00e9 au verset 21 (voir la note pr\u00e9c\u00e9dente). En effet, cette fois il ne s\u2019agit pas des Anges mais des hommes vertueux, les h\u00f4tes \u00e9ternels du Paradis."},{"id":"5877","sura":"83","aya":"29","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064e\u062c\u06e1\u0631\u064e\u0645\u064f\u0648\u0627\u0652 \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u0645\u0650\u0646\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u0652 \u064a\u064e\u0636\u06e1\u062d\u064e\u0643\u064f\u0648\u0646\u064e","translation":"29. Ceux qui commettaient les crimes se riaient de ceux qui avaient cru.","footnotes":""},{"id":"5878","sura":"83","aya":"30","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0645\u064e\u0631\u0651\u064f\u0648\u0627\u0652 \u0628\u0650\u0647\u0650\u0645\u06e1 \u064a\u064e\u062a\u064e\u063a\u064e\u0627\u0645\u064e\u0632\u064f\u0648\u0646\u064e","translation":"30. Lorsqu\u2019ils passaient \u00e0 c\u00f4t\u00e9 d\u2019eux, (ils les toisaient et) \u00e9changeaient des clins d\u2019\u0153il.","footnotes":""},{"id":"5879","sura":"83","aya":"31","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0646\u0642\u064e\u0644\u064e\u0628\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0647\u06e1\u0644\u0650\u0647\u0650\u0645\u064f \u0671\u0646\u0642\u064e\u0644\u064e\u0628\u064f\u0648\u0627\u0652 \u0641\u064e\u0643\u0650\u0647\u0650\u064a\u0646\u064e","translation":"31. Et quand ils retournaient chez eux, ils retournaient l\u2019air moqueur.","footnotes":""},{"id":"5880","sura":"83","aya":"32","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0631\u064e\u0623\u064e\u0648\u06e1\u0647\u064f\u0645\u06e1 \u0642\u064e\u0627\u0644\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u0646\u0651\u064e \u0647\u064e\u0670\u0653\u0624\u064f\u0644\u064e\u0627\u0653\u0621\u0650 \u0644\u064e\u0636\u064e\u0627\u0653\u0644\u0651\u064f\u0648\u0646\u064e","translation":"32. Et quand ils les voyaient, ils disaient : \u00ab Ceux-l\u00e0 sont vraiment \u00e9gar\u00e9s ! \u00bb","footnotes":""},{"id":"5881","sura":"83","aya":"33","arabic_text":"\u0648\u064e\u0645\u064e\u0627\u0653 \u0623\u064f\u0631\u06e1\u0633\u0650\u0644\u064f\u0648\u0627\u0652 \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650\u0645\u06e1 \u062d\u064e\u0670\u0641\u0650\u0638\u0650\u064a\u0646\u064e","translation":"33. Pourtant, nul ne les a charg\u00e9s d\u2019\u00eatre leurs gardiens.","footnotes":""},{"id":"5882","sura":"83","aya":"34","arabic_text":"\u0641\u064e\u0671\u0644\u06e1\u064a\u064e\u0648\u06e1\u0645\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u0652 \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0643\u064f\u0641\u0651\u064e\u0627\u0631\u0650 \u064a\u064e\u0636\u06e1\u062d\u064e\u0643\u064f\u0648\u0646\u064e","translation":"34. Mais ce jour-l\u00e0, ce sera ceux qui ont cru qui riront des m\u00e9cr\u00e9ants.","footnotes":""},{"id":"5883","sura":"83","aya":"35","arabic_text":"\u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u06e1\u0623\u064e\u0631\u064e\u0627\u0653\u0626\u0650\u0643\u0650 \u064a\u064e\u0646\u0638\u064f\u0631\u064f\u0648\u0646\u064e","translation":"35. (\u00c9tendus) sur les couches, ils verront bien alors","footnotes":""},{"id":"5884","sura":"83","aya":"36","arabic_text":"\u0647\u064e\u0644\u06e1 \u062b\u064f\u0648\u0651\u0650\u0628\u064e \u0671\u0644\u06e1\u0643\u064f\u0641\u0651\u064e\u0627\u0631\u064f \u0645\u064e\u0627 \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u064a\u064e\u0641\u06e1\u0639\u064e\u0644\u064f\u0648\u0646\u064e","translation":"36. si les m\u00e9cr\u00e9ants n\u2019ont pas \u00e9t\u00e9 r\u00e9tribu\u00e9s pour ce qu\u2019ils faisaient !","footnotes":""}]}