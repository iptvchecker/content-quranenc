 seront r\u00e9unies en couples (semblables),","footnotes":""},{"id":"5808","sura":"81","aya":"8","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u06e1\u0645\u064e\u0648\u06e1\u0621\u064f\u06e5\u062f\u064e\u0629\u064f \u0633\u064f\u0626\u0650\u0644\u064e\u062a\u06e1","translation":"8. et qu\u2019il sera demand\u00e9 \u00e0 la fillette enterr\u00e9e vivante","footnotes":""},{"id":"5809","sura":"81","aya":"9","arabic_text":"\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0630\u064e\u0646\u06e2\u0628\u0656 \u0642\u064f\u062a\u0650\u0644\u064e\u062a\u06e1","translation":"9. pour quel p\u00e9ch\u00e9 elle a \u00e9t\u00e9 tu\u00e9e,","footnotes":""},{"id":"5810","sura":"81","aya":"10","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u0635\u0651\u064f\u062d\u064f\u0641\u064f \u0646\u064f\u0634\u0650\u0631\u064e\u062a\u06e1","translation":"10. quand les feuilles (du Livre des comptes) seront d\u00e9ploy\u00e9es,","footnotes":""},{"id":"5811","sura":"81","aya":"11","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u064f \u0643\u064f\u0634\u0650\u0637\u064e\u062a\u06e1","translation":"11. quand le ciel sera d\u00e9pouill\u00e9,","footnotes":""},{"id":"5812","sura":"81","aya":"12","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u06e1\u062c\u064e\u062d\u0650\u064a\u0645\u064f \u0633\u064f\u0639\u0651\u0650\u0631\u064e\u062a\u06e1","translation":"12. que l\u2019Enfer sera attis\u00e9,","footnotes":""},{"id":"5813","sura":"81","aya":"13","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u06e1\u062c\u064e\u0646\u0651\u064e\u0629\u064f \u0623\u064f\u0632\u06e1\u0644\u0650\u0641\u064e\u062a\u06e1","translation":"13. et le Paradis rapproch\u00e9,","footnotes":""},{"id":"5814","sura":"81","aya":"14","arabic_text":"\u0639\u064e\u0644\u0650\u0645\u064e\u062a\u06e1 \u0646\u064e\u0641\u06e1\u0633\u065e \u0645\u0651\u064e\u0627\u0653 \u0623\u064e\u062d\u06e1\u0636\u064e\u0631\u064e\u062a\u06e1","translation":"14. chaque \u00e2me saura alors ce qu\u2019elle aura accompli.","footnotes":""},{"id":"5815","sura":"81","aya":"15","arabic_text":"\u0641\u064e\u0644\u064e\u0627\u0653 \u0623\u064f\u0642\u06e1\u0633\u0650\u0645\u064f \u0628\u0650\u0671\u0644\u06e1\u062e\u064f\u0646\u0651\u064e\u0633\u0650","translation":"15. J\u2019en jure par les \u00e9toiles qui se meuvent,","footnotes":""},{"id":"5816","sura":"81","aya":"16","arabic_text":"\u0671\u0644\u06e1\u062c\u064e\u0648\u064e\u0627\u0631\u0650 \u0671\u0644\u06e1\u0643\u064f\u0646\u0651\u064e\u0633\u0650","translation":"16. qui surgissent et s\u2019\u00e9clipsent,","footnotes":""},{"id":"5817","sura":"81","aya":"17","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u064a\u06e1\u0644\u0650 \u0625\u0650\u0630\u064e\u0627 \u0639\u064e\u0633\u06e1\u0639\u064e\u0633\u064e","translation":"17. par la nuit quand elle rampe et se r\u00e9pand,","footnotes":""},{"id":"5818","sura":"81","aya":"18","arabic_text":"\u0648\u064e\u0671\u0644\u0635\u0651\u064f\u0628\u06e1\u062d\u0650 \u0625\u0650\u0630\u064e\u0627 \u062a\u064e\u0646\u064e\u0641\u0651\u064e\u0633\u064e","translation":"18. par l\u2019aurore quand elle respire,","footnotes":""},{"id":"5819","sura":"81","aya":"19","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u0642\u064e\u0648\u06e1\u0644\u064f \u0631\u064e\u0633\u064f\u0648\u0644\u0656 \u0643\u064e\u0631\u0650\u064a\u0645\u0656","translation":"19. que c\u2019est la parole[1] d\u2019un noble \u00e9missaire,[2]","footnotes":"[1] Le Coran.\n[2] Nous traduisons ici par \u00ab \u00e9missaire \u00bb et non par \u00ab Messager \u00bb car il s\u2019agit de l\u2019Ange Gabriel et non du Proph\u00e8te (paix et b\u00e9n\u00e9diction d\u2019Allah sur lui)."},{"id":"5820","sura":"81","aya":"20","arabic_text":"\u0630\u0650\u064a \u0642\u064f\u0648\u0651\u064e\u0629\u064d \u0639\u0650\u0646\u062f\u064e \u0630\u0650\u064a \u0671\u0644\u06e1\u0639\u064e\u0631\u06e1\u0634\u0650 \u0645\u064e\u0643\u0650\u064a\u0646\u0656","translation":"20. fort de l\u2019estime du D\u00e9tenteur du Tr\u00f4ne,","footnotes":""},{"id":"5821","sura":"81","aya":"21","arabic_text":"\u0645\u0651\u064f\u0637\u064e\u0627\u0639\u0656 \u062b\u064e\u0645\u0651\u064e \u0623\u064e\u0645\u0650\u064a\u0646\u0656","translation":"21. \u00e9cout\u00e9[3] et loyal.","footnotes":"[3] L\u2019Ange Gabriel est ob\u00e9i des autres Anges."},{"id":"5822","sura":"81","aya":"22","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0635\u064e\u0627\u062d\u0650\u0628\u064f\u0643\u064f\u0645 \u0628\u0650\u0645\u064e\u062c\u06e1\u0646\u064f\u0648\u0646\u0656","translation":"22. Votre compagnon n\u2019est certes pas fou.","footnotes":""},{"id":"5823","sura":"81","aya":"23","arabic_text":"\u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u0631\u064e\u0621\u064e\u0627\u0647\u064f \u0628\u0650\u0671\u0644\u06e1\u0623\u064f\u0641\u064f\u0642\u0650 \u0671\u0644\u06e1\u0645\u064f\u0628\u0650\u064a\u0646\u0650","translation":"23. Il l\u2019a bien vu \u00e0 l\u2019horizon o\u00f9 tout est clair.","footnotes":""},{"id":"5824","sura":"81","aya":"24","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0647\u064f\u0648\u064e \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u06e1\u063a\u064e\u064a\u06e1\u0628\u0650 \u0628\u0650\u0636\u064e\u0646\u0650\u064a\u0646\u0656","translation":"24. Et ce n\u2019est pas lui qui sera avare du myst\u00e8re r\u00e9v\u00e9l\u00e9.","footnotes":""},{"id":"5825","sura":"81","aya":"25","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0647\u064f\u0648\u064e \u0628\u0650\u0642\u064e\u0648\u06e1\u0644\u0650 \u0634\u064e\u064a\u06e1\u0637\u064e\u0670\u0646\u0656 \u0631\u0651\u064e\u062c\u0650\u064a\u0645\u0656","translation":"25. Ce n\u2019est nullement la parole d\u2019un d\u00e9mon lapid\u00e9.","footnotes":""},{"id":"5826","sura":"81","aya":"26","arabic_text":"\u0641\u064e\u0623\u064e\u064a\u06e1\u0646\u064e \u062a\u064e\u0630\u06e1\u0647\u064e\u0628\u064f\u0648\u0646\u064e","translation":"26. Qu\u2019allez-vous donc chercher ?","footnotes":""},{"id":"5827","sura":"81","aya":"27","arabic_text":"\u0625\u0650\u0646\u06e1 \u0647\u064f\u0648\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0630\u0650\u0643\u06e1\u0631\u065e \u0644\u0651\u0650\u0644\u06e1\u0639\u064e\u0670\u0644\u064e\u0645\u0650\u064a\u0646\u064e","translation":"27. Ce n\u2019est l\u00e0 qu\u2019un Rappel pour l\u2019Univers,","footnotes":""},{"id":"5828","sura":"81","aya":"28","arabic_text":"\u0644\u0650\u0645\u064e\u0646 \u0634\u064e\u0627\u0653\u0621\u064e \u0645\u0650\u0646\u0643\u064f\u0645\u06e1 \u0623\u064e\u0646 \u064a\u064e\u0633\u06e1\u062a\u064e\u0642\u0650\u064a\u0645\u064e","translation":"28. pour ceux d\u2019entre vous, qui voudraient prendre le droit chemin.","footnotes":""},{"id":"5829","sura":"81","aya":"29","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u062a\u064e\u0634\u064e\u0627\u0653\u0621\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627\u0653 \u0623\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0631\u064e\u0628\u0651\u064f \u0671\u0644\u06e1\u0639\u064e\u0670\u0644\u064e\u0645\u0650\u064a\u0646\u064e","translation":"29. Or, vous ne voudrez rien qu\u2019Allah ne veuille, Lui, le Seigneur de l\u2019Univers.","footnotes":""}]}