\u064e\u0671\u0644\u06e1\u0623\u064f\u0648\u0644\u064e\u0649\u0670","translation":"oubliant qu\u2019Allah seul d\u00e9tient le pouvoir ici-bas et dans l\u2019au-del\u00e0 ?","footnotes":""},{"id":"4810","sura":"53","aya":"26","arabic_text":"\u06de\u00a0\u0648\u064e\u0643\u064e\u0645 \u0645\u0651\u0650\u0646 \u0645\u0651\u064e\u0644\u064e\u0643\u0656 \u0641\u0650\u064a \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0644\u064e\u0627 \u062a\u064f\u063a\u06e1\u0646\u0650\u064a \u0634\u064e\u0641\u064e\u0670\u0639\u064e\u062a\u064f\u0647\u064f\u0645\u06e1 \u0634\u064e\u064a\u06e1\u0640\u0654\u064b\u0627 \u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u0650\u0646\u06e2 \u0628\u064e\u0639\u06e1\u062f\u0650 \u0623\u064e\u0646 \u064a\u064e\u0623\u06e1\u0630\u064e\u0646\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0644\u0650\u0645\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064f \u0648\u064e\u064a\u064e\u0631\u06e1\u0636\u064e\u0649\u0670\u0653","translation":"Que d\u2019anges dans les cieux qui ne sauraient interc\u00e9der que si Allah le leur permet et uniquement en faveur de ceux dont Il est satisfait.","footnotes":""},{"id":"4811","sura":"53","aya":"27","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0644\u064e\u0627 \u064a\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e \u0628\u0650\u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u064e\u0629\u0650 \u0644\u064e\u064a\u064f\u0633\u064e\u0645\u0651\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u0645\u064e\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e\u0629\u064e \u062a\u064e\u0633\u06e1\u0645\u0650\u064a\u064e\u0629\u064e \u0671\u0644\u06e1\u0623\u064f\u0646\u062b\u064e\u0649\u0670","translation":"Ceux qui ne croient pas en la vie future font des anges des \u00eatres de sexe f\u00e9minin.","footnotes":""},{"id":"4812","sura":"53","aya":"28","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0644\u064e\u0647\u064f\u0645 \u0628\u0650\u0647\u0650\u06e6 \u0645\u0650\u0646\u06e1 \u0639\u0650\u0644\u06e1\u0645\u064d\u06d6 \u0625\u0650\u0646 \u064a\u064e\u062a\u0651\u064e\u0628\u0650\u0639\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u0638\u0651\u064e\u0646\u0651\u064e\u06d6 \u0648\u064e\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0638\u0651\u064e\u0646\u0651\u064e \u0644\u064e\u0627 \u064a\u064f\u063a\u06e1\u0646\u0650\u064a \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u062d\u064e\u0642\u0651\u0650 \u0634\u064e\u064a\u06e1\u0640\u0654\u0657\u0627","translation":"Ils n\u2019en ont pourtant aucune connaissance s\u00fbre, se perdant simplement en conjectures. Or, les conjectures ne sauraient fonder une certitude.","footnotes":""},{"id":"4813","sura":"53","aya":"29","arabic_text":"\u0641\u064e\u0623\u064e\u0639\u06e1\u0631\u0650\u0636\u06e1 \u0639\u064e\u0646 \u0645\u0651\u064e\u0646 \u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0649\u0670 \u0639\u064e\u0646 \u0630\u0650\u0643\u06e1\u0631\u0650\u0646\u064e\u0627 \u0648\u064e\u0644\u064e\u0645\u06e1 \u064a\u064f\u0631\u0650\u062f\u06e1 \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u06e1\u062d\u064e\u064a\u064e\u0648\u0670\u0629\u064e \u0671\u0644\u062f\u0651\u064f\u0646\u06e1\u064a\u064e\u0627","translation":"D\u00e9tourne-toi donc de ceux qui ont eux-m\u00eames tourn\u00e9 le dos \u00e0 Notre message et aspirent uniquement \u00e0 jouir de cette vie.","footnotes":""},{"id":"4814","sura":"53","aya":"30","arabic_text":"\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0645\u064e\u0628\u06e1\u0644\u064e\u063a\u064f\u0647\u064f\u0645 \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u06e1\u0639\u0650\u0644\u06e1\u0645\u0650\u06da \u0625\u0650\u0646\u0651\u064e \u0631\u064e\u0628\u0651\u064e\u0643\u064e \u0647\u064f\u0648\u064e \u0623\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0628\u0650\u0645\u064e\u0646 \u0636\u064e\u0644\u0651\u064e \u0639\u064e\u0646 \u0633\u064e\u0628\u0650\u064a\u0644\u0650\u0647\u0650\u06e6 \u0648\u064e\u0647\u064f\u0648\u064e \u0623\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0628\u0650\u0645\u064e\u0646\u0650 \u0671\u0647\u06e1\u062a\u064e\u062f\u064e\u0649\u0670","translation":"Voil\u00e0 \u00e0 quoi se limite leur savoir. Ton Seigneur sait parfaitement qui s\u2019est \u00e9cart\u00e9 de Sa voie et qui suit le droit chemin.","footnotes":""},{"id":"4815","sura":"53","aya":"31","arabic_text":"\u0648\u064e\u0644\u0650\u0644\u0651\u064e\u0647\u0650 \u0645\u064e\u0627 \u0641\u0650\u064a \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0645\u064e\u0627 \u0641\u0650\u064a \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0644\u0650\u064a\u064e\u062c\u06e1\u0632\u0650\u064a\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064e\u0633\u064e\u0670\u0653\u0640\u0654\u064f\u0648\u0627\u0652 \u0628\u0650\u0645\u064e\u0627 \u0639\u064e\u0645\u0650\u0644\u064f\u0648\u0627\u0652 \u0648\u064e\u064a\u064e\u062c\u06e1\u0632\u0650\u064a\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064e\u062d\u06e1\u0633\u064e\u0646\u064f\u0648\u0627\u0652 \u0628\u0650\u0671\u0644\u06e1\u062d\u064f\u0633\u06e1\u0646\u064e\u0649","translation":"A Allah appartient tout ce qui se trouve dans les cieux et sur la terre qu\u2019Il a cr\u00e9\u00e9s afin de punir ceux qui font le mal selon leurs \u0153uvres et d\u2019accorder la plus belle r\u00e9compense \u00e0 ceux qui font le bien,","footnotes":""},{"id":"4816","sura":"53","aya":"32","arabic_text":"\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u064a\u064e\u062c\u06e1\u062a\u064e\u0646\u0650\u0628\u064f\u0648\u0646\u064e \u0643\u064e\u0628\u064e\u0670\u0653\u0626\u0650\u0631\u064e \u0671\u0644\u06e1\u0625\u0650\u062b\u06e1\u0645\u0650 \u0648\u064e\u0671\u0644\u06e1\u0641\u064e\u0648\u064e\u0670\u062d\u0650\u0634\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u0644\u0651\u064e\u0645\u064e\u0645\u064e\u06da \u0625\u0650\u0646\u0651\u064e \u0631\u064e\u0628\u0651\u064e\u0643\u064e \u0648\u064e\u0670\u0633\u0650\u0639\u064f \u0671\u0644\u06e1\u0645\u064e\u063a\u06e1\u0641\u0650\u0631\u064e\u0629\u0650\u06da \u0647\u064f\u0648\u064e \u0623\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0628\u0650\u0643\u064f\u0645\u06e1 \u0625\u0650\u0630\u06e1 \u0623\u064e\u0646\u0634\u064e\u0623\u064e\u0643\u064f\u0645 \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0648\u064e\u0625\u0650\u0630\u06e1 \u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u0623\u064e\u062c\u0650\u0646\u0651\u064e\u0629\u065e \u0641\u0650\u064a \u0628\u064f\u0637\u064f\u0648\u0646\u0650 \u0623\u064f\u0645\u0651\u064e\u0647\u064e\u0670\u062a\u0650\u0643\u064f\u0645\u06e1\u06d6 \u0641\u064e\u0644\u064e\u0627 \u062a\u064f\u0632\u064e\u0643\u0651\u064f\u0648\u0653\u0627\u0652 \u0623\u064e\u0646\u0641\u064f\u0633\u064e\u0643\u064f\u0645\u06e1\u06d6 \u0647\u064f\u0648\u064e \u0623\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0628\u0650\u0645\u064e\u0646\u0650 \u0671\u062a\u0651\u064e\u0642\u064e\u0649\u0670\u0653","translation":"ceux qui fuient les p\u00e9ch\u00e9s les plus graves et les actes inf\u00e2mes, commettant uniquement des fautes v\u00e9nielles[8]. Le pardon de ton Seigneur est infini. Il savait parfaitement \u00e0 quoi s\u2019en tenir \u00e0 votre sujet lorsqu\u2019Il vous a cr\u00e9\u00e9s de terre et lorsque vous n\u2019\u00e9tiez que des embryons dans le ventre de vos m\u00e8res. Ne vantez donc pas vos propres m\u00e9rites. Il sait parfaitement qui Le craint r\u00e9ellement.","footnotes":"[8] Qu\u2019Allah leur pardonnera."},{"id":"4817","sura":"53","aya":"33","arabic_text":"\u0623\u064e\u0641\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0649\u0670","translation":"N\u2019as-tu pas vu celui qui a tourn\u00e9 le dos \u00e0 la foi,","footnotes":""},{"id":"4818","sura":"53","aya":"34","arabic_text":"\u0648\u064e\u0623\u064e\u0639\u06e1\u0637\u064e\u0649\u0670 \u0642\u064e\u0644\u0650\u064a\u0644\u0657\u0627 \u0648\u064e\u0623\u064e\u0643\u06e1\u062f\u064e\u0649\u0670\u0653","translation":"qui a peu donn\u00e9 avant de s\u2019en abstenir totalement ?","footnotes":""},{"id":"4819","sura":"53","aya":"35","arabic_text":"\u0623\u064e\u0639\u0650\u0646\u062f\u064e\u0647\u064f\u06e5 \u0639\u0650\u0644\u06e1\u0645\u064f \u0671\u0644\u06e1\u063a\u064e\u064a\u06e1\u0628\u0650 \u0641\u064e\u0647\u064f\u0648\u064e \u064a\u064e\u0631\u064e\u0649\u0670\u0653","translation":"Conna\u00eet-il l\u2019avenir qu\u2019il serait capable de pr\u00e9voir ?","footnotes":""},{"id":"4820","sura":"53","aya":"36","arabic_text":"\u0623\u064e\u0645\u06e1 \u0644\u064e\u0645\u06e1 \u064a\u064f\u0646\u064e\u0628\u0651\u064e\u0623\u06e1 \u0628\u0650\u0645\u064e\u0627 \u0641\u0650\u064a \u0635\u064f\u062d\u064f\u0641\u0650 \u0645\u064f\u0648\u0633\u064e\u0649\u0670","translation":"N\u2019a-t-il pas \u00e9t\u00e9 inform\u00e9 du contenu des Ecritures de Mo\u00efse","footnotes":""},{"id":"4821","sura":"53","aya":"37","arabic_text":"\u0648\u064e\u0625\u0650\u0628\u06e1\u0631\u064e\u0670\u0647\u0650\u064a\u0645\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u0648\u064e\u0641\u0651\u064e\u0649\u0670\u0653","translation":"et d\u2019Abraham qui s\u2019est parfaitement acquitt\u00e9 de ses devoirs ?","footnotes":""},{"id":"4822","sura":"53","aya":"38","arabic_text":"\u0623\u064e\u0644\u0651\u064e\u0627 \u062a\u064e\u0632\u0650\u0631\u064f \u0648\u064e\u0627\u0632\u0650\u0631\u064e\u0629\u065e \u0648\u0650\u0632\u06e1\u0631\u064e \u0623\u064f\u062e\u06e1\u0631\u064e\u0649\u0670","translation":"Ecritures qui enseignent que nul n\u2019aura \u00e0 supporter le p\u00e9ch\u00e9 d\u2019un autre,","footnotes":""},{"id":"4823","sura":"53","aya":"39","arabic_text":"\u0648\u064e\u0623\u064e\u0646 \u0644\u0651\u064e\u064a\u06e1\u0633\u064e \u0644\u0650\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u0650 \u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u064e\u0627 \u0633\u064e\u0639\u064e\u0649\u0670","translation":"et que chacun ne recevra que le fruit de son labeur,","footnotes":""},{"id":"4824","sura":"53","aya":"40","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e \u0633\u064e\u0639\u06e1\u064a\u064e\u0647\u064f\u06e5 \u0633\u064e\u0648\u06e1\u0641\u064e \u064a\u064f\u0631\u064e\u0649\u0670","translation":"et que ses \u0153uvres, qui seront parfaitement visibles,","footnotes":""},{"id":"4825","sura":"53","aya":"41","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u064a\u064f\u062c\u06e1\u0632\u064e\u0649\u0670\u0647\u064f \u0671\u0644\u06e1\u062c\u064e\u0632\u064e\u0627\u0653\u0621\u064e \u0671\u0644\u06e1\u0623\u064e\u0648\u06e1\u0641\u064e\u0649\u0670","translation":"lui seront un jour pleinement r\u00e9tribu\u00e9es.","footnotes":""},{"id":"4826","sura":"53","aya":"42","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e \u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0671\u0644\u06e1\u0645\u064f\u0646\u062a\u064e\u0647\u064e\u0649\u0670","translation":"Ecritures qui enseignent que tous feront retour \u00e0 ton Seigneur","footnotes":""},{"id":"4827","sura":"53","aya":"43","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u0647\u064f\u0648\u064e \u0623\u064e\u0636\u06e1\u062d\u064e\u0643\u064e \u0648\u064e\u0623\u064e\u0628\u06e1\u0643\u064e\u0649\u0670","translation":"et que c\u2019est Lui qui suscite les rires et les pleurs,","footnotes":""},{"id":"4828","sura":"53","aya":"44","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u0647\u064f\u0648\u064e \u0623\u064e\u0645\u064e\u0627\u062a\u064e \u0648\u064e\u0623\u064e\u062d\u06e1\u064a\u064e\u0627","translation":"et que c\u2019est Lui qui donne la vie et la mort,","footnotes":""},{"id":"4829","sura":"53","aya":"45","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u062e\u064e\u0644\u064e\u0642\u064e \u0671\u0644\u0632\u0651\u064e\u0648\u06e1\u062c\u064e\u064a\u06e1\u0646\u0650 \u0671\u0644\u0630\u0651\u064e\u0643\u064e\u0631\u064e \u0648\u064e\u0671\u0644\u06e1\u0623\u064f\u0646\u062b\u064e\u0649\u0670","translation":"et qu\u2019Il a cr\u00e9\u00e9 le couple, m\u00e2le et femelle,","footnotes":""},{"id":"4830","sura":"53","aya":"46","arabic_text":"\u0645\u0650\u0646 \u0646\u0651\u064f\u0637\u06e1\u0641\u064e\u0629\u064d \u0625\u0650\u0630\u064e\u0627 \u062a\u064f\u0645\u06e1\u0646\u064e\u0649\u0670","translation":"\u00e0 partir d\u2019un liquide insignifiant qui a \u00e9t\u00e9 r\u00e9pandu[9],","footnotes":"[9] Dans la matrice de la femme."},{"id":"4831","sura":"53","aya":"47","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650 \u0671\u0644\u0646\u0651\u064e\u0634\u06e1\u0623\u064e\u0629\u064e \u0671\u0644\u06e1\u0623\u064f\u062e\u06e1\u0631\u064e\u0649\u0670","translation":"et qu\u2019Il se chargera de la nouvelle cr\u00e9ation,","footnotes":""},{"id":"4832","sura":"53","aya":"48","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u0647\u064f\u0648\u064e \u0623\u064e\u063a\u06e1\u0646\u064e\u0649\u0670 \u0648\u064e\u0623\u064e\u0642\u06e1\u0646\u064e\u0649\u0670","translation":"et que c\u2019est Lui qui vous comble de Ses dons[10],","footnotes":"[10] Ou : qui d\u00e9cr\u00e8te votre richesse ou votre pauvret\u00e9."},{"id":"4833","sura":"53","aya":"49","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u0647\u064f\u0648\u064e \u0631\u064e\u0628\u0651\u064f \u0671\u0644\u0634\u0651\u0650\u0639\u06e1\u0631\u064e\u0649\u0670","translation":"et que c\u2019est Lui le v\u00e9ritable Seigneur de Sirius[11],","footnotes":"[11] Etoile v\u00e9n\u00e9r\u00e9e par les Arabes avant l\u2019islam."},{"id":"4834","sura":"53","aya":"50","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5\u0653 \u0623\u064e\u0647\u06e1\u0644\u064e\u0643\u064e \u0639\u064e\u0627\u062f\u064b\u0627 \u0671\u0644\u06e1\u0623\u064f\u0648\u0644\u064e\u0649\u0670","translation":"et qu\u2019Il a an\u00e9anti les premiers \u2018Ad[12]","footnotes":"[12] Le peuple de Houd."},{"id":"4835","sura":"53","aya":"51","arabic_text":"\u0648\u064e\u062b\u064e\u0645\u064f\u0648\u062f\u064e\u0627\u0652 \u0641\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u0628\u06e1\u0642\u064e\u0649\u0670","translation":"et les Thamoud, extermin\u00e9s jusqu\u2019au dernier,","footnotes":""},{"id":"4836","sura":"53","aya":"52","arabic_text":"\u0648\u064e\u0642\u064e\u0648\u06e1\u0645\u064e \u0646\u064f\u0648\u062d\u0656 \u0645\u0651\u0650\u0646 \u0642\u064e\u0628\u06e1\u0644\u064f\u06d6 \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u0647\u064f\u0645\u06e1 \u0623\u064e\u0638\u06e1\u0644\u064e\u0645\u064e \u0648\u064e\u0623\u064e\u0637\u06e1\u063a\u064e\u0649\u0670","translation":"et avant eux le peuple de No\u00e9, plus rebelle \u00e0 la v\u00e9rit\u00e9,","footnotes":""},{"id":"4837","sura":"53","aya":"53","arabic_text":"\u0648\u064e\u0671\u0644\u06e1\u0645\u064f\u0624\u06e1\u062a\u064e\u0641\u0650\u0643\u064e\u0629\u064e \u0623\u064e\u0647\u06e1\u0648\u064e\u0649\u0670","translation":"mais aussi les cit\u00e9s p\u00e9cheresses qui furent renvers\u00e9es","footnotes":""},{"id":"4838","sura":"53","aya":"54","arabic_text":"\u0641\u064e\u063a\u064e\u0634\u0651\u064e\u0649\u0670\u0647\u064e\u0627 \u0645\u064e\u0627 \u063a\u064e\u0634\u0651\u064e\u0649\u0670","translation":"et ensevelies sous une pluie de pierres marqu\u00e9es.","footnotes":""},{"id":"4839","sura":"53","aya":"55","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u062a\u064e\u062a\u064e\u0645\u064e\u0627\u0631\u064e\u0649\u0670","translation":"Lequel des bienfaits de ton Seigneur peux-tu encore contester ?","footnotes":""},{"id":"4840","sura":"53","aya":"56","arabic_text":"\u0647\u064e\u0670\u0630\u064e\u0627 \u0646\u064e\u0630\u0650\u064a\u0631\u065e \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u0646\u0651\u064f\u0630\u064f\u0631\u0650 \u0671\u0644\u06e1\u0623\u064f\u0648\u0644\u064e\u0649\u0670\u0653","translation":"Voici un avertissement comme ceux adress\u00e9s \u00e0 leurs devanciers[13].","footnotes":"[13] Ou : un proph\u00e8te \u00e0 l\u2019image de ceux qui l\u2019ont pr\u00e9c\u00e9d\u00e9."},{"id":"4841","sura":"53","aya":"57","arabic_text":"\u0623\u064e\u0632\u0650\u0641\u064e\u062a\u0650 \u0671\u0644\u06e1\u0623\u0653\u0632\u0650\u0641\u064e\u0629\u064f","translation":"L\u2019Heure du jugement ne cesse de s\u2019approcher.","footnotes":""},{"id":"4842","sura":"53","aya":"58","arabic_text":"\u0644\u064e\u064a\u06e1\u0633\u064e \u0644\u064e\u0647\u064e\u0627 \u0645\u0650\u0646 \u062f\u064f\u0648\u0646\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0643\u064e\u0627\u0634\u0650\u0641\u064e\u0629\u064c","translation":"Nul, en dehors d\u2019Allah, ne saurait la repousser[14].","footnotes":"[14] Autre sens : nul, en dehors d\u2019Allah, n\u2019en conna\u00eet l\u2019av\u00e8nement."},{"id":"4843","sura":"53","aya":"59","arabic_text":"\u0623\u064e\u0641\u064e\u0645\u0650\u0646\u06e1 \u0647\u064e\u0670\u0630\u064e\u0627 \u0671\u0644\u06e1\u062d\u064e\u062f\u0650\u064a\u062b\u0650 \u062a\u064e\u0639\u06e1\u062c\u064e\u0628\u064f\u0648\u0646\u064e","translation":"Est-ce de ce discours que vous vous \u00e9tonnez","footnotes":""},{"id":"4844","sura":"53","aya":"60","arabic_text":"\u0648\u064e\u062a\u064e\u0636\u06e1\u062d\u064e\u0643\u064f\u0648\u0646\u064e \u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u0628\u06e1\u0643\u064f\u0648\u0646\u064e","translation":"et que vous vous moquez plut\u00f4t que d\u2019en pleurer,","footnotes":""},{"id":"4845","sura":"53","aya":"61","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u0633\u064e\u0670\u0645\u0650\u062f\u064f\u0648\u0646\u064e","translation":"l\u2019accueillant avec indiff\u00e9rence et fiert\u00e9 ?","footnotes":""},{"id":"4846","sura":"53","aya":"62","arabic_text":"\u0641\u064e\u0671\u0633\u06e1\u062c\u064f\u062f\u064f\u0648\u0627\u0652\u06e4 \u0644\u0650\u0644\u0651\u064e\u0647\u0650\u06e4 \u0648\u064e\u0671\u0639\u06e1\u0628\u064f\u062f\u064f\u0648\u0627\u0652\u06e9","translation":"Prosternez-vous donc devant Allah et, Lui seul, adorez.","footnotes":""}]}