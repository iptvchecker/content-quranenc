u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u064a\u0645\u064e\u0670\u0646\u0657\u0627 \u0648\u064e\u0644\u064e\u0627 \u064a\u064e\u0631\u06e1\u062a\u064e\u0627\u0628\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064f\u0648\u062a\u064f\u0648\u0627\u0652 \u0671\u0644\u06e1\u0643\u0650\u062a\u064e\u0670\u0628\u064e \u0648\u064e\u0671\u0644\u06e1\u0645\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e \u0648\u064e\u0644\u0650\u064a\u064e\u0642\u064f\u0648\u0644\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0641\u0650\u064a \u0642\u064f\u0644\u064f\u0648\u0628\u0650\u0647\u0650\u0645 \u0645\u0651\u064e\u0631\u064e\u0636\u065e \u0648\u064e\u0671\u0644\u06e1\u0643\u064e\u0670\u0641\u0650\u0631\u064f\u0648\u0646\u064e \u0645\u064e\u0627\u0630\u064e\u0627\u0653 \u0623\u064e\u0631\u064e\u0627\u062f\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0628\u0650\u0647\u064e\u0670\u0630\u064e\u0627 \u0645\u064e\u062b\u064e\u0644\u0657\u0627\u06da \u0643\u064e\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u064a\u064f\u0636\u0650\u0644\u0651\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0645\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064f \u0648\u064e\u064a\u064e\u0647\u06e1\u062f\u0650\u064a \u0645\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064f\u06da \u0648\u064e\u0645\u064e\u0627 \u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u062c\u064f\u0646\u064f\u0648\u062f\u064e \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0647\u064f\u0648\u064e\u06da \u0648\u064e\u0645\u064e\u0627 \u0647\u0650\u064a\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0630\u0650\u0643\u06e1\u0631\u064e\u0649\u0670 \u0644\u0650\u0644\u06e1\u0628\u064e\u0634\u064e\u0631\u0650","translation":"Nous n\u2019avons assign\u00e9 \u00e0 la garde de l\u2019Enfer que des anges dont Nous n\u2019avons indiqu\u00e9 le nombre que pour \u00e9prouver les m\u00e9cr\u00e9ants, convaincre ceux qui ont re\u00e7u les Ecritures et raffermir la foi des croyants. Les gens du Livre et les croyants n\u2019\u00e9prouveront ainsi aucun doute, tandis que ceux dont les c\u0153urs sont malades et les impies diront : \u00ab Pourquoi donc Allah en a pr\u00e9cis\u00e9 le nombre ? \u00bb C\u2019est ainsi qu\u2019Allah laisse s\u2019\u00e9garer qui Il veut et guide qui Il veut. Mais seul ton Seigneur conna\u00eet v\u00e9ritablement Ses arm\u00e9es[4]. Nous n\u2019avons mentionn\u00e9 l\u2019Enfer[5] que pour mettre en garde l\u2019humanit\u00e9.","footnotes":"[4] Le nombre et la puissance de Ses anges.\n[5] Ses horreurs et le nombre de ses gardiens."},{"id":"5527","sura":"74","aya":"32","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627 \u0648\u064e\u0671\u0644\u06e1\u0642\u064e\u0645\u064e\u0631\u0650","translation":"Je jure par la lune,","footnotes":""},{"id":"5528","sura":"74","aya":"33","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u064a\u06e1\u0644\u0650 \u0625\u0650\u0630\u06e1 \u0623\u064e\u062f\u06e1\u0628\u064e\u0631\u064e","translation":"par la nuit sur le point de se retirer","footnotes":""},{"id":"5529","sura":"74","aya":"34","arabic_text":"\u0648\u064e\u0671\u0644\u0635\u0651\u064f\u0628\u06e1\u062d\u0650 \u0625\u0650\u0630\u064e\u0627\u0653 \u0623\u064e\u0633\u06e1\u0641\u064e\u0631\u064e","translation":"pour laisser place \u00e0 l\u2019aube et ses premi\u00e8res clart\u00e9s,","footnotes":""},{"id":"5530","sura":"74","aya":"35","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064e\u0627 \u0644\u064e\u0625\u0650\u062d\u06e1\u062f\u064e\u0649 \u0671\u0644\u06e1\u0643\u064f\u0628\u064e\u0631\u0650","translation":"que l\u2019Enfer est l\u2019une des plus grandes calamit\u00e9s,","footnotes":""},{"id":"5531","sura":"74","aya":"36","arabic_text":"\u0646\u064e\u0630\u0650\u064a\u0631\u0657\u0627 \u0644\u0651\u0650\u0644\u06e1\u0628\u064e\u0634\u064e\u0631\u0650","translation":"un avertissement adress\u00e9 \u00e0 l\u2019ensemble de l\u2019humanit\u00e9,","footnotes":""},{"id":"5532","sura":"74","aya":"37","arabic_text":"\u0644\u0650\u0645\u064e\u0646 \u0634\u064e\u0627\u0653\u0621\u064e \u0645\u0650\u0646\u0643\u064f\u0645\u06e1 \u0623\u064e\u0646 \u064a\u064e\u062a\u064e\u0642\u064e\u062f\u0651\u064e\u0645\u064e \u0623\u064e\u0648\u06e1 \u064a\u064e\u062a\u064e\u0623\u064e\u062e\u0651\u064e\u0631\u064e","translation":"\u00e0 ceux, parmi vous, d\u00e9cid\u00e9s \u00e0 se rapprocher et \u00e0 ceux r\u00e9solus \u00e0 s\u2019\u00e9loigner[6] !","footnotes":"[6] De la foi, c\u2019est-\u00e0-dire, \u00e0 tous les hommes."},{"id":"5533","sura":"74","aya":"38","arabic_text":"\u0643\u064f\u0644\u0651\u064f \u0646\u064e\u0641\u06e1\u0633\u0650\u06ed \u0628\u0650\u0645\u064e\u0627 \u0643\u064e\u0633\u064e\u0628\u064e\u062a\u06e1 \u0631\u064e\u0647\u0650\u064a\u0646\u064e\u0629\u064c","translation":"Chaque \u00eatre est l\u2019otage de ses \u0153uvres,","footnotes":""},{"id":"5534","sura":"74","aya":"39","arabic_text":"\u0625\u0650\u0644\u0651\u064e\u0627\u0653 \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u064e \u0671\u0644\u06e1\u064a\u064e\u0645\u0650\u064a\u0646\u0650","translation":"\u00e0 l\u2019exception des gens de la droite","footnotes":""},{"id":"5535","sura":"74","aya":"40","arabic_text":"\u0641\u0650\u064a \u062c\u064e\u0646\u0651\u064e\u0670\u062a\u0656 \u064a\u064e\u062a\u064e\u0633\u064e\u0627\u0653\u0621\u064e\u0644\u064f\u0648\u0646\u064e","translation":"qui, dans les jardins du Paradis, s\u2019interrogeront","footnotes":""},{"id":"5536","sura":"74","aya":"41","arabic_text":"\u0639\u064e\u0646\u0650 \u0671\u0644\u06e1\u0645\u064f\u062c\u06e1\u0631\u0650\u0645\u0650\u064a\u0646\u064e","translation":"sur le sort des damn\u00e9s, auxquels ils demanderont :","footnotes":""},{"id":"5537","sura":"74","aya":"42","arabic_text":"\u0645\u064e\u0627 \u0633\u064e\u0644\u064e\u0643\u064e\u0643\u064f\u0645\u06e1 \u0641\u0650\u064a \u0633\u064e\u0642\u064e\u0631\u064e","translation":"\u00ab Pour quelle raison \u00eates-vous entr\u00e9s en Enfer ? \u00bb","footnotes":""},{"id":"5538","sura":"74","aya":"43","arabic_text":"\u0642\u064e\u0627\u0644\u064f\u0648\u0627\u0652 \u0644\u064e\u0645\u06e1 \u0646\u064e\u0643\u064f \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0645\u064f\u0635\u064e\u0644\u0651\u0650\u064a\u0646\u064e","translation":"Ils r\u00e9pondront : \u00ab Nous n\u2019\u00e9tions pas de ceux qui accomplissent la pri\u00e8re,","footnotes":""},{"id":"5539","sura":"74","aya":"44","arabic_text":"\u0648\u064e\u0644\u064e\u0645\u06e1 \u0646\u064e\u0643\u064f \u0646\u064f\u0637\u06e1\u0639\u0650\u0645\u064f \u0671\u0644\u06e1\u0645\u0650\u0633\u06e1\u0643\u0650\u064a\u0646\u064e","translation":"ni de ceux qui nourrissent les n\u00e9cessiteux.","footnotes":""},{"id":"5540","sura":"74","aya":"45","arabic_text":"\u0648\u064e\u0643\u064f\u0646\u0651\u064e\u0627 \u0646\u064e\u062e\u064f\u0648\u0636\u064f \u0645\u064e\u0639\u064e \u0671\u0644\u06e1\u062e\u064e\u0627\u0653\u0626\u0650\u0636\u0650\u064a\u0646\u064e","translation":"Nous participions aux plus futiles discussions","footnotes":""},{"id":"5541","sura":"74","aya":"46","arabic_text":"\u0648\u064e\u0643\u064f\u0646\u0651\u064e\u0627 \u0646\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f \u0628\u0650\u064a\u064e\u0648\u06e1\u0645\u0650 \u0671\u0644\u062f\u0651\u0650\u064a\u0646\u0650","translation":"et traitions de mensonge le Jour de la r\u00e9tribution,","footnotes":""},{"id":"5542","sura":"74","aya":"47","arabic_text":"\u062d\u064e\u062a\u0651\u064e\u0649\u0670\u0653 \u0623\u064e\u062a\u064e\u0649\u0670\u0646\u064e\u0627 \u0671\u0644\u06e1\u064a\u064e\u0642\u0650\u064a\u0646\u064f","translation":"jusqu\u2019au jour o\u00f9 nous avons eu la conviction[7]. \u00bb","footnotes":"[7] Jusqu\u2019au jour o\u00f9 la mort nous a emport\u00e9s."},{"id":"5543","sura":"74","aya":"48","arabic_text":"\u0641\u064e\u0645\u064e\u0627 \u062a\u064e\u0646\u0641\u064e\u0639\u064f\u0647\u064f\u0645\u06e1 \u0634\u064e\u0641\u064e\u0670\u0639\u064e\u0629\u064f \u0671\u0644\u0634\u0651\u064e\u0670\u0641\u0650\u0639\u0650\u064a\u0646\u064e","translation":"Ils ne pourront b\u00e9n\u00e9ficier d\u2019aucune intercession.","footnotes":""},{"id":"5544","sura":"74","aya":"49","arabic_text":"\u0641\u064e\u0645\u064e\u0627 \u0644\u064e\u0647\u064f\u0645\u06e1 \u0639\u064e\u0646\u0650 \u0671\u0644\u062a\u0651\u064e\u0630\u06e1\u0643\u0650\u0631\u064e\u0629\u0650 \u0645\u064f\u0639\u06e1\u0631\u0650\u0636\u0650\u064a\u0646\u064e","translation":"Qu\u2019ont-ils donc \u00e0 tourner le dos \u00e0 toute exhortation,","footnotes":""},{"id":"5545","sura":"74","aya":"50","arabic_text":"\u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u062d\u064f\u0645\u064f\u0631\u065e \u0645\u0651\u064f\u0633\u06e1\u062a\u064e\u0646\u0641\u0650\u0631\u064e\u0629\u065e","translation":"\u00e0 l\u2019image de z\u00e8bres affol\u00e9s,","footnotes":""},{"id":"5546","sura":"74","aya":"51","arabic_text":"\u0641\u064e\u0631\u0651\u064e\u062a\u06e1 \u0645\u0650\u0646 \u0642\u064e\u0633\u06e1\u0648\u064e\u0631\u064e\u0629\u0650\u06ed","translation":"fuyant \u00e0 la vue d\u2019un lion[8] ?","footnotes":"[8] Ou : de chasseurs."},{"id":"5547","sura":"74","aya":"52","arabic_text":"\u0628\u064e\u0644\u06e1 \u064a\u064f\u0631\u0650\u064a\u062f\u064f \u0643\u064f\u0644\u0651\u064f \u0671\u0645\u06e1\u0631\u0650\u064a\u0655\u0656 \u0645\u0651\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0623\u064e\u0646 \u064a\u064f\u0624\u06e1\u062a\u064e\u0649\u0670 \u0635\u064f\u062d\u064f\u0641\u0657\u0627 \u0645\u0651\u064f\u0646\u064e\u0634\u0651\u064e\u0631\u064e\u0629\u0657","translation":"Mais chacun d\u2019entre eux voudrait que lui soit remis un livre r\u00e9v\u00e9l\u00e9[9].","footnotes":"[9] Confirmant la mission du Proph\u00e8te, expliquent nombre d\u2019ex\u00e9g\u00e8tes."},{"id":"5548","sura":"74","aya":"53","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u06d6 \u0628\u064e\u0644 \u0644\u0651\u064e\u0627 \u064a\u064e\u062e\u064e\u0627\u0641\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u064e\u0629\u064e","translation":"N\u2019est-ce pas plut\u00f4t qu\u2019ils ne redoutent pas la R\u00e9surrection ?","footnotes":""},{"id":"5549","sura":"74","aya":"54","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653 \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u062a\u064e\u0630\u06e1\u0643\u0650\u0631\u064e\u0629\u065e","translation":"Ceci, en v\u00e9rit\u00e9, est une simple exhortation.","footnotes":""},{"id":"5550","sura":"74","aya":"55","arabic_text":"\u0641\u064e\u0645\u064e\u0646 \u0634\u064e\u0627\u0653\u0621\u064e \u0630\u064e\u0643\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"Que celui qui le veut en tire donc des le\u00e7ons.","footnotes":""},{"id":"5551","sura":"74","aya":"56","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u064a\u064e\u0630\u06e1\u0643\u064f\u0631\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627\u0653 \u0623\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f\u06da \u0647\u064f\u0648\u064e \u0623\u064e\u0647\u06e1\u0644\u064f \u0671\u0644\u062a\u0651\u064e\u0642\u06e1\u0648\u064e\u0649\u0670 \u0648\u064e\u0623\u064e\u0647\u06e1\u0644\u064f \u0671\u0644\u06e1\u0645\u064e\u063a\u06e1\u0641\u0650\u0631\u064e\u0629\u0650","translation":"Mais ils n\u2019en tireront des le\u00e7ons que si Allah le veut. Lui seul m\u00e9rite leur crainte et peut leur accorder le pardon.","footnotes":""}]}