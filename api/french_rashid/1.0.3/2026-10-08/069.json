630\u064e\u0631\u06e1\u0639\u064f\u0647\u064e\u0627 \u0633\u064e\u0628\u06e1\u0639\u064f\u0648\u0646\u064e \u0630\u0650\u0631\u064e\u0627\u0639\u0657\u0627 \u0641\u064e\u0671\u0633\u06e1\u0644\u064f\u0643\u064f\u0648\u0647\u064f","translation":"Qu\u2019il soit ensuite enfil\u00e9 dans une cha\u00eene de soixante-dix coud\u00e9es ! \u00bb","footnotes":""},{"id":"5356","sura":"69","aya":"33","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0643\u064e\u0627\u0646\u064e \u0644\u064e\u0627 \u064a\u064f\u0624\u06e1\u0645\u0650\u0646\u064f \u0628\u0650\u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u06e1\u0639\u064e\u0638\u0650\u064a\u0645\u0650","translation":"Car il ne croyait pas en Allah, le Tr\u00e8s Glorieux,","footnotes":""},{"id":"5357","sura":"69","aya":"34","arabic_text":"\u0648\u064e\u0644\u064e\u0627 \u064a\u064e\u062d\u064f\u0636\u0651\u064f \u0639\u064e\u0644\u064e\u0649\u0670 \u0637\u064e\u0639\u064e\u0627\u0645\u0650 \u0671\u0644\u06e1\u0645\u0650\u0633\u06e1\u0643\u0650\u064a\u0646\u0650","translation":"ni n\u2019incitait les autres \u00e0 nourrir les n\u00e9cessiteux.","footnotes":""},{"id":"5358","sura":"69","aya":"35","arabic_text":"\u0641\u064e\u0644\u064e\u064a\u06e1\u0633\u064e \u0644\u064e\u0647\u064f \u0671\u0644\u06e1\u064a\u064e\u0648\u06e1\u0645\u064e \u0647\u064e\u0670\u0647\u064f\u0646\u064e\u0627 \u062d\u064e\u0645\u0650\u064a\u0645\u065e","translation":"Il n\u2019aura, ce Jour-l\u00e0, ni ami pour l\u2019assister en ce lieu,","footnotes":""},{"id":"5359","sura":"69","aya":"36","arabic_text":"\u0648\u064e\u0644\u064e\u0627 \u0637\u064e\u0639\u064e\u0627\u0645\u064c \u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u0650\u0646\u06e1 \u063a\u0650\u0633\u06e1\u0644\u0650\u064a\u0646\u0656","translation":"ni nourriture autre que le pus immonde des damn\u00e9s,","footnotes":""},{"id":"5360","sura":"69","aya":"37","arabic_text":"\u0644\u0651\u064e\u0627 \u064a\u064e\u0623\u06e1\u0643\u064f\u0644\u064f\u0647\u064f\u06e5\u0653 \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u06e1\u062e\u064e\u0670\u0637\u0650\u0640\u0654\u064f\u0648\u0646\u064e","translation":"dont seuls se nourriront les p\u00e9cheurs inv\u00e9t\u00e9r\u00e9s.","footnotes":""},{"id":"5361","sura":"69","aya":"38","arabic_text":"\u0641\u064e\u0644\u064e\u0627\u0653 \u0623\u064f\u0642\u06e1\u0633\u0650\u0645\u064f \u0628\u0650\u0645\u064e\u0627 \u062a\u064f\u0628\u06e1\u0635\u0650\u0631\u064f\u0648\u0646\u064e","translation":"Je jure par ce que vous pouvez observer,","footnotes":""},{"id":"5362","sura":"69","aya":"39","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0644\u064e\u0627 \u062a\u064f\u0628\u06e1\u0635\u0650\u0631\u064f\u0648\u0646\u064e","translation":"et par ce que vous ne pouvez observer,","footnotes":""},{"id":"5363","sura":"69","aya":"40","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u0642\u064e\u0648\u06e1\u0644\u064f \u0631\u064e\u0633\u064f\u0648\u0644\u0656 \u0643\u064e\u0631\u0650\u064a\u0645\u0656","translation":"que le Coran est la parole transmise par un noble Messager,","footnotes":""},{"id":"5364","sura":"69","aya":"41","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0647\u064f\u0648\u064e \u0628\u0650\u0642\u064e\u0648\u06e1\u0644\u0650 \u0634\u064e\u0627\u0639\u0650\u0631\u0656\u06da \u0642\u064e\u0644\u0650\u064a\u0644\u0657\u0627 \u0645\u0651\u064e\u0627 \u062a\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e","translation":"non l\u2019\u0153uvre d\u2019un po\u00e8te - mais vous \u00eates si peu dispos\u00e9s \u00e0 croire -","footnotes":""},{"id":"5365","sura":"69","aya":"42","arabic_text":"\u0648\u064e\u0644\u064e\u0627 \u0628\u0650\u0642\u064e\u0648\u06e1\u0644\u0650 \u0643\u064e\u0627\u0647\u0650\u0646\u0656\u06da \u0642\u064e\u0644\u0650\u064a\u0644\u0657\u0627 \u0645\u0651\u064e\u0627 \u062a\u064e\u0630\u064e\u0643\u0651\u064e\u0631\u064f\u0648\u0646\u064e","translation":"ni l\u2019invention d\u2019un devin - mais vous \u00eates si peu enclins \u00e0 r\u00e9fl\u00e9chir -,","footnotes":""},{"id":"5366","sura":"69","aya":"43","arabic_text":"\u062a\u064e\u0646\u0632\u0650\u064a\u0644\u065e \u0645\u0651\u0650\u0646 \u0631\u0651\u064e\u0628\u0651\u0650 \u0671\u0644\u06e1\u0639\u064e\u0670\u0644\u064e\u0645\u0650\u064a\u0646\u064e","translation":"mais bien une r\u00e9v\u00e9lation du Seigneur de la Cr\u00e9ation.","footnotes":""},{"id":"5367","sura":"69","aya":"44","arabic_text":"\u0648\u064e\u0644\u064e\u0648\u06e1 \u062a\u064e\u0642\u064e\u0648\u0651\u064e\u0644\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0646\u064e\u0627 \u0628\u064e\u0639\u06e1\u0636\u064e \u0671\u0644\u06e1\u0623\u064e\u0642\u064e\u0627\u0648\u0650\u064a\u0644\u0650","translation":"Si celui-ci Nous avait faussement pr\u00eat\u00e9 certains propos,","footnotes":""},{"id":"5368","sura":"69","aya":"45","arabic_text":"\u0644\u064e\u0623\u064e\u062e\u064e\u0630\u06e1\u0646\u064e\u0627 \u0645\u0650\u0646\u06e1\u0647\u064f \u0628\u0650\u0671\u0644\u06e1\u064a\u064e\u0645\u0650\u064a\u0646\u0650","translation":"Nous l\u2019aurions puissamment saisi","footnotes":""},{"id":"5369","sura":"69","aya":"46","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0644\u064e\u0642\u064e\u0637\u064e\u0639\u06e1\u0646\u064e\u0627 \u0645\u0650\u0646\u06e1\u0647\u064f \u0671\u0644\u06e1\u0648\u064e\u062a\u0650\u064a\u0646\u064e","translation":"puis lui aurions tranch\u00e9 l\u2019aorte,","footnotes":""},{"id":"5370","sura":"69","aya":"47","arabic_text":"\u0641\u064e\u0645\u064e\u0627 \u0645\u0650\u0646\u0643\u064f\u0645 \u0645\u0651\u0650\u0646\u06e1 \u0623\u064e\u062d\u064e\u062f\u064d \u0639\u064e\u0646\u06e1\u0647\u064f \u062d\u064e\u0670\u062c\u0650\u0632\u0650\u064a\u0646\u064e","translation":"sans que nul parmi vous ne puisse s\u2019y opposer.","footnotes":""},{"id":"5371","sura":"69","aya":"48","arabic_text":"\u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u062a\u064e\u0630\u06e1\u0643\u0650\u0631\u064e\u0629\u065e \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u062a\u0651\u064e\u0642\u0650\u064a\u0646\u064e","translation":"Le Coran, en v\u00e9rit\u00e9, est une exhortation pour ceux qui Nous craignent.","footnotes":""},{"id":"5372","sura":"69","aya":"49","arabic_text":"\u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0627 \u0644\u064e\u0646\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0623\u064e\u0646\u0651\u064e \u0645\u0650\u0646\u0643\u064f\u0645 \u0645\u0651\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"Certains d\u2019entre vous, Nous le savons, le traitent pourtant de mensonge,","footnotes":""},{"id":"5373","sura":"69","aya":"50","arabic_text":"\u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u062d\u064e\u0633\u06e1\u0631\u064e\u0629\u064c \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u06e1\u0643\u064e\u0670\u0641\u0650\u0631\u0650\u064a\u0646\u064e","translation":"ce qu\u2019ils ne manqueront pas de regretter am\u00e8rement le Jour dernier.","footnotes":""},{"id":"5374","sura":"69","aya":"51","arabic_text":"\u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u062d\u064e\u0642\u0651\u064f \u0671\u0644\u06e1\u064a\u064e\u0642\u0650\u064a\u0646\u0650","translation":"Tout ceci est l\u2019absolue v\u00e9rit\u00e9, \u00e0 n\u2019en point douter.","footnotes":""},{"id":"5375","sura":"69","aya":"52","arabic_text":"\u0641\u064e\u0633\u064e\u0628\u0651\u0650\u062d\u06e1 \u0628\u0650\u0671\u0633\u06e1\u0645\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0671\u0644\u06e1\u0639\u064e\u0638\u0650\u064a\u0645\u0650","translation":"Exalte donc le nom de ton Seigneur, le Tr\u00e8s Glorieux !","footnotes":""}]}