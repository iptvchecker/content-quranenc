a":"70","aya":"32","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0647\u064f\u0645\u06e1 \u0644\u0650\u0623\u064e\u0645\u064e\u0670\u0646\u064e\u0670\u062a\u0650\u0647\u0650\u0645\u06e1 \u0648\u064e\u0639\u064e\u0647\u06e1\u062f\u0650\u0647\u0650\u0645\u06e1 \u0631\u064e\u0670\u0639\u064f\u0648\u0646\u064e","translation":"A l\u2019exception \u00e9galement de ceux qui ne trahissent ni la confiance plac\u00e9e en eux, ni l\u2019engagement contract\u00e9,","footnotes":""},{"id":"5408","sura":"70","aya":"33","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0647\u064f\u0645 \u0628\u0650\u0634\u064e\u0647\u064e\u0670\u062f\u064e\u0670\u062a\u0650\u0647\u0650\u0645\u06e1 \u0642\u064e\u0627\u0653\u0626\u0650\u0645\u064f\u0648\u0646\u064e","translation":"qui rendent leur t\u00e9moignage en toute sinc\u00e9rit\u00e9","footnotes":""},{"id":"5409","sura":"70","aya":"34","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0647\u064f\u0645\u06e1 \u0639\u064e\u0644\u064e\u0649\u0670 \u0635\u064e\u0644\u064e\u0627\u062a\u0650\u0647\u0650\u0645\u06e1 \u064a\u064f\u062d\u064e\u0627\u0641\u0650\u0638\u064f\u0648\u0646\u064e","translation":"et observent la pri\u00e8re avec la plus grande assiduit\u00e9.","footnotes":""},{"id":"5410","sura":"70","aya":"35","arabic_text":"\u0623\u064f\u0648\u0652\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e \u0641\u0650\u064a \u062c\u064e\u0646\u0651\u064e\u0670\u062a\u0656 \u0645\u0651\u064f\u0643\u06e1\u0631\u064e\u0645\u064f\u0648\u0646\u064e","translation":"Voil\u00e0 ceux qui, dans les jardins du Paradis, seront \u00e0 jamais honor\u00e9s.","footnotes":""},{"id":"5411","sura":"70","aya":"36","arabic_text":"\u0641\u064e\u0645\u064e\u0627\u0644\u0650 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u0652 \u0642\u0650\u0628\u064e\u0644\u064e\u0643\u064e \u0645\u064f\u0647\u06e1\u0637\u0650\u0639\u0650\u064a\u0646\u064e","translation":"Qu\u2019ont donc les m\u00e9cr\u00e9ants \u00e0 se h\u00e2ter vers toi, te fixant du regard,","footnotes":""},{"id":"5412","sura":"70","aya":"37","arabic_text":"\u0639\u064e\u0646\u0650 \u0671\u0644\u06e1\u064a\u064e\u0645\u0650\u064a\u0646\u0650 \u0648\u064e\u0639\u064e\u0646\u0650 \u0671\u0644\u0634\u0651\u0650\u0645\u064e\u0627\u0644\u0650 \u0639\u0650\u0632\u0650\u064a\u0646\u064e","translation":"dispos\u00e9s par groupes sur ta droite et sur ta gauche[7] ?","footnotes":"[7] Ecoutant tes paroles qu\u2019ils finissent par rejeter."},{"id":"5413","sura":"70","aya":"38","arabic_text":"\u0623\u064e\u064a\u064e\u0637\u06e1\u0645\u064e\u0639\u064f \u0643\u064f\u0644\u0651\u064f \u0671\u0645\u06e1\u0631\u0650\u064a\u0655\u0656 \u0645\u0651\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0623\u064e\u0646 \u064a\u064f\u062f\u06e1\u062e\u064e\u0644\u064e \u062c\u064e\u0646\u0651\u064e\u0629\u064e \u0646\u064e\u0639\u0650\u064a\u0645\u0656","translation":"Chacun d\u2019entre eux esp\u00e8re-t-il \u00eatre admis dans les jardins des d\u00e9lices[8] ?","footnotes":"[8] Sans croire en toi et en la R\u00e9surrection."},{"id":"5414","sura":"70","aya":"39","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653\u06d6 \u0625\u0650\u0646\u0651\u064e\u0627 \u062e\u064e\u0644\u064e\u0642\u06e1\u0646\u064e\u0670\u0647\u064f\u0645 \u0645\u0651\u0650\u0645\u0651\u064e\u0627 \u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e","translation":"Oh que non ! Ils savent pourtant tr\u00e8s bien de quoi Nous les avons cr\u00e9\u00e9s[9].","footnotes":"[9] D\u2019un simple liquide s\u00e9minal, ce qui prouve Notre toute-puissance. Nous serons donc capable de les recr\u00e9er."},{"id":"5415","sura":"70","aya":"40","arabic_text":"\u0641\u064e\u0644\u064e\u0627\u0653 \u0623\u064f\u0642\u06e1\u0633\u0650\u0645\u064f \u0628\u0650\u0631\u064e\u0628\u0651\u0650 \u0671\u0644\u06e1\u0645\u064e\u0634\u064e\u0670\u0631\u0650\u0642\u0650 \u0648\u064e\u0671\u0644\u06e1\u0645\u064e\u063a\u064e\u0670\u0631\u0650\u0628\u0650 \u0625\u0650\u0646\u0651\u064e\u0627 \u0644\u064e\u0642\u064e\u0670\u062f\u0650\u0631\u064f\u0648\u0646\u064e","translation":"Je jure par le Seigneur des levants et des couchants que Nous avons le pouvoir","footnotes":""},{"id":"5416","sura":"70","aya":"41","arabic_text":"\u0639\u064e\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0646 \u0646\u0651\u064f\u0628\u064e\u062f\u0651\u0650\u0644\u064e \u062e\u064e\u064a\u06e1\u0631\u0657\u0627 \u0645\u0651\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0648\u064e\u0645\u064e\u0627 \u0646\u064e\u062d\u06e1\u0646\u064f \u0628\u0650\u0645\u064e\u0633\u06e1\u0628\u064f\u0648\u0642\u0650\u064a\u0646\u064e","translation":"de les remplacer par des hommes bien meilleurs qu\u2019eux. Qui donc pourrait Nous en emp\u00eacher ?","footnotes":""},{"id":"5417","sura":"70","aya":"42","arabic_text":"\u0641\u064e\u0630\u064e\u0631\u06e1\u0647\u064f\u0645\u06e1 \u064a\u064e\u062e\u064f\u0648\u0636\u064f\u0648\u0627\u0652 \u0648\u064e\u064a\u064e\u0644\u06e1\u0639\u064e\u0628\u064f\u0648\u0627\u0652 \u062d\u064e\u062a\u0651\u064e\u0649\u0670 \u064a\u064f\u0644\u064e\u0670\u0642\u064f\u0648\u0627\u0652 \u064a\u064e\u0648\u06e1\u0645\u064e\u0647\u064f\u0645\u064f \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u064a\u064f\u0648\u0639\u064e\u062f\u064f\u0648\u0646\u064e","translation":"Laisse-les donc \u00e0 leurs all\u00e9gations et \u00e0 leurs futilit\u00e9s, jusqu\u2019au Jour o\u00f9 ils devront affronter le ch\u00e2timent dont ils sont menac\u00e9s,","footnotes":""},{"id":"5418","sura":"70","aya":"43","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064e\u062e\u06e1\u0631\u064f\u062c\u064f\u0648\u0646\u064e \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0623\u064e\u062c\u06e1\u062f\u064e\u0627\u062b\u0650 \u0633\u0650\u0631\u064e\u0627\u0639\u0657\u0627 \u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u0625\u0650\u0644\u064e\u0649\u0670 \u0646\u064f\u0635\u064f\u0628\u0656 \u064a\u064f\u0648\u0641\u0650\u0636\u064f\u0648\u0646\u064e","translation":"Jour o\u00f9 ils se pr\u00e9cipiteront hors de leurs tombes comme s\u2019ils se h\u00e2taient vers leurs idoles,","footnotes":""},{"id":"5419","sura":"70","aya":"44","arabic_text":"\u062e\u064e\u0670\u0634\u0650\u0639\u064e\u0629\u064b \u0623\u064e\u0628\u06e1\u0635\u064e\u0670\u0631\u064f\u0647\u064f\u0645\u06e1 \u062a\u064e\u0631\u06e1\u0647\u064e\u0642\u064f\u0647\u064f\u0645\u06e1 \u0630\u0650\u0644\u0651\u064e\u0629\u065e\u06da \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0671\u0644\u06e1\u064a\u064e\u0648\u06e1\u0645\u064f \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u064a\u064f\u0648\u0639\u064e\u062f\u064f\u0648\u0646\u064e","translation":"regards baiss\u00e9s et couverts d\u2019opprobre. Voil\u00e0 le Jour dont ils \u00e9taient menac\u00e9s !","footnotes":""}]}