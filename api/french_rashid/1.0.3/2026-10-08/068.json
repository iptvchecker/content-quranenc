u0648\u06e1\u0627\u0652 \u0639\u064e\u0644\u064e\u0649\u0670 \u062d\u064e\u0631\u06e1\u062f\u0656 \u0642\u064e\u0670\u062f\u0650\u0631\u0650\u064a\u0646\u064e","translation":"Ils se dirig\u00e8rent donc vers le verger, persuad\u00e9s qu\u2019ils pourraient en r\u00e9colter les fruits, d\u00e9cid\u00e9s \u00e0 en priver les n\u00e9cessiteux.","footnotes":""},{"id":"5297","sura":"68","aya":"26","arabic_text":"\u0641\u064e\u0644\u064e\u0645\u0651\u064e\u0627 \u0631\u064e\u0623\u064e\u0648\u06e1\u0647\u064e\u0627 \u0642\u064e\u0627\u0644\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u0646\u0651\u064e\u0627 \u0644\u064e\u0636\u064e\u0627\u0653\u0644\u0651\u064f\u0648\u0646\u064e","translation":"Mais, d\u00e9couvrant le verger ravag\u00e9, ils dirent : \u00ab Nous nous sommes s\u00fbrement \u00e9gar\u00e9s \u00bb,","footnotes":""},{"id":"5298","sura":"68","aya":"27","arabic_text":"\u0628\u064e\u0644\u06e1 \u0646\u064e\u062d\u06e1\u0646\u064f \u0645\u064e\u062d\u06e1\u0631\u064f\u0648\u0645\u064f\u0648\u0646\u064e","translation":"avant d\u2019ajouter[5] : \u00ab Non, en r\u00e9alit\u00e9 nous sommes compl\u00e8tement ruin\u00e9s ! \u00bb","footnotes":"[5] S\u2019\u00e9tant assur\u00e9s qu\u2019il s\u2019agissait bien de leur verger."},{"id":"5299","sura":"68","aya":"28","arabic_text":"\u0642\u064e\u0627\u0644\u064e \u0623\u064e\u0648\u06e1\u0633\u064e\u0637\u064f\u0647\u064f\u0645\u06e1 \u0623\u064e\u0644\u064e\u0645\u06e1 \u0623\u064e\u0642\u064f\u0644 \u0644\u0651\u064e\u0643\u064f\u0645\u06e1 \u0644\u064e\u0648\u06e1\u0644\u064e\u0627 \u062a\u064f\u0633\u064e\u0628\u0651\u0650\u062d\u064f\u0648\u0646\u064e","translation":"Le plus sens\u00e9 d\u2019entre eux leur fit remarquer : \u00ab Ne vous avais-je pas recommand\u00e9 de rendre gloire \u00e0 Allah ? \u00bb","footnotes":""},{"id":"5300","sura":"68","aya":"29","arabic_text":"\u0642\u064e\u0627\u0644\u064f\u0648\u0627\u0652 \u0633\u064f\u0628\u06e1\u062d\u064e\u0670\u0646\u064e \u0631\u064e\u0628\u0651\u0650\u0646\u064e\u0627\u0653 \u0625\u0650\u0646\u0651\u064e\u0627 \u0643\u064f\u0646\u0651\u064e\u0627 \u0638\u064e\u0670\u0644\u0650\u0645\u0650\u064a\u0646\u064e","translation":"Ils dirent : \u00ab Gloire \u00e0 notre Seigneur ! Nous avons vraiment \u00e9t\u00e9 injustes ! \u00bb","footnotes":""},{"id":"5301","sura":"68","aya":"30","arabic_text":"\u0641\u064e\u0623\u064e\u0642\u06e1\u0628\u064e\u0644\u064e \u0628\u064e\u0639\u06e1\u0636\u064f\u0647\u064f\u0645\u06e1 \u0639\u064e\u0644\u064e\u0649\u0670 \u0628\u064e\u0639\u06e1\u0636\u0656 \u064a\u064e\u062a\u064e\u0644\u064e\u0670\u0648\u064e\u0645\u064f\u0648\u0646\u064e","translation":"Les uns se mirent alors \u00e0 bl\u00e2mer les autres,","footnotes":""},{"id":"5302","sura":"68","aya":"31","arabic_text":"\u0642\u064e\u0627\u0644\u064f\u0648\u0627\u0652 \u064a\u064e\u0670\u0648\u064e\u064a\u06e1\u0644\u064e\u0646\u064e\u0627\u0653 \u0625\u0650\u0646\u0651\u064e\u0627 \u0643\u064f\u0646\u0651\u064e\u0627 \u0637\u064e\u0670\u063a\u0650\u064a\u0646\u064e","translation":"disant : \u00ab Malheur \u00e0 nous ! Nous avons transgress\u00e9 !","footnotes":""},{"id":"5303","sura":"68","aya":"32","arabic_text":"\u0639\u064e\u0633\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u064f\u0646\u064e\u0627\u0653 \u0623\u064e\u0646 \u064a\u064f\u0628\u06e1\u062f\u0650\u0644\u064e\u0646\u064e\u0627 \u062e\u064e\u064a\u06e1\u0631\u0657\u0627 \u0645\u0651\u0650\u0646\u06e1\u0647\u064e\u0627\u0653 \u0625\u0650\u0646\u0651\u064e\u0627\u0653 \u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0646\u064e\u0627 \u0631\u064e\u0670\u063a\u0650\u0628\u064f\u0648\u0646\u064e","translation":"Puisse Notre Seigneur, en qui nous pla\u00e7ons tous nos espoirs, nous accorder mieux que ce verger ! \u00bb","footnotes":""},{"id":"5304","sura":"68","aya":"33","arabic_text":"\u0643\u064e\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0671\u0644\u06e1\u0639\u064e\u0630\u064e\u0627\u0628\u064f\u06d6 \u0648\u064e\u0644\u064e\u0639\u064e\u0630\u064e\u0627\u0628\u064f \u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u064e\u0629\u0650 \u0623\u064e\u0643\u06e1\u0628\u064e\u0631\u064f\u06da \u0644\u064e\u0648\u06e1 \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e","translation":"Voici le ch\u00e2timent r\u00e9serv\u00e9 \u00e0 leurs semblables, mais le ch\u00e2timent de l\u2019au-del\u00e0 sera bien plus terrible. S\u2019ils pouvaient en \u00eatre convaincus !","footnotes":""},{"id":"5305","sura":"68","aya":"34","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0644\u0650\u0644\u06e1\u0645\u064f\u062a\u0651\u064e\u0642\u0650\u064a\u0646\u064e \u0639\u0650\u0646\u062f\u064e \u0631\u064e\u0628\u0651\u0650\u0647\u0650\u0645\u06e1 \u062c\u064e\u0646\u0651\u064e\u0670\u062a\u0650 \u0671\u0644\u0646\u0651\u064e\u0639\u0650\u064a\u0645\u0650","translation":"A ceux qui craignent Allah sont promis, aupr\u00e8s de leur Seigneur, les jardins des d\u00e9lices.","footnotes":""},{"id":"5306","sura":"68","aya":"35","arabic_text":"\u0623\u064e\u0641\u064e\u0646\u064e\u062c\u06e1\u0639\u064e\u0644\u064f \u0671\u0644\u06e1\u0645\u064f\u0633\u06e1\u0644\u0650\u0645\u0650\u064a\u0646\u064e \u0643\u064e\u0671\u0644\u06e1\u0645\u064f\u062c\u06e1\u0631\u0650\u0645\u0650\u064a\u0646\u064e","translation":"Pourrions-Nous r\u00e9server \u00e0 ceux qui Nous sont soumis le m\u00eame sort qu\u2019aux impies ?","footnotes":""},{"id":"5307","sura":"68","aya":"36","arabic_text":"\u0645\u064e\u0627 \u0644\u064e\u0643\u064f\u0645\u06e1 \u0643\u064e\u064a\u06e1\u0641\u064e \u062a\u064e\u062d\u06e1\u0643\u064f\u0645\u064f\u0648\u0646\u064e","translation":"Qu\u2019avez-vous donc \u00e0 juger de cette fa\u00e7on ?","footnotes":""},{"id":"5308","sura":"68","aya":"37","arabic_text":"\u0623\u064e\u0645\u06e1 \u0644\u064e\u0643\u064f\u0645\u06e1 \u0643\u0650\u062a\u064e\u0670\u0628\u065e \u0641\u0650\u064a\u0647\u0650 \u062a\u064e\u062f\u06e1\u0631\u064f\u0633\u064f\u0648\u0646\u064e","translation":"Disposez-vous d\u2019un livre r\u00e9v\u00e9l\u00e9 o\u00f9 vous lisez","footnotes":""},{"id":"5309","sura":"68","aya":"38","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0644\u064e\u0643\u064f\u0645\u06e1 \u0641\u0650\u064a\u0647\u0650 \u0644\u064e\u0645\u064e\u0627 \u062a\u064e\u062e\u064e\u064a\u0651\u064e\u0631\u064f\u0648\u0646\u064e","translation":"que vous obtiendrez tout ce que vous d\u00e9sirez ?","footnotes":""},{"id":"5310","sura":"68","aya":"39","arabic_text":"\u0623\u064e\u0645\u06e1 \u0644\u064e\u0643\u064f\u0645\u06e1 \u0623\u064e\u064a\u06e1\u0645\u064e\u0670\u0646\u064c \u0639\u064e\u0644\u064e\u064a\u06e1\u0646\u064e\u0627 \u0628\u064e\u0670\u0644\u0650\u063a\u064e\u0629\u064c \u0625\u0650\u0644\u064e\u0649\u0670 \u064a\u064e\u0648\u06e1\u0645\u0650 \u0671\u0644\u06e1\u0642\u0650\u064a\u064e\u0670\u0645\u064e\u0629\u0650 \u0625\u0650\u0646\u0651\u064e \u0644\u064e\u0643\u064f\u0645\u06e1 \u0644\u064e\u0645\u064e\u0627 \u062a\u064e\u062d\u06e1\u0643\u064f\u0645\u064f\u0648\u0646\u064e","translation":"Ou bien avez-vous re\u00e7u Notre engagement formel, valable jusqu\u2019au Jour dernier, de vous accorder ce que vous d\u00e9cr\u00e9tez ?","footnotes":""},{"id":"5311","sura":"68","aya":"40","arabic_text":"\u0633\u064e\u0644\u06e1\u0647\u064f\u0645\u06e1 \u0623\u064e\u064a\u0651\u064f\u0647\u064f\u0645 \u0628\u0650\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0632\u064e\u0639\u0650\u064a\u0645\u064c","translation":"Demande-leur qui d\u2019entre eux peut s\u2019en porter garant.","footnotes":""},{"id":"5312","sura":"68","aya":"41","arabic_text":"\u0623\u064e\u0645\u06e1 \u0644\u064e\u0647\u064f\u0645\u06e1 \u0634\u064f\u0631\u064e\u0643\u064e\u0627\u0653\u0621\u064f \u0641\u064e\u0644\u06e1\u064a\u064e\u0623\u06e1\u062a\u064f\u0648\u0627\u0652 \u0628\u0650\u0634\u064f\u0631\u064e\u0643\u064e\u0627\u0653\u0626\u0650\u0647\u0650\u0645\u06e1 \u0625\u0650\u0646 \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u0635\u064e\u0670\u062f\u0650\u0642\u0650\u064a\u0646\u064e","translation":"Ou bien d\u2019autres qu\u2019eux confirment-ils leurs dires[6] ? Qu\u2019ils les fassent donc venir, s\u2019ils disent la v\u00e9rit\u00e9 !","footnotes":"[6] Autre sens : ou bien ont-ils des divinit\u00e9s qui le leur garantissent."},{"id":"5313","sura":"68","aya":"42","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064f\u0643\u06e1\u0634\u064e\u0641\u064f \u0639\u064e\u0646 \u0633\u064e\u0627\u0642\u0656 \u0648\u064e\u064a\u064f\u062f\u06e1\u0639\u064e\u0648\u06e1\u0646\u064e \u0625\u0650\u0644\u064e\u0649 \u0671\u0644\u0633\u0651\u064f\u062c\u064f\u0648\u062f\u0650 \u0641\u064e\u0644\u064e\u0627 \u064a\u064e\u0633\u06e1\u062a\u064e\u0637\u0650\u064a\u0639\u064f\u0648\u0646\u064e","translation":"Ils seront un jour expos\u00e9s aux affres du Jugement dernier et appel\u00e9s \u00e0 se prosterner, mais sans pouvoir s\u2019ex\u00e9cuter.","footnotes":""},{"id":"5314","sura":"68","aya":"43","arabic_text":"\u062e\u064e\u0670\u0634\u0650\u0639\u064e\u0629\u064b \u0623\u064e\u0628\u06e1\u0635\u064e\u0670\u0631\u064f\u0647\u064f\u0645\u06e1 \u062a\u064e\u0631\u06e1\u0647\u064e\u0642\u064f\u0647\u064f\u0645\u06e1 \u0630\u0650\u0644\u0651\u064e\u0629\u065e\u06d6 \u0648\u064e\u0642\u064e\u062f\u06e1 \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u064a\u064f\u062f\u06e1\u0639\u064e\u0648\u06e1\u0646\u064e \u0625\u0650\u0644\u064e\u0649 \u0671\u0644\u0633\u0651\u064f\u062c\u064f\u0648\u062f\u0650 \u0648\u064e\u0647\u064f\u0645\u06e1 \u0633\u064e\u0670\u0644\u0650\u0645\u064f\u0648\u0646\u064e","translation":"Regards baiss\u00e9s, ils seront couverts d\u2019opprobre. Ils \u00e9taient en effet appel\u00e9s \u00e0 se prosterner alors qu\u2019ils \u00e9taient en parfaite sant\u00e9 et jouissaient de toutes leurs facult\u00e9s !","footnotes":""},{"id":"5315","sura":"68","aya":"44","arabic_text":"\u0641\u064e\u0630\u064e\u0631\u06e1\u0646\u0650\u064a \u0648\u064e\u0645\u064e\u0646 \u064a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f \u0628\u0650\u0647\u064e\u0670\u0630\u064e\u0627 \u0671\u0644\u06e1\u062d\u064e\u062f\u0650\u064a\u062b\u0650\u06d6 \u0633\u064e\u0646\u064e\u0633\u06e1\u062a\u064e\u062f\u06e1\u0631\u0650\u062c\u064f\u0647\u064f\u0645 \u0645\u0651\u0650\u0646\u06e1 \u062d\u064e\u064a\u06e1\u062b\u064f \u0644\u064e\u0627 \u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e","translation":"Laisse-Moi donc avec ceux qui traitent ce discours de mensonge. Nous allons les laisser s\u2019enfoncer dans l\u2019erreur sans qu\u2019ils s\u2019en rendent compte.","footnotes":""},{"id":"5316","sura":"68","aya":"45","arabic_text":"\u0648\u064e\u0623\u064f\u0645\u06e1\u0644\u0650\u064a \u0644\u064e\u0647\u064f\u0645\u06e1\u06da \u0625\u0650\u0646\u0651\u064e \u0643\u064e\u064a\u06e1\u062f\u0650\u064a \u0645\u064e\u062a\u0650\u064a\u0646\u064c","translation":"Je leur accorde simplement un r\u00e9pit. Mes man\u0153uvres sont imparables.","footnotes":""},{"id":"5317","sura":"68","aya":"46","arabic_text":"\u0623\u064e\u0645\u06e1 \u062a\u064e\u0633\u06e1\u0640\u0654\u064e\u0644\u064f\u0647\u064f\u0645\u06e1 \u0623\u064e\u062c\u06e1\u0631\u0657\u0627 \u0641\u064e\u0647\u064f\u0645 \u0645\u0651\u0650\u0646 \u0645\u0651\u064e\u063a\u06e1\u0631\u064e\u0645\u0656 \u0645\u0651\u064f\u062b\u06e1\u0642\u064e\u0644\u064f\u0648\u0646\u064e","translation":"Leur r\u00e9clames-tu un salaire dont ils auraient toutes les peines \u00e0 s\u2019acquitter ?","footnotes":""},{"id":"5318","sura":"68","aya":"47","arabic_text":"\u0623\u064e\u0645\u06e1 \u0639\u0650\u0646\u062f\u064e\u0647\u064f\u0645\u064f \u0671\u0644\u06e1\u063a\u064e\u064a\u06e1\u0628\u064f \u0641\u064e\u0647\u064f\u0645\u06e1 \u064a\u064e\u0643\u06e1\u062a\u064f\u0628\u064f\u0648\u0646\u064e","translation":"Ou bien connaissent-ils les myst\u00e8res dont ils pourraient rendre compte par \u00e9crit ?","footnotes":""},{"id":"5319","sura":"68","aya":"48","arabic_text":"\u0641\u064e\u0671\u0635\u06e1\u0628\u0650\u0631\u06e1 \u0644\u0650\u062d\u064f\u0643\u06e1\u0645\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u0643\u064f\u0646 \u0643\u064e\u0635\u064e\u0627\u062d\u0650\u0628\u0650 \u0671\u0644\u06e1\u062d\u064f\u0648\u062a\u0650 \u0625\u0650\u0630\u06e1 \u0646\u064e\u0627\u062f\u064e\u0649\u0670 \u0648\u064e\u0647\u064f\u0648\u064e \u0645\u064e\u0643\u06e1\u0638\u064f\u0648\u0645\u065e","translation":"Accepte donc patiemment les d\u00e9crets de ton Seigneur[7]. N\u2019agis pas comme ce proph\u00e8te qui poussa un cri de d\u00e9tresse apr\u00e8s avoir \u00e9t\u00e9 aval\u00e9 par le poisson[8].","footnotes":"[7] Concernant leurs pers\u00e9cutions et leurs d\u00e9n\u00e9gations, en attendant le jugement d\u2019Allah qui ne manquera pas de te venger.\n[8] Pour avoir, faute de patience, renonc\u00e9 \u00e0 sa mission. Il s\u2019agit du proph\u00e8te Jonas. Voir sourate 21, verset 87 et ses notes."},{"id":"5320","sura":"68","aya":"49","arabic_text":"\u0644\u0651\u064e\u0648\u06e1\u0644\u064e\u0627\u0653 \u0623\u064e\u0646 \u062a\u064e\u062f\u064e\u0670\u0631\u064e\u0643\u064e\u0647\u064f\u06e5 \u0646\u0650\u0639\u06e1\u0645\u064e\u0629\u065e \u0645\u0651\u0650\u0646 \u0631\u0651\u064e\u0628\u0651\u0650\u0647\u0650\u06e6 \u0644\u064e\u0646\u064f\u0628\u0650\u0630\u064e \u0628\u0650\u0671\u0644\u06e1\u0639\u064e\u0631\u064e\u0627\u0653\u0621\u0650 \u0648\u064e\u0647\u064f\u0648\u064e \u0645\u064e\u0630\u06e1\u0645\u064f\u0648\u0645\u065e","translation":"Sans la gr\u00e2ce de son Seigneur, il aurait \u00e9t\u00e9 rejet\u00e9 en r\u00e9prouv\u00e9 sur une terre vierge.","footnotes":""},{"id":"5321","sura":"68","aya":"50","arabic_text":"\u0641\u064e\u0671\u062c\u06e1\u062a\u064e\u0628\u064e\u0670\u0647\u064f \u0631\u064e\u0628\u0651\u064f\u0647\u064f\u06e5 \u0641\u064e\u062c\u064e\u0639\u064e\u0644\u064e\u0647\u064f\u06e5 \u0645\u0650\u0646\u064e \u0671\u0644\u0635\u0651\u064e\u0670\u0644\u0650\u062d\u0650\u064a\u0646\u064e","translation":"Mais son Seigneur l\u2019a \u00e9lu et rempli de vertu.","footnotes":""},{"id":"5322","sura":"68","aya":"51","arabic_text":"\u0648\u064e\u0625\u0650\u0646 \u064a\u064e\u0643\u064e\u0627\u062f\u064f \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u0652 \u0644\u064e\u064a\u064f\u0632\u06e1\u0644\u0650\u0642\u064f\u0648\u0646\u064e\u0643\u064e \u0628\u0650\u0623\u064e\u0628\u06e1\u0635\u064e\u0670\u0631\u0650\u0647\u0650\u0645\u06e1 \u0644\u064e\u0645\u0651\u064e\u0627 \u0633\u064e\u0645\u0650\u0639\u064f\u0648\u0627\u0652 \u0671\u0644\u0630\u0651\u0650\u0643\u06e1\u0631\u064e \u0648\u064e\u064a\u064e\u0642\u064f\u0648\u0644\u064f\u0648\u0646\u064e \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u0645\u064e\u062c\u06e1\u0646\u064f\u0648\u0646\u065e","translation":"Peu s\u2019en faut que les m\u00e9cr\u00e9ants, en entendant le Coran, ne te foudroient du regard, en lan\u00e7ant : \u00ab C\u2019est un poss\u00e9d\u00e9 ! \u00bb","footnotes":""},{"id":"5323","sura":"68","aya":"52","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0647\u064f\u0648\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0630\u0650\u0643\u06e1\u0631\u065e \u0644\u0651\u0650\u0644\u06e1\u0639\u064e\u0670\u0644\u064e\u0645\u0650\u064a\u0646\u064e","translation":"Ce n\u2019est pourtant qu\u2019une exhortation adress\u00e9e \u00e0 l\u2019univers !","footnotes":""}]}