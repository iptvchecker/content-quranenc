631\u064e\u0641\u06e1\u0631\u064e\u0641\u064d \u062e\u064f\u0636\u06e1\u0631\u0656 \u0648\u064e\u0639\u064e\u0628\u06e1\u0642\u064e\u0631\u0650\u064a\u0651\u064d \u062d\u0650\u0633\u064e\u0627\u0646\u0656","translation":"Ils seront, sur des coussins verts, accoud\u00e9s et, sur de somptueux tapis, allong\u00e9s.","footnotes":""},{"id":"4978","sura":"55","aya":"77","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Lequel des bienfaits de votre Seigneur oserez-vous renier ?","footnotes":""},{"id":"4979","sura":"55","aya":"78","arabic_text":"\u062a\u064e\u0628\u064e\u0670\u0631\u064e\u0643\u064e \u0671\u0633\u06e1\u0645\u064f \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0630\u0650\u064a \u0671\u0644\u06e1\u062c\u064e\u0644\u064e\u0670\u0644\u0650 \u0648\u064e\u0671\u0644\u06e1\u0625\u0650\u0643\u06e1\u0631\u064e\u0627\u0645\u0650","translation":"B\u00e9ni soit le nom de ton Seigneur, Dieu de majest\u00e9 et de g\u00e9n\u00e9rosit\u00e9.","footnotes":""}]}