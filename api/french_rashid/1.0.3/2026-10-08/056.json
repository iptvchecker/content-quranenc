ocurant ni fra\u00eecheur, ni bien-\u00eatre.","footnotes":""},{"id":"5024","sura":"56","aya":"45","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u0642\u064e\u0628\u06e1\u0644\u064e \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0645\u064f\u062a\u06e1\u0631\u064e\u0641\u0650\u064a\u0646\u064e","translation":"Ils jouissaient sans retenue des plaisirs de la vie,","footnotes":""},{"id":"5025","sura":"56","aya":"46","arabic_text":"\u0648\u064e\u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u064a\u064f\u0635\u0650\u0631\u0651\u064f\u0648\u0646\u064e \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u06e1\u062d\u0650\u0646\u062b\u0650 \u0671\u0644\u06e1\u0639\u064e\u0638\u0650\u064a\u0645\u0650","translation":"et persistaient dans la plus inf\u00e2me impi\u00e9t\u00e9,","footnotes":""},{"id":"5026","sura":"56","aya":"47","arabic_text":"\u0648\u064e\u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u064a\u064e\u0642\u064f\u0648\u0644\u064f\u0648\u0646\u064e \u0623\u064e\u0626\u0650\u0630\u064e\u0627 \u0645\u0650\u062a\u06e1\u0646\u064e\u0627 \u0648\u064e\u0643\u064f\u0646\u0651\u064e\u0627 \u062a\u064f\u0631\u064e\u0627\u0628\u0657\u0627 \u0648\u064e\u0639\u0650\u0638\u064e\u0670\u0645\u064b\u0627 \u0623\u064e\u0621\u0650\u0646\u0651\u064e\u0627 \u0644\u064e\u0645\u064e\u0628\u06e1\u0639\u064f\u0648\u062b\u064f\u0648\u0646\u064e","translation":"disant : \u00ab Serons-nous, une fois morts et nos os r\u00e9duits en poussi\u00e8re, ressuscit\u00e9s","footnotes":""},{"id":"5027","sura":"56","aya":"48","arabic_text":"\u0623\u064e\u0648\u064e\u0621\u064e\u0627\u0628\u064e\u0627\u0653\u0624\u064f\u0646\u064e\u0627 \u0671\u0644\u06e1\u0623\u064e\u0648\u0651\u064e\u0644\u064f\u0648\u0646\u064e","translation":"ainsi que nos anc\u00eatres les plus \u00e9loign\u00e9s ? \u00bb","footnotes":""},{"id":"5028","sura":"56","aya":"49","arabic_text":"\u0642\u064f\u0644\u06e1 \u0625\u0650\u0646\u0651\u064e \u0671\u0644\u06e1\u0623\u064e\u0648\u0651\u064e\u0644\u0650\u064a\u0646\u064e \u0648\u064e\u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u0650\u064a\u0646\u064e","translation":"Dis : \u00ab Les premiers hommes et les derniers","footnotes":""},{"id":"5029","sura":"56","aya":"50","arabic_text":"\u0644\u064e\u0645\u064e\u062c\u06e1\u0645\u064f\u0648\u0639\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u064e\u0649\u0670 \u0645\u0650\u064a\u0642\u064e\u0670\u062a\u0650 \u064a\u064e\u0648\u06e1\u0645\u0656 \u0645\u0651\u064e\u0639\u06e1\u0644\u064f\u0648\u0645\u0656","translation":"seront tous rassembl\u00e9s en un jour d\u00e9j\u00e0 fix\u00e9. \u00bb","footnotes":""},{"id":"5030","sura":"56","aya":"51","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0625\u0650\u0646\u0651\u064e\u0643\u064f\u0645\u06e1 \u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u0636\u0651\u064e\u0627\u0653\u0644\u0651\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f\u0648\u0646\u064e","translation":"Puis vous, les \u00e9gar\u00e9s qui ne cessiez de crier au mensonge,","footnotes":""},{"id":"5031","sura":"56","aya":"52","arabic_text":"\u0644\u064e\u0623\u0653\u0643\u0650\u0644\u064f\u0648\u0646\u064e \u0645\u0650\u0646 \u0634\u064e\u062c\u064e\u0631\u0656 \u0645\u0651\u0650\u0646 \u0632\u064e\u0642\u0651\u064f\u0648\u0645\u0656","translation":"vous mangerez assur\u00e9ment des fruits de l\u2019arbre Zaqqoum","footnotes":""},{"id":"5032","sura":"56","aya":"53","arabic_text":"\u0641\u064e\u0645\u064e\u0627\u0644\u0650\u0640\u0654\u064f\u0648\u0646\u064e \u0645\u0650\u0646\u06e1\u0647\u064e\u0627 \u0671\u0644\u06e1\u0628\u064f\u0637\u064f\u0648\u0646\u064e","translation":"dont vous serez contraints de vous remplir le ventre,","footnotes":""},{"id":"5033","sura":"56","aya":"54","arabic_text":"\u0641\u064e\u0634\u064e\u0670\u0631\u0650\u0628\u064f\u0648\u0646\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650 \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u062d\u064e\u0645\u0650\u064a\u0645\u0650","translation":"avant de boire par-dessus une eau extr\u00eamement bouillante","footnotes":""},{"id":"5034","sura":"56","aya":"55","arabic_text":"\u0641\u064e\u0634\u064e\u0670\u0631\u0650\u0628\u064f\u0648\u0646\u064e \u0634\u064f\u0631\u06e1\u0628\u064e \u0671\u0644\u06e1\u0647\u0650\u064a\u0645\u0650","translation":"que vous avalerez, tel un troupeau de chameaux assoiff\u00e9s.","footnotes":""},{"id":"5035","sura":"56","aya":"56","arabic_text":"\u0647\u064e\u0670\u0630\u064e\u0627 \u0646\u064f\u0632\u064f\u0644\u064f\u0647\u064f\u0645\u06e1 \u064a\u064e\u0648\u06e1\u0645\u064e \u0671\u0644\u062f\u0651\u0650\u064a\u0646\u0650","translation":"Voil\u00e0 donc l\u2019accueil qui leur sera r\u00e9serv\u00e9 le Jour de la r\u00e9tribution.","footnotes":""},{"id":"5036","sura":"56","aya":"57","arabic_text":"\u0646\u064e\u062d\u06e1\u0646\u064f \u062e\u064e\u0644\u064e\u0642\u06e1\u0646\u064e\u0670\u0643\u064f\u0645\u06e1 \u0641\u064e\u0644\u064e\u0648\u06e1\u0644\u064e\u0627 \u062a\u064f\u0635\u064e\u062f\u0651\u0650\u0642\u064f\u0648\u0646\u064e","translation":"C\u2019est Nous qui vous avons cr\u00e9\u00e9s. Si seulement vous pouviez croire en la R\u00e9surrection !","footnotes":""},{"id":"5037","sura":"56","aya":"58","arabic_text":"\u0623\u064e\u0641\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064f\u0645 \u0645\u0651\u064e\u0627 \u062a\u064f\u0645\u06e1\u0646\u064f\u0648\u0646\u064e","translation":"Avez-vous consid\u00e9r\u00e9 le liquide que vous r\u00e9pandez[3] ?","footnotes":"[3] Dans les matrices des femmes."},{"id":"5038","sura":"56","aya":"59","arabic_text":"\u0621\u064e\u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u062a\u064e\u062e\u06e1\u0644\u064f\u0642\u064f\u0648\u0646\u064e\u0647\u064f\u06e5\u0653 \u0623\u064e\u0645\u06e1 \u0646\u064e\u062d\u06e1\u0646\u064f \u0671\u0644\u06e1\u062e\u064e\u0670\u0644\u0650\u0642\u064f\u0648\u0646\u064e","translation":"Est-ce vous ou bien Nous qui l\u2019avons cr\u00e9\u00e9[4] ?","footnotes":"[4] Ainsi que l\u2019\u00eatre qui na\u00eetra de ce liquide s\u00e9minal."},{"id":"5039","sura":"56","aya":"60","arabic_text":"\u0646\u064e\u062d\u06e1\u0646\u064f \u0642\u064e\u062f\u0651\u064e\u0631\u06e1\u0646\u064e\u0627 \u0628\u064e\u064a\u06e1\u0646\u064e\u0643\u064f\u0645\u064f \u0671\u0644\u06e1\u0645\u064e\u0648\u06e1\u062a\u064e \u0648\u064e\u0645\u064e\u0627 \u0646\u064e\u062d\u06e1\u0646\u064f \u0628\u0650\u0645\u064e\u0633\u06e1\u0628\u064f\u0648\u0642\u0650\u064a\u0646\u064e","translation":"C\u2019est Nous qui vous avons pr\u00e9destin\u00e9 la mort et rien ne pourra Nous emp\u00eacher","footnotes":""},{"id":"5040","sura":"56","aya":"61","arabic_text":"\u0639\u064e\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0646 \u0646\u0651\u064f\u0628\u064e\u062f\u0651\u0650\u0644\u064e \u0623\u064e\u0645\u06e1\u062b\u064e\u0670\u0644\u064e\u0643\u064f\u0645\u06e1 \u0648\u064e\u0646\u064f\u0646\u0634\u0650\u0626\u064e\u0643\u064f\u0645\u06e1 \u0641\u0650\u064a \u0645\u064e\u0627 \u0644\u064e\u0627 \u062a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e","translation":"de vous remplacer par d\u2019autres hommes comme vous ou d\u2019un aspect diff\u00e9rent de celui que vous connaissez.","footnotes":""},{"id":"5041","sura":"56","aya":"62","arabic_text":"\u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u0639\u064e\u0644\u0650\u0645\u06e1\u062a\u064f\u0645\u064f \u0671\u0644\u0646\u0651\u064e\u0634\u06e1\u0623\u064e\u0629\u064e \u0671\u0644\u06e1\u0623\u064f\u0648\u0644\u064e\u0649\u0670 \u0641\u064e\u0644\u064e\u0648\u06e1\u0644\u064e\u0627 \u062a\u064e\u0630\u064e\u0643\u0651\u064e\u0631\u064f\u0648\u0646\u064e","translation":"Vous savez pourtant que Nous avons proc\u00e9d\u00e9 \u00e0 la premi\u00e8re cr\u00e9ation. Si seulement vous r\u00e9fl\u00e9chissiez ?","footnotes":""},{"id":"5042","sura":"56","aya":"63","arabic_text":"\u0623\u064e\u0641\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064f\u0645 \u0645\u0651\u064e\u0627 \u062a\u064e\u062d\u06e1\u0631\u064f\u062b\u064f\u0648\u0646\u064e","translation":"Avez-vous consid\u00e9r\u00e9 ce que vous semez ?","footnotes":""},{"id":"5043","sura":"56","aya":"64","arabic_text":"\u0621\u064e\u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u062a\u064e\u0632\u06e1\u0631\u064e\u0639\u064f\u0648\u0646\u064e\u0647\u064f\u06e5\u0653 \u0623\u064e\u0645\u06e1 \u0646\u064e\u062d\u06e1\u0646\u064f \u0671\u0644\u0632\u0651\u064e\u0670\u0631\u0650\u0639\u064f\u0648\u0646\u064e","translation":"Est-ce vous ou bien Nous qui le faisons germer ?","footnotes":""},{"id":"5044","sura":"56","aya":"65","arabic_text":"\u0644\u064e\u0648\u06e1 \u0646\u064e\u0634\u064e\u0627\u0653\u0621\u064f \u0644\u064e\u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0670\u0647\u064f \u062d\u064f\u0637\u064e\u0670\u0645\u0657\u0627 \u0641\u064e\u0638\u064e\u0644\u06e1\u062a\u064f\u0645\u06e1 \u062a\u064e\u0641\u064e\u0643\u0651\u064e\u0647\u064f\u0648\u0646\u064e","translation":"Si Nous le voulions, Nous le ferions s\u00e9cher sur pied. Vous ne cesseriez alors de vous lamenter :","footnotes":""},{"id":"5045","sura":"56","aya":"66","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0627 \u0644\u064e\u0645\u064f\u063a\u06e1\u0631\u064e\u0645\u064f\u0648\u0646\u064e","translation":"\u00ab Nous voil\u00e0 totalement ruin\u00e9s !","footnotes":""},{"id":"5046","sura":"56","aya":"67","arabic_text":"\u0628\u064e\u0644\u06e1 \u0646\u064e\u062d\u06e1\u0646\u064f \u0645\u064e\u062d\u06e1\u0631\u064f\u0648\u0645\u064f\u0648\u0646\u064e","translation":"Ou plut\u00f4t enti\u00e8rement d\u00e9sh\u00e9rit\u00e9s ! \u00bb","footnotes":""},{"id":"5047","sura":"56","aya":"68","arabic_text":"\u0623\u064e\u0641\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064f\u0645\u064f \u0671\u0644\u06e1\u0645\u064e\u0627\u0653\u0621\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u062a\u064e\u0634\u06e1\u0631\u064e\u0628\u064f\u0648\u0646\u064e","translation":"Avez-vous consid\u00e9r\u00e9 l\u2019eau que vous buvez ?","footnotes":""},{"id":"5048","sura":"56","aya":"69","arabic_text":"\u0621\u064e\u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u0623\u064e\u0646\u0632\u064e\u0644\u06e1\u062a\u064f\u0645\u064f\u0648\u0647\u064f \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0645\u064f\u0632\u06e1\u0646\u0650 \u0623\u064e\u0645\u06e1 \u0646\u064e\u062d\u06e1\u0646\u064f \u0671\u0644\u06e1\u0645\u064f\u0646\u0632\u0650\u0644\u064f\u0648\u0646\u064e","translation":"Est-ce vous ou bien Nous qui la faisons descendre des nu\u00e9es ?","footnotes":""},{"id":"5049","sura":"56","aya":"70","arabic_text":"\u0644\u064e\u0648\u06e1 \u0646\u064e\u0634\u064e\u0627\u0653\u0621\u064f \u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0670\u0647\u064f \u0623\u064f\u062c\u064e\u0627\u062c\u0657\u0627 \u0641\u064e\u0644\u064e\u0648\u06e1\u0644\u064e\u0627 \u062a\u064e\u0634\u06e1\u0643\u064f\u0631\u064f\u0648\u0646\u064e","translation":"Si Nous le voulions, Nous la rendrions saum\u00e2tre. Si seulement vous vous montriez reconnaissants !","footnotes":""},{"id":"5050","sura":"56","aya":"71","arabic_text":"\u0623\u064e\u0641\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064f\u0645\u064f \u0671\u0644\u0646\u0651\u064e\u0627\u0631\u064e \u0671\u0644\u0651\u064e\u062a\u0650\u064a \u062a\u064f\u0648\u0631\u064f\u0648\u0646\u064e","translation":"Avez-vous consid\u00e9r\u00e9 le feu que vous allumez ?","footnotes":""},{"id":"5051","sura":"56","aya":"72","arabic_text":"\u0621\u064e\u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u0623\u064e\u0646\u0634\u064e\u0623\u06e1\u062a\u064f\u0645\u06e1 \u0634\u064e\u062c\u064e\u0631\u064e\u062a\u064e\u0647\u064e\u0627\u0653 \u0623\u064e\u0645\u06e1 \u0646\u064e\u062d\u06e1\u0646\u064f \u0671\u0644\u06e1\u0645\u064f\u0646\u0634\u0650\u0640\u0654\u064f\u0648\u0646\u064e","translation":"Est-ce vous ou bien Nous qui avons cr\u00e9\u00e9 le bois d\u2019o\u00f9 il jaillit ?","footnotes":""},{"id":"5052","sura":"56","aya":"73","arabic_text":"\u0646\u064e\u062d\u06e1\u0646\u064f \u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0670\u0647\u064e\u0627 \u062a\u064e\u0630\u06e1\u0643\u0650\u0631\u064e\u0629\u0657 \u0648\u064e\u0645\u064e\u062a\u064e\u0670\u0639\u0657\u0627 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0642\u06e1\u0648\u0650\u064a\u0646\u064e","translation":"Nous en avons fait un avertissement et un \u00e9l\u00e9ment utile aux voyageurs[5].","footnotes":"[5] Puisqu\u2019il rappelle aux hommes le feu de l\u2019Enfer et que, plus que quiconque, ce sont les voyageurs qui ont besoin de feu."},{"id":"5053","sura":"56","aya":"74","arabic_text":"\u0641\u064e\u0633\u064e\u0628\u0651\u0650\u062d\u06e1 \u0628\u0650\u0671\u0633\u06e1\u0645\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0671\u0644\u06e1\u0639\u064e\u0638\u0650\u064a\u0645\u0650","translation":"Exalte donc le nom de ton Seigneur, le Tr\u00e8s Glorieux !","footnotes":""},{"id":"5054","sura":"56","aya":"75","arabic_text":"\u06de\u00a0\u0641\u064e\u0644\u064e\u0627\u0653 \u0623\u064f\u0642\u06e1\u0633\u0650\u0645\u064f \u0628\u0650\u0645\u064e\u0648\u064e\u0670\u0642\u0650\u0639\u0650 \u0671\u0644\u0646\u0651\u064f\u062c\u064f\u0648\u0645\u0650","translation":"Je jure par la position[6] des \u00e9toiles","footnotes":"[6] Ou : le coucher."},{"id":"5055","sura":"56","aya":"76","arabic_text":"\u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u0642\u064e\u0633\u064e\u0645\u065e \u0644\u0651\u064e\u0648\u06e1 \u062a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e \u0639\u064e\u0638\u0650\u064a\u0645\u064c","translation":"- et c\u2019est un serment des plus solennels, si vous saviez -","footnotes":""},{"id":"5056","sura":"56","aya":"77","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u0642\u064f\u0631\u06e1\u0621\u064e\u0627\u0646\u065e \u0643\u064e\u0631\u0650\u064a\u0645\u065e","translation":"que le Coran est une sublime r\u00e9citation,","footnotes":""},{"id":"5057","sura":"56","aya":"78","arabic_text":"\u0641\u0650\u064a \u0643\u0650\u062a\u064e\u0670\u0628\u0656 \u0645\u0651\u064e\u0643\u06e1\u0646\u064f\u0648\u0646\u0656","translation":"dans un livre soigneusement gard\u00e9,","footnotes":""},{"id":"5058","sura":"56","aya":"79","arabic_text":"\u0644\u0651\u064e\u0627 \u064a\u064e\u0645\u064e\u0633\u0651\u064f\u0647\u064f\u06e5\u0653 \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u06e1\u0645\u064f\u0637\u064e\u0647\u0651\u064e\u0631\u064f\u0648\u0646\u064e","translation":"que seuls les \u00eatres purs[7] peuvent toucher,","footnotes":"[7] Les anges."},{"id":"5059","sura":"56","aya":"80","arabic_text":"\u062a\u064e\u0646\u0632\u0650\u064a\u0644\u065e \u0645\u0651\u0650\u0646 \u0631\u0651\u064e\u0628\u0651\u0650 \u0671\u0644\u06e1\u0639\u064e\u0670\u0644\u064e\u0645\u0650\u064a\u0646\u064e","translation":"r\u00e9v\u00e9l\u00e9e par le Seigneur de la Cr\u00e9ation.","footnotes":""},{"id":"5060","sura":"56","aya":"81","arabic_text":"\u0623\u064e\u0641\u064e\u0628\u0650\u0647\u064e\u0670\u0630\u064e\u0627 \u0671\u0644\u06e1\u062d\u064e\u062f\u0650\u064a\u062b\u0650 \u0623\u064e\u0646\u062a\u064f\u0645 \u0645\u0651\u064f\u062f\u06e1\u0647\u0650\u0646\u064f\u0648\u0646\u064e","translation":"Est-ce ce discours dont vous contestez l\u2019authenticit\u00e9,","footnotes":""},{"id":"5061","sura":"56","aya":"82","arabic_text":"\u0648\u064e\u062a\u064e\u062c\u06e1\u0639\u064e\u0644\u064f\u0648\u0646\u064e \u0631\u0650\u0632\u06e1\u0642\u064e\u0643\u064f\u0645\u06e1 \u0623\u064e\u0646\u0651\u064e\u0643\u064f\u0645\u06e1 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f\u0648\u0646\u064e","translation":"r\u00e9pondant aux gr\u00e2ces du Seigneur par la plus inf\u00e2me ingratitude ?","footnotes":""},{"id":"5062","sura":"56","aya":"83","arabic_text":"\u0641\u064e\u0644\u064e\u0648\u06e1\u0644\u064e\u0627\u0653 \u0625\u0650\u0630\u064e\u0627 \u0628\u064e\u0644\u064e\u063a\u064e\u062a\u0650 \u0671\u0644\u06e1\u062d\u064f\u0644\u06e1\u0642\u064f\u0648\u0645\u064e","translation":"Si seulement, lorsque l\u2019\u00e2me remonte \u00e0 la gorge,","footnotes":""},{"id":"5063","sura":"56","aya":"84","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u062d\u0650\u064a\u0646\u064e\u0626\u0650\u0630\u0656 \u062a\u064e\u0646\u0638\u064f\u0631\u064f\u0648\u0646\u064e","translation":"tandis que, tout autour de lui, vous regardez,","footnotes":""},{"id":"5064","sura":"56","aya":"85","arabic_text":"\u0648\u064e\u0646\u064e\u062d\u06e1\u0646\u064f \u0623\u064e\u0642\u06e1\u0631\u064e\u0628\u064f \u0625\u0650\u0644\u064e\u064a\u06e1\u0647\u0650 \u0645\u0650\u0646\u0643\u064f\u0645\u06e1 \u0648\u064e\u0644\u064e\u0670\u0643\u0650\u0646 \u0644\u0651\u064e\u0627 \u062a\u064f\u0628\u06e1\u0635\u0650\u0631\u064f\u0648\u0646\u064e","translation":"- Nous[8] sommes alors plus proche du mourant que vous sans que vous vous en aperceviez -","footnotes":"[8] Allah ou Ses anges."},{"id":"5065","sura":"56","aya":"86","arabic_text":"\u0641\u064e\u0644\u064e\u0648\u06e1\u0644\u064e\u0627\u0653 \u0625\u0650\u0646 \u0643\u064f\u0646\u062a\u064f\u0645\u06e1 \u063a\u064e\u064a\u06e1\u0631\u064e \u0645\u064e\u062f\u0650\u064a\u0646\u0650\u064a\u0646\u064e","translation":"si seulement donc, si vous pensez ne jamais devoir \u00eatre jug\u00e9s,","footnotes":""},{"id":"5066","sura":"56","aya":"87","arabic_text":"\u062a\u064e\u0631\u06e1\u062c\u0650\u0639\u064f\u0648\u0646\u064e\u0647\u064e\u0627\u0653 \u0625\u0650\u0646 \u0643\u064f\u0646\u062a\u064f\u0645\u06e1 \u0635\u064e\u0670\u062f\u0650\u0642\u0650\u064a\u0646\u064e","translation":"vous faisiez revenir cette \u00e2me, si vous dites la v\u00e9rit\u00e9 ?","footnotes":""},{"id":"5067","sura":"56","aya":"88","arabic_text":"\u0641\u064e\u0623\u064e\u0645\u0651\u064e\u0627\u0653 \u0625\u0650\u0646 \u0643\u064e\u0627\u0646\u064e \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0645\u064f\u0642\u064e\u0631\u0651\u064e\u0628\u0650\u064a\u0646\u064e","translation":"Si le moribond est du nombre des rapproch\u00e9s,","footnotes":""},{"id":"5068","sura":"56","aya":"89","arabic_text":"\u0641\u064e\u0631\u064e\u0648\u06e1\u062d\u065e \u0648\u064e\u0631\u064e\u064a\u06e1\u062d\u064e\u0627\u0646\u065e \u0648\u064e\u062c\u064e\u0646\u0651\u064e\u062a\u064f \u0646\u064e\u0639\u0650\u064a\u0645\u0656","translation":"il est promis au repos \u00e9ternel dans le Jardin de la f\u00e9licit\u00e9.","footnotes":""},{"id":"5069","sura":"56","aya":"90","arabic_text":"\u0648\u064e\u0623\u064e\u0645\u0651\u064e\u0627\u0653 \u0625\u0650\u0646 \u0643\u064e\u0627\u0646\u064e \u0645\u0650\u0646\u06e1 \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u0650 \u0671\u0644\u06e1\u064a\u064e\u0645\u0650\u064a\u0646\u0650","translation":"Et s\u2019il est du nombre des gens de la droite,","footnotes":""},{"id":"5070","sura":"56","aya":"91","arabic_text":"\u0641\u064e\u0633\u064e\u0644\u064e\u0670\u0645\u065e \u0644\u0651\u064e\u0643\u064e \u0645\u0650\u0646\u06e1 \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u0650 \u0671\u0644\u06e1\u064a\u064e\u0645\u0650\u064a\u0646\u0650","translation":"il lui sera dit : \u00ab Tu es sauv\u00e9, car tu fais partie des gens de la droite[9]. \u00bb","footnotes":"[9] Autre sens : il sera accueilli par les gens de la droite par ces mots : \u00ab Paix \u00e0 toi. \u00bb"},{"id":"5071","sura":"56","aya":"92","arabic_text":"\u0648\u064e\u0623\u064e\u0645\u0651\u064e\u0627\u0653 \u0625\u0650\u0646 \u0643\u064e\u0627\u0646\u064e \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e \u0671\u0644\u0636\u0651\u064e\u0627\u0653\u0644\u0651\u0650\u064a\u0646\u064e","translation":"Mais s\u2019il est du nombre des n\u00e9gateurs \u00e9gar\u00e9s,","footnotes":""},{"id":"5072","sura":"56","aya":"93","arabic_text":"\u0641\u064e\u0646\u064f\u0632\u064f\u0644\u065e \u0645\u0651\u0650\u0646\u06e1 \u062d\u064e\u0645\u0650\u064a\u0645\u0656","translation":"il sera accueilli par une eau \u00e0 son plus haut degr\u00e9","footnotes":""},{"id":"5073","sura":"56","aya":"94","arabic_text":"\u0648\u064e\u062a\u064e\u0635\u06e1\u0644\u0650\u064a\u064e\u0629\u064f \u062c\u064e\u062d\u0650\u064a\u0645\u064d","translation":"et introduit dans le Brasier pour y br\u00fbler.","footnotes":""},{"id":"5074","sura":"56","aya":"95","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0647\u064e\u0670\u0630\u064e\u0627 \u0644\u064e\u0647\u064f\u0648\u064e \u062d\u064e\u0642\u0651\u064f \u0671\u0644\u06e1\u064a\u064e\u0642\u0650\u064a\u0646\u0650","translation":"Tout ceci est l\u2019absolue v\u00e9rit\u00e9, \u00e0 n\u2019en point douter.","footnotes":""},{"id":"5075","sura":"56","aya":"96","arabic_text":"\u0641\u064e\u0633\u064e\u0628\u0651\u0650\u062d\u06e1 \u0628\u0650\u0671\u0633\u06e1\u0645\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0671\u0644\u06e1\u0639\u064e\u0638\u0650\u064a\u0645\u0650","translation":"Exalte donc le nom de ton Seigneur, le Tr\u00e8s Glorieux !","footnotes":""}]}