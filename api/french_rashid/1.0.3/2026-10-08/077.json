eux croyants, quant \u00e0 eux, seront sous d\u2019\u00e9pais ombrages, au milieu de sources vives,","footnotes":""},{"id":"5664","sura":"77","aya":"42","arabic_text":"\u0648\u064e\u0641\u064e\u0648\u064e\u0670\u0643\u0650\u0647\u064e \u0645\u0650\u0645\u0651\u064e\u0627 \u064a\u064e\u0634\u06e1\u062a\u064e\u0647\u064f\u0648\u0646\u064e","translation":"d\u00e9gustant les fruits les plus d\u00e9sirables.","footnotes":""},{"id":"5665","sura":"77","aya":"43","arabic_text":"\u0643\u064f\u0644\u064f\u0648\u0627\u0652 \u0648\u064e\u0671\u0634\u06e1\u0631\u064e\u0628\u064f\u0648\u0627\u0652 \u0647\u064e\u0646\u0650\u064a\u0653\u0640\u0654\u064e\u06e2\u0627 \u0628\u0650\u0645\u064e\u0627 \u0643\u064f\u0646\u062a\u064f\u0645\u06e1 \u062a\u064e\u0639\u06e1\u0645\u064e\u0644\u064f\u0648\u0646\u064e","translation":"\u00ab Mangez et buvez en paix pour prix de vos \u0153uvres pass\u00e9es ! \u00bb","footnotes":""},{"id":"5666","sura":"77","aya":"44","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0627 \u0643\u064e\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0646\u064e\u062c\u06e1\u0632\u0650\u064a \u0671\u0644\u06e1\u0645\u064f\u062d\u06e1\u0633\u0650\u0646\u0650\u064a\u0646\u064e","translation":"C\u2019est ainsi que Nous r\u00e9compenserons ceux qui auront v\u00e9cu dans la pi\u00e9t\u00e9.","footnotes":""},{"id":"5667","sura":"77","aya":"45","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"Malheur, ce Jour-l\u00e0, \u00e0 ceux qui auront rejet\u00e9 la v\u00e9rit\u00e9 !","footnotes":""},{"id":"5668","sura":"77","aya":"46","arabic_text":"\u0643\u064f\u0644\u064f\u0648\u0627\u0652 \u0648\u064e\u062a\u064e\u0645\u064e\u062a\u0651\u064e\u0639\u064f\u0648\u0627\u0652 \u0642\u064e\u0644\u0650\u064a\u0644\u064b\u0627 \u0625\u0650\u0646\u0651\u064e\u0643\u064f\u0645 \u0645\u0651\u064f\u062c\u06e1\u0631\u0650\u0645\u064f\u0648\u0646\u064e","translation":"\u00ab Mangez[4] et jouissez quelque temps de cette vie dans votre impi\u00e9t\u00e9 ! \u00bb","footnotes":"[4] Vous, m\u00e9cr\u00e9ants !"},{"id":"5669","sura":"77","aya":"47","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"Malheur, ce Jour-l\u00e0, \u00e0 ceux qui auront rejet\u00e9 la v\u00e9rit\u00e9 !","footnotes":""},{"id":"5670","sura":"77","aya":"48","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0642\u0650\u064a\u0644\u064e \u0644\u064e\u0647\u064f\u0645\u064f \u0671\u0631\u06e1\u0643\u064e\u0639\u064f\u0648\u0627\u0652 \u0644\u064e\u0627 \u064a\u064e\u0631\u06e1\u0643\u064e\u0639\u064f\u0648\u0646\u064e","translation":"Lorsqu\u2019on leur demande de s\u2019incliner en pri\u00e8re, ils s\u2019y refusent avec fiert\u00e9.","footnotes":""},{"id":"5671","sura":"77","aya":"49","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"Malheur, ce Jour-l\u00e0, \u00e0 ceux qui auront rejet\u00e9 la v\u00e9rit\u00e9 !","footnotes":""},{"id":"5672","sura":"77","aya":"50","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u062d\u064e\u062f\u0650\u064a\u062b\u0650\u06ed \u0628\u064e\u0639\u06e1\u062f\u064e\u0647\u064f\u06e5 \u064a\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e","translation":"En quel livre croiront-ils, s\u2019ils ne croient pas en celui-ci ?","footnotes":""}]}