0650\u062d\u06e1 \u0628\u0650\u0671\u0633\u06e1\u0645\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0671\u0644\u06e1\u0639\u064e\u0638\u0650\u064a\u0645\u0650","translation":" O halde y\u00fcce Rabbinin ad\u0131n\u0131 tesbih et!","footnotes":null},{"id":"5054","sura":"56","aya":"75","arabic_text":"\u06de\u00a0\u0641\u064e\u0644\u064e\u0627\u0653 \u0623\u064f\u0642\u06e1\u0633\u0650\u0645\u064f \u0628\u0650\u0645\u064e\u0648\u064e\u0670\u0642\u0650\u0639\u0650 \u0671\u0644\u0646\u0651\u064f\u062c\u064f\u0648\u0645\u0650","translation":"Y\u0131ld\u0131zlar\u0131n yerlerine yemin ederim ki! ","footnotes":null},{"id":"5055","sura":"56","aya":"76","arabic_text":"\u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u0642\u064e\u0633\u064e\u0645\u065e \u0644\u0651\u064e\u0648\u06e1 \u062a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e \u0639\u064e\u0638\u0650\u064a\u0645\u064c","translation":" \u015e\u00fcphesiz bu, b\u00fcy\u00fck bir yemindir, e\u011fer bilirseniz.","footnotes":null},{"id":"5056","sura":"56","aya":"77","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u0642\u064f\u0631\u06e1\u0621\u064e\u0627\u0646\u065e \u0643\u064e\u0631\u0650\u064a\u0645\u065e","translation":" \u015e\u00fcphesiz bu, de\u011ferli bir Kur'an'd\u0131r.","footnotes":null},{"id":"5057","sura":"56","aya":"78","arabic_text":"\u0641\u0650\u064a \u0643\u0650\u062a\u064e\u0670\u0628\u0656 \u0645\u0651\u064e\u0643\u06e1\u0646\u064f\u0648\u0646\u0656","translation":" Gizli\/korunmu\u015f bir kitaptad\u0131r.","footnotes":null},{"id":"5058","sura":"56","aya":"79","arabic_text":"\u0644\u0651\u064e\u0627 \u064a\u064e\u0645\u064e\u0633\u0651\u064f\u0647\u064f\u06e5\u0653 \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u06e1\u0645\u064f\u0637\u064e\u0647\u0651\u064e\u0631\u064f\u0648\u0646\u064e","translation":" Ona ancak temizlenenler dokunabilir.","footnotes":null},{"id":"5059","sura":"56","aya":"80","arabic_text":"\u062a\u064e\u0646\u0632\u0650\u064a\u0644\u065e \u0645\u0651\u0650\u0646 \u0631\u0651\u064e\u0628\u0651\u0650 \u0671\u0644\u06e1\u0639\u064e\u0670\u0644\u064e\u0645\u0650\u064a\u0646\u064e","translation":" Alemlerin Rabbinden indirilmi\u015ftir.","footnotes":null},{"id":"5060","sura":"56","aya":"81","arabic_text":"\u0623\u064e\u0641\u064e\u0628\u0650\u0647\u064e\u0670\u0630\u064e\u0627 \u0671\u0644\u06e1\u062d\u064e\u062f\u0650\u064a\u062b\u0650 \u0623\u064e\u0646\u062a\u064f\u0645 \u0645\u0651\u064f\u062f\u06e1\u0647\u0650\u0646\u064f\u0648\u0646\u064e","translation":" Siz bu s\u00f6z\u00fc m\u00fc hor g\u00f6r\u00fcyorsunuz?","footnotes":null},{"id":"5061","sura":"56","aya":"82","arabic_text":"\u0648\u064e\u062a\u064e\u062c\u06e1\u0639\u064e\u0644\u064f\u0648\u0646\u064e \u0631\u0650\u0632\u06e1\u0642\u064e\u0643\u064f\u0645\u06e1 \u0623\u064e\u0646\u0651\u064e\u0643\u064f\u0645\u06e1 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f\u0648\u0646\u064e","translation":" Onu yalanlayarak m\u0131 size verilen nimete \u015f\u00fck\u00fcr ediyorsunuz? ","footnotes":null},{"id":"5062","sura":"56","aya":"83","arabic_text":"\u0641\u064e\u0644\u064e\u0648\u06e1\u0644\u064e\u0627\u0653 \u0625\u0650\u0630\u064e\u0627 \u0628\u064e\u0644\u064e\u063a\u064e\u062a\u0650 \u0671\u0644\u06e1\u062d\u064f\u0644\u06e1\u0642\u064f\u0648\u0645\u064e","translation":" Hele bir (ruh) bo\u011faza gelmi\u015f olmas\u0131n.","footnotes":null},{"id":"5063","sura":"56","aya":"84","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u062d\u0650\u064a\u0646\u064e\u0626\u0650\u0630\u0656 \u062a\u064e\u0646\u0638\u064f\u0631\u064f\u0648\u0646\u064e","translation":" Siz, o zaman bak\u0131p kal\u0131rs\u0131n\u0131z","footnotes":null},{"id":"5064","sura":"56","aya":"85","arabic_text":"\u0648\u064e\u0646\u064e\u062d\u06e1\u0646\u064f \u0623\u064e\u0642\u06e1\u0631\u064e\u0628\u064f \u0625\u0650\u0644\u064e\u064a\u06e1\u0647\u0650 \u0645\u0650\u0646\u0643\u064f\u0645\u06e1 \u0648\u064e\u0644\u064