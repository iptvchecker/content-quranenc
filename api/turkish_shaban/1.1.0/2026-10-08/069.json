ahk\u00e2rdan ba\u015fkas\u0131 yemez.","footnotes":null},{"id":"5361","sura":"69","aya":"38","arabic_text":"\u0641\u064e\u0644\u064e\u0627\u0653 \u0623\u064f\u0642\u06e1\u0633\u0650\u0645\u064f \u0628\u0650\u0645\u064e\u0627 \u062a\u064f\u0628\u06e1\u0635\u0650\u0631\u064f\u0648\u0646\u064e","translation":"G\u00f6rebildikleriniz \u00fczerine yemin ederim.","footnotes":null},{"id":"5362","sura":"69","aya":"39","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0644\u064e\u0627 \u062a\u064f\u0628\u06e1\u0635\u0650\u0631\u064f\u0648\u0646\u064e","translation":"G\u00f6remediklerinize de\u2026","footnotes":null},{"id":"5363","sura":"69","aya":"40","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u0642\u064e\u0648\u06e1\u0644\u064f \u0631\u064e\u0633\u064f\u0648\u0644\u0656 \u0643\u064e\u0631\u0650\u064a\u0645\u0656","translation":" \u015e\u00fcphesiz o, \u015ferefli bir el\u00e7inin s\u00f6z\u00fcd\u00fcr.","footnotes":null},{"id":"5364","sura":"69","aya":"41","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0647\u064f\u0648\u064e \u0628\u0650\u0642\u064e\u0648\u06e1\u0644\u0650 \u0634\u064e\u0627\u0639\u0650\u0631\u0656\u06da \u0642\u064e\u0644\u0650\u064a\u0644\u0657\u0627 \u0645\u0651\u064e\u0627 \u062a\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e","translation":" O, bir \u015fair s\u00f6z\u00fc de\u011fildir. Ne de az iman ediyorsunuz! ","footnotes":null},{"id":"5365","sura":"69","aya":"42","arabic_text":"\u0648\u064e\u0644\u064e\u0627 \u0628\u0650\u0642\u064e\u0648\u06e1\u0644\u0650 \u0643\u064e\u0627\u0647\u0650\u0646\u0656\u06da \u0642\u064e\u0644\u0650\u064a\u0644\u0657\u0627 \u0645\u0651\u064e\u0627 \u062a\u064e\u0630\u064e\u0643\u0651\u064e\u0631\u064f\u0648\u0646\u064e","translation":" O, k\u00e2hin s\u00f6z\u00fc de de\u011fildir. Ne de az d\u00fc\u015f\u00fcn\u00fcyorsunuz! ","footnotes":null},{"id":"5366","sura":"69","aya":"43","arabic_text":"\u062a\u064e\u0646\u0632\u0650\u064a\u0644\u065e \u0645\u0651\u0650\u0646 \u0631\u0651\u064e\u0628\u0651\u0650 \u0671\u0644\u06e1\u0639\u064e\u0670\u0644\u064e\u0645\u0650\u064a\u0646\u064e","translation":" Alemlerin Rabbi taraf\u0131ndan indirilmi\u015ftir.","footnotes":null},{"id":"5367","sura":"69","aya":"44","arabic_text":"\u0648\u064e\u0644\u064e\u0648\u06e1 \u062a\u064e\u0642\u064e\u0648\u0651\u064e\u0644\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0646\u064e\u0627 \u0628\u064e\u0639\u06e1\u0636\u064e \u0671\u0644\u06e1\u0623\u064e\u0642\u064e\u0627\u0648\u0650\u064a\u0644\u0650","translation":"E\u011fer (Peygamber) bize atfen baz\u0131 s\u00f6zler uydurmu\u015f olsayd\u0131;","footnotes":null},{"id":"5368","sura":"69","aya":"45","arabic_text":"\u0644\u064e\u0623\u064e\u062e\u064e\u0630\u06e1\u0646\u064e\u0627 \u0645\u0650\u0646\u06e1\u0647\u064f \u0628\u0650\u0671\u0644\u06e1\u064a\u064e\u0645\u0650\u064a\u0646\u0650","translation":"Elbette onu (boynunun) sa\u011f taraf\u0131ndan k\u0131sk\u0131vrak yakalard\u0131k.","footnotes":null},{"id":"5369","sura":"69","aya":"46","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0644\u064e\u0642\u064e\u0637\u064e\u0639\u06e1\u0646\u064e\u0627 \u0645\u0650\u0646\u06e1\u0647\u064f \u0671\u0644\u06e1\u0648\u064e\u062a\u0650\u064a\u0646\u064e","translation":" Sonra onun \u015fah damar\u0131n\u0131 elbette keserdik.","footnotes":null},{"id":"5370","sura":"69","aya":"47","arabic_text":"\u0641\u064e\u0645\u064e\u0627 \u0645\u0650\u0646\u0643\u064f\u0645 \u0645\u0651\u0650\u0646\u06e1 \u0623\u064e\u062d\u064e\u062f\u064d \u0639\u064e\u0646\u06e1\u0647\u064f \u062d\u064e\u0670\u062c\u0650\u0632\u0650\u064a\u0646\u064e","translation":" Sizden hi\u00e7 kimse de buna engel olamazd\u0131.","footnotes":null},{"id":"5371","sura":"69","aya":"48","arabic_text":"\u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u062a\u064e\u0630\u06e1\u0643\u0650\u0631\u064e\u0629\u065e \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u062a\u0651\u064e\u0642\u0650\u064a\u0646\u064e","translation":" \u015e\u00fcphesiz o, sak\u0131nanlar i\u00e7in bir \u00f6\u011f\u00fctt\u00fcr. ","footnotes":null},{"id":"5372","sura":"69","aya":"49","arabic_text":"\u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0627 \u0644\u064e\u0646\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0623\u064e\u0646\u0651\u064e \u0645\u0650\u0646\u0643\u064f\u0645 \u0645\u0651\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":" Elbette biz, biliyoruz ki i\u00e7inizden yalanlayanlar vard\u0131r.","footnotes":null},{"id":"5373","sura":"69","aya":"50","arabic_text":"\u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u062d\u064e\u0633\u06e1\u0631\u064e\u0629\u064c \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u06e1\u0643\u064e\u0670\u0641\u0650\u0631\u0650\u064a\u0646\u064e","translation":" O k\u00e2firler i\u00e7in bir hasret\/pi\u015fmanl\u0131kt\u0131r.","footnotes":null},{"id":"5374","sura":"69","aya":"51","arabic_text":"\u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u062d\u064e\u0642\u0651\u064f \u0671\u0644\u06e1\u064a\u064e\u0642\u0650\u064a\u0646\u0650","translation":" O, kesin bir ger\u00e7ektir.","footnotes":null},{"id":"5375","sura":"69","aya":"52","arabic_text":"\u0641\u064e\u0633\u064e\u0628\u0651\u0650\u062d\u06e1 \u0628\u0650\u0671\u0633\u06e1\u0645\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0671\u0644\u06e1\u0639\u064e\u0638\u0650\u064a\u0645\u0650","translation":" O halde sen, y\u00fcce Rabbinin ad\u0131 ile tesbih et! ","footnotes":null}]}