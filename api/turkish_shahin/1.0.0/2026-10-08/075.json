an \u00e7eki\u015fen) bunun ger\u00e7ek bir ayr\u0131l\u0131\u015f oldu\u011funu anlar.","footnotes":""},{"id":"5580","sura":"75","aya":"29","arabic_text":"\u0648\u064e\u0671\u0644\u06e1\u062a\u064e\u0641\u0651\u064e\u062a\u0650 \u0671\u0644\u0633\u0651\u064e\u0627\u0642\u064f \u0628\u0650\u0671\u0644\u0633\u0651\u064e\u0627\u0642\u0650","translation":"Ve bacak baca\u011fa dola\u015f\u0131r.","footnotes":""},{"id":"5581","sura":"75","aya":"30","arabic_text":"\u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u064d \u0671\u0644\u06e1\u0645\u064e\u0633\u064e\u0627\u0642\u064f","translation":"\u0130\u015fte o g\u00fcn sevkedilecek yer, sadece Rabbinin huzurudur.","footnotes":""},{"id":"5582","sura":"75","aya":"31","arabic_text":"\u0641\u064e\u0644\u064e\u0627 \u0635\u064e\u062f\u0651\u064e\u0642\u064e \u0648\u064e\u0644\u064e\u0627 \u0635\u064e\u0644\u0651\u064e\u0649\u0670","translation":"\u0130\u015fte o, (Peygamber'in getirdi\u011fini) do\u011fru kabul etmemi\u015f, namaz da k\u0131lmam\u0131\u015ft\u0131.","footnotes":""},{"id":"5583","sura":"75","aya":"32","arabic_text":"\u0648\u064e\u0644\u064e\u0670\u0643\u0650\u0646 \u0643\u064e\u0630\u0651\u064e\u0628\u064e \u0648\u064e\u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0649\u0670","translation":"Aksine yalan saym\u0131\u015f ve y\u00fcz \u00e7evirmi\u015fti.","footnotes":""},{"id":"5584","sura":"75","aya":"33","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0630\u064e\u0647\u064e\u0628\u064e \u0625\u0650\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0647\u06e1\u0644\u0650\u0647\u0650\u06e6 \u064a\u064e\u062a\u064e\u0645\u064e\u0637\u0651\u064e\u0649\u0670\u0653","translation":"Sonra da \u00e7al\u0131m sata sata y\u00fcr\u00fcyerek kendi ehline (taraftarlar\u0131na) gitmi\u015fti.","footnotes":""},{"id":"5585","sura":"75","aya":"34","arabic_text":"\u0623\u064e\u0648\u06e1\u0644\u064e\u0649\u0670 \u0644\u064e\u0643\u064e \u0641\u064e\u0623\u064e\u0648\u06e1\u0644\u064e\u0649\u0670","translation":"L\u00e2y\u0131kt\u0131r (o azap) sana, l\u00e2y\u0131k!","footnotes":""},{"id":"5586","sura":"75","aya":"35","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0623\u064e\u0648\u06e1\u0644\u064e\u0649\u0670 \u0644\u064e\u0643\u064e \u0641\u064e\u0623\u064e\u0648\u06e1\u0644\u064e\u0649\u0670\u0653","translation":"Evet, l\u00e2y\u0131kt\u0131r sana ( o azap) l\u00e2y\u0131k!","footnotes":""},{"id":"5587","sura":"75","aya":"36","arabic_text":"\u0623\u064e\u064a\u064e\u062d\u06e1\u0633\u064e\u0628\u064f \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u0623\u064e\u0646 \u064a\u064f\u062a\u06e1\u0631\u064e\u0643\u064e \u0633\u064f\u062f\u064b\u0649","translation":"\u0130nsan, kendisinin ba\u015f\u0131bo\u015f b\u0131rak\u0131laca\u011f\u0131n\u0131 m\u0131 san\u0131r!","footnotes":""},{"id":"5588","sura":"75","aya":"37","arabic_text":"\u0623\u064e\u0644\u064e\u0645\u06e1 \u064a\u064e\u0643\u064f \u0646\u064f\u0637\u06e1\u0641\u064e\u0629\u0657 \u0645\u0651\u0650\u0646 \u0645\u0651\u064e\u0646\u0650\u064a\u0651\u0656 \u064a\u064f\u0645\u06e1\u0646\u064e\u0649\u0670","translation":"O, (d\u00f6l yata\u011f\u0131na) ak\u0131t\u0131lan meninin i\u00e7inden bir nutte (sperm) de\u011fil miydi?","footnotes":""},{"id":"5589","sura":"75","aya":"38","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0643\u064e\u0627\u0646\u064e \u0639\u064e\u0644\u064e\u0642\u064e\u0629\u0657 \u0641\u064e\u062e\u064e\u0644\u064e\u0642\u064e \u0641\u064e\u0633\u064e\u0648\u0651\u064e\u0649\u0670","translation":"Sonra bu, alaka (a\u015f\u0131lanm\u0131\u015f yumurta) olmu\u015f, derken Allah onu (insan bi\u00e7iminde) yarat\u0131p \u015fekillendirmi\u015fti.","footnotes":""},{"id":"5590","sura":"75","aya":"39","arabic_text":"\u0641\u064e\u062c\u064e\u0639\u064e\u0644\u064e \u0645\u0650\u0646\u06e1\u0647\u064f \u0671\u0644\u0632\u0651\u064e\u0648\u06e1\u062c\u064e\u064a\u06e1\u0646\u0650 \u0671\u0644\u0630\u0651\u064e\u0643\u064e\u0631\u064e \u0648\u064e\u0671\u0644\u06e1\u0623\u064f\u0646\u062b\u064e\u0649\u0670\u0653","translation":"Ondan da iki e\u015fi, yani erkek ve di\u015fiyi var etmi\u015fti.","footnotes":""},{"id":"5591","sura":"75","aya":"40","arabic_text":"\u0623\u064e\u0644\u064e\u064a\u06e1\u0633\u064e \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0628\u0650\u0642\u064e\u0670\u062f\u0650\u0631\u064d \u0639\u064e\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0646 \u064a\u064f\u062d\u06e1\u0640\u06e7\u0650\u064a\u064e \u0671\u0644\u06e1\u0645\u064e\u0648\u06e1\u062a\u064e\u0649\u0670","translation":"Peki (bunlar\u0131 yapan) Allah\u2019\u0131n, \u00f6l\u00fcleri tekrar diriltmeye g\u00fcc\u00fc yetmez mi?","footnotes":""}]}