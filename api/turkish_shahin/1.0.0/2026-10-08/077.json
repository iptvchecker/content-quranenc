ama) bir g\u00f6lgeye gidin.","footnotes":""},{"id":"5653","sura":"77","aya":"31","arabic_text":"\u0644\u0651\u064e\u0627 \u0638\u064e\u0644\u0650\u064a\u0644\u0656 \u0648\u064e\u0644\u064e\u0627 \u064a\u064f\u063a\u06e1\u0646\u0650\u064a \u0645\u0650\u0646\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e\u0628\u0650","translation":"Ne g\u00f6lgelendiren, ne de alevden koruyan.","footnotes":""},{"id":"5654","sura":"77","aya":"32","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064e\u0627 \u062a\u064e\u0631\u06e1\u0645\u0650\u064a \u0628\u0650\u0634\u064e\u0631\u064e\u0631\u0656 \u0643\u064e\u0671\u0644\u06e1\u0642\u064e\u0635\u06e1\u0631\u0650","translation":"O, saray gibi kocaman k\u0131v\u0131lc\u0131m sa\u00e7ar.","footnotes":""},{"id":"5655","sura":"77","aya":"33","arabic_text":"\u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u062c\u0650\u0645\u064e\u0670\u0644\u064e\u062a\u065e \u0635\u064f\u0641\u06e1\u0631\u065e","translation":"Her bir k\u0131v\u0131lc\u0131m, sanki birer sar\u0131 deve gibidir.","footnotes":""},{"id":"5656","sura":"77","aya":"34","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"O g\u00fcn, (hakikatleri) yalan sayanlar\u0131n vay haline!","footnotes":""},{"id":"5657","sura":"77","aya":"35","arabic_text":"\u0647\u064e\u0670\u0630\u064e\u0627 \u064a\u064e\u0648\u06e1\u0645\u064f \u0644\u064e\u0627 \u064a\u064e\u0646\u0637\u0650\u0642\u064f\u0648\u0646\u064e","translation":"Bu, (k\u00e2firlerin) konu\u015famayaca\u011f\u0131 bir g\u00fcnd\u00fcr.","footnotes":""},{"id":"5658","sura":"77","aya":"36","arabic_text":"\u0648\u064e\u0644\u064e\u0627 \u064a\u064f\u0624\u06e1\u0630\u064e\u0646\u064f \u0644\u064e\u0647\u064f\u0645\u06e1 \u0641\u064e\u064a\u064e\u0639\u06e1\u062a\u064e\u0630\u0650\u0631\u064f\u0648\u0646\u064e","translation":"Onlara izin de verilmez ki (s\u00f6zde) mazeretlerini beyan etsinler.","footnotes":""},{"id":"5659","sura":"77","aya":"37","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"O g\u00fcn, (hakikatleri) yalan sayanlar\u0131n vay haline!","footnotes":""},{"id":"5660","sura":"77","aya":"38","arabic_text":"\u0647\u064e\u0670\u0630\u064e\u0627 \u064a\u064e\u0648\u06e1\u0645\u064f \u0671\u0644\u06e1\u0641\u064e\u0635\u06e1\u0644\u0650\u06d6 \u062c\u064e\u0645\u064e\u0639\u06e1\u0646\u064e\u0670\u0643\u064f\u0645\u06e1 \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0648\u0651\u064e\u0644\u0650\u064a\u0646\u064e","translation":"(O zaman \u015f\u00f6yle denir:) Bu, ay\u0131r\u0131m g\u00fcn\u00fcd\u00fcr. Sizi ve sizden \u00f6ncekileri bir araya getirdik.","footnotes":""},{"id":"5661","sura":"77","aya":"39","arabic_text":"\u0641\u064e\u0625\u0650\u0646 \u0643\u064e\u0627\u0646\u064e \u0644\u064e\u0643\u064f\u0645\u06e1 \u0643\u064e\u064a\u06e1\u062f\u065e \u0641\u064e\u0643\u0650\u064a\u062f\u064f\u0648\u0646\u0650","translation":"(Azaptan kurtulman\u0131z i\u00e7in) bir hileniz varsa, g\u00f6sterin bana hilenizi!","footnotes":""},{"id":"5662","sura":"77","aya":"40","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"O g\u00fcn, (hakikatleri) yalan sayanlar\u0131n vay haline!","footnotes":""},{"id":"5663","sura":"77","aya":"41","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u06e1\u0645\u064f\u062a\u0651\u064e\u0642\u0650\u064a\u0646\u064e \u0641\u0650\u064a \u0638\u0650\u0644\u064e\u0670\u0644\u0656 \u0648\u064e\u0639\u064f\u064a\u064f\u0648\u0646\u0656","translation":"\u015e\u00fcphesiz (o g\u00fcn) takv\u00e2 sahipleri, g\u00f6lgeliklerde ve p\u0131nar ba\u015flar\u0131nda, ","footnotes":""},{"id":"5664","sura":"77","aya":"42","arabic_text":"\u0648\u064e\u0641\u064e\u0648\u064e\u0670\u0643\u0650\u0647\u064e \u0645\u0650\u0645\u0651\u064e\u0627 \u064a\u064e\u0634\u06e1\u062a\u064e\u0647\u064f\u0648\u0646\u064e","translation":"canlar\u0131n\u0131n \u00e7ekti\u011finden \u00e7e\u015fit \u00e7e\u015fit meyveler (aras\u0131nda olacaklard\u0131r.)","footnotes":""},{"id":"5665","sura":"77","aya":"43","arabic_text":"\u0643\u064f\u0644\u064f\u0648\u0627\u0652 \u0648\u064e\u0671\u0634\u06e1\u0631\u064e\u0628\u064f\u0648\u0627\u0652 \u0647\u064e\u0646\u0650\u064a\u0653\u0640\u0654\u064e\u06e2\u0627 \u0628\u0650\u0645\u064e\u0627 \u0643\u064f\u0646\u062a\u064f\u0645\u06e1 \u062a\u064e\u0639\u06e1\u0645\u064e\u0644\u064f\u0648\u0646\u064e","translation":"(Kendilerine:) \u00ab\u0130\u015flediklerinizin kar\u015f\u0131l\u0131\u011f\u0131 olarak \u015fimdi \u00e2f\u00eeyetle yiyin i\u00e7in\u00bb (denir).","footnotes":""},{"id":"5666","sura":"77","aya":"44","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0627 \u0643\u064e\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0646\u064e\u062c\u06e1\u0632\u0650\u064a \u0671\u0644\u06e1\u0645\u064f\u062d\u06e1\u0633\u0650\u0646\u0650\u064a\u0646\u064e","translation":"\u0130\u015fte, biz iyilik yapanlar\u0131 b\u00f6yle m\u00fck\u00e2fatland\u0131r\u0131r\u0131z.","footnotes":""},{"id":"5667","sura":"77","aya":"45","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"O g\u00fcn, (hakikatleri) yalan sayanlar\u0131n vay haline!","footnotes":""},{"id":"5668","sura":"77","aya":"46","arabic_text":"\u0643\u064f\u0644\u064f\u0648\u0627\u0652 \u0648\u064e\u062a\u064e\u0645\u064e\u062a\u0651\u064e\u0639\u064f\u0648\u0627\u0652 \u0642\u064e\u0644\u0650\u064a\u0644\u064b\u0627 \u0625\u0650\u0646\u0651\u064e\u0643\u064f\u0645 \u0645\u0651\u064f\u062c\u06e1\u0631\u0650\u0645\u064f\u0648\u0646\u064e","translation":"(Ey ink\u00e2rc\u0131lar!) yiyiniz, (d\u00fcnyadan) faydalan\u0131n\u0131z biraz! Ger\u00e7ek \u015fu ki, sizler su\u00e7lusunuz!","footnotes":""},{"id":"5669","sura":"77","aya":"47","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"O g\u00fcn, (hakikatleri) yalan sayanlar\u0131n vay haline!","footnotes":""},{"id":"5670","sura":"77","aya":"48","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0642\u0650\u064a\u0644\u064e \u0644\u064e\u0647\u064f\u0645\u064f \u0671\u0631\u06e1\u0643\u064e\u0639\u064f\u0648\u0627\u0652 \u0644\u064e\u0627 \u064a\u064e\u0631\u06e1\u0643\u064e\u0639\u064f\u0648\u0646\u064e","translation":"Onlar, kendilerine: \u00abAllah'\u0131n huzurunda e\u011filin!\u00bb denildi\u011fi vakit e\u011filmezler.","footnotes":""},{"id":"5671","sura":"77","aya":"49","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"O g\u00fcn, (hakikatleri) yalan sayanlar\u0131n vay haline!","footnotes":""},{"id":"5672","sura":"77","aya":"50","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u062d\u064e\u062f\u0650\u064a\u062b\u0650\u06ed \u0628\u064e\u0639\u06e1\u062f\u064e\u0647\u064f\u06e5 \u064a\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e","translation":"Onlar art\u0131k bundan (Kur'an'dan) sonra hangi s\u00f6ze inanacaklar?\u2003","footnotes":""}]}