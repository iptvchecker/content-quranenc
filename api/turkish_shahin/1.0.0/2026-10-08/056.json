\u0631\u064e\u0641\u0650\u064a\u0646\u064e","translation":"\u00c7\u00fcnk\u00fc onlar bundan \u00f6nce varl\u0131k i\u00e7inde sefahete dalm\u0131\u015flard\u0131.","footnotes":""},{"id":"5025","sura":"56","aya":"46","arabic_text":"\u0648\u064e\u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u064a\u064f\u0635\u0650\u0631\u0651\u064f\u0648\u0646\u064e \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u06e1\u062d\u0650\u0646\u062b\u0650 \u0671\u0644\u06e1\u0639\u064e\u0638\u0650\u064a\u0645\u0650","translation":"B\u00fcy\u00fck g\u00fcnah\u0131 i\u015flemekte direnir dururlard\u0131.","footnotes":""},{"id":"5026","sura":"56","aya":"47","arabic_text":"\u0648\u064e\u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u064a\u064e\u0642\u064f\u0648\u0644\u064f\u0648\u0646\u064e \u0623\u064e\u0626\u0650\u0630\u064e\u0627 \u0645\u0650\u062a\u06e1\u0646\u064e\u0627 \u0648\u064e\u0643\u064f\u0646\u0651\u064e\u0627 \u062a\u064f\u0631\u064e\u0627\u0628\u0657\u0627 \u0648\u064e\u0639\u0650\u0638\u064e\u0670\u0645\u064b\u0627 \u0623\u064e\u0621\u0650\u0646\u0651\u064e\u0627 \u0644\u064e\u0645\u064e\u0628\u06e1\u0639\u064f\u0648\u062b\u064f\u0648\u0646\u064e","translation":"Ve diyorlard\u0131 ki: Biz \u00f6ld\u00fckten, toprak ve kemik y\u0131\u011f\u0131n\u0131 haline geldikten sonra, biz mi bir daha diriltilece\u011fiz?","footnotes":""},{"id":"5027","sura":"56","aya":"48","arabic_text":"\u0623\u064e\u0648\u064e\u0621\u064e\u0627\u0628\u064e\u0627\u0653\u0624\u064f\u0646\u064e\u0627 \u0671\u0644\u06e1\u0623\u064e\u0648\u0651\u064e\u0644\u064f\u0648\u0646\u064e","translation":"\u00d6nceki atalar\u0131m\u0131z da m\u0131?","footnotes":""},{"id":"5028","sura":"56","aya":"49","arabic_text":"\u0642\u064f\u0644\u06e1 \u0625\u0650\u0646\u0651\u064e \u0671\u0644\u06e1\u0623\u064e\u0648\u0651\u064e\u0644\u0650\u064a\u0646\u064e \u0648\u064e\u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u0650\u064a\u0646\u064e","translation":"De ki: Hem \u00f6ncekiler hem de sonrakiler,","footnotes":""},{"id":"5029","sura":"56","aya":"50","arabic_text":"\u0644\u064e\u0645\u064e\u062c\u06e1\u0645\u064f\u0648\u0639\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u064e\u0649\u0670 \u0645\u0650\u064a\u0642\u064e\u0670\u062a\u0650 \u064a\u064e\u0648\u06e1\u0645\u0656 \u0645\u0651\u064e\u0639\u06e1\u0644\u064f\u0648\u0645\u0656","translation":"belli bir g\u00fcn\u00fcn belli vaktinde mutlaka toplanacaklard\u0131r!\u2003","footnotes":""},{"id":"5030","sura":"56","aya":"51","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0625\u0650\u0646\u0651\u064e\u0643\u064f\u0645\u06e1 \u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u0636\u0651\u064e\u0627\u0653\u0644\u0651\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f\u0648\u0646\u064e","translation":"Sonra siz ey sap\u0131klar, yalanc\u0131lar!","footnotes":""},{"id":"5031","sura":"56","aya":"52","arabic_text":"\u0644\u064e\u0623\u0653\u0643\u0650\u0644\u064f\u0648\u0646\u064e \u0645\u0650\u0646 \u0634\u064e\u062c\u064e\u0631\u0656 \u0645\u0651\u0650\u0646 \u0632\u064e\u0642\u0651\u064f\u0648\u0645\u0656","translation":"Elbette bir a\u011fa\u00e7tan, zakkum a\u011fac\u0131ndan yiyeceksiniz.","footnotes":""},{"id":"5032","sura":"56","aya":"53","arabic_text":"\u0641\u064e\u0645\u064e\u0627\u0644\u0650\u0640\u0654\u064f\u0648\u0646\u064e \u0645\u0650\u0646\u06e1\u0647\u064e\u0627 \u0671\u0644\u06e1\u0628\u064f\u0637\u064f\u0648\u0646\u064e","translation":"Kar\u0131nlar\u0131n\u0131z\u0131 ondan dolduracaks\u0131n\u0131z.","footnotes":""},{"id":"5033","sura":"56","aya":"54","arabic_text":"\u0641\u064e\u0634\u064e\u0670\u0631\u0650\u0628\u064f\u0648\u0646\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650 \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u062d\u064e\u0645\u0650\u064a\u0645\u0650","translation":"\u00dcst\u00fcne de kaynar sudan i\u00e7eceksiniz.","footnotes":""},{"id":"5034","sura":"56","aya":"55","arabic_text":"\u0641\u064e\u0634\u064e\u0670\u0631\u0650\u0628\u064f\u0648\u0646\u064e \u0634\u064f\u0631\u06e1\u0628\u064e \u0671\u0644\u06e1\u0647\u0650\u064a\u0645\u0650","translation":"Susam\u0131\u015f develerin suya sald\u0131r\u0131\u015f\u0131 gibi i\u00e7eceksiniz.","footnotes":""},{"id":"5035","sura":"56","aya":"56","arabic_text":"\u0647\u064e\u0670\u0630\u064e\u0627 \u0646\u064f\u0632\u064f\u0644\u064f\u0647\u064f\u0645\u06e1 \u064a\u064e\u0648\u06e1\u0645\u064e \u0671\u0644\u062f\u0651\u0650\u064a\u0646\u0650","translation":"\u0130\u015fte ceza g\u00fcn\u00fcnde onlara sunulacak ziyafet budur!","footnotes":""},{"id":"5036","sura":"56","aya":"57","arabic_text":"\u0646\u064e\u062d\u06e1\u0646\u064f \u062e\u064e\u0644\u064e\u0642\u06e1\u0646\u064e\u0670\u0643\u064f\u0645\u06e1 \u0641\u064e\u0644\u064e\u0648\u06e1\u0644\u064e\u0627 \u062a\u064f\u0635\u064e\u062f\u0651\u0650\u0642\u064f\u0648\u0646\u064e","translation":"Sizi biz yaratt\u0131k. Tasdik etmeniz gerekmez mi?","footnotes":""},{"id":"5037","sura":"56","aya":"58","arabic_text":"\u0623\u064e\u0641\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064f\u0645 \u0645\u0651\u064e\u0627 \u062a\u064f\u0645\u06e1\u0646\u064f\u0648\u0646\u064e","translation":"S\u00f6yleyin \u00f6yleyse, (rahimlere) d\u00f6kt\u00fc\u011f\u00fcn\u00fcz meni nedir?","footnotes":""},{"id":"5038","sura":"56","aya":"59","arabic_text":"\u0621\u064e\u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u062a\u064e\u062e\u06e1\u0644\u064f\u0642\u064f\u0648\u0646\u064e\u0647\u064f\u06e5\u0653 \u0623\u064e\u0645\u06e1 \u0646\u064e\u062d\u06e1\u0646\u064f \u0671\u0644\u06e1\u062e\u064e\u0670\u0644\u0650\u0642\u064f\u0648\u0646\u064e","translation":"Onu siz mi yarat\u0131yorsunuz yoksa yaratan biz miyiz?","footnotes":""},{"id":"5039","sura":"56","aya":"60","arabic_text":"\u0646\u064e\u062d\u06e1\u0646\u064f \u0642\u064e\u062f\u0651\u064e\u0631\u06e1\u0646\u064e\u0627 \u0628\u064e\u064a\u06e1\u0646\u064e\u0643\u064f\u0645\u064f \u0671\u0644\u06e1\u0645\u064e\u0648\u06e1\u062a\u064e \u0648\u064e\u0645\u064e\u0627 \u0646\u064e\u062d\u06e1\u0646\u064f \u0628\u0650\u0645\u064e\u0633\u06e1\u0628\u064f\u0648\u0642\u0650\u064a\u0646\u064e","translation":"Aran\u0131zda \u00f6l\u00fcm\u00fc takdir eden biziz ve biz, \u00f6n\u00fcne ge\u00e7ilebileceklerden de\u011filiz.","footnotes":""},{"id":"5040","sura":"56","aya":"61","arabic_text":"\u0639\u064e\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0646 \u0646\u0651\u064f\u0628\u064e\u062f\u0651\u0650\u0644\u064e \u0623\u064e\u0645\u06e1\u062b\u064e\u0670\u0644\u064e\u0643\u064f\u0645\u06e1 \u0648\u064e\u0646\u064f\u0646\u0634\u0650\u0626\u064e\u0643\u064f\u0645\u06e1 \u0641\u0650\u064a \u0645\u064e\u0627 \u0644\u064e\u0627 \u062a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e","translation":"B\u00f6ylece sizin yerinize benzerlerinizi getirelim ve sizi bilmedi\u011finiz bir \u00e2lemde tekrar var edelim diye (\u00f6l\u00fcm\u00fc takdir ettik).","footnotes":""},{"id":"5041","sura":"56","aya":"62","arabic_text":"\u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u0639\u064e\u0644\u0650\u0645\u06e1\u062a\u064f\u0645\u064f \u0671\u0644\u0646\u0651\u064e\u0634\u06e1\u0623\u064e\u0629\u064e \u0671\u0644\u06e1\u0623\u064f\u0648\u0644\u064e\u0649\u0670 \u0641\u064e\u0644\u064e\u0648\u06e1\u0644\u064e\u0627 \u062a\u064e\u0630\u064e\u0643\u0651\u064e\u0631\u064f\u0648\u0646\u064e","translation":"Andolsun, ilk yarat\u0131l\u0131\u015f\u0131 bildiniz. D\u00fc\u015f\u00fcn\u00fcp ibret alman\u0131z gerekmez mi?","footnotes":""},{"id":"5042","sura":"56","aya":"63","arabic_text":"\u0623\u064e\u0641\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064f\u0645 \u0645\u0651\u064e\u0627 \u062a\u064e\u062d\u06e1\u0631\u064f\u062b\u064f\u0648\u0646\u064e","translation":"\u015eimdi bana, ekti\u011finizi haber verin.","footnotes":""},{"id":"5043","sura":"56","aya":"64","arabic_text":"\u0621\u064e\u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u062a\u064e\u0632\u06e1\u0631\u064e\u0639\u064f\u0648\u0646\u064e\u0647\u064f\u06e5\u0653 \u0623\u064e\u0645\u06e1 \u0646\u064e\u062d\u06e1\u0646\u064f \u0671\u0644\u0632\u0651\u064e\u0670\u0631\u0650\u0639\u064f\u0648\u0646\u064e","translation":"Onu siz mi bitiriyorsunuz, yoksa bitiren biz miyiz?","footnotes":""},{"id":"5044","sura":"56","aya":"65","arabic_text":"\u0644\u064e\u0648\u06e1 \u0646\u064e\u0634\u064e\u0627\u0653\u0621\u064f \u0644\u064e\u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0670\u0647\u064f \u062d\u064f\u0637\u064e\u0670\u0645\u0657\u0627 \u0641\u064e\u0638\u064e\u0644\u06e1\u062a\u064f\u0645\u06e1 \u062a\u064e\u0641\u064e\u0643\u0651\u064e\u0647\u064f\u0648\u0646\u064e","translation":"Dileseydik onu kuru bir \u00e7\u00f6p yapard\u0131k da \u015fa\u015far kal\u0131rd\u0131n\u0131z.","footnotes":""},{"id":"5045","sura":"56","aya":"66","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0627 \u0644\u064e\u0645\u064f\u063a\u06e1\u0631\u064e\u0645\u064f\u0648\u0646\u064e","translation":"\u00abDo\u011frusu bor\u00e7 alt\u0131na girdik.","footnotes":""},{"id":"5046","sura":"56","aya":"67","arabic_text":"\u0628\u064e\u0644\u06e1 \u0646\u064e\u062d\u06e1\u0646\u064f \u0645\u064e\u062d\u06e1\u0631\u064f\u0648\u0645\u064f\u0648\u0646\u064e","translation":"Daha do\u011frusu, biz yoksul kald\u0131k\u00bb (derdiniz).","footnotes":""},{"id":"5047","sura":"56","aya":"68","arabic_text":"\u0623\u064e\u0641\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064f\u0645\u064f \u0671\u0644\u06e1\u0645\u064e\u0627\u0653\u0621\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u062a\u064e\u0634\u06e1\u0631\u064e\u0628\u064f\u0648\u0646\u064e","translation":"Ya i\u00e7ti\u011finiz suya ne dersiniz?","footnotes":""},{"id":"5048","sura":"56","aya":"69","arabic_text":"\u0621\u064e\u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u0623\u064e\u0646\u0632\u064e\u0644\u06e1\u062a\u064f\u0645\u064f\u0648\u0647\u064f \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0645\u064f\u0632\u06e1\u0646\u0650 \u0623\u064e\u0645\u06e1 \u0646\u064e\u062d\u06e1\u0646\u064f \u0671\u0644\u06e1\u0645\u064f\u0646\u0632\u0650\u0644\