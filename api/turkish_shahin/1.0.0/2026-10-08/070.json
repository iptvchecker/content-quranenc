:"38","arabic_text":"\u0623\u064e\u064a\u064e\u0637\u06e1\u0645\u064e\u0639\u064f \u0643\u064f\u0644\u0651\u064f \u0671\u0645\u06e1\u0631\u0650\u064a\u0655\u0656 \u0645\u0651\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0623\u064e\u0646 \u064a\u064f\u062f\u06e1\u062e\u064e\u0644\u064e \u062c\u064e\u0646\u0651\u064e\u0629\u064e \u0646\u064e\u0639\u0650\u064a\u0645\u0656","translation":"Onlardan her biri nimet cennetine sokulaca\u011f\u0131n\u0131 m\u0131 umuyor?","footnotes":""},{"id":"5414","sura":"70","aya":"39","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653\u06d6 \u0625\u0650\u0646\u0651\u064e\u0627 \u062e\u064e\u0644\u064e\u0642\u06e1\u0646\u064e\u0670\u0647\u064f\u0645 \u0645\u0651\u0650\u0645\u0651\u064e\u0627 \u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e","translation":"Hay\u0131r (hi\u00e7 ummas\u0131nlar!) \u015e\u00fcphesiz biz onlar\u0131, kendilerinin de bildikleri \u015feyden yaratt\u0131k (fakat ibret almad\u0131lar, imana gelmediler).\u2003","footnotes":""},{"id":"5415","sura":"70","aya":"40","arabic_text":"\u0641\u064e\u0644\u064e\u0627\u0653 \u0623\u064f\u0642\u06e1\u0633\u0650\u0645\u064f \u0628\u0650\u0631\u064e\u0628\u0651\u0650 \u0671\u0644\u06e1\u0645\u064e\u0634\u064e\u0670\u0631\u0650\u0642\u0650 \u0648\u064e\u0671\u0644\u06e1\u0645\u064e\u063a\u064e\u0670\u0631\u0650\u0628\u0650 \u0625\u0650\u0646\u0651\u064e\u0627 \u0644\u064e\u0642\u064e\u0670\u062f\u0650\u0631\u064f\u0648\u0646\u064e","translation":"\u015eu halde (i\u015fin ger\u00e7e\u011fi) \u00f6yle (umduklar\u0131 gibi) de\u011fil! Do\u011fular\u0131n ve bat\u0131lar\u0131n Rabbine yemin ederim ki, bizim g\u00fcc\u00fcm\u00fcz yeter.","footnotes":""},{"id":"5416","sura":"70","aya":"41","arabic_text":"\u0639\u064e\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0646 \u0646\u0651\u064f\u0628\u064e\u062f\u0651\u0650\u0644\u064e \u062e\u064e\u064a\u06e1\u0631\u0657\u0627 \u0645\u0651\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0648\u064e\u0645\u064e\u0627 \u0646\u064e\u062d\u06e1\u0646\u064f \u0628\u0650\u0645\u064e\u0633\u06e1\u0628\u064f\u0648\u0642\u0650\u064a\u0646\u064e","translation":"\u015e\u00fcphesiz onlar\u0131n yerine daha hay\u0131rl\u0131lar\u0131n\u0131 getirmeye  elbette kadiriz ve kimse bizim \u00f6n\u00fcm\u00fcze ge\u00e7emez.","footnotes":""},{"id":"5417","sura":"70","aya":"42","arabic_text":"\u0641\u064e\u0630\u064e\u0631\u06e1\u0647\u064f\u0645\u06e1 \u064a\u064e\u062e\u064f\u0648\u0636\u064f\u0648\u0627\u0652 \u0648\u064e\u064a\u064e\u0644\u06e1\u0639\u064e\u0628\u064f\u0648\u0627\u0652 \u062d\u064e\u062a\u0651\u064e\u0649\u0670 \u064a\u064f\u0644\u064e\u0670\u0642\u064f\u0648\u0627\u0652 \u064a\u064e\u0648\u06e1\u0645\u064e\u0647\u064f\u0645\u064f \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u064a\u064f\u0648\u0639\u064e\u062f\u064f\u0648\u0646\u064e","translation":"Ama sen onlar\u0131 (\u015fimdilik) b\u0131rak da, tehdit edildikleri g\u00fcnlerine kavu\u015funcaya dek dals\u0131nlar, oynayadursunlar.","footnotes":""},{"id":"5418","sura":"70","aya":"43","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064e\u062e\u06e1\u0631\u064f\u062c\u064f\u0648\u0646\u064e \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0623\u064e\u062c\u06e1\u062f\u064e\u0627\u062b\u0650 \u0633\u0650\u0631\u064e\u0627\u0639\u0657\u0627 \u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u0625\u0650\u0644\u064e\u0649\u0670 \u0646\u064f\u0635\u064f\u0628\u0656 \u064a\u064f\u0648\u0641\u0650\u0636\u064f\u0648\u0646\u064e","translation":"O g\u00fcn onlar, sanki dikili bir \u015feye ko\u015fuyorlar gibi, bir halde kabirlerinden f\u0131rlaya f\u0131rlaya \u00e7\u0131karlar.","footnotes":""},{"id":"5419","sura":"70","aya":"44","arabic_text":"\u062e\u064e\u0670\u0634\u0650\u0639\u064e\u0629\u064b \u0623\u064e\u0628\u06e1\u0635\u064e\u0670\u0631\u064f\u0647\u064f\u0645\u06e1 \u062a\u064e\u0631\u06e1\u0647\u064e\u0642\u064f\u0647\u064f\u0645\u06e1 \u0630\u0650\u0644\u0651\u064e\u0629\u065e\u06da \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0671\u0644\u06e1\u064a\u064e\u0648\u06e1\u0645\u064f \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u064a\u064f\u0648\u0639\u064e\u062f\u064f\u0648\u0646\u064e","translation":"G\u00f6zleri horluktan a\u015fa\u011f\u0131 d\u00fc\u015fm\u00fc\u015f ve kendileri zillete b\u00fcr\u00fcnm\u00fc\u015f. \u0130\u015fte bu, onlar\u0131n tehdit edilegeldikleri g\u00fcnd\u00fcr!","footnotes":""}]}