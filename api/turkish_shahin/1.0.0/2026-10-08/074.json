064e\u0646\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u064a\u0645\u064e\u0670\u0646\u0657\u0627 \u0648\u064e\u0644\u064e\u0627 \u064a\u064e\u0631\u06e1\u062a\u064e\u0627\u0628\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064f\u0648\u062a\u064f\u0648\u0627\u0652 \u0671\u0644\u06e1\u0643\u0650\u062a\u064e\u0670\u0628\u064e \u0648\u064e\u0671\u0644\u06e1\u0645\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e \u0648\u064e\u0644\u0650\u064a\u064e\u0642\u064f\u0648\u0644\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0641\u0650\u064a \u0642\u064f\u0644\u064f\u0648\u0628\u0650\u0647\u0650\u0645 \u0645\u0651\u064e\u0631\u064e\u0636\u065e \u0648\u064e\u0671\u0644\u06e1\u0643\u064e\u0670\u0641\u0650\u0631\u064f\u0648\u0646\u064e \u0645\u064e\u0627\u0630\u064e\u0627\u0653 \u0623\u064e\u0631\u064e\u0627\u062f\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0628\u0650\u0647\u064e\u0670\u0630\u064e\u0627 \u0645\u064e\u062b\u064e\u0644\u0657\u0627\u06da \u0643\u064e\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u064a\u064f\u0636\u0650\u0644\u0651\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0645\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064f \u0648\u064e\u064a\u064e\u0647\u06e1\u062f\u0650\u064a \u0645\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064f\u06da \u0648\u064e\u0645\u064e\u0627 \u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u062c\u064f\u0646\u064f\u0648\u062f\u064e \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0647\u064f\u0648\u064e\u06da \u0648\u064e\u0645\u064e\u0627 \u0647\u0650\u064a\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0630\u0650\u0643\u06e1\u0631\u064e\u0649\u0670 \u0644\u0650\u0644\u06e1\u0628\u064e\u0634\u064e\u0631\u0650","translation":"Biz cehennemin i\u015flerine bakmakla ancak melekleri g\u00f6revlendirmi\u015fizdir. Onlar\u0131n say\u0131s\u0131n\u0131 da ink\u00e2rc\u0131lar i\u00e7in sadece bir imtinan (vesilesi) yapt\u0131k ki, b\u00f6ylelikle, kendilerine kitap verilenler iyiden iyiye \u00f6\u011frensin, iman edenlerin iman\u0131n\u0131 artt\u0131rs\u0131n; hem kendilerine kitap verilenler hem m\u00fcminler \u015f\u00fcpheye d\u00fc\u015fmesinler, kalplerinde hastal\u0131k bulunanlar ve k\u00e2firler de: \u00abAllah bu misalle ne demek istemi\u015ftir ki?\u00bb desinler. \u0130\u015fte Allah b\u00f6ylece, diledi\u011fini sap\u0131kl\u0131kta b\u0131rak\u0131r, diledi\u011fini do\u011fru yola eri\u015ftirir. Rabbinin ordular\u0131n\u0131, kendisinden ba\u015fkas\u0131 bilmez. Bu ise, insanl\u0131k i\u00e7in ancak bir \u00f6\u011f\u00fctt\u00fcr.","footnotes":""},{"id":"5527","sura":"74","aya":"32","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627 \u0648\u064e\u0671\u0644\u06e1\u0642\u064e\u0645\u064e\u0631\u0650","translation":"Hay\u0131r hay\u0131r (\u00f6\u011f\u00fct almazlar). Aya andolsun ki,","footnotes":""},{"id":"5528","sura":"74","aya":"33","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u064a\u06e1\u0644\u0650 \u0625\u0650\u0630\u06e1 \u0623\u064e\u062f\u06e1\u0628\u064e\u0631\u064e","translation":"D\u00f6n\u00fcp gitmekte olan geceye,","footnotes":""},{"id":"5529","sura":"74","aya":"34","arabic_text":"\u0648\u064e\u0671\u0644\u0635\u0651\u064f\u0628\u06e1\u062d\u0650 \u0625\u0650\u0630\u064e\u0627\u0653 \u0623\u064e\u0633\u06e1\u0641\u064e\u0631\u064e","translation":"a\u011farmakta olan sabaha andolsun ki,","footnotes":""},{"id":"5530","sura":"74","aya":"35","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064e\u0627 \u0644\u064e\u0625\u0650\u062d\u06e1\u062f\u064e\u0649 \u0671\u0644\u06e1\u0643\u064f\u0628\u064e\u0631\u0650","translation":"O (cehennem), b\u00fcy\u00fck musibetlerden biridir.","footnotes":""},{"id":"5531","sura":"74","aya":"36","arabic_text":"\u0646\u064e\u0630\u0650\u064a\u0631\u0657\u0627 \u0644\u0651\u0650\u0644\u06e1\u0628\u064e\u0634\u064e\u0631\u0650","translation":" \u0130nsanl\u0131k i\u00e7in, uyar\u0131c\u0131. ","footnotes":""},{"id":"5532","sura":"74","aya":"37","arabic_text":"\u0644\u0650\u0645\u064e\u0646 \u0634\u064e\u0627\u0653\u0621\u064e \u0645\u0650\u0646\u0643\u064f\u0645\u06e1 \u0623\u064e\u0646 \u064a\u064e\u062a\u064e\u0642\u064e\u062f\u0651\u064e\u0645\u064e \u0623\u064e\u0648\u06e1 \u064a\u064e\u062a\u064e\u0623\u064e\u062e\u0651\u064e\u0631\u064e","translation":" Sizden ileri gitmek ya da geri kalmak isteyen kimseler i\u00e7in. ","footnotes":""},{"id":"5533","sura":"74","aya":"38","arabic_text":"\u0643\u064f\u0644\u0651\u064f \u0646\u064e\u0641\u06e1\u0633\u0650\u06ed \u0628\u0650\u0645\u064e\u0627 \u0643\u064e\u0633\u064e\u0628\u064e\u062a\u06e1 \u0631\u064e\u0647\u0650\u064a\u0646\u064e\u0629\u064c","translation":"Her nefis, kazand\u0131\u011f\u0131na kar\u015f\u0131l\u0131k bir rehindir,","footnotes":""},{"id":"5534","sura":"74","aya":"39","arabic_text":"\u0625\u0650\u0644\u0651\u064e\u0627\u0653 \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u064e \u0671\u0644\u06e1\u064a\u064e\u0645\u0650\u064a\u0646\u0650","translation":"ancak sa\u011fdakiler ba\u015fka.","footnotes":""},{"id":"5535","sura":"74","aya":"40","arabic_text":"\u0641\u0650\u064a \u062c\u064e\u0646\u0651\u064e\u0670\u062a\u0656 \u064a\u064e\u062a\u064e\u0633\u064e\u0627\u0653\u0621\u064e\u0644\u064f\u0648\u0646\u064e","translation":"Onlar cennetler i\u00e7indedir. Uzaktan uza\u011fa sorarlar.","footnotes":""},{"id":"5536","sura":"74","aya":"41","arabic_text":"\u0639\u064e\u0646\u0650 \u0671\u0644\u06e1\u0645\u064f\u062c\u06e1\u0631\u0650\u0645\u0650\u064a\u0646\u064e","translation":"G\u00fcnahk\u00e2rlara: ","footnotes":""},{"id":"5537","sura":"74","aya":"42","arabic_text":"\u0645\u064e\u0627 \u0633\u064e\u0644\u064e\u0643\u064e\u0643\u064f\u0645\u06e1 \u0641\u0650\u064a \u0633\u064e\u0642\u064e\u0631\u064e","translation":"Sizi \u015fu yak\u0131c\u0131 ate\u015fe sokan nedir? diye ","footnotes":""},{"id":"5538","sura":"74","aya":"43","arabic_text":"\u0642\u064e\u0627\u0644\u064f\u0648\u0627\u0652 \u0644\u064e\u0645\u06e1 \u0646\u064e\u0643\u064f \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0645\u064f\u0635\u064e\u0644\u0651\u0650\u064a\u0646\u064e","translation":"Onlar \u015f\u00f6yle cevap verirler: Biz namaz k\u0131lanlardan de\u011fildik,","footnotes":""},{"id":"5539","sura":"74","aya":"44","arabic_text":"\u0648\u064e\u0644\u064e\u0645\u06e1 \u0646\u064e\u0643\u064f \u0646\u064f\u0637\u06e1\u0639\u0650\u0645\u064f \u0671\u0644\u06e1\u0645\u0650\u0633\u06e1\u0643\u0650\u064a\u0646\u064e","translation":"yoksulu doyurmuyorduk,","footnotes":""},{"id":"5540","sura":"74","aya":"45","arabic_text":"\u0648\u064e\u0643\u064f\u0646\u0651\u064e\u0627 \u0646\u064e\u062e\u064f\u0648\u0636\u064f \u0645\u064e\u0639\u064e \u0671\u0644\u06e1\u062e\u064e\u0627\u0653\u0626\u0650\u0636\u0650\u064a\u0646\u064e","translation":"(B\u00e2t\u0131la) dalanlarla birlikte dal\u0131yorduk,","footnotes":""},{"id":"5541","sura":"74","aya":"46","arabic_text":"\u0648\u064e\u0643\u064f\u0646\u0651\u064e\u0627 \u0646\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f \u0628\u0650\u064a\u064e\u0648\u06e1\u0645\u0650 \u0671\u0644\u062f\u0651\u0650\u064a\u0646\u0650","translation":"Ceza g\u00fcn\u00fcn\u00fc de yalan say\u0131yorduk,","footnotes":""},{"id":"5542","sura":"74","aya":"47","arabic_text":"\u062d\u064e\u062a\u0651\u064e\u0649\u0670\u0653 \u0623\u064e\u062a\u064e\u0649\u0670\u0646\u064e\u0627 \u0671\u0644\u06e1\u064a\u064e\u0642\u0650\u064a\u0646\u064f","translation":"sonunda bize \u00f6l\u00fcm geldi \u00e7att\u0131. ","footnotes":""},{"id":"5543","sura":"74","aya":"48","arabic_text":"\u0641\u064e\u0645\u064e\u0627 \u062a\u064e\u0646\u0641\u064e\u0639\u064f\u0647\u064f\u0645\u06e1 \u0634\u064e\u0641\u064e\u0670\u0639\u064e\u0629\u064f \u0671\u0644\u0634\u0651\u064e\u0670\u0641\u0650\u0639\u0650\u064a\u0646\u064e","translation":"Art\u0131k \u015fefaat\u00e7ilerin \u015fefaati onlara fayda vermez.","footnotes":""},{"id":"5544","sura":"74","aya":"49","arabic_text":"\u0641\u064e\u0645\u064e\u0627 \u0644\u064e\u0647\u064f\u0645\u06e1 \u0639\u064e\u0646\u0650 \u0671\u0644\u062a\u0651\u064e\u0630\u06e1\u0643\u0650\u0631\u064e\u0629\u0650 \u0645\u064f\u0639\u06e1\u0631\u0650\u0636\u0650\u064a\u0646\u064e","translation":"B\u00f6yle iken onlara ne oluyor ki, y\u00fcz \u00e7eviriyorlar?","footnotes":""},{"id":"5545","sura":"74","aya":"50","arabic_text":"\u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u062d\u064f\u0645\u064f\u0631\u065e \u0645\u0651\u064f\u0633\u06e1\u062a\u064e\u0646\u0641\u0650\u0631\u064e\u0629\u065e","translation":"\u00c2deta yaban e\u015fekleri gibi (h\u00e2l\u00e2) \u00f6\u011f\u00fctten, ","footnotes":""},{"id":"5546","sura":"74","aya":"51","arabic_text":"\u0641\u064e\u0631\u0651\u064e\u062a\u06e1 \u0645\u0650\u0646 \u0642\u064e\u0633\u06e1\u0648\u064e\u0631\u064e\u0629\u0650\u06ed","translation":"arslandan \u00fcrk\u00fcp ka\u00e7an.","footnotes":""},{"id":"5547","sura":"74","aya":"52","arabic_text":"\u0628\u064e\u0644\u06e1 \u064a\u064f\u0631\u0650\u064a\u062f\u064f \u0643\u064f\u0644\u0651\u064f \u0671\u0645\u06e1\u0631\u0650\u064a\u0655\u0656 \u0645\u0651\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0623\u064e\u0646 \u064a\u064f\u0624\u06e1\u062a\u064e\u0649\u0670 \u0635\u064f\u062d\u064f\u0641\u0657\u0627 \u0645\u0651\u064f\u0646\u064e\u0634\u0651\u064e\u0631\u064e\u0629\u0657","translation":"Daha do\u011frusu onlardan her biri, kendisine, (\u00f6n\u00fcnde) a\u00e7\u0131lm\u0131\u015f sahifeler (\u0130l\u00e2h\u00ee vahiy) verilmesini istiyor.","footnotes":""},{"id":"5548","sura":"74","aya":"53","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u06d6 \u0628\u064e\u0644 \u0644\u0651\u064e\u0627 \u064a\u064e\u062e\u064e\u0627\u0641\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u064e\u0629\u064e","translation":"Hay\u0131r! Asl\u0131nda onlar ahiretten korkmuyorlar.","footnotes":""},{"id":"5549","sura":"74","aya":"54","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653 \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u062a\u064e\u0630\u06e1\u0643\u0650\u0631\u064e\u0629\u065e","translation":"Asla (d\u00fc\u015f\u00fcnd\u00fckleri gibi de\u011fil)! Bilsinler ki bu, ger\u00e7ekten bir ikazd\u0131r!","footnotes":""},{"id":"5550","sura":"74","aya":"55","arabic_text":"\u0641\u064e\u0645\u064e\u0646 \u0634\u064e\u0627\u0653\u0621\u064e \u0630\u064e\u0643\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"Dileyen ondan (d\u00fc\u015f\u00fcn\u00fcp) \u00f6\u011f\u00fct al\u0131r.","footnotes":""},{"id":"5551","sura":"74","aya":"56","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u064a\u064e\u0630\u06e1\u0643\u064f\u0631\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627\u0653 \u0623\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f\u06da \u0647\u064f\u0648\u064e \u0623\u064e\u0647\u06e1\u0644\u064f \u0671\u0644\u062a\u0651\u064e\u0642\u06e1\u0648\u064e\u0649\u0670 \u0648\u064e\u0623\u064e\u0647\u06e1\u0644\u064f \u0671\u0644\u06e1\u0645\u064e\u063a\u06e1\u0641\u0650\u0631\u064e\u0629\u0650","translation":"Bununla beraber, Allah dilemeksizin onlar \u00f6\u011f\u00fct alamazlar. Sak\u0131n\u0131lmaya l\u00e2y\u0131k olan da O'dur, ma\u011ffiret sahibi de O\u2019dur.","footnotes":""}]}